@model CreateChoiceItemViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Sửa bài học" : "Tạo bài học";
    var skillGroups = ViewBag.SkillGroups as IReadOnlyList<SkillGroup> ?? [];
    var activityTemplates = ViewBag.ActivityTemplates as IReadOnlyList<ActivityTemplateDefinition> ?? [];
    var mediaAssets = ViewBag.MediaAssets as IReadOnlyList<MediaAsset> ?? [];
    var imageAssets = mediaAssets.Where(x => x.AssetType == "image").ToList();
    var voiceCacheJson = ViewBag.VoiceCacheJson as string ?? "[]";
    var imageAssetsJson = ViewBag.ImageAssetsJson as string ?? "[]";
}

<style>
.activity-builder-2col-layout {
    display: grid;
    grid-template-columns: 320px minmax(480px, 1fr);
    align-items: start;
    gap: 22px;
}
@@media (max-width: 1024px) {
    .activity-builder-2col-layout {
        grid-template-columns: 1fr;
    }
}
.activity-header-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 18px;
    padding: 14px 20px;
    background: #ffffff;
    border: 1px solid var(--line, #e2e8f0);
    border-radius: 18px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
}
.activity-title-block {
    display: flex;
    align-items: center;
    gap: 14px;
}
.activity-page-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
}
.activity-page-subtitle {
    margin: 2px 0 0;
    font-size: 0.84rem;
    color: #64748b;
    line-height: 1.35;
}
.activity-toolbar-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}
/* Left Column Sticky Phone Preview - Always pinned in view */
.activity-builder-stage-sticky {
    position: sticky;
    top: 16px;
    align-self: start;
    z-index: 10;
}
.activity-preview-card {
    background: #ffffff;
    border: 1px solid var(--line, #e2e8f0);
    border-radius: 20px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.activity-preview-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 8px;
}
.builder-phone {
    width: 286px;
    height: 520px;
    aspect-ratio: unset;
    border: 8px solid #0f172a;
    border-radius: 28px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    margin: 2px auto 0;
    overflow: hidden;
    flex-shrink: 0;
    background: #ffffff;
}
.builder-phone-screen {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fffdf7;
    padding: 10px;
    overflow-y: auto;
}
/* Right Column Section Cards */
.activity-section-card {
    background: #ffffff;
    border: 1px solid var(--line, #e2e8f0);
    border-radius: 18px;
    padding: 18px 20px;
    margin-bottom: 18px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
}
.activity-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1.5px solid #f1f5f9;
}
.activity-section-header h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
}
.activity-section-icon {
    font-size: 1.3rem;
    color: #f97316;
    background: #fff7ed;
    padding: 6px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.activity-field-group {
    margin-bottom: 14px;
}
.activity-field-group:last-child {
    margin-bottom: 0;
}
.activity-field-group label {
    display: block;
    font-size: 0.86rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 5px;
}
.activity-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}
.activity-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}
@@media (max-width: 992px) {
    .activity-grid-4 {
        grid-template-columns: 1fr 1fr;
    }
}
@@media (max-width: 576px) {
    .activity-grid-2, .activity-grid-4 {
        grid-template-columns: 1fr;
    }
}
</style>

<section class="admin-layout">
    <partial name="_AdminSidebar" />
    <main class="admin-main activity-builder-page">
        <script type="application/json" data-voice-cache-json>@Html.Raw(voiceCacheJson)</script>
        <script type="application/json" data-image-assets-json>@Html.Raw(imageAssetsJson)</script>
        <partial name="_AdminHeader" model="@(isEdit ? "Sửa bài học" : "Tạo bài học mới")" />

        <!-- 1. Thanh điều hướng & Thao tác chính gọn gàng (Đã loại bỏ các nút thừa) -->
        <div class="activity-header-toolbar">
            <div class="activity-title-block">
                <a class="btn-back-circle" asp-action="LearningItems" title="Quay lại Kho bài học">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="activity-page-title">@(isEdit ? (!string.IsNullOrWhiteSpace(Model.Title) ? Model.Title : "Chỉnh sửa bài học") : "Tạo bài học tương tác mới")</h2>
                        @if (isEdit)
                        {
                            <span class="status-chip status-@Model.Status">@ContentStatus.GetDisplayName(Model.Status)</span>
                            @if (!Model.IsCompatible)
                            {
                                <span class="status-chip status-warning" title="Bài học cần chuẩn hóa nhóm kỹ năng">
                                    <span class="material-symbols-outlined" style="font-size:14px; margin-right:3px;">warning</span>
                                    Cần chuẩn hóa
                                </span>
                            }
                        }
                    </div>
                    <p class="activity-page-subtitle">Soạn thảo câu hỏi, dạng tương tác, gắn hình ảnh và cấu hình âm thanh cho bé</p>
                </div>
            </div>

            <div class="activity-toolbar-actions">
                @if (isEdit)
                {
                    <form asp-action="GenerateLearningItemAudio" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button class="dash-btn dash-btn-outline" type="submit" title="Tự động tạo âm thanh giọng đọc AI cho câu hỏi và các lựa chọn của bài học này">
                            <span class="material-symbols-outlined">record_voice_over</span>
                            <span>Tạo Voice AI</span>
                        </button>
                    </form>

                    <form asp-action="DeleteLearningItem" asp-route-id="@Model.Id" method="post" data-confirm-delete class="d-inline">
                        <button class="dash-btn dash-btn-outline btn-action-delete" type="submit" title="Xóa bài học này">
                            <span class="material-symbols-outlined">delete</span>
                            <span>Xóa</span>
                        </button>
                    </form>
                }

                <!-- Duy nhất 1 nút Lưu chính trên toàn trang -->
                <button class="dash-btn dash-btn-primary" type="submit" form="activity-builder-form">
                    <span class="material-symbols-outlined">save</span>
                    <span>@(isEdit ? "Lưu thay đổi" : "Lưu bài học")</span>
                </button>
            </div>
        </div>

        <!-- 2. Form Trình tạo bài học (Bố cục 2 cột cân đối, Live Preview luôn ghim cố định) -->
        <form id="activity-builder-form" class="activity-builder-2col-layout" asp-action="CreateChoice" method="post" enctype="multipart/form-data" data-admin-learning-form data-activity-builder>
            <!-- Các trường dữ liệu ẩn & mặc định hệ thống -->
            <input asp-for="Id" type="hidden" />
            <input asp-for="IsCompatible" type="hidden" />
            <input asp-for="InstructionText" type="hidden" />
            <input asp-for="HintText" type="hidden" />
            <input asp-for="AudioUrl" type="hidden" />
            <input asp-for="AudioUrlEn" type="hidden" />
            <input asp-for="QuestionAudioUrl" type="hidden" />
            <input asp-for="QuestionAudioUrlEn" type="hidden" />
            <input asp-for="CorrectFeedbackAudioUrl" type="hidden" />
            <input asp-for="CorrectFeedbackAudioUrlEn" type="hidden" />
            <input asp-for="RetryFeedbackAudioUrl" type="hidden" />
            <input asp-for="RetryFeedbackAudioUrlEn" type="hidden" />
            <input asp-for="TopicId" type="hidden" value="" />

            <!-- Các phần tử ẩn phục vụ tương thích site.js (không gây tốn diện tích màn hình) -->
            <div hidden>
                @foreach (var template in activityTemplates)
                {
                    <button type="button" data-template-option="@template.InteractionType"></button>
                }
                <a data-tracing-link hidden></a>
            </div>

            <!-- CỘT 1: KHUNG XEM TRƯỚC ĐIỆN THOẠI (STICKY - LUÔN CỐ ĐỊNH TRONG TẦM MẮT) -->
            <aside class="activity-builder-stage-sticky">
                <div class="activity-preview-card">
                    <div class="activity-preview-card-header">
                        <div class="d-flex align-items-center gap-1">
                            <span class="material-symbols-outlined" style="color:#0284c7; font-size:18px;">smartphone</span>
                            <strong style="color:#0f172a; font-size:0.92rem;">Xem trước trực quan</strong>
                        </div>
                        <span class="badge-preview-mode" data-preview-template-name>Chọn một đáp án</span>
                    </div>

                    <div class="builder-phone">
                        <div class="builder-phone-screen">
                            <div class="builder-phone-status">
                                <span>9:41</span>
                                <span>● ● ●</span>
                            </div>
                            <div class="builder-preview-topbar" style="display:flex; align-items:center; justify-content:space-between; gap:6px; padding:6px 10px; background:#ffffff; border:1.5px solid #e0f2fe; border-radius:14px; margin-bottom:10px; box-shadow:0 3px 8px rgba(0,0,0,0.03);">
                                <span class="material-symbols-outlined" style="font-size:1.1rem; color:#64748b;">arrow_back</span>
                                <strong data-preview-prompt style="flex:1; text-align:center; font-size:0.88rem; color:#0f172a; line-height:1.2; font-weight:800;">Con chọn đáp án phù hợp nhé.</strong>
                                <span class="material-symbols-outlined" style="font-size:1.15rem; color:#ea580c; background:#fff7ed; border-radius:50%; padding:2px;">volume_up</span>
                            </div>
                            <div class="builder-preview-media" data-preview-media hidden>
                                <span class="material-symbols-outlined">image</span>
                            </div>
                            <div class="builder-preview-activity" data-preview-activity>
                                <div class="builder-preview-options" data-preview-options>
                                    <button type="button">A</button><button type="button">B</button><button type="button">C</button>
                                </div>
                            </div>
                            <button class="builder-preview-submit" type="button" disabled style="margin-top:auto; padding:8px; font-size:0.82rem;">Kiểm tra đáp án</button>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- CỘT 2: CÁC KHỐI CẤU HÌNH & NỘI DUNG CHÍNH (GỌN GÀNG, KHÔNG DÀI DÒNG) -->
            <div class="activity-builder-properties">
                <div asp-validation-summary="All" class="text-danger mb-2" style="font-size:0.88rem; font-weight:600;"></div>

                <!-- KHỐI 1: PHÂN LOẠI & MẪU HOẠT ĐỘNG (GỌN GÀNG) -->
                <section class="activity-section-card">
                    <div class="activity-section-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="activity-section-icon material-symbols-outlined">category</span>
                            <h3>Phân loại & Dạng bài</h3>
                        </div>
                        <span class="badge-sub">Mục tiêu</span>
                    </div>

                    <div class="activity-grid-2 mb-3">
                        <div class="activity-field-group mb-0">
                            <label asp-for="SkillGroupId">Nhóm kỹ năng <span class="text-danger">*</span></label>
                            <select asp-for="SkillGroupId" class="form-control" data-skill-group-select>
                                @foreach (var group in skillGroups)
                                {
                                    var rule = ActivityTemplateCatalog.ForSkillGroup(group.Code);
                                    <option value="@group.Id" data-allowed-types="@string.Join(',', rule.InteractionTypes)" data-allows-tracing="@rule.AllowsTracing.ToString().ToLowerInvariant()">@group.Name</option>
                                }
                            </select>
                        </div>

                        <div class="activity-field-group mb-0">
                            <label asp-for="InteractionType">Dạng bài tương tác <span class="text-danger">*</span></label>
                            <select asp-for="InteractionType" class="form-control" data-interaction-select>
                                @foreach (var template in activityTemplates)
                                {
                                    <option value="@template.InteractionType" data-default-instruction="@template.DefaultInstruction" data-default-prompt="@template.DefaultPrompt" data-description="@template.Description">@template.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Hàng cấu hình phụ: Độ khó, Thứ tự, Thời lượng, Trạng thái bài học -->
                    <div class="activity-grid-4">
                        <div class="activity-field-group mb-0">
                            <label asp-for="Level">Độ khó</label>
                            <select asp-for="Level" class="form-control">
                                <option value="1">Dễ (Khởi đầu)</option>
                                <option value="2">Trung bình (Luyện tập)</option>
                                <option value="3">Nâng cao (Thử thách)</option>
                            </select>
                        </div>

                        <div class="activity-field-group mb-0">
                            <label asp-for="SortOrder">Thứ tự học</label>
                            <input asp-for="SortOrder" class="form-control" type="number" min="0" max="100000" placeholder="Tự động" />
                        </div>

                        <div class="activity-field-group mb-0">
                            <label asp-for="EstimatedMinutes">Thời lượng (phút)</label>
                            <input asp-for="EstimatedMinutes" class="form-control" type="number" min="1" max="30" value="@(Model.EstimatedMinutes > 0 ? Model.EstimatedMinutes : 5)" />
                        </div>

                        <div class="activity-field-group mb-0">
                            <label asp-for="Status">Trạng thái bài học</label>
                            <select asp-for="Status" class="form-control">
                                <option value="@ContentStatus.Published">Xuất bản (Bé thấy bài)</option>
                                <option value="@ContentStatus.Draft">Bản nháp (Đang soạn)</option>
                            </select>
                        </div>
                    </div>
                </section>

                <!-- KHỐI 2: NỘI DUNG CÂU HỎI & CẤU HÌNH ĐÁP ÁN (ĐÃ TÍCH HỢP PHẢN HỒI SƯ PHẠM VÀO CHUNG) -->
                <section class="activity-section-card">
                    <div class="activity-section-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="activity-section-icon material-symbols-outlined">edit_square</span>
                            <h3>Nội dung câu hỏi & Đáp án</h3>
                        </div>
                        <span class="badge-sub">Câu hỏi & Lựa chọn</span>
                    </div>

                    <div class="activity-field-group">
                        <label asp-for="PromptText">Câu hỏi / Lời dặn chính (Phát âm thanh trong bài) <span class="text-danger">*</span></label>
                        <textarea asp-for="PromptText" class="form-control" rows="2" maxlength="500" placeholder="Ví dụ: Con hãy chọn đúng chữ cái nhé!" data-preview-source="prompt" required></textarea>
                        <span asp-validation-for="PromptText" class="text-danger"></span>
                        <small style="color:#64748b; font-size:0.8rem;">Câu này sẽ được đọc tự động khi bé bắt đầu bài học.</small>
                    </div>

                    <div class="activity-field-group">
                        <label asp-for="Title">Tên bài hiển thị trên Bản đồ (Ngắn gọn 2-5 từ) <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" maxlength="100" placeholder="Ví dụ: Nhận biết chữ A" data-preview-source="title" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                        <small style="color:#64748b; font-size:0.8rem;">Tên này xuất hiện trên các nút Bản đồ Map và Thẻ bài học của bé.</small>
                    </div>

                    <div class="builder-template-context mb-3" style="padding:8px 12px; background:#f0f9ff; border:1px solid #bae6fd; border-radius:10px;">
                        <strong data-config-name style="color:#0369a1; font-size:0.88rem;"></strong>
                        <p data-config-description class="mb-0" style="color:#0c4a6e; font-size:0.82rem;"></p>
                    </div>

                    <!-- Dynamic field sections tương ứng với từng dạng bài -->
                    <div class="builder-config-section" data-builder-fields="single_choice,multi_select,listen_choose,drag_drop,story_choice">
                        <h4 data-choice-heading style="font-size:0.92rem; font-weight:800; color:#1e293b; margin-bottom:4px;">Phương án trả lời</h4>
                        <p class="builder-field-help mb-2" data-choice-help style="font-size:0.8rem; color:#64748b;"></p>
                        <div class="builder-choice-grid">
                            <div><label asp-for="ChoiceA">Lựa chọn 1</label><input asp-for="ChoiceA" class="form-control" data-choice-input /></div>
                            <div><label asp-for="ChoiceB">Lựa chọn 2</label><input asp-for="ChoiceB" class="form-control" data-choice-input /></div>
                            <div><label asp-for="ChoiceC">Lựa chọn 3</label><input asp-for="ChoiceC" class="form-control" data-choice-input /></div>
                            <div><label asp-for="ChoiceD">Lựa chọn 4</label><input asp-for="ChoiceD" class="form-control" data-choice-input /></div>
                            <div><label asp-for="ChoiceE">Lựa chọn 5</label><input asp-for="ChoiceE" class="form-control" data-choice-input /></div>
                        </div>
                    </div>

                    <div class="builder-config-section mt-3" data-builder-fields="single_choice,listen_choose,drag_drop,story_choice">
                        <label asp-for="CorrectAnswer" style="font-weight:700; color:#1e293b; margin-bottom:4px; display:block;">Đáp án đúng</label>
                        <select asp-for="CorrectAnswer" class="form-control" data-correct-answer>
                            @if (!string.IsNullOrWhiteSpace(Model.CorrectAnswer))
                            {
                                <option value="@Model.CorrectAnswer">@Model.CorrectAnswer</option>
                            }
                        </select>
                        <span asp-validation-for="CorrectAnswer" class="text-danger"></span>
                    </div>

                    <div class="builder-config-section mt-3" data-builder-fields="multi_select">
                        <h4 style="font-size:0.92rem; font-weight:800; color:#1e293b; margin-bottom:4px;">Tập đáp án đúng</h4>
                        <label asp-for="CorrectAnswersText">Các đáp án đúng</label>
                        <textarea asp-for="CorrectAnswersText" class="form-control" rows="3" placeholder="Mỗi đáp án một dòng"></textarea>
                    </div>

                    <div class="builder-config-section mt-3" data-builder-fields="drag_drop,quantity_builder">
                        <h4 style="font-size:0.92rem; font-weight:800; color:#1e293b; margin-bottom:4px;">Vùng nhận kết quả</h4>
                        <label asp-for="TargetLabel">Tên vùng đích</label>
                        <input asp-for="TargetLabel" class="form-control" />
                    </div>

                    <div class="builder-config-section mt-3" data-builder-fields="matching">
                        <h4 style="font-size:0.92rem; font-weight:800; color:#1e293b; margin-bottom:4px;">Danh sách cặp nối</h4>
                        <label asp-for="PairsText">Các cặp cần nối</label>
                        <textarea asp-for="PairsText" class="form-control" rows="5" placeholder="A = a&#10;B = b&#10;C = c"></textarea>
                        <span asp-validation-for="PairsText" class="text-danger"></span>
                    </div>

                    <div class="builder-config-section mt-3" data-builder-fields="ordering">
                        <h4 style="font-size:0.92rem; font-weight:800; color:#1e293b; margin-bottom:4px;">Chuỗi thứ tự chuẩn</h4>
                        <label asp-for="SequenceItemsText">Thứ tự đúng</label>
                        <textarea asp-for="SequenceItemsText" class="form-control" rows="5" placeholder="Mỗi mục một dòng theo thứ tự đúng"></textarea>
                        <span asp-validation-for="SequenceItemsText" class="text-danger"></span>
                    </div>

                    <div class="builder-config-section mt-3" data-builder-fields="counting,quantity_builder,comparison">
                        <h4 style="font-size:0.92rem; font-weight:800; color:#1e293b; margin-bottom:4px;">Đồ vật và số lượng</h4>
                        <div class="activity-grid-2">
                            <div>
                                <label asp-for="ObjectSymbol">Ký hiệu đồ vật</label>
                                <input asp-for="ObjectSymbol" class="form-control" maxlength="12" />
                            </div>
                            <div>
                                <label asp-for="TargetCount">Số lượng mục tiêu / Nhóm A</label>
                                <input asp-for="TargetCount" class="form-control" type="number" min="0" max="20" />
                            </div>
                        </div>
                    </div>

                    <div class="builder-config-section mt-3" data-builder-fields="comparison">
                        <label asp-for="ComparisonVisualMode">Cách trình bày</label>
                        <select asp-for="ComparisonVisualMode" class="form-control">
                            <option value="quantity">Hai nhóm đồ vật (so sánh số lượng)</option>
                            <option value="shape">Hai hình (so sánh kích thước/hình học)</option>
                        </select>
                        <p class="builder-field-help" style="font-size:0.8rem; color:#64748b; margin-top:3px;">Với nhóm Hình dạng và không gian, chọn “Hai hình”; số lượng nhóm A/B được dùng làm kích thước hiển thị của hai hình.</p>
                        <div class="activity-grid-2 mt-2">
                            <div><label asp-for="LeftLabel">Tên nhóm bên trái</label><input asp-for="LeftLabel" class="form-control" /></div>
                            <div><label asp-for="RightLabel">Tên nhóm bên phải</label><input asp-for="RightLabel" class="form-control" /></div>
                        </div>
                        <div class="activity-grid-2 mt-2">
                            <div>
                                <label asp-for="SecondaryCount">Số lượng nhóm B</label>
                                <input asp-for="SecondaryCount" class="form-control" type="number" min="0" max="20" />
                            </div>
                            <div>
                                <label asp-for="ComparisonMode">Yêu cầu so sánh</label>
                                <select asp-for="ComparisonMode" class="form-control">
                                    <option value="more">Chọn nhóm nhiều hơn</option>
                                    <option value="less">Chọn nhóm ít hơn</option>
                                    <option value="equal">Kiểm tra hai nhóm bằng nhau</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="builder-config-section mt-3" data-builder-fields="classification">
                        <h4 style="font-size:0.92rem; font-weight:800; color:#1e293b; margin-bottom:4px;">Vật và nhóm đích</h4>
                        <label asp-for="ClassificationText">Vật và nhóm phân loại</label>
                        <textarea asp-for="ClassificationText" class="form-control" rows="5" placeholder="Hình vuông = Hình có góc&#10;Hình tròn = Hình không góc"></textarea>
                        <span asp-validation-for="ClassificationText" class="text-danger"></span>
                    </div>

                    <div class="builder-config-section mt-3" data-builder-fields="story_choice">
                        <h4 style="font-size:0.92rem; font-weight:800; color:#1e293b; margin-bottom:4px;">Nội dung truyện</h4>
                        <label asp-for="SpeechText">Câu chuyện bé sẽ nghe</label>
                        <textarea asp-for="SpeechText" class="form-control" rows="4" maxlength="1000" placeholder="Nhập trọn vẹn câu chuyện hoặc đoạn kể dài"></textarea>
                        <p class="builder-field-help" style="font-size:0.8rem; color:#64748b; margin-top:3px;">Chỉ dùng cho dạng Nghe truyện và chọn. Dạng Nghe và chọn sẽ đọc trực tiếp đúng nội dung Câu hỏi / Yêu cầu chính.</p>
                    </div>

                    <!-- Phản hồi sư phạm tích hợp gọn gàng vào cuối khối câu hỏi -->
                    <div class="activity-grid-2 mt-3 pt-3" style="border-top:1.5px dashed #e2e8f0;">
                        <div class="activity-field-group mb-0">
                            <label asp-for="CorrectFeedback" style="color:#15803d; font-size:0.82rem;">Lời khen khi bé trả lời đúng</label>
                            <input asp-for="CorrectFeedback" class="form-control form-control-sm" placeholder="Giỏi lắm! Con đã làm rất tốt." />
                        </div>
                        <div class="activity-field-group mb-0">
                            <label asp-for="RetryFeedback" style="color:#b45309; font-size:0.82rem;">Lời động viên khi cần thử lại</label>
                            <input asp-for="RetryFeedback" class="form-control form-control-sm" placeholder="Chưa đúng rồi, con thử lại một lần nữa nhé!" />
                        </div>
                    </div>
                </section>

                <!-- KHỐI 3: KIỂM SOÁT VOICE & HÌNH ẢNH MINH HỌA -->
                <section class="activity-section-card">
                    <div class="activity-section-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="activity-section-icon material-symbols-outlined" style="background:#f0fdf4; color:#16a34a;">perm_media</span>
                            <h3>Kiểm soát Voice & Hình ảnh</h3>
                        </div>
                        <span class="badge-sub">Âm thanh & Đồ họa</span>
                    </div>

                    <!-- Voice panel -->
                    <div class="builder-config-section builder-config-section-always builder-voice-panel mb-3" data-builder-voice-panel>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="mb-0" style="font-size:0.92rem; font-weight:800; color:#0f172a; display:flex; align-items:center; gap:6px;">
                                <span class="material-symbols-outlined" style="font-size:1.2rem; color:#0284c7;">record_voice_over</span>
                                Âm thanh giọng đọc AI
                            </h4>
                            <div class="builder-voice-summary mb-0" style="margin:0; display:flex; align-items:center; gap:6px;">
                                <span style="font-size:12px; color:#64748b;">Mục cần:</span>
                                <strong data-builder-voice-total style="background:#0284c7; min-width:26px; min-height:20px; font-size:11px; border-radius:6px; color:#fff; display:inline-flex; align-items:center; justify-content:center;">0</strong>
                                <span style="font-size:12px; color:#64748b; margin-left:4px;">File VI:</span>
                                <strong data-builder-voice-filled style="background:#16a34a; min-width:26px; min-height:20px; font-size:11px; border-radius:6px; color:#fff; display:inline-flex; align-items:center; justify-content:center;">0</strong>
                                <span style="font-size:12px; color:#64748b; margin-left:4px;">File EN:</span>
                                <strong data-builder-voice-filled-en style="background:#16a34a; min-width:26px; min-height:20px; font-size:11px; border-radius:6px; color:#fff; display:inline-flex; align-items:center; justify-content:center;">0</strong>
                            </div>
                        </div>
                        <p class="builder-field-help" style="margin-bottom:8px; font-size:11px; color:#64748b;">Nghe thử phát âm, chọn file từ kho voice, tải file từ máy hoặc bấm Tạo voice AI.</p>
                        <div class="builder-voice-list" data-builder-voice-list></div>
                    </div>

                    <!-- Image panel -->
                    <div class="builder-config-section builder-config-section-always builder-image-panel" data-builder-image-panel>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="mb-0" style="font-size:0.92rem; font-weight:800; color:#0f172a; display:flex; align-items:center; gap:6px;">
                                <span class="material-symbols-outlined" style="font-size:1.2rem; color:#059669;">image</span>
                                Hình ảnh minh họa bài học
                            </h4>
                            <div class="builder-image-summary mb-0" style="margin:0; display:flex; align-items:center; gap:6px;">
                                <span style="font-size:12px; color:#64748b;">Mục cần:</span>
                                <strong data-builder-image-total style="background:#059669; min-width:26px; min-height:20px; font-size:11px; border-radius:6px; color:#fff; display:inline-flex; align-items:center; justify-content:center;">0</strong>
                                <span style="font-size:12px; color:#64748b; margin-left:4px;">Đã có:</span>
                                <strong data-builder-image-filled style="background:#16a34a; min-width:26px; min-height:20px; font-size:11px; border-radius:6px; color:#fff; display:inline-flex; align-items:center; justify-content:center;">0</strong>
                            </div>
                        </div>
                        <p class="builder-field-help" style="margin-bottom:8px; font-size:11px; color:#64748b;">Xem trước ảnh, tìm chọn trong thư viện hoặc tải ảnh từ máy tính.</p>
                        
                        <div class="builder-image-list" data-builder-image-list></div>

                        <!-- Dữ liệu lưu trữ ngầm gửi lên server -->
                        <input asp-for="ExistingImageAssetId" type="hidden" id="existingImageAssetHiddenId" />
                        <input asp-for="ImageUrl" type="hidden" id="mainImageUrlHidden" />
                        <input asp-for="ImageAltText" type="hidden" id="mainImageAltTextHidden" />
                        <input asp-for="ImageFile" type="file" id="mainImageHiddenFileInput" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none;" />
                        <textarea asp-for="ItemMediaText" id="itemMediaTextHidden" style="display:none;"></textarea>
                        <div data-item-media-upload-store hidden></div>
                    </div>
                </section>
            </div>
        </form>
    </main>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
