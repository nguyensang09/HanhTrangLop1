@model CreateChoiceItemViewModel
@{
    ViewData["Title"] = "Trình tạo bài học";
    var skillGroups = ViewBag.SkillGroups as IReadOnlyList<SkillGroup> ?? [];
    var topics = ViewBag.Topics as IReadOnlyList<Topic> ?? [];
    var activityTemplates = ViewBag.ActivityTemplates as IReadOnlyList<ActivityTemplateDefinition> ?? [];
    var mediaAssets = ViewBag.MediaAssets as IReadOnlyList<MediaAsset> ?? [];
    var imageAssets = mediaAssets.Where(x => x.AssetType == "image").ToList();
    var audioAssets = mediaAssets.Where(x => x.AssetType == "audio").ToList();
}

<section class="activity-builder-page">
    <div class="builder-topbar">
        <div>
            <p class="eyebrow">Quản trị nội dung</p>
            <h1>@(Model.Id.HasValue ? "Sửa bài học" : "Trình tạo bài học")</h1>
        </div>
        <div class="dashboard-actions">
            <a class="app-btn app-btn-muted app-btn-small" asp-action="LearningItems">
                <span class="material-symbols-outlined">library_books</span>
                Kho bài học
            </a>
            <button class="app-btn app-btn-small" type="submit" form="activity-builder-form">
                <span class="material-symbols-outlined">save</span>
                @(Model.Id.HasValue ? "Lưu thay đổi" : "Lưu bản nháp")
            </button>
        </div>
    </div>

    <form id="activity-builder-form" class="activity-builder-layout" asp-action="CreateChoice" method="post" enctype="multipart/form-data" data-admin-learning-form data-activity-builder>
        <input asp-for="Id" type="hidden" />
        <input asp-for="Status" type="hidden" />
        <input asp-for="IsCompatible" type="hidden" />
        <aside class="builder-template-panel">
            <h2>Mẫu hoạt động</h2>
            <div class="template-palette">
                @foreach (var template in activityTemplates)
                {
                    <button type="button" data-template-option="@template.InteractionType" title="@template.Description">
                        <span class="material-symbols-outlined">@template.IconKey</span><strong>@template.Name</strong>
                    </button>
                }
            </div>
            <a class="tracing-template-link" asp-action="CreateTracing" asp-route-skillGroupId="@Model.SkillGroupId" asp-route-topicId="@Model.TopicId" data-tracing-link>
                <span class="material-symbols-outlined">draw</span>
                <span><strong>Tô theo nét</strong><small>Dùng trình tạo nét riêng</small></span>
                <span class="material-symbols-outlined">arrow_forward</span>
            </a>
        </aside>

        <main class="builder-stage-panel">
            <div class="builder-stage-heading">
                <div><span class="material-symbols-outlined">smartphone</span><strong>Xem trước điện thoại</strong></div>
                <span data-preview-template-name>Chọn một đáp án</span>
            </div>
            <div class="builder-phone">
                <div class="builder-phone-screen">
                    <div class="builder-phone-status"><span>9:41</span><span>● ● ●</span></div>
                    <div class="builder-preview-progress"><span></span></div>
                    <div class="builder-preview-instruction">
                        <span class="material-symbols-outlined">volume_up</span>
                        <strong data-preview-instruction>Con hãy chọn đáp án đúng.</strong>
                    </div>
                    <div class="builder-preview-media" data-preview-media hidden>
                        <span class="material-symbols-outlined">image</span>
                    </div>
                    <div class="builder-preview-activity" data-preview-activity>
                        <h3 data-preview-prompt>Con chọn đáp án phù hợp nhé.</h3>
                        <div class="builder-preview-options" data-preview-options>
                            <button type="button">A</button><button type="button">B</button><button type="button">C</button>
                        </div>
                    </div>
                    <button class="builder-preview-submit" type="button" disabled>Kiểm tra</button>
                </div>
            </div>
        </main>

        <aside class="builder-properties-panel">
            <div asp-validation-summary="All" class="text-danger"></div>

            <h2>Thông tin bài học</h2>
            <label asp-for="Title">Tên bài</label>
            <input asp-for="Title" class="form-control" maxlength="200" data-preview-source="title" />
            <span asp-validation-for="Title" class="text-danger"></span>

            <label asp-for="SkillGroupId">Nhóm kỹ năng</label>
            <select asp-for="SkillGroupId" class="form-control" data-skill-group-select>
                @foreach (var group in skillGroups)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>

            <label asp-for="TopicId">Chủ đề</label>
            <select asp-for="TopicId" class="form-control" data-topic-select>
                <option value="">Chọn chủ đề</option>
                @foreach (var topic in topics)
                {
                    var rule = ActivityTemplateCatalog.ForTopic(topic.Code);
                    <option value="@topic.Id" data-skill-group-id="@topic.SkillGroupId" data-allowed-types="@string.Join(',', rule.InteractionTypes)" data-allows-tracing="@rule.AllowsTracing.ToString().ToLowerInvariant()">@topic.Name</option>
                }
            </select>
            <span asp-validation-for="TopicId" class="text-danger"></span>
            <p class="builder-field-help" data-topic-guidance></p>

            <label asp-for="InteractionType">Mẫu tương tác</label>
            <select asp-for="InteractionType" class="form-control" data-interaction-select>
                @foreach (var template in activityTemplates)
                {
                    <option value="@template.InteractionType" data-default-instruction="@template.DefaultInstruction" data-default-prompt="@template.DefaultPrompt" data-description="@template.Description">@template.Name</option>
                }
            </select>

            <label asp-for="InstructionText">Lời hướng dẫn</label>
            <textarea asp-for="InstructionText" class="form-control" rows="2" maxlength="500" data-preview-source="instruction"></textarea>
            <label asp-for="PromptText">Câu hỏi</label>
            <textarea asp-for="PromptText" class="form-control" rows="2" maxlength="500" data-preview-source="prompt"></textarea>

            <h2>Cấu hình hoạt động</h2>

            <div class="builder-template-context">
                <strong data-config-name></strong>
                <p data-config-description></p>
            </div>

            <section class="builder-config-section" data-builder-fields="single_choice,multi_select,listen_choose,drag_drop,story_choice">
                <h3 data-choice-heading>Phương án trả lời</h3>
                <p class="builder-field-help" data-choice-help></p>
                <div class="builder-choice-grid">
                    <div><label asp-for="ChoiceA">Lựa chọn 1</label><input asp-for="ChoiceA" class="form-control" data-choice-input /></div>
                    <div><label asp-for="ChoiceB">Lựa chọn 2</label><input asp-for="ChoiceB" class="form-control" data-choice-input /></div>
                    <div><label asp-for="ChoiceC">Lựa chọn 3</label><input asp-for="ChoiceC" class="form-control" data-choice-input /></div>
                    <div><label asp-for="ChoiceD">Lựa chọn 4</label><input asp-for="ChoiceD" class="form-control" data-choice-input /></div>
                    <div><label asp-for="ChoiceE">Lựa chọn 5</label><input asp-for="ChoiceE" class="form-control" data-choice-input /></div>
                </div>
            </section>

            <section class="builder-config-section" data-builder-fields="single_choice,listen_choose,drag_drop,story_choice">
                <label asp-for="CorrectAnswer">Đáp án đúng</label>
                <select asp-for="CorrectAnswer" class="form-control" data-correct-answer>
                    @if (!string.IsNullOrWhiteSpace(Model.CorrectAnswer))
                    {
                        <option value="@Model.CorrectAnswer">@Model.CorrectAnswer</option>
                    }
                </select>
                <span asp-validation-for="CorrectAnswer" class="text-danger"></span>
            </section>

            <section class="builder-config-section" data-builder-fields="multi_select">
                <h3>Tập đáp án đúng</h3>
                <label asp-for="CorrectAnswersText">Các đáp án đúng</label>
                <textarea asp-for="CorrectAnswersText" class="form-control" rows="4" placeholder="Mỗi đáp án một dòng"></textarea>
            </section>

            <section class="builder-config-section" data-builder-fields="drag_drop,quantity_builder">
                <h3>Vùng nhận kết quả</h3>
                <label asp-for="TargetLabel">Tên vùng đích</label>
                <input asp-for="TargetLabel" class="form-control" />
            </section>

            <section class="builder-config-section" data-builder-fields="matching">
                <h3>Danh sách cặp nối</h3>
                <label asp-for="PairsText">Các cặp cần nối</label>
                <textarea asp-for="PairsText" class="form-control" rows="6" placeholder="A = a&#10;B = b&#10;C = c"></textarea>
                <span asp-validation-for="PairsText" class="text-danger"></span>
            </section>

            <section class="builder-config-section" data-builder-fields="ordering">
                <h3>Chuỗi thứ tự chuẩn</h3>
                <label asp-for="SequenceItemsText">Thứ tự đúng</label>
                <textarea asp-for="SequenceItemsText" class="form-control" rows="6" placeholder="Mỗi mục một dòng theo thứ tự đúng"></textarea>
                <span asp-validation-for="SequenceItemsText" class="text-danger"></span>
            </section>

            <section class="builder-config-section" data-builder-fields="counting,quantity_builder,comparison">
                <h3>Đồ vật và số lượng</h3>
                <label asp-for="ObjectSymbol">Ký hiệu đồ vật</label>
                <input asp-for="ObjectSymbol" class="form-control" maxlength="12" />
                <label asp-for="TargetCount">Số lượng mục tiêu / Nhóm A</label>
                <input asp-for="TargetCount" class="form-control" type="number" min="0" max="20" />
            </section>

            <section class="builder-config-section" data-builder-fields="comparison">
                <div class="two-column-form">
                    <div><label asp-for="LeftLabel">Tên nhóm bên trái</label><input asp-for="LeftLabel" class="form-control" /></div>
                    <div><label asp-for="RightLabel">Tên nhóm bên phải</label><input asp-for="RightLabel" class="form-control" /></div>
                </div>
                <label asp-for="SecondaryCount">Số lượng nhóm B</label>
                <input asp-for="SecondaryCount" class="form-control" type="number" min="0" max="20" />
                <label asp-for="ComparisonMode">Yêu cầu so sánh</label>
                <select asp-for="ComparisonMode" class="form-control">
                    <option value="more">Chọn nhóm nhiều hơn</option>
                    <option value="less">Chọn nhóm ít hơn</option>
                    <option value="equal">Kiểm tra hai nhóm bằng nhau</option>
                </select>
            </section>

            <section class="builder-config-section" data-builder-fields="classification">
                <h3>Vật và nhóm đích</h3>
                <label asp-for="ClassificationText">Vật và nhóm phân loại</label>
                <textarea asp-for="ClassificationText" class="form-control" rows="7" placeholder="Hình vuông = Hình có góc&#10;Hình tròn = Hình không góc"></textarea>
                <span asp-validation-for="ClassificationText" class="text-danger"></span>
            </section>

            <section class="builder-config-section" data-builder-fields="listen_choose,story_choice">
                <h3>Âm thanh nội dung</h3>
                <label asp-for="SpeechText">Nội dung đọc tự động</label>
                <textarea asp-for="SpeechText" class="form-control" rows="3" maxlength="500" placeholder="Nhập nội dung để trình duyệt đọc khi chưa có tệp âm thanh"></textarea>
                <p class="builder-field-help">Có thể dùng nội dung đọc tự động, hoặc chọn/tải một tệp âm thanh bên dưới.</p>
                <label asp-for="ExistingAudioAssetId">Chọn từ thư viện</label>
                <select asp-for="ExistingAudioAssetId" class="form-control">
                    <option value="">Tải tệp mới hoặc dùng đường dẫn</option>
                    @foreach (var asset in audioAssets) { <option value="@asset.Id" data-path="@asset.StoragePath">@asset.FileName</option> }
                </select>
                <label asp-for="AudioFile">Tải âm thanh mới</label>
                <input asp-for="AudioFile" class="form-control" type="file" accept="audio/mpeg,audio/wav,audio/ogg,audio/mp4" />
                <label asp-for="AudioUrl">Đường dẫn âm thanh</label>
                <input asp-for="AudioUrl" class="form-control" type="text" placeholder="/uploads/audio/ten-tep.mp3" />
                <span asp-validation-for="AudioUrl" class="text-danger"></span>
            </section>

            <section class="builder-config-section builder-config-section-always">
                <h3>Giọng đọc câu hỏi</h3>
                <p class="builder-field-help">Nếu không chọn tệp, hệ thống tự đọc tiếng Việt từ nội dung câu hỏi. Tệp riêng giúp giọng đọc ổn định hơn trên mọi thiết bị.</p>
                <label asp-for="ExistingQuestionAudioAssetId">Chọn từ thư viện âm thanh</label>
                <select asp-for="ExistingQuestionAudioAssetId" class="form-control">
                    <option value="">Dùng giọng đọc tự động</option>
                    @foreach (var asset in audioAssets) { <option value="@asset.Id" data-path="@asset.StoragePath">@asset.FileName</option> }
                </select>
                <label asp-for="QuestionAudioFile">Tải giọng đọc câu hỏi</label>
                <input asp-for="QuestionAudioFile" class="form-control" type="file" accept="audio/mpeg,audio/wav,audio/ogg,audio/mp4" />
                <label asp-for="QuestionAudioUrl">Đường dẫn giọng đọc câu hỏi</label>
                <input asp-for="QuestionAudioUrl" class="form-control" type="text" placeholder="/uploads/audio/cau-hoi.mp3" />
                <span asp-validation-for="QuestionAudioUrl" class="text-danger"></span>
            </section>

            <section class="builder-config-section" data-builder-fields="single_choice,multi_select,listen_choose,drag_drop,matching,ordering,counting,quantity_builder,comparison,classification,story_choice">
                <h3>Hình minh họa</h3>
                <label asp-for="ExistingImageAssetId">Chọn từ thư viện</label>
                <select asp-for="ExistingImageAssetId" class="form-control">
                    <option value="">Không dùng hình thư viện</option>
                    @foreach (var asset in imageAssets) { <option value="@asset.Id" data-path="@asset.StoragePath">@asset.FileName</option> }
                </select>
                <label asp-for="ImageFile">Tải hình mới</label>
                <input asp-for="ImageFile" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
                <label asp-for="ImageUrl">Đường dẫn hình</label>
                <input asp-for="ImageUrl" class="form-control" type="text" placeholder="/uploads/images/ten-tep.webp" />
                <label asp-for="ImageAltText">Mô tả hình cho phụ huynh và thiết bị hỗ trợ</label>
                <input asp-for="ImageAltText" class="form-control" type="text" maxlength="250" placeholder="Ví dụ: Năm quả táo đỏ xếp thành hai hàng" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </section>

            <section class="builder-config-section" data-builder-fields="single_choice,multi_select,listen_choose,drag_drop,matching,ordering,counting,quantity_builder,comparison,classification,story_choice">
                <h3>Ảnh riêng theo nội dung</h3>
                <p class="builder-field-help">Nhãn phải trùng với đáp án, vật, mục sắp xếp hoặc một đầu cặp nối. Mỗi dòng theo mẫu: Táo = /uploads/images/tao.jpg</p>
                <label asp-for="ItemMediaText">Ánh xạ nội dung và hình ảnh</label>
                <textarea asp-for="ItemMediaText" class="form-control" rows="6" maxlength="8000" placeholder="Táo = /images/photos/apple.jpg&#10;Chó = /images/photos/dog.jpg"></textarea>
                <span asp-validation-for="ItemMediaText" class="text-danger"></span>
            </section>

            <h2>Chấm điểm và phản hồi</h2>
            <div class="two-column-form">
                <div><label asp-for="SortOrder">Thứ tự học</label><input asp-for="SortOrder" class="form-control" type="number" min="0" max="100000" placeholder="Tự động" /></div>
                <div><label asp-for="Level">Độ khó</label><select asp-for="Level" class="form-control"><option value="1">Dễ</option><option value="2">Trung bình</option><option value="3">Nâng cao</option></select></div>
                <div><label asp-for="EstimatedMinutes">Thời lượng</label><input asp-for="EstimatedMinutes" class="form-control" type="number" min="1" max="30" /></div>
            </div>
            <label asp-for="HintText">Gợi ý</label><input asp-for="HintText" class="form-control" />
            <label asp-for="CorrectFeedback">Phản hồi khi đúng</label><input asp-for="CorrectFeedback" class="form-control" />
            <label asp-for="RetryFeedback">Phản hồi khi thử lại</label><input asp-for="RetryFeedback" class="form-control" />

            <button class="app-btn app-btn-wide" type="submit"><span class="material-symbols-outlined">save</span>@(Model.Id.HasValue ? "Lưu thay đổi" : "Lưu bản nháp")</button>
        </aside>
    </form>
    @if (Model.Id.HasValue)
    {
        <partial name="_LearningItemWorkflow" model="@(new LearningItemWorkflowViewModel { Id = Model.Id.Value, Status = Model.Status, IsCompatible = Model.IsCompatible })" />
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
