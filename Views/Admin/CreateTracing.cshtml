@model CreateTracingItemViewModel
@{
    ViewData["Title"] = "Tạo bài tô nét";
    var skillGroups = ViewBag.SkillGroups as IReadOnlyList<SkillGroup> ?? [];
}

<section class="admin-layout">
    <partial name="_AdminSidebar" />
    <main class="admin-main">
        <partial name="_AdminHeader" model="@(Model.Id.HasValue ? "Sửa bài tô nét" : "Tạo bài tô nét")" />

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <span class="admin-subheading">Biên tập bài tập tô chữ, từ, nét vẽ & tranh</span>
                <p class="empty-note mb-0" style="color:#64748b; font-size:13px;">Nhập một ký tự, một từ, vài từ hoặc chọn mẫu tranh tạo hình có sẵn.</p>
            </div>
            <div class="dashboard-actions d-flex gap-2 flex-wrap">
                <a class="app-btn app-btn-muted app-btn-small" asp-action="MediaLibrary"><span class="material-symbols-outlined">perm_media</span>Thư viện ảnh</a>
                <a class="app-btn app-btn-muted app-btn-small" asp-action="VoiceCache"><span class="material-symbols-outlined">graphic_eq</span>Kiểm soát voice</a>
                <a class="app-btn app-btn-muted app-btn-small" asp-action="LearningItems"><span class="material-symbols-outlined">library_books</span>Kho bài học</a>
            </div>
        </div>

    <form class="tracing-builder-layout" asp-action="CreateTracing" method="post" enctype="multipart/form-data" data-admin-learning-form data-tracing-builder>
        <input asp-for="Id" type="hidden" />
        <input asp-for="Status" type="hidden" />
        <input asp-for="IsCompatible" type="hidden" />
        <input asp-for="AudioUrl" type="hidden" />
        <input asp-for="TopicId" type="hidden" value="" />

        <div class="soft-card tracing-builder-preview">
            <div class="builder-stage-heading"><div><span class="material-symbols-outlined">draw</span><strong>Xem trước bảng tô</strong></div></div>
            <div class="tracing-guidance-card tracing-preview-guidance">
                <span class="material-symbols-outlined" aria-hidden="true">draw</span>
                <strong>Bé vẽ theo đường nét đứt nhé!</strong>
                <button class="learning-voice-button tracing-guidance-audio" type="button" disabled title="Nghe hướng dẫn">
                    <span class="material-symbols-outlined">volume_up</span>
                </button>
            </div>
            <div class="tracing-preview-board tracing-canvas-host" data-tracing-preview-board>
                <span class="tracing-preview-symbol trace-letter outline-guide" data-tracing-preview-symbol>@Model.Symbol</span>
                <div class="tracing-guide-overlay" data-tracing-preview-guide aria-hidden="true"></div>
            </div>
        </div>

        <div class="soft-card admin-form tracing-builder-properties">
            <div asp-validation-summary="All" class="text-danger"></div>

            <h2>Phân loại bài tô</h2>
            <label asp-for="SkillGroupId">Nhóm kỹ năng</label>
            <select asp-for="SkillGroupId" class="form-control" data-skill-group-select>
                @foreach (var group in skillGroups)
                {
                    <option value="@group.Id" data-group-code="@group.Code">@group.Name</option>
                }
            </select>

            <h2>Nội dung cần tô</h2>
            <label asp-for="Title">Tên bài</label>
            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Tập tô chữ b" data-tracing-title-input />
            <span asp-validation-for="Title" class="text-danger"></span>

            <label asp-for="Symbol">Ký tự, từ hoặc mã tranh cần tô</label>
            <input asp-for="Symbol" class="form-control" maxlength="120" data-tracing-symbol-input />
            <span asp-validation-for="Symbol" class="text-danger"></span>
            <p class="builder-field-help">Có thể nhập chữ hoa, chữ thường, số, một từ hoặc vài từ. Hệ thống giữ nguyên nội dung và tự dàn nét theo khung.</p>

            <label for="tracingArtTemplate">Mẫu Tô tranh & Tạo hình nghệ thuật</label>
            <select id="tracingArtTemplate" class="form-control" data-tracing-art-template>
                <option value="">-- Không dùng mẫu tranh --</option>
                <option value="phong-canh" data-title="Phong cảnh thiên nhiên">Phong cảnh thiên nhiên</option>
                <option value="do-dung" data-title="Đồ dùng học tập">Đồ dùng học tập</option>
                <option value="hinh-hoc" data-title="Hình học kỳ diệu">Hình học kỳ diệu</option>
                <option value="meo-con" data-title="Chú mèo con">Chú mèo con</option>
                <option value="ca-heo" data-title="Cá heo tung tăng">Cá heo tung tăng</option>
                <option value="o-che-mua" data-title="Chiếc ô che mưa">Chiếc ô che mưa</option>
                <option value="trai-tao" data-title="Quả táo và chú sâu">Quả táo và chú sâu</option>
                <option value="tau-hoa" data-title="Đoàn tàu tí hon">Đoàn tàu tí hon</option>
                <option value="chu-tho" data-title="Chú thỏ và cà rốt">Chú thỏ và cà rốt</option>
                <option value="ong-vang" data-title="Ong vàng và hoa">Ong vàng và hoa</option>
                <option value="may-bay" data-title="Máy bay trên trời">Máy bay trên trời</option>
                <option value="thuyen" data-title="Thuyền buồm lướt sóng">Thuyền buồm lướt sóng</option>
                <option value="cau-vong" data-title="Cầu vồng và lâu đài">Cầu vồng và lâu đài</option>
                <option value="chu-buom" data-title="Bướm xinh trong vườn">Bướm xinh trong vườn</option>
                <option value="khung-long" data-title="Khủng long tí hon">Khủng long tí hon</option>
                <option value="ten-lua" data-title="Tên lửa và các vì sao">Tên lửa và các vì sao</option>
            </select>
            <p class="builder-field-help">Chọn mẫu sẽ tự chuyển sang nhóm Vận động tinh và điền đúng mã tranh để preview ngay.</p>

            <div class="two-column-form">
                <div>
                    <label asp-for="GuideMode">Kiểu bảng tô</label>
                    <select asp-for="GuideMode" class="form-control" data-tracing-guide-mode>
                        <option value="outline">Tô theo đường viền</option>
                        <option value="free">Tự viết trong khung</option>
                    </select>
                </div>
                <div>
                    <label asp-for="ExpectedStrokeCount">Số nét tham khảo</label>
                    <input asp-for="ExpectedStrokeCount" class="form-control" type="number" min="1" max="200" />
                    <small>Chỉ là thông tin mô tả; nét tô thực tế được dựng tự động theo toàn bộ ký tự hoặc cụm từ.</small>
                </div>
            </div>
            <input asp-for="ShowStartPoint" type="hidden" value="true" />

            <div class="two-column-form">
                <div>
                    <label asp-for="MinPoints">Mức hoàn thành tối thiểu</label>
                    <input asp-for="MinPoints" class="form-control" type="number" min="5" max="300" />
                </div>
                <div>
                    <label asp-for="SortOrder">Thứ tự học</label>
                    <input asp-for="SortOrder" class="form-control" type="number" min="0" max="100000" placeholder="Tự động" />
                </div>
                <div>
                    <label asp-for="Level">Độ khó</label>
                    <select asp-for="Level" class="form-control"><option value="1">Dễ</option><option value="2">Trung bình</option><option value="3">Nâng cao</option></select>
                </div>
            </div>

            <h2>Hướng dẫn và voice</h2>
            <label asp-for="InstructionText">Lời hướng dẫn</label>
            <input asp-for="InstructionText" class="form-control" />
            <label asp-for="PromptText">Yêu cầu trên bảng tô</label>
            <input asp-for="PromptText" class="form-control" data-tracing-prompt-input />
            <p class="builder-field-help">Khi lưu bài, yêu cầu và phản hồi sẽ được đưa vào Kiểm soát voice để dùng lại file âm thanh trùng nội dung.</p>

            <button class="app-btn app-btn-wide" type="submit"><span class="material-symbols-outlined">save</span>@(Model.Id.HasValue ? "Lưu thay đổi" : "Lưu bản nháp")</button>
        </div>
    </form>
    @if (Model.Id.HasValue)
    {
        <partial name="_LearningItemWorkflow" model="@(new LearningItemWorkflowViewModel { Id = Model.Id.Value, Status = Model.Status, IsCompatible = Model.IsCompatible })" />
    }
    </main>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/tracing-guides.js" asp-append-version="true"></script>
}
