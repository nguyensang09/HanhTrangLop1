@model LearningItem
@{
    ViewData["Title"] = Model.Title;
    var isCompatible = ActivityTemplateCatalog.IsItemAllowed(Model);
}

<section class="admin-layout">
    <partial name="_AdminSidebar" />
    <main class="admin-main">
        <partial name="_AdminHeader" model="@Model.Title" />

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <span class="admin-subheading">Chi tiết cấu hình bài học</span>
                <p class="empty-note mb-0" style="color:#64748b; font-size:13px;">Xem trước thông số kỹ thuật, cấu hình câu hỏi và trạng thái xuất bản bài học.</p>
            </div>
            <div class="dashboard-actions d-flex gap-2 flex-wrap">
                <a class="app-btn app-btn-muted app-btn-small" asp-action="LearningItems">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Kho nội dung
                </a>
                @if (Model.InteractionType == InteractionTypes.Tracing)
                {
                    <a class="dash-btn dash-btn-primary" asp-action="CreateTracing" asp-route-editId="@Model.Id"><span class="material-symbols-outlined">edit</span>Sửa bài tô nét</a>
                }
                else
                {
                    <a class="dash-btn dash-btn-primary" asp-action="CreateChoice" asp-route-editId="@Model.Id"><span class="material-symbols-outlined">edit</span>Sửa bài trắc nghiệm</a>
                }
            </div>
        </div>

    <div class="admin-detail-grid">
        @if (TempData["AdminMessage"] is string message)
        {
            <div class="feedback-band retry"><span class="material-symbols-outlined">warning</span><strong>@message</strong></div>
        }
        @if (!isCompatible)
        {
            <div class="feedback-band retry"><span class="material-symbols-outlined">rule</span><strong>Dạng bài hiện tại không phù hợp với chủ đề. Bài sẽ không xuất hiện trong khu bé học cho tới khi được sửa đúng mẫu.</strong></div>
        }
        <div class="soft-card report-panel">
            <h2>Thông tin</h2>
            <dl class="admin-meta-list">
                <dt>Mã</dt><dd>@Model.Code</dd>
                <dt>Nhóm</dt><dd>@Model.SkillGroup?.Name</dd>
                <dt>Chủ đề</dt><dd>@(Model.Topic?.Name ?? "Không chọn")</dd>
                <dt>Dạng bài</dt><dd>@Model.InteractionType</dd>
                <dt>Độ khó</dt><dd>@Model.Level</dd>
                <dt>Thời lượng</dt><dd>@Model.EstimatedMinutes phút</dd>
                <dt>Trạng thái</dt><dd><span class="status-chip status-@Model.Status">@ContentStatus.GetDisplayName(Model.Status)</span></dd>
            </dl>

            <h2 class="mt-4">Luồng duyệt</h2>
            <div class="status-action-row">
                <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" name="status" value="@ContentStatus.Draft" />
                    <button class="app-btn app-btn-muted app-btn-small" type="submit">Đưa về nháp</button>
                </form>
                <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" name="status" value="@ContentStatus.Review" />
                    <button class="app-btn app-btn-muted app-btn-small" type="submit">Gửi duyệt</button>
                </form>
                @if (isCompatible)
                {
                    <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" name="status" value="@ContentStatus.Published" />
                        <button class="app-btn app-btn-small" type="submit">Xuất bản</button>
                    </form>
                }
                <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" name="status" value="@ContentStatus.Archived" />
                    <button class="danger-link" type="submit">Lưu trữ</button>
                </form>
            </div>
        </div>

        <div class="soft-card report-panel">
            <h2>Lời hướng dẫn</h2>
            <p>@Model.InstructionText</p>
            <h2 class="mt-4">Câu hỏi</h2>
            @foreach (var question in Model.Questions.OrderBy(x => x.SortOrder))
            {
                <article class="question-admin-card">
                    <strong>@question.PromptText</strong>
                    <small>@question.QuestionType</small>
                    <pre>@question.PayloadJson</pre>
                </article>
            }
        </div>
    </div>
    </main>
</section>
