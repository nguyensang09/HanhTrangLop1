@model AdminLearningItemListViewModel
@{
    ViewData["Title"] = "Kho bài học theo kỹ năng & dạng bài";
}

<section class="admin-layout">
    <partial name="_AdminSidebar" />
    <main class="admin-main">
        <partial name="_AdminHeader" model='ViewData["Title"]' />
        @if (TempData["AdminMessage"] is string message)
        {
            <div class="feedback-band success"><span class="material-symbols-outlined">check_circle</span><strong>@message</strong></div>
        }

        <div class="dashboard-header">
            <div>
                <p class="eyebrow">Cấu trúc quản lý: Nhóm kỹ năng → Dạng bài → Bài học</p>
                <h1>Kho bài học</h1>
                <p class="empty-note">Chủ đề chỉ còn là metadata tương thích; không dùng để nhân bản hoặc chia nhỏ kho bài.</p>
            </div>
            <div class="hero-actions">
                <a class="app-btn app-btn-small" asp-action="CreateChoice" asp-route-skillGroupId="@Model.SkillGroupId"><span class="material-symbols-outlined">add</span>Tạo bài tương tác</a>
                <a class="app-btn app-btn-small" asp-action="CreateTracing" asp-route-skillGroupId="@Model.SkillGroupId"><span class="material-symbols-outlined">draw</span>Tạo bài tô nét</a>
                <button class="app-btn app-btn-small" type="button" data-sync-voice-btn><span class="material-symbols-outlined">sync</span>Đồng bộ Voice toàn hệ thống</button>
                <a class="app-btn app-btn-muted app-btn-small" asp-action="VoiceCache"><span class="material-symbols-outlined">graphic_eq</span>Kiểm soát voice</a>
                <form class="inline-action-form" asp-action="ReseedLessons" method="post"><button class="app-btn app-btn-muted app-btn-small" type="submit"><span class="material-symbols-outlined">refresh</span>Đối chiếu kho gốc</button></form>
            </div>
        </div>

        <div class="curriculum-summary mb-4">
            <div class="curriculum-stat-card"><span class="material-symbols-outlined icon-wrap">category</span><div><strong>@Model.TotalGroups</strong><span>Nhóm kỹ năng</span></div></div>
            <div class="curriculum-stat-card"><span class="material-symbols-outlined icon-wrap">extension</span><div><strong>@Model.TotalActivityTypes</strong><span>Nhóm dạng bài</span></div></div>
            <div class="curriculum-stat-card"><span class="material-symbols-outlined icon-wrap">menu_book</span><div><strong>@Model.TotalItems</strong><span>Bài học hiện có</span></div></div>
            <div class="curriculum-stat-card highlight-card"><span class="material-symbols-outlined icon-wrap">verified</span><div><strong>@Model.OverallCoveragePercentage%</strong><span>Độ phủ dạng bài</span></div></div>
        </div>

        <form class="soft-card admin-filter learning-filter-form" asp-action="LearningItems" method="get">
            <div class="filter-field search-field"><label for="search">Tìm bài học</label><input id="search" name="search" class="form-control" value="@Model.Search" placeholder="Tên bài, nhóm kỹ năng hoặc dạng bài" /></div>
            <div class="filter-field"><label for="skillGroupId">Nhóm kỹ năng</label><select id="skillGroupId" name="skillGroupId" class="form-control"><option value="">Tất cả nhóm</option>@foreach (var group in Model.SkillGroups){<option value="@group.Id" selected="@(Model.SkillGroupId == group.Id)">@group.Name</option>}</select></div>
            <div class="filter-field"><label for="interactionType">Dạng bài</label><select id="interactionType" name="interactionType" class="form-control"><option value="">Tất cả dạng</option>@foreach (var template in ActivityTemplateCatalog.Templates){<option value="@template.InteractionType" selected="@(Model.InteractionType == template.InteractionType)">@template.Name</option>}<option value="@InteractionTypes.Tracing" selected="@(Model.InteractionType == InteractionTypes.Tracing)">Tô theo nét</option></select></div>
            <div class="filter-field"><label for="status">Trạng thái</label><select id="status" name="status" class="form-control"><option value="">Tất cả</option><option value="@ContentStatus.Draft" selected="@(Model.Status == ContentStatus.Draft)">Nháp</option><option value="@ContentStatus.Review" selected="@(Model.Status == ContentStatus.Review)">Chờ duyệt</option><option value="@ContentStatus.Published" selected="@(Model.Status == ContentStatus.Published)">Xuất bản</option><option value="@ContentStatus.Archived" selected="@(Model.Status == ContentStatus.Archived)">Lưu trữ</option></select></div>
            <div class="filter-field"><label for="voiceStatus">Voice</label><select id="voiceStatus" name="voiceStatus" class="form-control"><option value="">Tất cả</option><option value="ready" selected="@(Model.VoiceFilter == "ready")">Đủ VI & EN</option><option value="missing" selected="@(Model.VoiceFilter == "missing")">Thiếu voice</option><option value="none" selected="@(Model.VoiceFilter == "none")">Chưa có voice</option></select></div>
            <button class="app-btn app-btn-small" type="submit"><span class="material-symbols-outlined">filter_alt</span>Lọc</button>
            @if (Model.HasActiveFilter){<a class="app-btn app-btn-muted app-btn-small" asp-action="LearningItems">Xóa lọc</a>}
        </form>

        <div class="learning-tree-container" id="learningTreeRoot">
        @if (Model.TreeGroups.Count == 0)
        {
            <div class="soft-card empty-tree-state"><span class="material-symbols-outlined empty-icon">folder_off</span><h3>Không tìm thấy bài học</h3></div>
        }
        else
        {
            @foreach (var groupItem in Model.TreeGroups)
            {
                var groupColor = string.IsNullOrWhiteSpace(groupItem.SkillGroup.Color) ? "#2563eb" : groupItem.SkillGroup.Color;
                <div class="tree-group-card" style="--group-color:@groupColor" data-group-node>
                    <header class="tree-group-header" data-toggle-trigger>
                        <button type="button" class="tree-toggle-btn" aria-label="Mở rộng nhóm" aria-expanded="false"><span class="material-symbols-outlined tree-chevron">chevron_right</span></button>
                        <div class="tree-group-icon-wrap"><span class="material-symbols-outlined tree-group-icon">@groupItem.SkillGroup.IconKey</span></div>
                        <div class="tree-group-info"><div class="tree-group-title-row"><h2 class="tree-group-title">@groupItem.SkillGroup.Name</h2><span class="tree-count-badge group-count">@groupItem.LearningItemCount bài</span></div><p class="tree-group-desc">@groupItem.SkillGroup.Description</p><div class="activity-coverage-chips">@foreach (var activity in groupItem.ActivityTypes){<span class="activity-count-chip @(activity.IsCovered ? "is-covered" : "is-missing")"><span class="material-symbols-outlined">@activity.IconKey</span>@activity.DisplayName: <b>@activity.LearningItemCount</b></span>}</div></div>
                        <div class="tree-group-actions" onclick="event.stopPropagation()"><a class="app-btn app-btn-muted app-btn-small" asp-action="CreateChoice" asp-route-skillGroupId="@groupItem.SkillGroup.Id"><span class="material-symbols-outlined">add</span>Tạo bài</a></div>
                    </header>
                    <div class="tree-group-body"><div class="tree-topics-list">
                    @foreach (var activityGroup in groupItem.ActivityGroups)
                    {
                        <div class="tree-topic-item" data-topic-node>
                            <header class="tree-topic-header" data-toggle-trigger>
                                <button type="button" class="tree-toggle-btn small-toggle" aria-label="Mở rộng dạng bài" aria-expanded="false"><span class="material-symbols-outlined tree-chevron">chevron_right</span></button>
                                <div class="tree-topic-icon-wrap"><span class="material-symbols-outlined tree-topic-icon topic-has-content">@activityGroup.IconKey</span></div>
                                <div class="tree-topic-info"><div class="tree-topic-title-row"><h3 class="tree-topic-title">@activityGroup.DisplayName</h3><span class="tree-count-badge topic-count">@activityGroup.LearningItemCount bài</span></div></div>
                                <div class="tree-topic-actions" onclick="event.stopPropagation()">@if (activityGroup.InteractionType == InteractionTypes.Tracing){<a class="icon-button" asp-action="CreateTracing" asp-route-skillGroupId="@groupItem.SkillGroup.Id"><span class="material-symbols-outlined">add</span></a>}else{<a class="icon-button" asp-action="CreateChoice" asp-route-skillGroupId="@groupItem.SkillGroup.Id" asp-route-interactionType="@activityGroup.InteractionType"><span class="material-symbols-outlined">add</span></a>}</div>
                            </header>
                            <div class="tree-topic-body"><div class="table-responsive"><table class="app-table tree-items-table"><thead><tr><th class="col-secondary">STT</th><th>Tên bài học</th><th>Trạng thái</th><th>Voice VI & EN</th><th style="text-align:right">Thao tác</th></tr></thead><tbody>
                            @foreach (var item in activityGroup.Items)
                            {
                                var voice = Model.VoiceStatuses.GetValueOrDefault(item.Id) ?? new AdminLearningItemVoiceStatus();
                                <tr><td class="col-secondary"><span class="sort-badge">#@item.SortOrder</span></td><td><a class="table-link lesson-name" asp-action="LearningItemDetail" asp-route-id="@item.Id">@item.Title</a></td><td><span class="status-chip status-@item.Status">@ContentStatus.GetDisplayName(item.Status)</span></td><td><div data-voice-status-cell="@item.Id">@if (voice.Status == "full"){<span class="badge-voice-pill voice-ready">Đủ @voice.RequiredCount/@voice.RequiredCount</span>}else if (voice.Status == "partial"){<span class="badge-voice-pill voice-partial">VI @voice.VoiceViCount/@voice.RequiredCount · EN @voice.VoiceEnCount/@voice.RequiredCount</span>}else{<span class="badge-voice-pill voice-none">Chưa có</span>}</div></td><td class="table-actions"><a class="mini-action primary-link" asp-action="PreviewLearningItem" asp-route-id="@item.Id"><span class="material-symbols-outlined">visibility</span>Xem</a>@if(item.InteractionType == InteractionTypes.Tracing){<a class="mini-action" asp-action="CreateTracing" asp-route-editId="@item.Id"><span class="material-symbols-outlined">edit</span>Sửa</a>}else{<a class="mini-action" asp-action="CreateChoice" asp-route-editId="@item.Id"><span class="material-symbols-outlined">edit</span>Sửa</a>}<form class="inline-action-form" asp-action="DeleteLearningItem" asp-route-id="@item.Id" method="post" data-confirm-delete><button class="mini-action danger" type="submit"><span class="material-symbols-outlined">delete</span>Xóa</button></form></td></tr>
                            }
                            </tbody></table></div></div>
                        </div>
                    }
                    </div></div>
                </div>
            }
        }
        </div>
    </main>
</section>

@section Scripts {
<script>
document.querySelectorAll('[data-toggle-trigger]').forEach(header => header.addEventListener('click', event => {
    if (event.target.closest('a,button,form') && !event.target.closest('.tree-toggle-btn')) return;
    const node = header.closest('[data-group-node],[data-topic-node]');
    node?.classList.toggle('is-expanded');
    const toggle = header.querySelector('.tree-toggle-btn');
    const isExpanded = node?.classList.contains('is-expanded') === true;
    toggle?.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
    if (toggle) toggle.setAttribute('aria-label', `${isExpanded ? 'Thu gọn' : 'Mở rộng'} ${node?.matches('[data-group-node]') ? 'nhóm' : 'dạng bài'}`);
}));
</script>
}
