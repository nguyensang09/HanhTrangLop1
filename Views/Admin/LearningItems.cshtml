@model AdminLearningItemListViewModel
@{
    ViewData["Title"] = "Kho bài học & Cấu trúc chương trình";
}

<section class="admin-layout">
    <partial name="_AdminSidebar" />
    <main class="admin-main">
        <partial name="_AdminHeader" model='ViewData["Title"]' />
        @if (TempData["AdminMessage"] is string message)
        {
            <div class="feedback-band success"><span class="material-symbols-outlined">check_circle</span><strong>@message</strong></div>
        }
        
        <!-- Header chính -->
        <div class="dashboard-header">
            <div>
                <p class="eyebrow">Phân loại & Quản trị chương trình học</p>
                <h1>Kho bài học & Cấu trúc chương trình</h1>
            </div>
            <div class="hero-actions">
                <a class="app-btn app-btn-small" asp-action="CreateChoice" asp-route-skillGroupId="@Model.SkillGroupId" asp-route-topicId="@Model.TopicId">
                    <span class="material-symbols-outlined">add</span>
                    Tạo bài tương tác
                </a>
                <a class="app-btn app-btn-small" asp-action="CreateTracing" asp-route-skillGroupId="@Model.SkillGroupId" asp-route-topicId="@Model.TopicId">
                    <span class="material-symbols-outlined">draw</span>
                    Tạo bài tô nét
                </a>
                <button class="app-btn app-btn-small" type="button" data-sync-voice-btn title="Rà soát voice có sẵn và tự động sinh Voice VI & EN còn thiếu cho toàn bộ bài học">
                    <span class="material-symbols-outlined">sync</span>
                    Đồng bộ Voice toàn hệ thống
                </button>
                <a class="app-btn app-btn-muted app-btn-small" asp-action="VoiceCache" title="Thư viện âm thanh và kiểm soát giọng đọc">
                    <span class="material-symbols-outlined">graphic_eq</span>
                    Kiểm soát voice
                </a>
                <form class="inline-action-form" asp-action="ReseedLessons" method="post">
                    <button class="app-btn app-btn-muted app-btn-small" type="submit" title="Đồng bộ lại cấu trúc kho bài học gốc">
                        <span class="material-symbols-outlined">refresh</span>
                        Nạp lại kho gốc
                    </button>
                </form>
                <a class="app-btn app-btn-muted app-btn-small" asp-action="Index">Dashboard</a>
            </div>
        </div>

        <!-- Thống kê tổng thể độ phủ chương trình (Hợp nhất từ Catalogs) -->
        <div class="curriculum-summary mb-4">
            <div class="curriculum-stat-card">
                <span class="material-symbols-outlined icon-wrap" style="color:#ea580c;">category</span>
                <div>
                    <strong>@Model.TotalGroups</strong>
                    <span>Nhóm kỹ năng</span>
                </div>
            </div>
            <div class="curriculum-stat-card">
                <span class="material-symbols-outlined icon-wrap" style="color:#0284c7;">topic</span>
                <div>
                    <strong>@Model.StandardTopicsCount</strong>
                    <span>Chủ đề chuẩn</span>
                </div>
            </div>
            <div class="curriculum-stat-card">
                <span class="material-symbols-outlined icon-wrap" style="color:#16a34a;">menu_book</span>
                <div>
                    <strong>@Model.TotalItems</strong>
                    <span>Bài học hiện có</span>
                </div>
            </div>
            <div class="curriculum-stat-card highlight-card">
                <span class="material-symbols-outlined icon-wrap" style="color:#8b5cf6;">verified</span>
                <div style="flex:1;">
                    <div style="display:flex; justify-content:space-between; align-items:baseline;">
                        <strong>@Model.OverallCoveragePercentage%</strong>
                        <span style="font-size:12px; color:#64748b; font-weight:600;">Độ phủ bài học</span>
                    </div>
                    <div class="curriculum-progress-mini">
                        <span style="width:@Model.OverallCoveragePercentage%;"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bộ Lọc & Tìm Kiếm Bài Học -->
        <form class="soft-card admin-filter learning-filter-form" asp-action="LearningItems" method="get" id="learningFilterForm">
            <div class="filter-field search-field">
                <label for="search">Tìm kiếm bài học</label>
                <div class="search-input-wrap">
                    <span class="material-symbols-outlined search-icon">search</span>
                    <input type="text" id="search" name="search" class="form-control" value="@Model.Search" placeholder="Nhập tên bài, mã chủ đề..." />
                </div>
            </div>
            <div class="filter-field">
                <label for="skillGroupId">Nhóm kỹ năng</label>
                <select id="skillGroupId" name="skillGroupId" class="form-control">
                    <option value="">Tất cả nhóm</option>
                    @foreach (var group in Model.SkillGroups)
                    {
                        <option value="@group.Id" selected="@(Model.SkillGroupId == group.Id)">@group.Name</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="topicId">Chủ đề</label>
                <select id="topicId" name="topicId" class="form-control">
                    <option value="">Tất cả chủ đề</option>
                    @foreach (var topic in Model.Topics)
                    {
                        <option value="@topic.Id" data-group-id="@topic.SkillGroupId" selected="@(Model.TopicId == topic.Id)">@topic.Name (@topic.Code)</option>
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="status">Trạng thái bài</label>
                <select id="status" name="status" class="form-control">
                    <option value="">Tất cả</option>
                    <option value="@ContentStatus.Draft" selected="@(Model.Status == ContentStatus.Draft)">Nháp</option>
                    <option value="@ContentStatus.Review" selected="@(Model.Status == ContentStatus.Review)">Chờ duyệt</option>
                    <option value="@ContentStatus.Published" selected="@(Model.Status == ContentStatus.Published)">Xuất bản</option>
                    <option value="@ContentStatus.Archived" selected="@(Model.Status == ContentStatus.Archived)">Lưu trữ</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="voiceStatus">Trạng thái Voice</label>
                <select id="voiceStatus" name="voiceStatus" class="form-control">
                    <option value="">Tất cả voice</option>
                    <option value="ready" selected="@(Model.VoiceFilter == "ready")">Đủ cả VI & EN</option>
                    <option value="missing" selected="@(Model.VoiceFilter == "missing")">Thiếu voice (chưa đủ)</option>
                    <option value="none" selected="@(Model.VoiceFilter == "none")">Chưa có voice</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="interactionType">Dạng bài</label>
                <select id="interactionType" name="interactionType" class="form-control">
                    <option value="">Tất cả dạng</option>
                    <option value="@InteractionTypes.SingleChoice" selected="@(Model.InteractionType == InteractionTypes.SingleChoice)">Chọn đáp án</option>
                    <option value="@InteractionTypes.MultiSelect" selected="@(Model.InteractionType == InteractionTypes.MultiSelect)">Chọn nhiều</option>
                    <option value="@InteractionTypes.ListenAndChoose" selected="@(Model.InteractionType == InteractionTypes.ListenAndChoose)">Nghe - chọn</option>
                    <option value="@InteractionTypes.DragDrop" selected="@(Model.InteractionType == InteractionTypes.DragDrop)">Kéo - thả</option>
                    <option value="@InteractionTypes.Matching" selected="@(Model.InteractionType == InteractionTypes.Matching)">Nối cặp</option>
                    <option value="@InteractionTypes.Ordering" selected="@(Model.InteractionType == InteractionTypes.Ordering)">Sắp xếp</option>
                    <option value="@InteractionTypes.Counting" selected="@(Model.InteractionType == InteractionTypes.Counting)">Đếm đồ vật</option>
                    <option value="@InteractionTypes.QuantityBuilder" selected="@(Model.InteractionType == InteractionTypes.QuantityBuilder)">Tạo số lượng</option>
                    <option value="@InteractionTypes.Comparison" selected="@(Model.InteractionType == InteractionTypes.Comparison)">So sánh</option>
                    <option value="@InteractionTypes.Classification" selected="@(Model.InteractionType == InteractionTypes.Classification)">Phân loại</option>
                    <option value="@InteractionTypes.StoryChoice" selected="@(Model.InteractionType == InteractionTypes.StoryChoice)">Nghe truyện</option>
                    <option value="@InteractionTypes.Tracing" selected="@(Model.InteractionType == InteractionTypes.Tracing)">Tô nét</option>
                </select>
            </div>
            <div class="filter-actions">
                <button class="app-btn app-btn-small" type="submit">
                    <span class="material-symbols-outlined">filter_alt</span>
                    Lọc
                </button>
                @if (Model.HasActiveFilter)
                {
                    <a class="app-btn app-btn-muted app-btn-small" asp-action="LearningItems" title="Xóa tất cả điều kiện lọc">
                        <span class="material-symbols-outlined">clear_all</span>
                        Xóa lọc
                    </a>
                }
            </div>
        </form>

        <!-- Thanh điều khiển Cây Thư Mục -->
        <div class="tree-control-bar">
            <div class="tree-summary-chips">
                <div class="tree-summary-chip">
                    <span class="material-symbols-outlined">category</span>
                    <strong>@Model.TotalGroups</strong>
                    <span>Nhóm kỹ năng</span>
                </div>
                <div class="tree-summary-chip">
                    <span class="material-symbols-outlined">folder</span>
                    <strong>@Model.TotalTopics</strong>
                    <span>Chủ đề</span>
                </div>
                <div class="tree-summary-chip highlight">
                    <span class="material-symbols-outlined">auto_stories</span>
                    <strong>@Model.TotalItems</strong>
                    <span>Bài học</span>
                </div>
                @if (Model.HasActiveFilter)
                {
                    <span class="active-filter-indicator">
                        <span class="material-symbols-outlined">info</span>
                        Đang lọc kết quả
                    </span>
                }
            </div>
            <div class="tree-expand-buttons">
                <button type="button" class="app-btn app-btn-muted app-btn-small" id="btnExpandAll" title="Mở rộng toàn bộ cây thư mục">
                    <span class="material-symbols-outlined">unfold_more</span>
                    Mở rộng tất cả
                </button>
                <button type="button" class="app-btn app-btn-muted app-btn-small" id="btnCollapseAll" title="Thu gọn toàn bộ cây thư mục">
                    <span class="material-symbols-outlined">unfold_less</span>
                    Thu gọn tất cả
                </button>
            </div>
        </div>

        <!-- Cây Phân Cấp Chương Trình & Bài Học -->
        <div class="learning-tree-container" id="learningTreeRoot">
            @if (Model.TreeGroups.Count == 0)
            {
                <div class="soft-card empty-tree-state">
                    <span class="material-symbols-outlined empty-icon">folder_off</span>
                    <h3>Không tìm thấy bài học phù hợp</h3>
                    <p>Không có bài học nào khớp với điều kiện lọc hiện tại. Vui lòng thử thay đổi tiêu chí lọc hoặc xóa bộ lọc.</p>
                    @if (Model.HasActiveFilter)
                    {
                        <a class="app-btn app-btn-small" asp-action="LearningItems">
                            <span class="material-symbols-outlined">restart_alt</span>
                            Xóa bộ lọc
                        </a>
                    }
                </div>
            }
            else
            {
                @foreach (var groupItem in Model.TreeGroups)
                {
                    var groupColor = string.IsNullOrWhiteSpace(groupItem.SkillGroup.Color) ? "#2563eb" : groupItem.SkillGroup.Color;
                    <div class="tree-group-card @(Model.HasActiveFilter ? "is-expanded" : "")" style="--group-color: @groupColor;" data-group-node>
                        <header class="tree-group-header" data-toggle-trigger>
                            <button type="button" class="tree-toggle-btn" aria-label="Đóng mở nhóm" title="Đóng / Mở nhóm">
                                <span class="material-symbols-outlined tree-chevron">chevron_right</span>
                            </button>
                            <div class="tree-group-icon-wrap">
                                <span class="material-symbols-outlined tree-group-icon">@groupItem.SkillGroup.IconKey</span>
                            </div>
                            <div class="tree-group-info">
                                <div class="tree-group-title-row">
                                    <h2 class="tree-group-title">@groupItem.SkillGroup.Name</h2>
                                    <span class="tree-count-badge group-count">@groupItem.LearningItemCount bài</span>
                                    <div class="group-coverage-wrap" title="Độ phủ bài học của nhóm: @groupItem.CoveragePercentage%">
                                        <div class="group-coverage-bar">
                                            <span class="group-coverage-fill" style="width:@groupItem.CoveragePercentage%;"></span>
                                        </div>
                                        <span class="group-coverage-text">@groupItem.CoveragePercentage% độ phủ</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(groupItem.SkillGroup.Description))
                                {
                                    <p class="tree-group-desc">@groupItem.SkillGroup.Description</p>
                                }
                                <div class="activity-coverage-summary" title="Mỗi dạng bài trong từng chủ đề cần có ít nhất 10 bài">
                                    <strong>@groupItem.ActivityCoveragePercentage% dạng bài trong chủ đề đạt tối thiểu 10 bài</strong>
                                    <div class="activity-coverage-chips">
                                        @foreach (var activity in groupItem.ActivityTypes)
                                        {
                                            <span class="activity-count-chip @(activity.IsCovered ? "is-covered" : "is-missing")">
                                                <span class="material-symbols-outlined">@activity.IconKey</span>
                                                @activity.DisplayName: <b>@activity.LearningItemCount/@activity.MinimumRequired</b>
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="tree-group-actions" onclick="event.stopPropagation();">
                                <a class="app-btn app-btn-muted app-btn-small" asp-action="CreateChoice" asp-route-skillGroupId="@groupItem.SkillGroup.Id" title="Tạo bài tương tác cho @groupItem.SkillGroup.Name">
                                    <span class="material-symbols-outlined">add</span>
                                    Tạo bài
                                </a>
                            </div>
                        </header>

                        <div class="tree-group-body">
                            <div class="tree-topics-list">
                                @foreach (var topicItem in groupItem.Topics)
                                {
                                    var hasLessons = topicItem.LearningItemCount > 0;
                                    <div class="tree-topic-item @(Model.HasActiveFilter && hasLessons ? "is-expanded" : "")" data-topic-node>
                                        <header class="tree-topic-header" data-toggle-trigger>
                                            <button type="button" class="tree-toggle-btn small-toggle" aria-label="Đóng mở chủ đề" title="Đóng / Mở chủ đề">
                                                <span class="material-symbols-outlined tree-chevron">chevron_right</span>
                                            </button>
                                            <div class="tree-topic-icon-wrap">
                                                <span class="material-symbols-outlined tree-topic-icon @(hasLessons ? "topic-has-content" : "topic-empty")">
                                                    @(hasLessons ? "check_circle" : "radio_button_unchecked")
                                                </span>
                                            </div>
                                            <div class="tree-topic-info">
                                                <div class="tree-topic-title-row">
                                                    <span class="tree-topic-code">@topicItem.Topic.Code</span>
                                                    <h3 class="tree-topic-title">@topicItem.Topic.Name</h3>
                                                    <span class="tree-count-badge topic-count">@topicItem.LearningItemCount bài</span>
                                                </div>
                                                <div class="tree-topic-meta">
                                                    @if (topicItem.ActivityTypes.Any())
                                                    {
                                                        <div class="topic-templates-chips">
                                                            @foreach (var activity in topicItem.ActivityTypes)
                                                            {
                                                                <span class="template-chip @(activity.IsCovered ? "is-covered" : "is-missing")" title="@activity.DisplayName: @activity.LearningItemCount/@activity.MinimumRequired bài trong chủ đề">
                                                                    <span class="material-symbols-outlined">@activity.IconKey</span>
                                                                    @activity.DisplayName · @activity.LearningItemCount/@activity.MinimumRequired bài
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            
                                            <!-- Dàn nút Tạo nhanh theo từng Template chuẩn của Topic (Kế thừa trọn vẹn từ Catalogs) -->
                                            <div class="tree-topic-actions" onclick="event.stopPropagation();">
                                                <div class="topic-quick-create-bar" title="Tạo nhanh bài học chuẩn sư phạm">
                                                    @foreach (var template in topicItem.AllowedTemplates)
                                                    {
                                                        <a class="icon-button" asp-action="CreateChoice" asp-route-skillGroupId="@groupItem.SkillGroup.Id" asp-route-topicId="@topicItem.Topic.Id" asp-route-interactionType="@template.InteractionType" title="Tạo bài @template.Name cho @topicItem.Topic.Name" aria-label="Tạo bài @template.Name">
                                                            <span class="material-symbols-outlined">@template.IconKey</span>
                                                        </a>
                                                    }
                                                    @if (topicItem.AllowsTracing)
                                                    {
                                                        <a class="icon-button" asp-action="CreateTracing" asp-route-skillGroupId="@groupItem.SkillGroup.Id" asp-route-topicId="@topicItem.Topic.Id" title="Tạo bài Tô nét cho @topicItem.Topic.Name" aria-label="Tạo bài tô nét">
                                                            <span class="material-symbols-outlined">draw</span>
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </header>

                                        <div class="tree-topic-body">
                                            @if (topicItem.Items.Count == 0)
                                            {
                                                <div class="tree-empty-topic">
                                                    <span class="material-symbols-outlined">info</span>
                                                    <span>Chưa có bài học nào trong chủ đề này.</span>
                                                    <a asp-action="CreateChoice" asp-route-skillGroupId="@groupItem.SkillGroup.Id" asp-route-topicId="@topicItem.Topic.Id" class="primary-link">Tạo bài ngay</a>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="table-responsive">
                                                    <table class="app-table tree-items-table">
                                                        <thead>
                                                        <tr>
                                                            <th style="width: 55px;" class="col-secondary">STT</th>
                                                            <th>Tên bài học</th>
                                                            <th class="col-secondary">Dạng bài</th>
                                                            <th>Trạng thái</th>
                                                            <th style="width: 130px; text-align:center;">Voice Song Ngữ</th>
                                                            <th style="width: 300px; text-align: right;">Thao tác</th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        @{ string? currentInteractionType = null; }
                                                        @foreach (var item in topicItem.Items)
                                                        {
                                                            var isCompatible = ActivityTemplateCatalog.IsItemAllowed(item);
                                                            var voiceStatus = Model.VoiceStatuses.GetValueOrDefault(item.Id) ?? new AdminLearningItemVoiceStatus();
                                                            if (!string.Equals(currentInteractionType, item.InteractionType, StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                currentInteractionType = item.InteractionType;
                                                                var activity = topicItem.ActivityTypes.FirstOrDefault(x => string.Equals(x.InteractionType, item.InteractionType, StringComparison.OrdinalIgnoreCase));
                                                                var visibleTypeCount = topicItem.Items.Count(x => string.Equals(x.InteractionType, item.InteractionType, StringComparison.OrdinalIgnoreCase));
                                                                <tr class="activity-type-divider-row">
                                                                    <td colspan="6">
                                                                        <span class="material-symbols-outlined">@(activity?.IconKey ?? "extension")</span>
                                                                        <strong>@ActivityTemplateCatalog.GetDisplayName(item.InteractionType)</strong>
                                                                        <span>@visibleTypeCount bài đang hiển thị</span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                            <tr data-lesson-row-id="@item.Id">
                                                                <td class="col-secondary">
                                                                    <span class="sort-badge">#@item.SortOrder</span>
                                                                </td>
                                                                <td>
                                                                    <div class="lesson-title-cell">
                                                                        <a class="table-link lesson-name" asp-action="LearningItemDetail" asp-route-id="@item.Id" title="Xem chi tiết bài học">
                                                                            @item.Title
                                                                        </a>
                                                                    </div>
                                                                </td>
                                                                <td class="col-secondary">
                                                                    <span class="template-badge">
                                                                        @ActivityTemplateCatalog.GetDisplayName(item.InteractionType)
                                                                    </span>
                                                                    @if (!isCompatible)
                                                                    {
                                                                        <span class="status-chip status-warning" title="Dạng bài cần điều chỉnh cho phù hợp chủ đề">Cần chuẩn hóa</span>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    <span class="status-chip status-@item.Status">@ContentStatus.GetDisplayName(item.Status)</span>
                                                                </td>
                                                                <td style="text-align:center;">
                                                                    <div class="lesson-voice-status-cell" data-voice-status-cell="@item.Id">
                                                                        @if (voiceStatus.Status == "full")
                                                                        {
                                                                            <span class="badge-voice-pill voice-ready" title="Đã có đủ cả Voice Tiếng Việt & Tiếng Anh">
                                                                                <span class="material-symbols-outlined">record_voice_over</span>
                                                                                Đủ VI & EN (@voiceStatus.RequiredCount/@voiceStatus.RequiredCount)
                                                                            </span>
                                                                        }
                                                                        else if (voiceStatus.Status == "partial")
                                                                        {
                                                                            <span class="badge-voice-pill voice-partial" title="Đã có một phần voice, cần sinh bổ sung">
                                                                                <span class="material-symbols-outlined">mic_none</span>
                                                                                VI @voiceStatus.VoiceViCount/@voiceStatus.RequiredCount · EN @voiceStatus.VoiceEnCount/@voiceStatus.RequiredCount
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge-voice-pill voice-none" title="Chưa có voice cho bài học">
                                                                                <span class="material-symbols-outlined">voice_over_off</span>
                                                                                Chưa có
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                </td>
                                                                <td class="table-actions">
                                                                    <a class="mini-action primary-link" asp-action="PreviewLearningItem" asp-route-id="@item.Id" title="Xem thử giao diện bé học">
                                                                        <span class="material-symbols-outlined">visibility</span>
                                                                        Xem
                                                                    </a>
                                                                    @if (item.InteractionType == InteractionTypes.Tracing)
                                                                    {
                                                                        <a class="mini-action" asp-action="CreateTracing" asp-route-editId="@item.Id" title="Chỉnh sửa bài học">
                                                                            <span class="material-symbols-outlined">edit</span>
                                                                            Sửa
                                                                        </a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a class="mini-action" asp-action="CreateChoice" asp-route-editId="@item.Id" title="Chỉnh sửa bài học">
                                                                            <span class="material-symbols-outlined">edit</span>
                                                                            Sửa
                                                                        </a>
                                                                    }
                                                                    <!-- Nút kiểm soát Voice mở Modal nghe thử & sinh voice tại chỗ (AJAX) -->
                                                                    <button class="mini-action voice-action-btn" type="button" data-lesson-voice-btn="@item.Id" title="Kiểm tra & sinh Voice bài học">
                                                                        <span class="material-symbols-outlined">graphic_eq</span>
                                                                        Voice
                                                                    </button>
                                                                    <form class="inline-action-form" asp-action="DeleteLearningItem" asp-route-id="@item.Id" method="post" data-confirm-delete>
                                                                        <button class="mini-action danger-link" type="submit" title="Xóa bài học">
                                                                            <span class="material-symbols-outlined">delete</span>
                                                                        </button>
                                                                    </form>
                                                                </td>
                                                            </tr>
                                                        }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (groupItem.DirectItems.Count > 0)
                                {
                                    <div class="tree-topic-item @(Model.HasActiveFilter ? "is-expanded" : "")" data-topic-node>
                                        <header class="tree-topic-header direct-topic-header" data-toggle-trigger>
                                            <button type="button" class="tree-toggle-btn small-toggle" aria-label="Đóng mở" title="Đóng / Mở">
                                                <span class="material-symbols-outlined tree-chevron">chevron_right</span>
                                            </button>
                                            <div class="tree-topic-icon-wrap">
                                                <span class="material-symbols-outlined tree-topic-icon">folder_special</span>
                                            </div>
                                            <div class="tree-topic-info">
                                                <div class="tree-topic-title-row">
                                                    <h3 class="tree-topic-title">Chủ đề chung / Chưa phân loại</h3>
                                                    <span class="tree-count-badge topic-count">@groupItem.DirectItems.Count bài</span>
                                                </div>
                                            </div>
                                        </header>

                                        <div class="tree-topic-body">
                                            <div class="table-responsive">
                                                <table class="app-table tree-items-table">
                                                    <thead>
                                                    <tr>
                                                        <th style="width: 55px;">STT</th>
                                                        <th>Tên bài học</th>
                                                        <th>Dạng bài</th>
                                                        <th>Trạng thái</th>
                                                        <th style="width: 130px; text-align:center;">Voice Song Ngữ</th>
                                                        <th style="width: 300px; text-align: right;">Thao tác</th>
                                                    </tr>
                                                    </thead>
                                                    <tbody>
                                                    @foreach (var item in groupItem.DirectItems)
                                                    {
                                                        var isCompatible = ActivityTemplateCatalog.IsItemAllowed(item);
                                                        var voiceStatus = Model.VoiceStatuses.GetValueOrDefault(item.Id) ?? new AdminLearningItemVoiceStatus();
                                                        <tr data-lesson-row-id="@item.Id">
                                                            <td>
                                                                <span class="sort-badge">#@item.SortOrder</span>
                                                            </td>
                                                            <td>
                                                                <div class="lesson-title-cell">
                                                                    <a class="table-link lesson-name" asp-action="LearningItemDetail" asp-route-id="@item.Id">
                                                                        @item.Title
                                                                    </a>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <span class="template-badge">
                                                                    @ActivityTemplateCatalog.GetDisplayName(item.InteractionType)
                                                                </span>
                                                                @if (!isCompatible)
                                                                {
                                                                    <span class="status-chip status-warning">Cần chuẩn hóa</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                <span class="status-chip status-@item.Status">@ContentStatus.GetDisplayName(item.Status)</span>
                                                            </td>
                                                            <td style="text-align:center;">
                                                                <div class="lesson-voice-status-cell" data-voice-status-cell="@item.Id">
                                                                    @if (voiceStatus.Status == "full")
                                                                    {
                                                                        <span class="badge-voice-pill voice-ready">
                                                                            <span class="material-symbols-outlined">record_voice_over</span>
                                                                            Đủ VI & EN (@voiceStatus.RequiredCount/@voiceStatus.RequiredCount)
                                                                        </span>
                                                                    }
                                                                    else if (voiceStatus.Status == "partial")
                                                                    {
                                                                        <span class="badge-voice-pill voice-partial">
                                                                            <span class="material-symbols-outlined">mic_none</span>
                                                                            VI @voiceStatus.VoiceViCount/@voiceStatus.RequiredCount · EN @voiceStatus.VoiceEnCount/@voiceStatus.RequiredCount
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge-voice-pill voice-none">
                                                                            <span class="material-symbols-outlined">voice_over_off</span>
                                                                            Chưa có
                                                                        </span>
                                                                    }
                                                                </div>
                                                            </td>
                                                            <td class="table-actions">
                                                                <a class="mini-action primary-link" asp-action="PreviewLearningItem" asp-route-id="@item.Id" title="Xem thử" target="_blank">
                                                                    <span class="material-symbols-outlined">visibility</span>
                                                                    Xem
                                                                </a>
                                                                @if (item.InteractionType == InteractionTypes.Tracing)
                                                                {
                                                                    <a class="mini-action" asp-action="CreateTracing" asp-route-editId="@item.Id">
                                                                        <span class="material-symbols-outlined">edit</span>
                                                                        Sửa
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <a class="mini-action" asp-action="CreateChoice" asp-route-editId="@item.Id">
                                                                        <span class="material-symbols-outlined">edit</span>
                                                                        Sửa
                                                                    </a>
                                                                }
                                                                <button class="mini-action voice-action-btn" type="button" data-lesson-voice-btn="@item.Id" title="Kiểm tra & sinh Voice bài học">
                                                                    <span class="material-symbols-outlined">graphic_eq</span>
                                                                    Voice
                                                                </button>
                                                                <form class="inline-action-form" asp-action="DeleteLearningItem" asp-route-id="@item.Id" method="post" data-confirm-delete>
                                                                    <button class="mini-action danger-link" type="submit" title="Xóa bài học">
                                                                        <span class="material-symbols-outlined">delete</span>
                                                                    </button>
                                                                </form>
                                                            </td>
                                                        </tr>
                                                    }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </main>
</section>

<!-- Modal Kiểm Tra & Quản Trị Voice Của Riêng Bài Học (AJAX Modal) -->
<div class="lesson-voice-modal-backdrop" id="lessonVoiceModal" style="display:none;">
    <div class="lesson-voice-modal-box">
        <div class="lesson-voice-modal-header">
            <div>
                <span class="lesson-voice-badge" id="lvModalTopicBadge">Chủ đề</span>
                <h3 class="lesson-voice-modal-title" id="lvModalTitle">Voice Bài Học</h3>
            </div>
            <button type="button" class="close-card-btn" id="lvModalCloseBtn" title="Đóng">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="lesson-voice-modal-body">
            <div id="lvLoading" style="text-align:center; padding:32px 0; color:#64748b;">
                <span class="material-symbols-outlined" style="font-size:36px; animation:spin 1s linear infinite;">sync</span>
                <p style="margin-top:8px; font-weight:600;">Đang nạp danh sách âm thanh bài học...</p>
            </div>

            <div id="lvContent" style="display:none;">
                <div class="lv-summary-band mb-3">
                    <div id="lvStatusBadgeWrap"></div>
                    <p class="lv-summary-note mb-0">Nghe thử phát âm Tiếng Việt (Hoài My - Nữ) và Tiếng Anh (Jenny - Nữ) của từng câu trong bài.</p>
                </div>

                <div class="lv-prompts-list" id="lvPromptsList">
                    <!-- Danh sách câu thoại sinh động bằng JS -->
                </div>
            </div>
        </div>

        <div class="lesson-voice-modal-footer">
            <div class="lv-footer-left">
                <a class="app-btn app-btn-muted app-btn-small" id="lvOpenInVoiceCacheBtn" href="#" target="_blank" title="Mở trong trang Thư viện voice để chỉnh sửa sâu">
                    <span class="material-symbols-outlined">open_in_new</span>
                    Mở trong Kiểm soát voice
                </a>
            </div>
            <div class="lv-footer-right" style="display:flex; gap:8px;">
                <button type="button" class="app-btn app-btn-muted app-btn-small" id="lvModalCancelBtn">Đóng</button>
                <button type="button" class="app-btn app-btn-small" id="lvRegenerateBtn">
                    <span class="material-symbols-outlined" id="lvRegenIcon">sync</span>
                    <span id="lvRegenText">Sinh / Đồng bộ lại Voice bài này</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    // 1. Cascade Topic dropdown based on SkillGroup dropdown
    const skillGroupSelect = document.getElementById("skillGroupId");
    const topicSelect = document.getElementById("topicId");

    function updateTopicDropdown() {
        if (!skillGroupSelect || !topicSelect) return;
        const selectedGroupId = skillGroupSelect.value;
        const topicOptions = topicSelect.querySelectorAll("option[data-group-id]");

        let currentTopicMatched = false;
        topicOptions.forEach(opt => {
            const optGroupId = opt.getAttribute("data-group-id");
            if (!selectedGroupId || optGroupId === selectedGroupId) {
                opt.style.display = "";
                if (opt.selected) currentTopicMatched = true;
            } else {
                opt.style.display = "none";
                if (opt.selected) opt.selected = false;
            }
        });

        if (!currentTopicMatched && topicSelect.value !== "") {
            const defaultOpt = topicSelect.querySelector("option[value='']");
            if (defaultOpt) defaultOpt.selected = true;
        }
    }

    if (skillGroupSelect) {
        skillGroupSelect.addEventListener("change", updateTopicDropdown);
        updateTopicDropdown();
    }

    // 2. Tree toggle logic (Group and Topic nodes)
    const treeContainer = document.getElementById("learningTreeRoot");
    if (treeContainer) {
        treeContainer.addEventListener("click", function (e) {
            const trigger = e.target.closest("[data-toggle-trigger]");
            if (!trigger) return;

            // Check if clicking inside an interactive action button
            if (e.target.closest("a, button:not(.tree-toggle-btn), form, input, select")) {
                return;
            }

            const groupNode = trigger.closest("[data-group-node]");
            const topicNode = trigger.closest("[data-topic-node]");

            if (topicNode && trigger.classList.contains("tree-topic-header")) {
                topicNode.classList.toggle("is-expanded");
            } else if (groupNode && trigger.classList.contains("tree-group-header")) {
                groupNode.classList.toggle("is-expanded");
            }
        });
    }

    // 3. Expand All / Collapse All buttons
    const btnExpandAll = document.getElementById("btnExpandAll");
    const btnCollapseAll = document.getElementById("btnCollapseAll");

    if (btnExpandAll) {
        btnExpandAll.addEventListener("click", function () {
            document.querySelectorAll(".tree-group-card, .tree-topic-item").forEach(node => {
                node.classList.add("is-expanded");
            });
        });
    }

    if (btnCollapseAll) {
        btnCollapseAll.addEventListener("click", function () {
            document.querySelectorAll(".tree-group-card, .tree-topic-item").forEach(node => {
                node.classList.remove("is-expanded");
            });
        });
    }

    // 4. Modal Quản trị Voice của bài học (AJAX)
    const modal = document.getElementById("lessonVoiceModal");
    const closeBtn = document.getElementById("lvModalCloseBtn");
    const cancelBtn = document.getElementById("lvModalCancelBtn");
    const loadingEl = document.getElementById("lvLoading");
    const contentEl = document.getElementById("lvContent");
    const titleEl = document.getElementById("lvModalTitle");
    const topicBadgeEl = document.getElementById("lvModalTopicBadge");
    const statusBadgeWrap = document.getElementById("lvStatusBadgeWrap");
    const promptsListEl = document.getElementById("lvPromptsList");
    const openInVcBtn = document.getElementById("lvOpenInVoiceCacheBtn");
    const regenBtn = document.getElementById("lvRegenerateBtn");
    const regenIcon = document.getElementById("lvRegenIcon");
    const regenText = document.getElementById("lvRegenText");

    let currentLessonId = null;

    const closeModal = () => {
        if (modal) modal.style.display = "none";
        // Dừng tất cả audio đang phát
        document.querySelectorAll("#lessonVoiceModal audio").forEach(a => a.pause());
    };

    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    if (cancelBtn) cancelBtn.addEventListener("click", closeModal);
    if (modal) {
        modal.addEventListener("click", function(e) {
            if (e.target === modal) closeModal();
        });
    }

    const renderVoiceModal = (data) => {
        titleEl.textContent = data.title || "Voice Bài Học";
        topicBadgeEl.textContent = `${data.skillGroupName} • ${data.topicName}`;
        openInVcBtn.href = `/admin/voice-cache?learningItemId=${data.id}`;

        let statusHtml = "";
        if (data.voiceStatus === "full") {
            statusHtml = `<span class="badge-voice-pill voice-ready" style="font-size:13px; padding:6px 14px;"><span class="material-symbols-outlined">record_voice_over</span> Đã đủ Voice VI & EN (${data.requiredVoiceCount}/${data.requiredVoiceCount})</span>`;
        } else if (data.voiceStatus === "partial") {
            statusHtml = `<span class="badge-voice-pill voice-partial" style="font-size:13px; padding:6px 14px;"><span class="material-symbols-outlined">mic_none</span> VI ${data.readyVoiceViCount}/${data.requiredVoiceCount} · EN ${data.readyVoiceEnCount}/${data.requiredVoiceCount}</span>`;
        } else {
            statusHtml = `<span class="badge-voice-pill voice-none" style="font-size:13px; padding:6px 14px;"><span class="material-symbols-outlined">voice_over_off</span> Bài học chưa có file Voice nào</span>`;
        }
        statusBadgeWrap.innerHTML = statusHtml;

        const listStatusCell = document.querySelector(`[data-voice-status-cell="${data.id}"]`);
        if (listStatusCell) listStatusCell.innerHTML = statusHtml;

        let promptsHtml = "";
        if (!data.prompts || data.prompts.length === 0) {
            promptsHtml = `<div style="text-align:center; padding:24px; color:#64748b;">Không có câu thoại nào trong bài học này.</div>`;
        } else {
            data.prompts.forEach(p => {
                promptsHtml += `
                    <div class="lv-prompt-card">
                        <div class="lv-prompt-header">
                            <span class="lv-prompt-type">${escapeHtml(p.typeName)}</span>
                        </div>
                        <div class="lv-prompt-cols">
                            <div class="lv-prompt-col">
                                <span class="lv-lang-tag vi">🇻🇳 Tiếng Việt</span>
                                <p class="lv-prompt-text">${escapeHtml(p.text)}</p>
                                ${p.hasVi ? `
                                    <div class="lv-audio-wrap">
                                        <audio controls preload="none" src="${p.audioUrl}" class="lv-audio-player"></audio>
                                    </div>
                                ` : `<span class="badge-missing-voice">Chưa có âm thanh VI</span>`}
                            </div>
                            <div class="lv-prompt-col">
                                <span class="lv-lang-tag en">🇬🇧 English</span>
                                <p class="lv-prompt-text en">${p.textEn ? escapeHtml(p.textEn) : `<em style="color:#94a3b8;">Chưa có bản dịch</em>`}</p>
                                ${p.hasEn ? `
                                    <div class="lv-audio-wrap">
                                        <audio controls preload="none" src="${p.audioUrlEn}" class="lv-audio-player"></audio>
                                    </div>
                                ` : `<span class="badge-missing-voice">Chưa có âm thanh EN</span>`}
                            </div>
                        </div>
                    </div>
                `;
            });
        }
        promptsListEl.innerHTML = promptsHtml;

        loadingEl.style.display = "none";
        contentEl.style.display = "block";
    };

    const loadVoiceDetails = async (lessonId) => {
        currentLessonId = lessonId;
        modal.style.display = "flex";
        loadingEl.style.display = "block";
        contentEl.style.display = "none";

        try {
            const resp = await fetch(`/admin/learning-items/${lessonId}/voice-details`);
            if (!resp.ok) throw new Error("Không thể tải thông tin voice.");
            const data = await resp.json();
            renderVoiceModal(data);
        } catch (err) {
            loadingEl.innerHTML = `<p style="color:#ef4444; font-weight:700;">Lỗi: ${err.message}</p>`;
        }
    };

    // Bắt sự kiện click nút Voice trên từng bài học
    document.querySelectorAll("[data-lesson-voice-btn]").forEach(btn => {
        btn.addEventListener("click", function () {
            const lessonId = btn.getAttribute("data-lesson-voice-btn");
            if (lessonId) loadVoiceDetails(lessonId);
        });
    });

    // Sinh voice AJAX khi bấm nút trong modal
    if (regenBtn) {
        regenBtn.addEventListener("click", async function () {
            if (!currentLessonId) return;
            regenBtn.disabled = true;
            regenIcon.style.animation = "spin 1s linear infinite";
            regenText.textContent = "Đang sinh Voice chuẩn...";

            const csrf = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
            try {
                const formData = new FormData();
                formData.append("__RequestVerificationToken", csrf);

                const resp = await fetch(`/admin/learning-items/${currentLessonId}/generate-audio-ajax`, {
                    method: "POST",
                    body: formData
                });
                const result = await resp.json();
                if (result.success) {
                    // Cập nhật lại badge trên bảng chính
                    const cell = document.querySelector(`[data-voice-status-cell="${currentLessonId}"]`);
                    if (cell) {
                        if (result.voiceStatus === "full") {
                            cell.innerHTML = `<span class="badge-voice-pill voice-ready"><span class="material-symbols-outlined">record_voice_over</span> Đủ VI & EN</span>`;
                        } else if (result.voiceStatus === "partial") {
                            cell.innerHTML = `<span class="badge-voice-pill voice-partial"><span class="material-symbols-outlined">mic_none</span> Thiếu voice</span>`;
                        } else {
                            cell.innerHTML = `<span class="badge-voice-pill voice-none"><span class="material-symbols-outlined">voice_over_off</span> Chưa có</span>`;
                        }
                    }
                    // Tải lại chi tiết trong modal để phát ngay
                    await loadVoiceDetails(currentLessonId);
                } else {
                    alert(result.message || "Không thể sinh voice.");
                }
            } catch (err) {
                alert("Lỗi khi kết nối sinh voice: " + err.message);
            } finally {
                regenBtn.disabled = false;
                regenIcon.style.animation = "";
                regenText.textContent = "Sinh / Đồng bộ lại Voice bài này";
            }
        });
    }

    function escapeHtml(text) {
        if (!text) return "";
        return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }
});
</script>
}
