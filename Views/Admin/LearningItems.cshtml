@model AdminLearningItemListViewModel
@{
    ViewData["Title"] = "Kho nội dung";
}

<section class="container dashboard-wrap">
    @if (TempData["AdminMessage"] is string message)
    {
        <div class="feedback-band success"><span class="material-symbols-outlined">check_circle</span><strong>@message</strong></div>
    }
    <div class="dashboard-header">
        <div>
            <p class="eyebrow">Quản trị nội dung</p>
            <h1>Kho bài học</h1>
        </div>
        <div class="hero-actions">
            <a class="app-btn app-btn-muted app-btn-small" asp-action="Catalogs">
                <span class="material-symbols-outlined">account_tree</span>
                Cấu trúc chương trình
            </a>
            <a class="app-btn app-btn-small" asp-action="CreateChoice" asp-route-skillGroupId="@Model.SkillGroupId" asp-route-topicId="@Model.TopicId">
                <span class="material-symbols-outlined">add</span>
                Tạo bài tương tác
            </a>
            <a class="app-btn app-btn-small" asp-action="CreateTracing" asp-route-skillGroupId="@Model.SkillGroupId" asp-route-topicId="@Model.TopicId">
                <span class="material-symbols-outlined">draw</span>
                Tạo bài tô nét
            </a>
            <form class="inline-action-form" asp-action="GenerateMissingLearningItemsAudio" method="post">
                <input type="hidden" name="status" value="@Model.Status" />
                <input type="hidden" name="interactionType" value="@Model.InteractionType" />
                <input type="hidden" name="skillGroupId" value="@Model.SkillGroupId" />
                <input type="hidden" name="topicId" value="@Model.TopicId" />
                <input type="hidden" name="page" value="@Model.Page" />
                <button class="app-btn app-btn-muted app-btn-small" type="submit">
                    <span class="material-symbols-outlined">record_voice_over</span>
                    Bổ sung âm thanh
                </button>
            </form>
            <a class="app-btn app-btn-muted app-btn-small" asp-action="Index">Dashboard</a>
        </div>
    </div>

    <form class="soft-card admin-filter" asp-action="LearningItems" method="get">
        <div>
            <label for="skillGroupId">Nhóm kỹ năng</label>
            <select id="skillGroupId" name="skillGroupId" class="form-control">
                <option value="">Tất cả</option>
                @foreach (var group in Model.SkillGroups)
                {
                    <option value="@group.Id" selected="@(Model.SkillGroupId == group.Id)">@group.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="status">Trạng thái</label>
            <select id="status" name="status" class="form-control">
                <option value="">Tất cả</option>
                <option value="@ContentStatus.Draft" selected="@(Model.Status == ContentStatus.Draft)">Nháp</option>
                <option value="@ContentStatus.Review" selected="@(Model.Status == ContentStatus.Review)">Chờ duyệt</option>
                <option value="@ContentStatus.Published" selected="@(Model.Status == ContentStatus.Published)">Xuất bản</option>
                <option value="@ContentStatus.Archived" selected="@(Model.Status == ContentStatus.Archived)">Lưu trữ</option>
            </select>
        </div>
        <div>
            <label for="topicId">Chủ đề</label>
            <select id="topicId" name="topicId" class="form-control">
                <option value="">Tất cả</option>
                @foreach (var topic in Model.Topics.Where(x => !Model.SkillGroupId.HasValue || x.SkillGroupId == Model.SkillGroupId))
                {
                    <option value="@topic.Id" selected="@(Model.TopicId == topic.Id)">@topic.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="interactionType">Dạng bài</label>
            <select id="interactionType" name="interactionType" class="form-control">
                <option value="">Tất cả</option>
                <option value="@InteractionTypes.SingleChoice" selected="@(Model.InteractionType == InteractionTypes.SingleChoice)">Chọn đáp án</option>
                <option value="@InteractionTypes.MultiSelect" selected="@(Model.InteractionType == InteractionTypes.MultiSelect)">Chọn nhiều</option>
                <option value="@InteractionTypes.ListenAndChoose" selected="@(Model.InteractionType == InteractionTypes.ListenAndChoose)">Nghe - chọn</option>
                <option value="@InteractionTypes.DragDrop" selected="@(Model.InteractionType == InteractionTypes.DragDrop)">Kéo - thả</option>
                <option value="@InteractionTypes.Matching" selected="@(Model.InteractionType == InteractionTypes.Matching)">Nối cặp</option>
                <option value="@InteractionTypes.Ordering" selected="@(Model.InteractionType == InteractionTypes.Ordering)">Sắp xếp</option>
                <option value="@InteractionTypes.Counting" selected="@(Model.InteractionType == InteractionTypes.Counting)">Đếm đồ vật</option>
                <option value="@InteractionTypes.QuantityBuilder" selected="@(Model.InteractionType == InteractionTypes.QuantityBuilder)">Tạo số lượng</option>
                <option value="@InteractionTypes.Comparison" selected="@(Model.InteractionType == InteractionTypes.Comparison)">So sánh</option>
                <option value="@InteractionTypes.Classification" selected="@(Model.InteractionType == InteractionTypes.Classification)">Phân loại</option>
                <option value="@InteractionTypes.StoryChoice" selected="@(Model.InteractionType == InteractionTypes.StoryChoice)">Nghe truyện</option>
                <option value="@InteractionTypes.Tracing" selected="@(Model.InteractionType == InteractionTypes.Tracing)">Tô nét</option>
            </select>
        </div>
        <button class="app-btn app-btn-small" type="submit">Lọc</button>
    </form>

    <div class="soft-card report-panel mt-4">
        <table class="app-table admin-content-table">
            <thead>
            <tr>
                <th>Tên bài</th>
                <th>Nhóm</th>
                <th>Dạng</th>
                <th>Thứ tự</th>
                <th>Câu hỏi</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                var isCompatible = ActivityTemplateCatalog.IsItemAllowed(item);
                <tr>
                    <td><a class="table-link" asp-action="LearningItemDetail" asp-route-id="@item.Id">@item.Title</a></td>
                    <td>@item.SkillGroup?.Name</td>
                    <td>@ActivityTemplateCatalog.GetDisplayName(item.InteractionType) @if (!isCompatible) { <span class="status-chip status-warning">Cần chuẩn hóa</span> }</td>
                    <td>@item.SortOrder</td>
                    <td>@item.Questions.Count</td>
                    <td><span class="status-chip status-@item.Status">@ContentStatus.GetDisplayName(item.Status)</span></td>
                    <td class="table-actions">
                        @if (item.InteractionType == InteractionTypes.Tracing)
                        {
                            <a class="mini-action" asp-action="CreateTracing" asp-route-editId="@item.Id">Sửa</a>
                        }
                        else
                        {
                            <a class="mini-action" asp-action="CreateChoice" asp-route-editId="@item.Id">Sửa</a>
                        }
                        <form class="inline-action-form" asp-action="GenerateLearningItemAudio" asp-route-id="@item.Id" method="post">
                            <button class="mini-action" type="submit">Tạo âm thanh</button>
                        </form>
                        <form class="inline-action-form" asp-action="DeleteLearningItem" asp-route-id="@item.Id" method="post" data-confirm-delete>
                            <button class="mini-action danger-link" type="submit">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="admin-pagination" aria-label="Phân trang kho bài học">
            <a class="icon-button @(Model.Page == 1 ? "disabled" : "")"
               asp-action="LearningItems" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.Status"
               asp-route-interactionType="@Model.InteractionType" asp-route-skillGroupId="@Model.SkillGroupId" asp-route-topicId="@Model.TopicId"
               aria-label="Trang trước"><span class="material-symbols-outlined">chevron_left</span></a>
            <strong>Trang @Model.Page / @Model.TotalPages</strong>
            <span>@Model.TotalItems bài học</span>
            <a class="icon-button @(Model.Page == Model.TotalPages ? "disabled" : "")"
               asp-action="LearningItems" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.Status"
               asp-route-interactionType="@Model.InteractionType" asp-route-skillGroupId="@Model.SkillGroupId" asp-route-topicId="@Model.TopicId"
               aria-label="Trang sau"><span class="material-symbols-outlined">chevron_right</span></a>
        </nav>
    }
</section>
