@model AdminMediaLibraryViewModel
@{
    ViewData["Title"] = "Thư viện hình ảnh";
}

<section class="admin-layout">
    <partial name="_AdminSidebar" />
    <main class="admin-main">
        <div class="dashboard-header">
            <div>
                <p class="eyebrow">Tài nguyên nội dung</p>
                <h1>Thư viện hình ảnh</h1>
            </div>
            <div class="hero-actions">
                <a class="app-btn app-btn-muted app-btn-small" asp-action="VoiceCache">
                    <span class="material-symbols-outlined">graphic_eq</span>
                    Kiểm soát voice
                </a>
                <a class="app-btn app-btn-muted app-btn-small" asp-action="Index">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Dashboard
                </a>
            </div>
        </div>

        @if (TempData["AdminMessage"] is string message)
        {
            <div class="feedback-band success"><span class="material-symbols-outlined">info</span>@message</div>
        }

        <datalist id="media-category-options">
            @foreach (var item in Model.Categories)
            {
                <option value="@item"></option>
            }
        </datalist>

        <section class="media-upload-panel">
            <div>
                <h2>Tải ảnh vào thư viện</h2>
                <p class="empty-note">Ảnh tải tại đây được dùng lại trong phần Kiểm soát Hình ảnh bài học.</p>
            </div>
            <form asp-action="UploadMediaImage" method="post" enctype="multipart/form-data" class="media-upload-form">
                <div>
                    <label for="imageFile">Tệp ảnh *</label>
                    <input id="imageFile" name="imageFile" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required />
                </div>
                <div>
                    <label for="altText">Mô tả ảnh</label>
                    <input id="altText" name="altText" class="form-control" maxlength="500" placeholder="Ví dụ: Quả táo đỏ" />
                </div>
                <div>
                    <label for="category">Phân loại</label>
                    <input id="category" name="category" class="form-control" maxlength="100" list="media-category-options" placeholder="Ví dụ: Con vật" />
                </div>
                <button class="app-btn" type="submit"><span class="material-symbols-outlined">upload</span>Tải ảnh</button>
            </form>
        </section>

        <section class="media-library-section">
            <div class="media-library-heading">
                <div>
                    <h2>Hình ảnh</h2>
                    <p class="empty-note">@Model.Images.Count ảnh phù hợp bộ lọc.</p>
                </div>
                <form asp-action="MediaLibrary" method="get" class="media-filter-form">
                    <input name="q" value="@Model.Search" class="form-control" placeholder="Tìm tên hoặc mô tả ảnh" />
                    <select name="category" class="form-control">
                        <option value="">Tất cả phân loại</option>
                        @foreach (var item in Model.Categories)
                        {
                            <option value="@item" selected="@(string.Equals(Model.Category, item, StringComparison.OrdinalIgnoreCase))">@item</option>
                        }
                    </select>
                    <button class="app-btn app-btn-muted app-btn-small" type="submit"><span class="material-symbols-outlined">search</span>Lọc</button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Category))
                    {
                        <a class="app-btn app-btn-muted app-btn-small" asp-action="MediaLibrary">Xóa lọc</a>
                    }
                </form>
            </div>

            @if (!Model.Images.Any())
            {
                <p class="empty-note">Chưa có hình phù hợp. Bạn có thể tải ảnh mới bằng biểu mẫu phía trên.</p>
            }
            <div class="media-library-grid">
                @foreach (var asset in Model.Images)
                {
                    <article class="media-asset-card">
                        <img src="@asset.StoragePath" alt="@(asset.AltText ?? asset.FileName)" />
                        <strong title="@asset.FileName">@asset.FileName</strong>
                        <small title="@asset.StoragePath">@asset.StoragePath</small>
                        <form asp-action="UpdateMediaImage" method="post" class="media-metadata-form">
                            <input type="hidden" name="id" value="@asset.Id" />
                            <input type="hidden" name="q" value="@Model.Search" />
                            <input type="hidden" name="currentCategory" value="@Model.Category" />
                            <div>
                                <label>Mô tả ảnh</label>
                                <input name="altText" value="@asset.AltText" class="form-control" maxlength="500" placeholder="Mô tả ngắn" />
                            </div>
                            <div>
                                <label>Phân loại</label>
                                <input name="category" value="@asset.Category" class="form-control" maxlength="100" list="media-category-options" placeholder="Chưa phân loại" />
                            </div>
                            <button class="app-btn app-btn-muted app-btn-small" type="submit"><span class="material-symbols-outlined">save</span>Lưu thông tin</button>
                        </form>
                    </article>
                }
            </div>
        </section>
    </main>
</section>
