@model IReadOnlyList<TextToSpeechCache>
@{
    ViewData["Title"] = "Kiểm soát voice";
    var totalCount = ViewBag.TotalVoiceCount as int? ?? Model.Count;
    var missingCount = ViewBag.MissingVoiceCount as int? ?? Model.Count(x => string.IsNullOrWhiteSpace(x.AudioUrl) || x.Status != "ready" || string.IsNullOrWhiteSpace(x.AudioUrlEn) || x.StatusEn != "ready");
    var currentStatus = ViewBag.Status as string;
    var currentUsageType = ViewBag.UsageType as string;
    var keyword = ViewBag.Keyword as string;
    var usageTypes = ViewBag.UsageTypes as IReadOnlyList<string> ?? [];
    var legacyCount = ViewBag.LegacyVoiceCount as int? ?? 0;
    var filteredCount = ViewBag.FilteredVoiceCount as int? ?? Model.Count;
    var currentPage = ViewBag.Page as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 50;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}
@functions {
    private static string DisplayUsageType(string? usageType) => usageType switch
    {
        "title" => "Tiêu đề",
        "instruction" => "Hướng dẫn",
        "question" => "Câu hỏi",
        "content" => "Nội dung",
        "correct-feedback" => "Phản hồi đúng",
        "retry-feedback" => "Phản hồi sai",
        "option" => "Đáp án",
        "tracing-prompt" => "Tô nét",
        "legacy" => "Voice cũ",
        "custom" => "Tự tạo",
        _ => string.IsNullOrWhiteSpace(usageType) ? "Khác" : usageType
    };
}

<section class="admin-layout">
    <partial name="_AdminSidebar" />
    <main class="admin-main">
        @if (TempData["AdminMessage"] is string message)
        {
            <div class="feedback-band success"><span class="material-symbols-outlined">check_circle</span><strong>@message</strong></div>
        }

        <div class="dashboard-header">
            <div>
                <p class="eyebrow">Thư viện âm thanh Song Ngữ</p>
                <h1>Kiểm soát voice (Việt – Anh)</h1>
                <p class="empty-note">Tổng số @totalCount mục voice. Đang hiển thị @Model.Count / @filteredCount mục.</p>
            </div>
            <div class="hero-actions">
                <button class="app-btn app-btn-muted app-btn-small" type="button" id="toggleAddVoiceBtn" title="Mở form tạo nhanh voice mới">
                    <span class="material-symbols-outlined">add_circle</span>
                    Tạo voice mới
                </button>
                <button class="app-btn app-btn-small" type="button" data-sync-voice-btn title="Rà soát voice đã có và tự động sinh Voice VI & EN cho toàn bộ bài học">
                    <span class="material-symbols-outlined">sync</span>
                    Đồng bộ & Tự sinh Voice
                </button>
                <a class="app-btn app-btn-muted app-btn-small" asp-action="LearningItems">
                    <span class="material-symbols-outlined">library_books</span>
                    Kho bài học
                </a>
            </div>
        </div>

        <!-- Form Tạo Voice Tùy Chỉnh Nhanh (Mặc định ẩn, bật lên khi bấm Tạo voice mới) -->
        <form class="soft-card voice-generate-card" id="addVoiceCard" asp-action="GenerateVoiceFromText" method="post" style="display:none;">
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="voice-card-header">
                <div style="display:flex; align-items:center; gap:10px;">
                    <span class="material-symbols-outlined header-icon">add_circle</span>
                    <div>
                        <h2 class="card-title">Thêm Voice Song Ngữ Mới (Việt – Anh)</h2>
                        <p class="card-subtitle">Nhập câu Tiếng Việt và tùy chỉnh câu Tiếng Anh (nếu để trống hệ thống sẽ tự động dịch chuẩn).</p>
                    </div>
                </div>
                <button type="button" class="close-card-btn" id="closeAddVoiceBtn" title="Đóng form">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="voice-form-rows">
                <!-- Hàng 1: Tiếng Việt (50%) & Tiếng Anh (50%) dạng textarea rộng rãi -->
                <div class="form-row-two-col">
                    <div class="form-field-wrap">
                        <label for="voiceText">Nội dung Tiếng Việt *</label>
                        <textarea id="voiceText" name="text" class="form-control voice-textarea" rows="3" maxlength="1000" placeholder="Ví dụ: Con hãy chọn đáp án đúng" required></textarea>
                    </div>
                    <div class="form-field-wrap">
                        <label for="voiceTextEn">Bản dịch Tiếng Anh (Tùy chỉnh)</label>
                        <textarea id="voiceTextEn" name="textEn" class="form-control voice-textarea" rows="3" maxlength="1000" placeholder="Ví dụ: Please choose the correct answer (để trống để tự động dịch)"></textarea>
                    </div>
                </div>

                <!-- Hàng 2: Tên kiểm soát + Loại voice + Nút bấm tạo voice cùng 1 hàng -->
                <div class="form-row-three-col">
                    <div class="form-field-wrap">
                        <label for="voiceName">Tên kiểm soát</label>
                        <input id="voiceName" name="name" class="form-control" maxlength="200" placeholder="Ví dụ: Lời nhắc mở đầu" />
                    </div>
                    <div class="form-field-wrap">
                        <label for="voiceUsageType">Loại voice</label>
                        <select id="voiceUsageType" name="usageType" class="form-control">
                            <option value="title">Tiêu đề</option>
                            <option value="instruction">Hướng dẫn</option>
                            <option value="question">Câu hỏi</option>
                            <option value="content">Nội dung</option>
                            <option value="option">Đáp án</option>
                            <option value="correct-feedback">Phản hồi đúng</option>
                            <option value="retry-feedback">Phản hồi sai</option>
                            <option value="tracing-prompt">Tô nét</option>
                            <option value="custom" selected>Tự tạo</option>
                            <option value="legacy">Voice cũ</option>
                        </select>
                    </div>
                    <div class="form-field-wrap btn-wrap">
                        <label class="invisible-label">&nbsp;</label>
                        <button class="app-btn app-btn-small" type="submit">
                            <span class="material-symbols-outlined">record_voice_over</span>
                            Tạo voice song ngữ
                        </button>
                    </div>
                </div>
            </div>
        </form>

        <!-- Bộ Lọc & Tìm Kiếm Voice -->
        <form class="soft-card admin-filter voice-filter" asp-action="VoiceCache" method="get">
            <input type="hidden" name="pageSize" value="@pageSize" />
            <div class="filter-field">
                <label for="q">Tìm kiếm</label>
                <input id="q" name="q" class="form-control" value="@keyword" placeholder="Nhập câu tiếng Việt hoặc tiếng Anh..." />
            </div>
            <div class="filter-field">
                <label for="status">Trạng thái</label>
                <select id="status" name="status" class="form-control">
                    <option value="">Tất cả trạng thái</option>
                    <option value="missing" selected="@(currentStatus == "missing")">Thiếu file (VI hoặc EN)</option>
                    <option value="missing-en" selected="@(currentStatus == "missing-en")">Thiếu Voice Tiếng Anh (EN)</option>
                    <option value="missing-vi" selected="@(currentStatus == "missing-vi")">Thiếu Voice Tiếng Việt (VI)</option>
                    <option value="missing-both" selected="@(currentStatus == "missing-both")">Thiếu cả 2 file (VI & EN)</option>
                    <option value="ready" selected="@(currentStatus == "ready")">Đầy đủ cả 2 file (VI & EN)</option>
                    <option value="failed" selected="@(currentStatus == "failed")">Bị lỗi khi sinh file</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="usageType">Loại voice</label>
                <select id="usageType" name="usageType" class="form-control">
                    <option value="">Tất cả loại voice</option>
                    @foreach (var type in usageTypes)
                    {
                        <option value="@type" selected="@(currentUsageType == type)">@DisplayUsageType(type)</option>
                    }
                </select>
            </div>
            <div class="filter-actions-group">
                <button class="app-btn app-btn-small" type="submit">
                    <span class="material-symbols-outlined">filter_alt</span>
                    Lọc
                </button>
                <a class="app-btn app-btn-muted app-btn-small" asp-action="VoiceCache">Xóa lọc</a>
            </div>
        </form>

        <!-- Bảng Danh Sách Voice Song Ngữ -->
        <div class="soft-card report-panel mt-4 voice-cache-panel">
            <table class="app-table voice-cache-table">
                <thead>
                <tr>
                    <th style="width:36%;">Nội dung Tiếng Việt & Voice VI</th>
                    <th style="width:36%;">Bản dịch Tiếng Anh & Voice EN</th>
                    <th style="width:10%;">Loại</th>
                    <th style="width:12%;">Trạng thái</th>
                    <th style="width:6%; text-align:center;">Thao tác</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var hasVi = !string.IsNullOrWhiteSpace(item.AudioUrl) && item.Status == "ready";
                    var hasEn = !string.IsNullOrWhiteSpace(item.AudioUrlEn) && item.StatusEn == "ready";
                    <tr>
                        <td class="voice-main-cell">
                            <strong class="voice-title-label">@item.Name</strong>
                            <p class="voice-text-content">@(string.IsNullOrWhiteSpace(item.OriginalText) ? item.NormalizedText : item.OriginalText)</p>
                            @if (hasVi)
                            {
                                <div class="voice-audio-wrap">
                                    <audio controls preload="none" src="@item.AudioUrl" class="voice-audio-player"></audio>
                                </div>
                            }
                            else
                            {
                                <span class="badge-voice-status badge-voice-missing">Chưa có Voice VI</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.LastError))
                            {
                                <small class="text-danger-msg">@item.LastError</small>
                            }
                        </td>
                        <td class="voice-main-cell">
                            <span class="badge-voice-en">🇬🇧 English</span>
                            <p class="voice-text-en">@(string.IsNullOrWhiteSpace(item.TextEn) ? "Chưa có bản dịch" : item.TextEn)</p>
                            @if (hasEn)
                            {
                                <div class="voice-audio-wrap">
                                    <audio controls preload="none" src="@item.AudioUrlEn" class="voice-audio-player"></audio>
                                </div>
                            }
                            else
                            {
                                <span class="badge-voice-status badge-voice-missing">Chưa có Voice EN</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.LastErrorEn))
                            {
                                <small class="text-danger-msg">@item.LastErrorEn</small>
                            }
                        </td>
                        <td>
                            <span class="badge-voice-type">@DisplayUsageType(item.UsageType)</span>
                        </td>
                        <td>
                            @if (hasVi && hasEn)
                            {
                                <span class="status-chip status-published" title="Đã có đủ cả Voice VI và EN">Đủ VI & EN</span>
                            }
                            else if (hasVi && !hasEn)
                            {
                                <span class="status-chip status-review" title="Đã có Voice VI, đang thiếu Voice EN">Thiếu Voice EN</span>
                            }
                            else if (!hasVi && hasEn)
                            {
                                <span class="status-chip status-review" title="Đã có Voice EN, đang thiếu Voice VI">Thiếu Voice VI</span>
                            }
                            else
                            {
                                <span class="status-chip status-draft" title="Chưa có file nào">Thiếu cả 2</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <div style="display:inline-flex; align-items:center; gap:6px;">
                                <button type="button" class="mini-edit-btn" title="Chỉnh sửa voice này"
                                        data-edit-voice-btn
                                        data-id="@item.Id"
                                        data-name="@item.Name"
                                        data-text="@(string.IsNullOrWhiteSpace(item.OriginalText) ? item.NormalizedText : item.OriginalText)"
                                        data-text-en="@item.TextEn"
                                        data-usage-type="@item.UsageType">
                                    <span class="material-symbols-outlined">edit</span>
                                </button>
                                <form asp-action="DeleteVoiceCache" asp-route-id="@item.Id" method="post" data-confirm-delete data-confirm-message="Xóa mục voice này khỏi thư viện?">
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button class="mini-danger-btn" type="submit" title="Xóa voice này">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-cell">Không tìm thấy mục voice nào phù hợp với bộ lọc.</td>
                    </tr>
                }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <div class="pagination-bar mt-4">
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <a class="page-num @(p == currentPage ? "active" : "")"
                           asp-action="VoiceCache"
                           asp-route-page="@p"
                           asp-route-pageSize="@pageSize"
                           asp-route-q="@keyword"
                           asp-route-status="@currentStatus"
                           asp-route-usageType="@currentUsageType">@p</a>
                    }
                </div>
            }
        </div>
    </main>
</section>

<!-- Modal Chỉnh Sửa Voice Song Ngữ (Rộng rãi 880px, Textarea đầy đủ) -->
<div class="voice-edit-modal-backdrop" id="editVoiceModal" style="display:none;">
    <div class="voice-edit-modal-box">
        <div class="voice-card-header">
            <div style="display:flex; align-items:center; gap:10px;">
                <span class="material-symbols-outlined header-icon" style="color:var(--primary);">edit</span>
                <div>
                    <h2 class="card-title">Chỉnh Sửa Voice Song Ngữ</h2>
                    <p class="card-subtitle">Cập nhật nội dung Tiếng Việt, câu Tiếng Anh hoặc sinh lại âm thanh.</p>
                </div>
            </div>
            <button type="button" class="close-card-btn" id="closeEditModalBtn" title="Đóng">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form id="editVoiceForm" method="post" action="">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="voice-form-rows">
                <div class="form-row-two-col">
                    <div class="form-field-wrap">
                        <label for="editVoiceText">Nội dung Tiếng Việt *</label>
                        <textarea id="editVoiceText" name="text" class="form-control voice-textarea" rows="3" maxlength="1000" required></textarea>
                    </div>
                    <div class="form-field-wrap">
                        <label for="editVoiceTextEn">Bản dịch Tiếng Anh</label>
                        <textarea id="editVoiceTextEn" name="textEn" class="form-control voice-textarea" rows="3" maxlength="1000" placeholder="Để trống để tự động dịch lại"></textarea>
                    </div>
                </div>

                <div class="form-row-two-col">
                    <div class="form-field-wrap">
                        <label for="editVoiceName">Tên kiểm soát</label>
                        <input id="editVoiceName" name="name" class="form-control" maxlength="200" />
                    </div>
                    <div class="form-field-wrap">
                        <label for="editVoiceUsageType">Loại voice</label>
                        <select id="editVoiceUsageType" name="usageType" class="form-control">
                            <option value="title">Tiêu đề</option>
                            <option value="instruction">Hướng dẫn</option>
                            <option value="question">Câu hỏi</option>
                            <option value="content">Nội dung</option>
                            <option value="option">Đáp án</option>
                            <option value="correct-feedback">Phản hồi đúng</option>
                            <option value="retry-feedback">Phản hồi sai</option>
                            <option value="tracing-prompt">Tô nét</option>
                            <option value="custom">Tự tạo</option>
                            <option value="legacy">Voice cũ</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer-actions">
                    <label class="check-row" style="font-weight:700; color:#c2410c; margin:0; font-size:0.88rem; cursor:pointer;">
                        <input type="checkbox" name="regenerateVoice" value="true" checked />
                        Tự động sinh lại file âm thanh (VI & EN) sau khi lưu
                    </label>
                    <div style="display:flex; gap:8px;">
                        <button type="button" class="app-btn app-btn-muted app-btn-small" id="cancelEditModalBtn">Hủy</button>
                        <button type="submit" class="app-btn app-btn-small">
                            <span class="material-symbols-outlined">save</span>
                            Lưu thay đổi
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Toggle Create Form
        const toggleBtn = document.getElementById("toggleAddVoiceBtn");
        const addCard = document.getElementById("addVoiceCard");
        const closeBtn = document.getElementById("closeAddVoiceBtn");

        if (toggleBtn && addCard) {
            toggleBtn.addEventListener("click", function() {
                const isHidden = addCard.style.display === "none";
                addCard.style.display = isHidden ? "block" : "none";
                if (isHidden) {
                    document.getElementById("voiceText")?.focus();
                }
            });
        }

        if (closeBtn && addCard) {
            closeBtn.addEventListener("click", function() {
                addCard.style.display = "none";
            });
        }

        // Edit Voice Modal
        const editModal = document.getElementById("editVoiceModal");
        const editForm = document.getElementById("editVoiceForm");
        const closeEditBtn = document.getElementById("closeEditModalBtn");
        const cancelEditBtn = document.getElementById("cancelEditModalBtn");

        const editText = document.getElementById("editVoiceText");
        const editTextEn = document.getElementById("editVoiceTextEn");
        const editName = document.getElementById("editVoiceName");
        const editUsage = document.getElementById("editVoiceUsageType");

        document.querySelectorAll("[data-edit-voice-btn]").forEach(function(btn) {
            btn.addEventListener("click", function() {
                const id = btn.getAttribute("data-id");
                const name = btn.getAttribute("data-name") || "";
                const text = btn.getAttribute("data-text") || "";
                const textEn = btn.getAttribute("data-text-en") || "";
                const usage = btn.getAttribute("data-usage-type") || "custom";

                editForm.action = "/admin/voice-cache/" + id + "/update";
                if (editText) editText.value = text;
                if (editTextEn) editTextEn.value = textEn;
                if (editName) editName.value = name;
                if (editUsage) editUsage.value = usage;

                editModal.style.display = "flex";
                editText?.focus();
            });
        });

        const closeEdit = function() {
            editModal.style.display = "none";
        };

        if (closeEditBtn) closeEditBtn.addEventListener("click", closeEdit);
        if (cancelEditBtn) cancelEditBtn.addEventListener("click", closeEdit);
        if (editModal) {
            editModal.addEventListener("click", function(e) {
                if (e.target === editModal) closeEdit();
            });
        }
    });
</script>
