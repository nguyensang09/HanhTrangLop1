@model HomeIndexViewModel
@{
    ViewData["Title"] = "Sóc Nâu Đồng Hành - Hành Trang Vào Lớp 1 Cho Bé 5 Tuổi";
    var isParentSignedIn = User.Identity?.IsAuthenticated == true;
}

<div class="en en--home">
    <div class="en-sky" aria-hidden="true">
        <span class="en-cloud en-cloud--1"></span><span class="en-cloud en-cloud--2"></span><span class="en-cloud en-cloud--3"></span>
    </div>

    <!-- ==================== MỞ ĐẦU ==================== -->
    <section class="en-hero">
        <div class="en-hero-copy">
            <span class="en-eyebrow"><span aria-hidden="true">🎒</span> Hành trang vào lớp 1 cho bé 5–6 tuổi</span>
            <h1 class="en-title">Khởi đầu tự tin cùng <span class="en-hl">Sóc Nâu</span> chinh phục lớp 1!</h1>
            <p class="en-lead">
                Luyện nét chữ, nhận biết 29 chữ cái, đếm số 0–20, nghe song ngữ và rèn kỹ năng sống —
                <strong>chỉ 15 phút mỗi ngày, học mà chơi, không áp lực.</strong>
            </p>

            <div class="en-hero-actions">
                <a class="en-btn en-btn--primary en-btn--xl" asp-controller="Kids" asp-action="Home" title="Bắt đầu học ngay">
                    <span class="en-btn-orb" aria-hidden="true">🐿️</span>
                    <span class="en-btn-text">
                        <strong>Vào góc học của bé</strong>
                        <small>Bản đồ phiêu lưu &amp; bài học vui nhộn</small>
                    </span>
                    <span class="material-symbols-outlined en-btn-go" aria-hidden="true">play_arrow</span>
                </a>
                <div class="en-hero-sub">
                    <a class="en-btn en-btn--ghost" asp-controller="Profiles" asp-action="Index" title="Chọn hoặc đổi bé đang học">
                        <span class="material-symbols-outlined" aria-hidden="true">face_6</span>
                        <span>Chọn bé</span>
                    </a>
                    <a class="en-btn en-btn--ghost" asp-controller="Parent" asp-action="Dashboard" title="Dành cho ba mẹ theo dõi con">
                        <span class="material-symbols-outlined" aria-hidden="true">family_restroom</span>
                        <span>Góc phụ huynh</span>
                    </a>
                </div>
            </div>

            <ul class="en-trust">
                <li><span class="material-symbols-outlined" aria-hidden="true">verified</span>Chuẩn kiến thức vào lớp 1</li>
                <li><span class="material-symbols-outlined" aria-hidden="true">timer</span>15 phút mỗi ngày</li>
                <li><span class="material-symbols-outlined" aria-hidden="true">shield</span>Không quảng cáo</li>
            </ul>
        </div>

        <div class="en-stage">
            <span class="en-buddy en-buddy--1" aria-hidden="true"><img src="~/images/decorations/dinosaur.svg" alt="" /></span>
            <span class="en-buddy en-buddy--2" aria-hidden="true"><img src="~/images/decorations/rocket.svg" alt="" /></span>
            <span class="en-buddy en-buddy--3" aria-hidden="true"><img src="~/images/decorations/robot.svg" alt="" /></span>
            <span class="en-buddy en-buddy--4" aria-hidden="true"><img src="~/images/decorations/cute-car.svg" alt="" /></span>
            <img src="~/images/soc-nau-mascot.png" alt="Sóc Nâu" class="en-stage-mascot" />
            <p class="en-bubble">Chào bạn nhỏ! Hôm nay mình tô chữ, đếm số hay đi thám hiểm bản đồ nào?</p>
        </div>
    </section>

    <!-- ==================== DÀNH CHO BA MẸ ==================== -->
    <section class="en-card en-parent-strip" aria-labelledby="enParentStripTitle">
        <span class="en-parent-strip-icon" aria-hidden="true"><span class="material-symbols-outlined">family_restroom</span></span>
        @if (isParentSignedIn)
        {
            <div>
                <h2 id="enParentStripTitle">Chào ba mẹ <span class="en-hl">@(User.Identity?.Name)</span>!</h2>
                <p>Xem tiến độ của bé trong Góc phụ huynh, hoặc chọn bạn nhỏ sẽ học hôm nay.</p>
            </div>
            <div class="en-parent-strip-actions">
                <a class="en-btn en-btn--violet" asp-controller="Parent" asp-action="Dashboard">
                    <span class="material-symbols-outlined" aria-hidden="true">insights</span>
                    <span>Xem tiến độ</span>
                </a>
                <a class="en-btn en-btn--ghost" asp-controller="Profiles" asp-action="Index">
                    <span class="material-symbols-outlined" aria-hidden="true">sync_alt</span>
                    <span>Đổi bé</span>
                </a>
            </div>
        }
        else
        {
            <div>
                <h2 id="enParentStripTitle">Ba mẹ đã có tài khoản chưa?</h2>
                <p>Đăng nhập để lưu tiến độ, huy hiệu và chỉnh thời lượng học cho từng bé. Đăng ký miễn phí.</p>
            </div>
            <div class="en-parent-strip-actions">
                <a class="en-btn en-btn--violet" asp-controller="Parent" asp-action="Login">
                    <span class="material-symbols-outlined" aria-hidden="true">login</span>
                    <span>Đăng nhập</span>
                </a>
                <a class="en-btn en-btn--ghost" asp-controller="Parent" asp-action="Register">
                    <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
                    <span>Đăng ký</span>
                </a>
            </div>
        }
    </section>

    <!-- ==================== BẮT ĐẦU THẾ NÀO ==================== -->
    <section class="en-section" aria-labelledby="enStepsTitle">
        <div class="en-section-head">
            <span class="en-eyebrow"><span aria-hidden="true">🗺️</span> Học theo bản đồ phiêu lưu</span>
            <h2 id="enStepsTitle">Ba bước nhỏ mỗi ngày</h2>
        </div>
        <ol class="en-steps">
            <li class="en-card en-step">
                <span class="en-step-num" aria-hidden="true">1</span>
                <span><strong>Chọn bé</strong><span>Mỗi bạn nhỏ có hồ sơ và lộ trình riêng.</span></span>
            </li>
            <li class="en-card en-step">
                <span class="en-step-num" aria-hidden="true">2</span>
                <span><strong>Học từng trạm</strong><span>Bài ngắn, vui, tự động lưu tiến độ.</span></span>
            </li>
            <li class="en-card en-step">
                <span class="en-step-num" aria-hidden="true">3</span>
                <span><strong>Nhận sao &amp; huy hiệu</strong><span>Mở rương báu, về đích lâu đài tri thức.</span></span>
            </li>
        </ol>
    </section>

    <!-- ==================== 4 NHÓM KỸ NĂNG ==================== -->
    <section class="en-section" aria-labelledby="enSkillsTitle">
        <div class="en-section-head">
            <span class="en-eyebrow"><span aria-hidden="true">📚</span> Lộ trình chuẩn mầm non 5 tuổi</span>
            <h2 id="enSkillsTitle">4 nhóm kỹ năng cốt lõi</h2>
            <p>Sắp xếp khoa học từ dễ đến nâng cao, học mà chơi cực kỳ hào hứng.</p>
        </div>
        <div class="en-skill-grid">
            <a class="en-card en-skill" asp-controller="Kids" asp-action="Tracing">
                <span class="en-skill-icon" aria-hidden="true"><span class="material-symbols-outlined">draw</span></span>
                <h3>Nét viết &amp; 29 chữ cái</h3>
                <p>Bảng tô cảm ứng: tập các nét cơ bản, chữ in hoa, in thường và âm vần tiếng Việt.</p>
                <span class="en-skill-go">Vào phòng tập tô <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></span>
            </a>
            <a class="en-card en-skill en-skill--violet" asp-controller="Kids" asp-action="Home">
                <span class="en-skill-icon" aria-hidden="true"><span class="material-symbols-outlined">calculate</span></span>
                <h3>Số 0–20 &amp; toán trực quan</h3>
                <p>Đếm qua hình ảnh, so sánh nhiều – ít, làm quen phép cộng trừ trong phạm vi 10.</p>
                <span class="en-skill-go">Khám phá toán vui <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></span>
            </a>
            <a class="en-card en-skill en-skill--sky" asp-controller="Kids" asp-action="BilingualListen">
                <span class="en-skill-icon" aria-hidden="true"><span class="material-symbols-outlined">record_voice_over</span></span>
                <h3>Nghe song ngữ Việt – Anh</h3>
                <p>Thẻ âm thanh với giọng đọc chuẩn giúp bé phát triển thính giác ngôn ngữ tự nhiên.</p>
                <span class="en-skill-go">Góc nghe song ngữ <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></span>
            </a>
            <a class="en-card en-skill en-skill--good" asp-controller="Kids" asp-action="Home">
                <span class="en-skill-icon" aria-hidden="true"><span class="material-symbols-outlined">volunteer_activism</span></span>
                <h3>Kỹ năng sống &amp; tự lập</h3>
                <p>Rửa tay, xếp balo, an toàn giao thông, lễ phép và tự tin khi đến trường.</p>
                <span class="en-skill-go">Học kỹ năng sống <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></span>
            </a>
        </div>
    </section>

    <!-- ==================== SỐ LIỆU ==================== -->
    <section class="en-section en-stats" aria-label="Số liệu nổi bật">
        <div class="en-card en-stat">
            <span class="material-symbols-outlined" aria-hidden="true">category</span>
            <strong>@Model.SkillGroupCount</strong>
            <span>Nhóm kỹ năng</span>
        </div>
        <div class="en-card en-stat">
            <span class="material-symbols-outlined" aria-hidden="true">auto_stories</span>
            <strong>@Model.PublishedItemCount</strong>
            <span>Bài học &amp; trò chơi</span>
        </div>
        <div class="en-card en-stat">
            <span class="material-symbols-outlined" aria-hidden="true">child_care</span>
            <strong>@Model.ChildProfileCount</strong>
            <span>Bạn nhỏ đang tiến bộ</span>
        </div>
        <div class="en-card en-stat">
            <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
            <strong>100%</strong>
            <span>An toàn, không quảng cáo</span>
        </div>
    </section>

    <!-- ==================== BA MẸ YÊN TÂM ==================== -->
    <section class="en-section" aria-labelledby="enTrustTitle">
        <div class="en-section-head">
            <span class="en-eyebrow"><span aria-hidden="true">👨‍👩‍👧</span> Dành cho phụ huynh</span>
            <h2 id="enTrustTitle">Đồng hành nhẹ nhàng – con tự tin từng bước</h2>
        </div>
        <div class="en-trust-grid">
            <div class="en-card en-trust-card">
                <span class="en-skill-icon" aria-hidden="true"><span class="material-symbols-outlined">lock</span></span>
                <h3>Cổng bảo vệ phụ huynh</h3>
                <p>Khóa an toàn bằng phép tính nhỏ, giúp bé không vô tình vào phần cài đặt của ba mẹ.</p>
            </div>
            <div class="en-card en-trust-card">
                <span class="en-skill-icon" aria-hidden="true"><span class="material-symbols-outlined">insights</span></span>
                <h3>Báo cáo tiến độ rõ ràng</h3>
                <p>Biết chữ nào con đã nhớ, nét nào tô khéo và kỹ năng nào cần luyện thêm.</p>
            </div>
            <div class="en-card en-trust-card">
                <span class="en-skill-icon" aria-hidden="true"><span class="material-symbols-outlined">touch_app</span></span>
                <h3>Giao diện chuẩn trẻ em</h3>
                <p>Nút to dễ chạm, màu sắc tươi vui, lời khích lệ giúp con hào hứng tự giác.</p>
            </div>
        </div>
    </section>

    <!-- ==================== LỜI MỜI CUỐI TRANG ==================== -->
    <section class="en-cta">
        <img src="~/images/soc-nau-mascot.png" alt="" />
        <div>
            <h2>Cùng bé chuẩn bị hành trang vào lớp 1 ngay hôm nay!</h2>
            <p>Học vui, nhớ lâu, tự tin bước vào ngôi trường mới cùng Sóc Nâu và những người bạn.</p>
            <div class="en-cta-actions">
                <a class="en-btn en-btn--primary" asp-controller="Kids" asp-action="Home">
                    <span class="material-symbols-outlined" aria-hidden="true">play_arrow</span>
                    <span>Bắt đầu học cùng bé</span>
                </a>
                <a class="en-btn en-btn--ghost" asp-controller="Parent" asp-action="Dashboard">
                    <span class="material-symbols-outlined" aria-hidden="true">family_restroom</span>
                    <span>Góc phụ huynh</span>
                </a>
            </div>
        </div>
    </section>
</div>
