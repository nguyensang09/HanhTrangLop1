@model HanhTrangLop1.Models.ChildProfile
@{
    ViewData["Title"] = "Góc Nghe Song Ngữ Anh - Việt";

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    var letters = HanhTrangLop1.Application.Voice.BilingualListenCatalog.Letters;

    var numbers = HanhTrangLop1.Application.Voice.BilingualListenCatalog.Numbers;

    var totalItems = letters.Length + numbers.Length;
    var childName = string.IsNullOrWhiteSpace(Model.Nickname) ? "Con" : Model.Nickname.Trim();
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/kid-hub.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/kid-extras.css" asp-append-version="true" />

<div class="kh kx-listen kh--with-dock">
    @* Lớp bilingual-listen-screen + data-child-id: bilingual-listen.js đọc mã bé; site.js + site.css mở cuộn tự do. *@
    <span class="kh-scroll-marker bilingual-listen-screen" data-child-id="@Model.Id" aria-hidden="true"></span>

    <div class="kh-sky" aria-hidden="true">
        <span class="kh-cloud kh-cloud--1"></span>
        <span class="kh-cloud kh-cloud--2"></span>
        <span class="kh-cloud kh-cloud--3"></span>
        <span class="kh-float kh-float--1">🎧</span>
        <span class="kh-float kh-float--2">🔤</span>
        <span class="kh-float kh-float--3">🎵</span>
        <span class="kh-float kh-float--4">🔢</span>
    </div>

    <header class="kh-topbar">
        <a class="kh-pill" asp-controller="Kids" asp-action="Home" title="Về trang chủ" aria-label="Trang chủ">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span><span class="kh-hide-sm">Trang chủ</span>
        </a>
        <a class="kh-avatar" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bé khác" aria-label="Đổi bé khác">
            <img src="@ResolveAvatar(Model.AvatarKey)" alt="Ảnh bé" />
            <span class="kh-avatar-badge material-symbols-outlined" aria-hidden="true">sync_alt</span>
        </a>
        <div class="kh-brand">
            <span class="kh-brand-mark" aria-hidden="true">🎧</span>
            <span class="kh-brand-text">
                <small>Âm thanh song ngữ</small>
                <strong>Bé Nghe Tiếng Anh</strong>
            </span>
        </div>
        <div class="kh-pill kh-pill--stars kx-counter" id="bilingualCounterPill" title="Số thẻ bé đã nghe">
            <span aria-hidden="true">⭐</span><strong id="counterText">0/@totalItems</strong><small class="kh-hide-sm">đã nghe</small>
        </div>
        <button type="button" class="kh-pill kh-pill--lock" onclick="openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh" aria-label="Góc phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span><span class="kh-hide-sm">Ba mẹ</span>
        </button>
    </header>

    <!-- Sóc Nâu hướng dẫn + bảng điều khiển nghe -->
    <section class="kh-hero">
        <div class="kh-guide">
            <img class="kh-guide-img" src="~/images/mascot-squirrel-3d.png" alt="Sóc Nâu" />
            <p class="kh-bubble">@childName ơi, chạm vào một thẻ để nghe cô đọc nhé! 🎧</p>
        </div>
        <div class="kh-hero-card kx-listen-controls">
            <div class="kx-control-row">
                <span class="kx-control-label">Cô đọc</span>
                <div class="kx-seg" role="group" aria-label="Chế độ phát âm">
                    <button type="button" class="kx-seg-btn read-mode-btn active" data-mode="en_only" title="Chỉ đọc tiếng Anh: chữ – từ (ví dụ: A – Apple)">
                        <span class="kx-seg-emoji" aria-hidden="true">🔤</span>
                        <span>Tiếng Anh</span>
                    </button>
                    <button type="button" class="kx-seg-btn read-mode-btn" data-mode="bilingual" title="Đọc song ngữ Anh – Việt đầy đủ">
                        <span class="kx-seg-emoji" aria-hidden="true">🌐</span>
                        <span>Anh – Việt</span>
                    </button>
                </div>
            </div>
            <div class="kx-control-row">
                <span class="kx-control-label">Tốc độ</span>
                <div class="kx-seg" role="group" aria-label="Tốc độ đọc">
                    <button type="button" class="kx-seg-btn speed-toggle-btn active" data-speed="normal" title="Tốc độ nghe bình thường">
                        <span class="kx-seg-emoji" aria-hidden="true">🐇</span>
                        <span>Vừa</span>
                    </button>
                    <button type="button" class="kx-seg-btn speed-toggle-btn" data-speed="slow" title="Đọc chậm từng âm">
                        <span class="kx-seg-emoji" aria-hidden="true">🐢</span>
                        <span>Chậm</span>
                    </button>
                </div>
            </div>
            <button type="button" class="kh-big-btn kh-big-btn--violet kx-tour-btn" id="autoplayTourBtn" title="Tự động phát lần lượt các thẻ">
                <span class="material-symbols-outlined tour-icon" aria-hidden="true">play_circle</span>
                <span class="tour-label">Tự động phát</span>
            </button>
        </div>
    </section>

    <!-- Thẻ lọc (giữ lớp bilingual-tab-btn + data-tab cho script) -->
    <nav class="kh-tabs kx-tabs" role="tablist" aria-label="Chọn nhóm thẻ">
        <button type="button" class="kh-tab kx-tab bilingual-tab-btn active" data-tab="all" role="tab" aria-selected="true">
            <span class="kx-tab-emoji" aria-hidden="true">🌟</span>
            <span>Tất cả</span>
            <span class="kx-tab-count">@totalItems</span>
        </button>
        <button type="button" class="kh-tab kx-tab bilingual-tab-btn" data-tab="letters" role="tab" aria-selected="false">
            <span class="kx-tab-emoji" aria-hidden="true">🔤</span>
            <span>Chữ cái A – Z</span>
            <span class="kx-tab-count">@letters.Length</span>
        </button>
        <button type="button" class="kh-tab kx-tab bilingual-tab-btn" data-tab="numbers" role="tab" aria-selected="false">
            <span class="kx-tab-emoji" aria-hidden="true">🔢</span>
            <span>Số 0 – 20</span>
            <span class="kx-tab-count">@numbers.Length</span>
        </button>
    </nav>

    <!-- Khu vực 1: Bảng chữ cái tiếng Anh -->
    <section class="kh-panel kx-listen-section kh-tone-coral" data-section="letters" aria-label="Bảng chữ cái tiếng Anh">
        <div class="kh-panel-head">
            <span class="kh-panel-emoji kx-panel-emoji" aria-hidden="true">🔤</span>
            <div class="kh-panel-title">
                <h2>Chữ cái tiếng Anh A – Z</h2>
                <p>Mỗi chữ có hình và một từ dễ nhớ</p>
            </div>
            <span class="kh-chip">@letters.Length thẻ</span>
        </div>

        <div class="kx-listen-grid">
            @for (var i = 0; i < letters.Length; i++)
            {
                var item = letters[i];
                <button class="kx-listen-card kx-@(item.ColorTheme)"
                        type="button"
                        data-listen-card
                        data-index="@i"
                        data-kind="letter"
                        data-symbol="@item.Symbol"
                        data-word="@item.Word"
                        data-phonetic="@item.Phonetic"
                        data-meaning="@item.MeaningVi"
                        data-emoji="@item.Emoji"
                        data-image="@item.Image"
                        data-example-en="@item.ExampleEn"
                        data-example-vi="@item.ExampleVi"
                        data-speak="@item.Symbol"
                        data-example-speak="@item.Word"
                        aria-label="Chữ cái @item.Symbol - @item.Word">
                    <span class="kx-listen-check" aria-hidden="true">✓</span>
                    <span class="kx-listen-symbol" aria-hidden="true">@item.Symbol</span>
                    <span class="kx-listen-thumb" aria-hidden="true">
                        <img src="@item.Image" alt="" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <span class="kx-listen-emoji">@item.Emoji</span>
                    </span>
                    <span class="kx-listen-word">@item.Word</span>
                    <span class="kx-listen-meaning">@item.MeaningVi</span>
                    <span class="card-audio-btn kx-listen-audio" aria-hidden="true">
                        <span class="material-symbols-outlined audio-icon">volume_up</span>
                        <span class="card-waves"><span></span><span></span><span></span></span>
                    </span>
                </button>
            }
        </div>
    </section>

    <!-- Khu vực 2: Chữ số 0 - 20 -->
    <section class="kh-panel kx-listen-section kh-tone-emerald" data-section="numbers" aria-label="Chữ số từ 0 đến 20">
        <div class="kh-panel-head">
            <span class="kh-panel-emoji kx-panel-emoji" aria-hidden="true">🔢</span>
            <div class="kh-panel-title">
                <h2>Đếm số tiếng Anh 0 – 20</h2>
                <p>Nghe và đếm theo cô thật vui</p>
            </div>
            <span class="kh-chip">@numbers.Length thẻ</span>
        </div>

        <div class="kx-listen-grid">
            @for (var i = 0; i < numbers.Length; i++)
            {
                var item = numbers[i];
                var globalIndex = letters.Length + i;
                <button class="kx-listen-card kx-@(item.ColorTheme)"
                        type="button"
                        data-listen-card
                        data-index="@globalIndex"
                        data-kind="number"
                        data-symbol="@item.Number"
                        data-word="@item.Name"
                        data-phonetic="@item.Phonetic"
                        data-meaning="@item.MeaningVi"
                        data-emoji="@item.Emoji"
                        data-image="@item.Image"
                        data-example-en="@item.ExampleEn"
                        data-example-vi="@item.ExampleVi"
                        data-speak="@item.Name"
                        data-example-speak="@item.ExampleEn"
                        aria-label="Số @item.Number - @item.Name">
                    <span class="kx-listen-check" aria-hidden="true">✓</span>
                    <span class="kx-listen-symbol" aria-hidden="true">@item.Number</span>
                    <span class="kx-listen-thumb" aria-hidden="true">
                        <img src="@item.Image" alt="" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <span class="kx-listen-emoji">@item.Emoji</span>
                    </span>
                    <span class="kx-listen-word">@item.Name</span>
                    <span class="kx-listen-meaning">@item.MeaningVi</span>
                    <span class="card-audio-btn kx-listen-audio" aria-hidden="true">
                        <span class="material-symbols-outlined audio-icon">volume_up</span>
                        <span class="card-waves"><span></span><span></span><span></span></span>
                    </span>
                </button>
            }
        </div>
    </section>

    <!-- Thanh điều hướng dưới của khu bé -->
    <nav class="kid-bottom-nav kh-dock" aria-label="Điều hướng">
        <a asp-controller="Kids" asp-action="Home">
            <span class="material-symbols-outlined" aria-hidden="true">home</span>
            <span>Trang chủ</span>
        </a>
        <a asp-controller="Kids" asp-action="Today">
            <span class="material-symbols-outlined" aria-hidden="true">map</span>
            <span>Bài tập</span>
        </a>
        <a asp-controller="Kids" asp-action="Rewards">
            <span class="material-symbols-outlined" aria-hidden="true">emoji_events</span>
            <span>Quà tặng</span>
        </a>
        <a href="#" onclick="openParentGate('/parent/dashboard'); return false;" title="Cổng mở khóa cho phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <span>Phụ huynh</span>
        </a>
    </nav>
</div>

<!-- Hộp thẻ to song ngữ (nằm ngoài .kh để giữ position: fixed) -->
<div class="kx-dialog" id="flashcardDialog" role="dialog" aria-modal="true" aria-labelledby="dialogSymbolTitle" hidden>
    <div class="kx-dialog-card">
        <button type="button" class="kx-dialog-close" id="dialogCloseBtn" aria-label="Đóng thẻ">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>

        <div class="kx-dialog-body">
            <div class="kx-dialog-art">
                <img src="/images/photos/flashcard-apple.jpg" alt="" id="dialogImage" class="kx-dialog-img" onerror="this.style.display='none';" />
                <span class="kx-dialog-emoji" id="dialogEmoji" aria-hidden="true">🍎</span>
            </div>

            <div class="kx-dialog-info">
                <span class="kx-dialog-cat" id="dialogCategoryBadge">Chữ cái A</span>
                <div class="kx-dialog-head">
                    <div class="kx-dialog-symbol" id="dialogSymbolTitle">A</div>
                    <div class="kx-dialog-wordbox">
                        <h3 class="kx-dialog-word" id="dialogWord">Apple</h3>
                        <div class="kx-dialog-chips">
                            <span class="kx-dialog-phonetic" id="dialogPhonetic">/ˈæp.əl/</span>
                            <span class="kx-dialog-meaning" id="dialogMeaning">Quả táo</span>
                        </div>
                    </div>
                </div>

                <div class="kx-dialog-example">
                    <p class="kx-dialog-example-vi" id="dialogExampleVi">Chữ A trong Quả táo. Quả táo đỏ thật ngọt lành.</p>
                    <p class="kx-dialog-example-en" id="dialogExampleEn">A is for Apple. An apple is sweet and red.</p>
                </div>

                <div class="kx-dialog-actions">
                    <button type="button" class="kx-dialog-btn kx-dialog-btn--main" id="dialogSpeakBilingualBtn" title="Nghe âm thanh thẻ">
                        <span class="material-symbols-outlined" aria-hidden="true">headphones</span>
                        <span class="kx-dialog-btn-text">
                            <strong id="dialogSpeakModeTitle">Chỉ Tiếng Anh</strong>
                            <small id="dialogSpeakModeSub">Chữ ➔ Từ ví dụ (A - Apple)</small>
                        </span>
                    </button>
                    <button type="button" class="kx-dialog-btn kx-dialog-btn--slow" id="dialogSpeakSlowBtn" title="Nghe chậm từ tiếng Anh">
                        <span class="kx-dialog-btn-emoji" aria-hidden="true">🐢</span>
                        <span class="kx-dialog-btn-text">
                            <strong>Nghe chậm</strong>
                            <small>Bé đọc theo cô</small>
                        </span>
                    </button>
                </div>
            </div>
        </div>

        <div class="kx-dialog-nav">
            <button type="button" class="kx-dialog-navbtn" id="dialogPrevBtn" aria-label="Thẻ trước">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
            </button>
            <span class="kx-dialog-progress" id="dialogProgressIndicator">Thẻ 1 / 47</span>
            <button type="button" class="kx-dialog-navbtn" id="dialogNextBtn" aria-label="Thẻ tiếp theo">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/bilingual-listen.js" asp-append-version="true"></script>
}
