@model HanhTrangLop1.Models.ChildProfile
@{
    ViewData["Title"] = "Góc Nghe Song Ngữ Anh - Việt";

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    var letters = new (string Symbol, string Word, string Phonetic, string MeaningVi, string Emoji, string ExampleEn, string ExampleVi, string Image, string ColorTheme)[]
    {
        ("A", "Apple", "ép-pồ", "Quả táo", "🍎", "A is for Apple. An apple is sweet and red.", "Chữ A trong Quả táo. Quả táo đỏ thật ngọt lành.", "/images/photos/flashcard-letter-a.jpg", "theme-coral"),
        ("B", "Ball", "bo-l", "Quả bóng", "⚽", "B is for Ball. Let's kick the ball together!", "Chữ B trong Quả bóng. Cùng bé đá bóng vui nào!", "/images/photos/flashcard-letter-b.jpg", "theme-cyan"),
        ("C", "Cat", "két", "Con mèo", "🐱", "C is for Cat. The cute cat says meow meow.", "Chữ C trong Con mèo. Chú mèo con kêu meo meo.", "/images/photos/flashcard-letter-c.jpg", "theme-amber"),
        ("D", "Doll", "đo-l", "Búp bê", "🪆", "D is for Doll. The pretty doll has a pink dress.", "Chữ D trong Búp bê. Em búp bê xinh mặc váy hồng.", "/images/photos/flashcard-letter-d.jpg", "theme-mint"),
        ("E", "Egg", "e-g", "Quả trứng", "🥚", "E is for Egg. A cute chick hatches from the egg.", "Chữ E trong Quả trứng. Chú gà con nở ra từ quả trứng.", "/images/photos/flashcard-letter-e.jpg", "theme-purple"),
        ("F", "Fan", "phen", "Chiếc quạt", "🌀", "F is for Fan. The electric fan blows cool breeze.", "Chữ F trong Chiếc quạt. Chiếc quạt quay mát lành cho bé.", "/images/photos/flashcard-letter-f.jpg", "theme-teal"),
        ("G", "Garden", "ga-đừn", "Khu vườn", "🏡", "G is for Garden. Beautiful flowers grow in our garden.", "Chữ G trong Khu vườn. Khu vườn rực rỡ muôn sắc hoa.", "/images/photos/flashcard-letter-g.jpg", "theme-pink"),
        ("H", "Hand", "hen-đ", "Bàn tay", "✋", "H is for Hand. Wave your little hand to say hello!", "Chữ H trong Bàn tay. Bé vẫy đôi bàn tay nhỏ xinh chào bạn.", "/images/photos/flashcard-letter-h.jpg", "theme-coral"),
        ("I", "Icicle", "ai-si-cồ", "Cột băng", "🧊", "I is for Icicle. Sparkling icicles hang from the roof.", "Chữ I trong Cột băng. Cột băng lấp lánh rủ bên hiên nhà.", "/images/photos/flashcard-letter-i.jpg", "theme-cyan"),
        ("J", "Jam", "gem", "Hũ mứt", "🍓", "J is for Jam. Sweet strawberry jam spread on bread.", "Chữ J trong Hũ mứt. Mứt dâu thơm ngọt phết lên bánh mì.", "/images/photos/flashcard-letter-j.jpg", "theme-amber"),
        ("K", "Kangaroo", "keng-gơ-ru", "Chuột túi", "🦘", "K is for Kangaroo. Kangaroo hops happily with her baby.", "Chữ K trong Chuột túi. Chuột túi nhảy nhót cõng con trong túi.", "/images/photos/flashcard-letter-k.jpg", "theme-mint"),
        ("L", "Lamb", "lem", "Cừu con", "🐑", "L is for Lamb. The fluffy lamb plays on green grass.", "Chữ L trong Cừu con. Chú cừu con lông trắng đùa trên cỏ non.", "/images/photos/flashcard-letter-l.jpg", "theme-purple"),
        ("M", "Mushroom", "mắt-rum", "Cây nấm", "🍄", "M is for Mushroom. Colorful mushrooms grow after rain.", "Chữ M trong Cây nấm. Những cây nấm xinh mọc lên sau mưa.", "/images/photos/flashcard-letter-m.jpg", "theme-teal"),
        ("N", "Net", "nét", "Khung lưới", "🥅", "N is for Net. The soccer ball goes into the net!", "Chữ N trong Khung lưới. Quả bóng lăn vào khung lưới gôn rồi!", "/images/photos/flashcard-letter-n.jpg", "theme-pink"),
        ("O", "Orange", "o-rin-d", "Quả cam", "🍊", "O is for Orange. Ripe orange is sweet, juicy and bright.", "Chữ O trong Quả cam. Quả cam tròn mọng nước bổ dưỡng.", "/images/photos/flashcard-letter-o.jpg", "theme-coral"),
        ("P", "Pet", "pét", "Thú cưng", "🐕", "P is for Pet. The friendly pet wags its tail happily.", "Chữ P trong Thú cưng. Bạn thú cưng ngoan ngoãn vẫy đuôi mừng bé.", "/images/photos/flashcard-letter-p.jpg", "theme-cyan"),
        ("Q", "Quilt", "cuyn-t", "Chiếc chăn", "🛏️", "Q is for Quilt. The warm quilt keeps baby cozy all night.", "Chữ Q trong Chiếc chăn. Chiếc chăn bông ấm áp giữ ấm cho bé ngủ ngoan.", "/images/photos/flashcard-letter-q.jpg", "theme-amber"),
        ("R", "Rain", "rên", "Cơn mưa", "🌧️", "R is for Rain. Pitter-patter falling rain waters all trees.", "Chữ R trong Cơn mưa. Mưa rơi tí tách tưới mát cỏ cây.", "/images/photos/flashcard-letter-r.jpg", "theme-mint"),
        ("S", "Sunflower", "săn-flao-ơ", "Hoa hướng dương", "🌻", "S is for Sunflower. Tall sunflower smiles toward the bright sun.", "Chữ S trong Hoa hướng dương. Bông hoa hướng dương rực rỡ đón ánh mặt trời.", "/images/photos/flashcard-letter-s.jpg", "theme-purple"),
        ("T", "Train", "trên", "Tàu hỏa", "🚂", "T is for Train. The colorful train goes choo-choo along the track.", "Chữ T trong Tàu hỏa. Đoàn tàu xình xịch bon bon trên đường ray.", "/images/photos/flashcard-letter-t.jpg", "theme-teal"),
        ("U", "Underwear", "ăn-đơ-we", "Quần áo nhỏ", "🩲", "U is for Underwear. Put on clean underwear every single day.", "Chữ U trong Quần áo nhỏ. Bé mặc quần áo sạch sẽ thơm tho mỗi ngày.", "/images/photos/flashcard-letter-u.jpg", "theme-pink"),
        ("V", "Vase", "va-z", "Bình hoa", "🏺", "V is for Vase. Fresh blooming flowers placed inside a ceramic vase.", "Chữ V trong Bình hoa. Bình hoa tươi thắm tô điểm góc phòng bé.", "/images/photos/flashcard-letter-v.jpg", "theme-coral"),
        ("W", "Wagon", "we-gừn", "Xe kéo nhỏ", "🛒", "W is for Wagon. Pull the little red wagon full of fun toys.", "Chữ W trong Xe kéo nhỏ. Chiếc xe kéo nhỏ chở đầy đồ chơi vui nhộn.", "/images/photos/flashcard-letter-w.jpg", "theme-cyan"),
        ("X", "X-ray", "ếch-s-rây", "Tia X-quang", "🩻", "X is for X-ray. Doctor takes an X-ray to see our healthy bones.", "Chữ X trong Tia X-quang. Bác sĩ chụp X-quang xem khung xương khỏe mạnh.", "/images/photos/flashcard-letter-x.jpg", "theme-amber"),
        ("Y", "Yo-yo", "dô-dô", "Đồ chơi Yo-yo", "🪀", "Y is for Yo-yo. Spin the yo-yo up and down so fast.", "Chữ Y trong Con quay yo-yo. Trò chơi khéo tay diệu kỳ.", "/images/photos/flashcard-letter-y.jpg", "theme-mint"),
        ("Z", "Zebra", "dép-bra", "Ngựa vằn", "🦓", "Z is for Zebra. A zebra looks wonderful with black and white stripes.", "Chữ Z trong Ngựa vằn. Chú ngựa vằn có bộ áo kẻ sọc thật độc đáo.", "/images/photos/flashcard-letter-z.jpg", "theme-purple")
    };

    var numbers = new (int Number, string Name, string Phonetic, string MeaningVi, string Emoji, string ExampleEn, string ExampleVi, string Image, string ColorTheme)[]
    {
        (0, "Zero", "di-rôu", "Số không", "⭕", "Number zero: Zero means none or empty basket.", "Số không: Nghĩa là chiếc giỏ chưa có quả nào cả.", "/images/photos/flashcard-number-0.svg", "theme-cyan"),
        (1, "One", "oăn", "Số một", "1️⃣", "Number one: One bright sun shining above.", "Số một: Một ông mặt trời chiếu sáng.", "/images/photos/flashcard-number-1.jpg", "theme-coral"),
        (2, "Two", "tu", "Số hai", "2️⃣", "Number two: Two cute little shoes on your feet.", "Số hai: Đôi giày xinh hai chiếc của bé.", "/images/photos/flashcard-number-2.jpg", "theme-amber"),
        (3, "Three", "th-ri", "Số ba", "3️⃣", "Number three: Three little cheerful birds on branch.", "Số ba: Ba chú chim hót líu lo trên cành.", "/images/photos/flashcard-number-3.jpg", "theme-mint"),
        (4, "Four", "pho", "Số bốn", "4️⃣", "Number four: A sturdy study table has four legs.", "Số bốn: Bốn chân bàn học vững chãi.", "/images/photos/flashcard-number-4.jpg", "theme-purple"),
        (5, "Five", "phai-v", "Số năm", "5️⃣", "Number five: Five little fingers on one tiny hand.", "Số năm: Năm ngón tay xinh xắn trên một bàn tay.", "/images/photos/flashcard-number-5.jpg", "theme-teal"),
        (6, "Six", "xích-s", "Số sáu", "6️⃣", "Number six: Six colorful crayons in the box.", "Số sáu: Sáu cây bút sáp tô màu rực rỡ.", "/images/photos/flashcard-number-6.jpg", "theme-pink"),
        (7, "Seven", "xe-vần", "Số bảy", "7️⃣", "Number seven: Seven lovely colors of the rainbow.", "Số bảy: Bảy sắc cầu vồng sau cơn mưa rào.", "/images/photos/flashcard-number-7.jpg", "theme-coral"),
        (8, "Eight", "ây-t", "Số tám", "8️⃣", "Number eight: An octopus swimming with eight arms.", "Số tám: Chú bạch tuộc có tám cái vòi linh hoạt.", "/images/photos/flashcard-number-8.jpg", "theme-cyan"),
        (9, "Nine", "nai-n", "Số chín", "9️⃣", "Number nine: Nine twinkling stars in the evening sky.", "Số chín: Chín ngôi sao lấp lánh trên bầu trời đêm.", "/images/photos/flashcard-number-9.jpg", "theme-amber"),
        (10, "Ten", "ten", "Số mười", "🔟", "Number ten: Ten little fingers on both hands clapping.", "Số mười: Mười ngón tay cùng vỗ tay khen ngợi bé.", "/images/photos/flashcard-number-10.jpg", "theme-mint"),
        (11, "Eleven", "i-le-vần", "Số mười một", "1️⃣1️⃣", "Number eleven: Ten plus one makes eleven.", "Số mười một: Mười thêm một bằng mười một.", "/images/photos/flashcard-number-11.jpg", "theme-purple"),
        (12, "Twelve", "th-queo-v", "Số mười hai", "1️⃣2️⃣", "Number twelve: A clock face has twelve numbers.", "Số mười hai: Mặt đồng hồ có mười hai số giờ.", "/images/photos/flashcard-number-12.jpg", "theme-teal"),
        (13, "Thirteen", "thơ-tin", "Số mười ba", "1️⃣3️⃣", "Number thirteen: Thirteen delicious sweet cupcakes.", "Số mười ba: Mười ba chiếc bánh ngọt thơm lừng.", "/images/photos/flashcard-number-13.jpg", "theme-pink"),
        (14, "Fourteen", "pho-tin", "Số mười bốn", "1️⃣4️⃣", "Number fourteen: Fourteen shiny wooden blocks.", "Số mười bốn: Mười bốn khối gỗ xếp hình.", "/images/photos/flashcard-number-14.jpg", "theme-coral"),
        (15, "Fifteen", "phíp-tin", "Số mười lăm", "1️⃣5️⃣", "Number fifteen: Fifteen happy learning minutes a day.", "Số mười lăm: Mười lăm phút học vui mỗi ngày cùng Sóc Nâu.", "/images/photos/flashcard-number-15.jpg", "theme-cyan"),
        (16, "Sixteen", "xích-s-tin", "Số mười sáu", "1️⃣6️⃣", "Number sixteen: Sixteen colorful glass marbles.", "Số mười sáu: Mười sáu viên bi tròn lấp lánh.", "/images/photos/flashcard-number-16.jpg", "theme-amber"),
        (17, "Seventeen", "xe-vần-tin", "Số mười bảy", "1️⃣7️⃣", "Number seventeen: Seventeen ripe red strawberries.", "Số mười bảy: Mười bảy quả dâu tây chín mọng.", "/images/photos/flashcard-number-17.jpg", "theme-mint"),
        (18, "Eighteen", "ây-tin", "Số mười tám", "1️⃣8️⃣", "Number eighteen: Eighteen blooming flowers in morning garden.", "Số mười tám: Mười tám bông hoa nở rộ trong vườn.", "/images/photos/flashcard-number-18.jpg", "theme-purple"),
        (19, "Nineteen", "nain-tin", "Số mười chín", "1️⃣9️⃣", "Number nineteen: Nineteen storybooks on the wooden bookshelf.", "Số mười chín: Mười chín cuốn truyện tranh trên giá sách.", "/images/photos/flashcard-number-19.jpg", "theme-teal"),
        (20, "Twenty", "th-goen-ti", "Số hai mươi", "2️⃣0️⃣", "Number twenty: Twenty shiny gold stars for your effort!", "Số hai mươi: Hai mươi ngôi sao vàng tặng bé chăm ngoan!", "/images/photos/flashcard-number-20.jpg", "theme-pink")
    };

    var totalItems = letters.Length + numbers.Length;
}

<section class="kid-screen bilingual-listen-screen" data-child-id="@Model.Id">
    <!-- Topbar Hồ Sơ Bé Chuẩn Claymorphism -->
    <div class="kid-topbar home-topbar clay-card bilingual-topbar">
        <div class="kid-header-profile">
            <a class="learning-back-btn clay-button" asp-controller="Kids" asp-action="Home" title="Về trang chủ">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div class="squirrel-avatar-wrap">
                <img src="@ResolveAvatar(Model.AvatarKey)" alt="Ảnh bé" class="squirrel-avatar" />
            </div>
            <div>
                <p class="eyebrow">Âm Thanh Song Ngữ 🎧</p>
                <h1>Bé @(Model.Nickname) Luyện Nghe 🌟</h1>
            </div>
        </div>
        <div class="kid-topbar-actions">
            <div class="star-pill clay-button bilingual-counter-pill" id="bilingualCounterPill" title="Tiến độ thẻ đã khám phá">
                <span class="material-symbols-outlined star-icon" style="font-variation-settings: 'FILL' 1; color: #f59e0b;">star</span>
                <span id="counterText">0/@totalItems đã nghe</span>
            </div>
            <button type="button" class="clay-button bilingual-tour-btn" id="autoplayTourBtn" title="Tự động phát lần lượt các thẻ">
                <span class="material-symbols-outlined tour-icon">play_circle</span>
                <span class="tour-label">Tự động phát</span>
            </button>
        </div>
    </div>

    <!-- Banner Khích Lệ Cùng Bạn Sóc Nâu -->
    <div class="bilingual-hero-banner clay-card">
        <div class="bilingual-hero-avatar">
            <img src="/images/mascot-squirrel-3d.png" alt="Sóc Nâu" class="hero-mascot-img" />
            <div class="sound-wave-badge" title="Đang sẵn sàng phát âm">
                <span class="material-symbols-outlined">graphic_eq</span>
            </div>
        </div>
        <div class="bilingual-hero-content">
            <div class="hero-badge-pill">
                <span class="material-symbols-outlined">record_voice_over</span>
                <span>Phát âm chuẩn tiếng Anh bản ngữ & Tiếng Việt</span>
            </div>
            <h2>Chạm thẻ để nghe đọc & xem tranh sinh động! ✨</h2>
            <p>Bé hãy chạm vào bất kỳ thẻ chữ cái hoặc chữ số nào bên dưới để nghe cách phát âm chuẩn, học từ vựng và câu ví dụ thú vị nhé!</p>
            
            <div class="hero-quick-tools">
                <!-- Tốc độ đọc -->
                <div class="speed-toggle-group" role="group" aria-label="Tốc độ đọc">
                    <span class="tool-label">Tốc độ:</span>
                    <button type="button" class="speed-toggle-btn clay-button active" data-speed="normal" title="Tốc độ nghe bình thường">
                        <span>⚡ Chuẩn</span>
                    </button>
                    <button type="button" class="speed-toggle-btn clay-button" data-speed="slow" title="Tốc độ đọc chậm từng âm">
                        <span>🐢 Rùa con (Chậm)</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh Lọc Tab & Tìm Kiếm Nhanh -->
    <div class="bilingual-controls-bar">
        <div class="bilingual-tab-bar" role="tablist">
            <button type="button" class="bilingual-tab-btn clay-button active" data-tab="all" role="tab" aria-selected="true">
                <span class="material-symbols-outlined">auto_awesome</span>
                <span>Tất cả</span>
                <span class="tab-badge">@totalItems</span>
            </button>
            <button type="button" class="bilingual-tab-btn clay-button" data-tab="letters" role="tab" aria-selected="false">
                <span class="material-symbols-outlined">spellcheck</span>
                <span>Chữ cái A - Z</span>
                <span class="tab-badge">@letters.Length</span>
            </button>
            <button type="button" class="bilingual-tab-btn clay-button" data-tab="numbers" role="tab" aria-selected="false">
                <span class="material-symbols-outlined">pin</span>
                <span>Chữ số 0 - 20</span>
                <span class="tab-badge">@numbers.Length</span>
            </button>
        </div>

        <div class="bilingual-search-box">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" id="bilingualSearchInput" placeholder="Tìm chữ, số hoặc từ..." aria-label="Tìm kiếm thẻ song ngữ" autocomplete="off" />
            <button type="button" id="clearSearchBtn" class="clear-search-btn" title="Xóa tìm kiếm" hidden>
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    </div>

    <!-- Thông báo khi tìm kiếm không có kết quả -->
    <div id="noResultsNotice" class="no-results-card clay-card" hidden>
        <span class="material-symbols-outlined notice-icon">search_off</span>
        <h3>Không tìm thấy thẻ nào phù hợp</h3>
        <p>Bé thử gõ chữ cái (A, B, C...) hoặc số (1, 2, 3...) xem sao nhé!</p>
        <button type="button" class="clay-button" id="resetSearchBtn">Xem tất cả thẻ</button>
    </div>

    <!-- Khu vực 1: Bảng Chữ Cái Tiếng Anh -->
    <div class="bilingual-section-group" data-section="letters">
        <div class="bilingual-section-header">
            <div class="section-title-wrap">
                <div class="section-icon-pill icon-coral">
                    <span class="material-symbols-outlined">menu_book</span>
                </div>
                <div>
                    <h2>Bảng Chữ Cái Tiếng Anh (A - Z)</h2>
                    <p>26 chữ cái kèm hình ảnh, từ vựng quen thuộc và phiên âm tiếng Việt dễ nhớ</p>
                </div>
            </div>
            <span class="section-count-badge">26 thẻ chữ</span>
        </div>

        <div class="bilingual-cards-grid">
            @for (var i = 0; i < letters.Length; i++)
            {
                var item = letters[i];
                <button class="bilingual-card letter-card @item.ColorTheme"
                        type="button"
                        data-listen-card
                        data-index="@i"
                        data-kind="letter"
                        data-symbol="@item.Symbol"
                        data-word="@item.Word"
                        data-phonetic="@item.Phonetic"
                        data-meaning="@item.MeaningVi"
                        data-emoji="@item.Emoji"
                        data-image="@item.Image"
                        data-example-en="@item.ExampleEn"
                        data-example-vi="@item.ExampleVi"
                        data-speak="@item.Symbol"
                        data-example-speak="@item.Word"
                        aria-label="Chữ cái @item.Symbol - @item.Word">
                    
                    <div class="card-status-indicator" title="Đã nghe">
                        <span class="material-symbols-outlined check-icon">check_circle</span>
                    </div>

                    <div class="card-symbol-badge">
                        <span class="symbol-text">@item.Symbol</span>
                    </div>

                    <div class="card-thumb-wrap">
                        <img src="@item.Image" alt="@item.Word" class="card-thumb-img" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <span class="card-emoji-fallback">@item.Emoji</span>
                    </div>

                    <div class="card-text-col">
                        <strong class="card-word">@item.Word</strong>
                        <span class="card-phonetic">/@item.Phonetic/</span>
                        <span class="card-meaning">@item.MeaningVi</span>
                    </div>

                    <div class="card-audio-btn" title="Nghe phát âm">
                        <span class="material-symbols-outlined audio-icon">volume_up</span>
                        <div class="card-waves">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </button>
            }
        </div>
    </div>

    <!-- Khu vực 2: Chữ Số 0 - 20 -->
    <div class="bilingual-section-group" data-section="numbers">
        <div class="bilingual-section-header">
            <div class="section-title-wrap">
                <div class="section-icon-pill icon-mint">
                    <span class="material-symbols-outlined">calculate</span>
                </div>
                <div>
                    <h2>Chữ Số Từ 0 Đến 20 (Numbers)</h2>
                    <p>Đếm số bằng tiếng Anh thật vui với hình ảnh minh họa que tính và đồ vật</p>
                </div>
            </div>
            <span class="section-count-badge">21 thẻ số</span>
        </div>

        <div class="bilingual-cards-grid">
            @for (var i = 0; i < numbers.Length; i++)
            {
                var item = numbers[i];
                var globalIndex = letters.Length + i;
                <button class="bilingual-card number-card @item.ColorTheme"
                        type="button"
                        data-listen-card
                        data-index="@globalIndex"
                        data-kind="number"
                        data-symbol="@item.Number"
                        data-word="@item.Name"
                        data-phonetic="@item.Phonetic"
                        data-meaning="@item.MeaningVi"
                        data-emoji="@item.Emoji"
                        data-image="@item.Image"
                        data-example-en="@item.ExampleEn"
                        data-example-vi="@item.ExampleVi"
                        data-speak="@item.Name"
                        data-example-speak="@item.ExampleEn"
                        aria-label="Số @item.Number - @item.Name">
                    
                    <div class="card-status-indicator" title="Đã nghe">
                        <span class="material-symbols-outlined check-icon">check_circle</span>
                    </div>

                    <div class="card-symbol-badge">
                        <span class="symbol-text">@item.Number</span>
                    </div>

                    <div class="card-thumb-wrap">
                        <img src="@item.Image" alt="@item.Name" class="card-thumb-img" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <span class="card-emoji-fallback">@item.Emoji</span>
                    </div>

                    <div class="card-text-col">
                        <strong class="card-word">@item.Name</strong>
                        <span class="card-phonetic">/@item.Phonetic/</span>
                        <span class="card-meaning">@item.MeaningVi</span>
                    </div>

                    <div class="card-audio-btn" title="Nghe phát âm">
                        <span class="material-symbols-outlined audio-icon">volume_up</span>
                        <div class="card-waves">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </button>
            }
        </div>
    </div>
</section>

<!-- Modal / Hộp Thoại Flashcard Song Ngữ Siêu Tương Tác -->
<div class="flashcard-dialog-backdrop" id="flashcardDialog" role="dialog" aria-modal="true" aria-labelledby="dialogSymbolTitle" hidden>
    <div class="flashcard-dialog clay-card">
        <!-- Nút Đóng -->
        <button type="button" class="dialog-close-btn clay-button" id="dialogCloseBtn" aria-label="Đóng cửa sổ">
            <span class="material-symbols-outlined">close</span>
        </button>

        <!-- Thẻ Điều Hướng Lật Trước/Sau Nhanh Cho Trẻ -->
        <button type="button" class="dialog-nav-btn dialog-nav-prev clay-button" id="dialogPrevBtn" aria-label="Thẻ trước đó" title="Thẻ trước (Mũi tên trái)">
            <span class="material-symbols-outlined">arrow_back_ios_new</span>
        </button>
        <button type="button" class="dialog-nav-btn dialog-nav-next clay-button" id="dialogNextBtn" aria-label="Thẻ tiếp theo" title="Thẻ tiếp theo (Mũi tên phải)">
            <span class="material-symbols-outlined">arrow_forward_ios</span>
        </button>

        <!-- Nội Dung Flashcard To Rõ Sinh Động -->
        <div class="dialog-inner-content">
            <!-- Cột Hình Ảnh Flashcard -->
            <div class="dialog-image-col">
                <div class="dialog-image-wrapper">
                    <img src="/images/photos/flashcard-apple.jpg" alt="" id="dialogImage" class="dialog-main-image" />
                </div>
            </div>

            <!-- Cột Nội Dung & Phát Âm -->
            <div class="dialog-info-col">
                <div class="dialog-badge-row">
                    <span class="dialog-category-badge" id="dialogCategoryBadge">Chữ cái A</span>
                </div>
                <div class="dialog-header-text">
                    <div class="dialog-symbol-large" id="dialogSymbolTitle">A</div>
                    <div class="dialog-emoji-badge" id="dialogEmoji">🍎</div>
                    <div class="dialog-word-block">
                        <h3 class="dialog-english-word" id="dialogWord">Apple</h3>
                        <div class="dialog-phonetic-row">
                            <span class="phonetic-chip" id="dialogPhonetic">/ˈæp.əl/ (ép-pồ)</span>
                            <span class="dialog-meaning-badge" id="dialogMeaning">Quả táo</span>
                        </div>
                    </div>
                </div>

                <!-- Khung Câu Ví Dụ Song Ngữ Thân Thiện -->
                <div class="dialog-example-box clay-card">
                    <div class="example-header">
                        <span class="material-symbols-outlined example-icon">forum</span>
                        <strong>Câu ví dụ mẫu:</strong>
                    </div>
                    <p class="example-vietnamese" id="dialogExampleVi">Chữ A trong Quả táo. Quả táo đỏ thật ngọt lành.</p>
                    <p class="example-english" id="dialogExampleEn">A is for Apple. An apple is sweet and red.</p>
                </div>

                <!-- Cụm Duy Nhất 2 Nút Thao Tác: Nghe Song Ngữ Tích Hợp Toàn Bộ & Đọc Chậm -->
                <div class="dialog-actions-cluster">
                    <button type="button" class="dialog-action-btn btn-speak-bilingual clay-button" id="dialogSpeakBilingualBtn" title="Nghe đầy đủ: Chữ cái ➔ Từ vựng ➔ Câu ví dụ">
                        <span class="material-symbols-outlined btn-icon">headphones</span>
                        <div class="btn-text-wrap">
                            <strong>Nghe Song Ngữ</strong>
                            <small>Chữ cái ➔ Từ ➔ Câu ví dụ</small>
                        </div>
                    </button>

                    <button type="button" class="dialog-action-btn btn-speak-slow clay-button" id="dialogSpeakSlowBtn" title="Luyện đọc chậm tiếng Anh">
                        <span class="material-symbols-outlined btn-icon">slow_motion_video</span>
                        <div class="btn-text-wrap">
                            <strong>Đọc Chậm</strong>
                            <small>Bé nhại từng âm</small>
                        </div>
                    </button>
                </div>

                <!-- Chỉ dẫn phím tắt & Đếm số thẻ -->
                <div class="dialog-footer-hint">
                    <span id="dialogProgressIndicator">Thẻ 1 / 47</span>
                    <span class="keyboard-tip">Mẹo: Dùng phím ◀ ▶ để lật thẻ, phím Space để nghe lại</span>
                </div>
            </div>
        </div>
    </div>
</div>

