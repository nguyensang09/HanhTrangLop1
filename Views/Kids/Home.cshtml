@model KidsHomeViewModel
@using HanhTrangLop1.Application.Learning
@using HanhTrangLop1.Application.MathWorld
@inject MathWorldService MathWorld
@inject KidsModuleService Modules
@{
    ViewData["Title"] = "Góc Khám Phá Của Bé - Hành Trang Lớp 1";

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    var childName = Model.ChildProfile?.Nickname ?? "Bé yêu";

    // Danh sách và thứ tự module do quản trị viên cấu hình (Bài học hôm nay luôn đứng đầu).
    var visibleModules = await Modules.GetVisibleAsync();
    var hasMathIsland = visibleModules.Any(m => m.Key == MathCurriculum.SkillGroupCode);
    var todayVisible = visibleModules.Any(m => m.Key == KidsModuleKeys.Today);
    var rewardsVisible = visibleModules.Any(m => m.Key == KidsModuleKeys.Rewards);
    var mathProgress = hasMathIsland && Model.ChildProfile is not null
        ? await MathWorld.GetProgressSummaryAsync(Model.ChildProfile)
        : (Completed: 0, Total: 0);
    var mathPercent = mathProgress.Total == 0 ? 0 : mathProgress.Completed * 100 / mathProgress.Total;

    string? ModuleUrl(KidsModule module) => module.Key switch
    {
        KidsModuleKeys.Today => Url.Action("Today", "Kids"),
        KidsModuleKeys.Tracing => Url.Action("Tracing", "Kids"),
        KidsModuleKeys.Games => Url.Action("Index", "Games"),
        KidsModuleKeys.Bilingual => Url.Action("BilingualListen", "Kids"),
        KidsModuleKeys.Rewards => Url.Action("Rewards", "Kids"),
        _ => Model.SkillGroups.Any(g => g.Id == module.SkillGroupId) ? Url.Action("Skill", "Kids", new { id = module.SkillGroupId }) : null
    };
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/math-entry.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/kid-hub.css" asp-append-version="true" />

<div class="kh kh-home">
    @* Giữ lớp kid-home-screen/ipad-home-hub-screen để site.js + site.css mở cuộn tự do cho trang chủ bé. *@
    <span class="kh-scroll-marker kid-home-screen ipad-home-hub-screen" aria-hidden="true"></span>

    <div class="kh-sky" aria-hidden="true">
        <span class="kh-cloud kh-cloud--1"></span>
        <span class="kh-cloud kh-cloud--2"></span>
        <span class="kh-cloud kh-cloud--3"></span>
        <span class="kh-float kh-float--1">🎈</span>
        <span class="kh-float kh-float--2">🌈</span>
        <span class="kh-float kh-float--3">⭐</span>
        <span class="kh-float kh-float--4">🪁</span>
    </div>

    <header class="kh-topbar">
        <a class="kh-avatar" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bạn nhỏ khác" aria-label="Đổi bé khác" onclick="playAudioChime('tap')">
            <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Avatar bé" />
            <span class="kh-avatar-badge material-symbols-outlined" aria-hidden="true">sync_alt</span>
        </a>
        <div class="kh-brand">
            <span class="kh-brand-mark" aria-hidden="true">🎒</span>
            <span class="kh-brand-text">
                <small>Hành Trang Lớp 1</small>
                <strong>Chào @childName 👋</strong>
            </span>
        </div>
        @if (rewardsVisible)
        {
            <a class="kh-pill kh-pill--stars" asp-controller="Kids" asp-action="Rewards" title="Số sao thưởng bé tích lũy được • Bấm xem kho quà" onclick="playAudioChime('celebrate')">
                <span aria-hidden="true">⭐</span><strong>@Model.Stars</strong><small class="kh-hide-sm">sao vàng</small>
            </a>
        }
        else
        {
            <span class="kh-pill kh-pill--stars" title="Số sao thưởng bé tích lũy được">
                <span aria-hidden="true">⭐</span><strong>@Model.Stars</strong><small class="kh-hide-sm">sao vàng</small>
            </span>
        }
        <button type="button" class="kh-pill kh-pill--lock" onclick="playAudioChime('tap'); openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh (Cần giải phép tính)" aria-label="Góc phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span><span class="kh-hide-sm">Ba mẹ</span>
        </button>
    </header>

    <section class="kh-hero">
        <div class="kh-guide" onclick="playAudioChime('celebrate')" title="Sóc Nâu đồng hành">
            <img class="kh-guide-img" src="~/images/mascot-squirrel-3d.png" alt="Sóc Nâu" />
            <p class="kh-bubble">@childName ơi, hôm nay mình học gì nào? Bé chọn bài học để khám phá nhé! 🌰</p>
        </div>
        @if (todayVisible)
        {
            <div class="kh-hero-card">
                <a class="kh-continue kh-continue--gold" asp-controller="Kids" asp-action="Today" onclick="playAudioChime('tap')">
                    <span class="kh-continue-orb" aria-hidden="true">🗺️</span>
                    <span class="kh-continue-text">
                        <small>Hành trình học tập · Ngày @Model.CurrentDayNumber</small>
                        <strong>@(Model.TodayTheme?.Title ?? "Bài học rèn luyện trong ngày")</strong>
                    </span>
                    <span class="kh-continue-play material-symbols-outlined" aria-hidden="true">play_arrow</span>
                </a>
            </div>
        }
    </section>

    <div class="kh-home-bar">
        <h2>Bé muốn chơi gì nào? 🎯</h2>
        <span class="kh-chip">Tổng cộng: @visibleModules.Count mục học tập</span>
    </div>

    <div class="kh-grid">
        @foreach (var module in visibleModules)
        {
            if (module.Key == MathCurriculum.SkillGroupCode)
            {
                @* Đảo Toán Học: cùng kích thước với các thẻ khác, giữ minh họa đảo và rô-bốt Bíp làm điểm nhấn. *@
                <a class="kh-tile kh-tone-violet math-island-tile" asp-controller="KidsMath" asp-action="Index" onclick="playAudioChime('celebrate')" title="Đảo Toán Học • Cộng, trừ trong phạm vi 10">
                    <partial name="_KidsMathTileBody" model="(mathProgress.Completed, mathProgress.Total, mathPercent)" />
                </a>
                continue;
            }

            if (ModuleUrl(module) is not { } moduleUrl) continue;
            var card = KidsModuleCard.For(module, Model.SkillGroups.FirstOrDefault(g => g.Id == module.SkillGroupId)?.Description, Model.Stars, Model.CurrentDayNumber, Model.TodayTheme?.Title);
            <a class="kh-tile @card.Theme" href="@moduleUrl" onclick="playAudioChime('tap')" title="@card.Title • @card.Badge">
                <partial name="_KidsModuleTileBody" model="card" />
            </a>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            let audioCtx = null;

            window.playAudioChime = function (type) {
                try {
                    if (!audioCtx) {
                        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    }
                    if (audioCtx.state === 'suspended') {
                        audioCtx.resume();
                    }

                    const now = audioCtx.currentTime;
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);

                    if (type === 'celebrate') {
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(523.25, now);
                        osc.frequency.exponentialRampToValueAtTime(1046.50, now + 0.25);
                        gain.gain.setValueAtTime(0.2, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                        osc.start(now);
                        osc.stop(now + 0.35);
                    } else {
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(587.33, now);
                        osc.frequency.exponentialRampToValueAtTime(880.00, now + 0.12);
                        gain.gain.setValueAtTime(0.18, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
                        osc.start(now);
                        osc.stop(now + 0.18);
                    }
                } catch (e) {
                    // Ignore audio error
                }
            };
        })();
    </script>
}
