@model KidsHomeViewModel
@{
    ViewData["Title"] = "Góc Khám Phá Của Bé - Hành Trang Lớp 1";

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    var childName = Model.ChildProfile?.Nickname ?? "Bé yêu";

    // Helper trích xuất thông tin nhóm kỹ năng
    (string Title, string Icon, string Emoji, string Theme, string Badge, string Desc, string Url) GetSkillGroupCard(SkillGroup g)
    {
        var (icon, emoji, theme, badge, desc) = g.Code switch
        {
            "chu-cai" => ("menu_book", "📖", "card-theme-coral", "33 Chữ Việt – Anh & Nét", "Mặt chữ, nét chuẩn & phát âm"),
            "chu-so" => ("pin", "🔢", "card-theme-emerald", "Chữ Số 0 - 20", "Đếm số lượng & tập viết số đẹp"),
            "so-luong-toan" => ("calculate", "🧮", "card-theme-sky", "Đếm & So Sánh", "So sánh lớn bé, tách gộp nhóm"),
            "tu-duy-logic" => ("extension", "💡", "card-theme-cyan", "Tư Duy & Ghép Bóng", "Quy luật, phân loại & tư duy"),
            "ky-nang-song" => ("volunteer_activism", "💖", "card-theme-rose", "Kỹ Năng & Tự Lập", "Tự phục vụ, an toàn & cảm xúc"),
            "ngon-ngu" => ("auto_stories", "📚", "card-theme-purple", "Vốn Từ & Âm Vần", "Nghe hiểu, kể chuyện & từ vựng"),
            "hinh-dang-khong-gian" => ("category", "🔺", "card-theme-teal", "Hình Khối & Không Gian", "Nhận biết hình học & định hướng"),
            "ghi-nho-tap-trung" => ("psychology", "🧠", "card-theme-amber", "Ghi Nhớ & Tập Trung", "Rèn trí nhớ & khả năng quan sát"),
            _ => (g.IconKey ?? "school", "🌟", "card-theme-coral", g.Name, g.Description ?? "Hành trình khám phá tri thức")
        };

        return (g.Name, icon, emoji, theme, badge, desc, Url.Action("Skill", "Kids", new { id = g.Id })!);
    }

    // Tách các nhóm kỹ năng cụ thể
    var chuCaiGroup = Model.SkillGroups.FirstOrDefault(g => g.Code == "chu-cai");
    var chuSoGroup = Model.SkillGroups.FirstOrDefault(g => g.Code == "chu-so");
    var soLuongToanGroup = Model.SkillGroups.FirstOrDefault(g => g.Code == "so-luong-toan");
    var otherSkillGroups = Model.SkillGroups
        .Where(g => g.Code != "chu-cai" && g.Code != "chu-so" && g.Code != "so-luong-toan")
        .ToList();

    // Sắp xếp thứ tự chính xác theo yêu cầu:
    // bé tập tô nét -> Chữ cái -> chữ số -> số lượng toán học -> bài hôm nay -> nghe song ngữ -> các mục khác -> kho quà của bé
    var activityCards = new List<(string Title, string Icon, string Emoji, string Theme, string Badge, string Desc, string Url)>();

    // 1. Bé tập tô nét
    activityCards.Add((
        "Bé Tập Tô Nét",
        "draw",
        "🎨",
        "card-theme-coral",
        "Xưởng Vẽ Sáng Tạo",
        "Luyện nét chữ, tô chữ cái và vẽ hình",
        Url.Action("Tracing", "Kids")!
    ));

    // 2. Chữ cái
    if (chuCaiGroup != null)
    {
        activityCards.Add(GetSkillGroupCard(chuCaiGroup));
    }

    // 3. Chữ số
    if (chuSoGroup != null)
    {
        activityCards.Add(GetSkillGroupCard(chuSoGroup));
    }

    // 4. Số lượng và toán học
    if (soLuongToanGroup != null)
    {
        activityCards.Add(GetSkillGroupCard(soLuongToanGroup));
    }

    // 5. Trò chơi vui nhộn (Game Hub mini-games)
    activityCards.Add((
        "Trò Chơi Vui Nhộn",
        "sports_esports",
        "🎮",
        "card-theme-coral",
        "4 Mini-game Hấp Dẫn",
        "Bắn bóng, đào vàng, khinh khí cầu & tàu số",
        Url.Action("Index", "Games")!
    ));

    // 6. Bài học hôm nay
    activityCards.Add((
        "Bài Học Hôm Nay",
        "play_circle",
        "⭐",
        "card-theme-amber",
        $"Ngày {Model.CurrentDayNumber} • Mục Tiêu",
        Model.TodayTheme?.Title ?? "Bài học rèn luyện trong ngày",
        Url.Action("Today", "Kids")!
    ));

    // 6. Nghe song ngữ
    activityCards.Add((
        "Nghe Song Ngữ",
        "record_voice_over",
        "🎧",
        "card-theme-purple",
        "Phát Âm Bản Xứ",
        "Luyện nghe chuẩn ABC & Số 0-20",
        Url.Action("BilingualListen", "Kids")!
    ));

    // 7. Các mục khác (các nhóm kỹ năng còn lại)
    foreach (var g in otherSkillGroups)
    {
        activityCards.Add(GetSkillGroupCard(g));
    }

    // 8. Kho quà của bé (ở cuối cùng)
    activityCards.Add((
        "Kho Quà Của Bé",
        "emoji_events",
        "🏆",
        "card-theme-gold",
        $"{Model.Stars} Sao Vàng ⭐",
        "Mở rương báu, đổi quà & huy hiệu",
        Url.Action("Rewards", "Kids")!
    ));
}

<section class="kid-screen kid-home-screen ipad-home-hub-screen">
    <!-- ==================== TOPBAR CHUẨN ĐỒNG NHẤT VỚI CÁC CHỨC NĂNG ==================== -->
    <header class="child-zone-header clay-card">
        <div class="child-header-left">
            <a class="child-avatar-touch" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bạn nhỏ khác" onclick="playAudioChime('tap')">
                <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Avatar bé" class="child-avatar-img" />
                <span class="child-avatar-switch-badge" title="Đổi bé">
                    <span class="material-symbols-outlined">sync_alt</span>
                </span>
            </a>
            <div class="child-header-greeting">
                <span class="child-hi-eyebrow">Hành Trang Lớp 1</span>
                <strong class="child-name-display">Chào bạn nhỏ @childName 👋</strong>
            </div>
        </div>

        <div class="child-header-center">
            <a asp-controller="Kids" asp-action="Rewards" class="child-star-badge-3d" title="Số sao thưởng bé tích lũy được • Bấm xem kho quà" onclick="playAudioChime('celebrate')">
                <span class="star-3d-icon">⭐</span>
                <span class="star-number-display">@Model.Stars</span>
                <span class="star-label-text">sao vàng</span>
            </a>
        </div>

        <div class="child-header-right">
            <button type="button" class="child-lock-gate-btn" onclick="playAudioChime('tap'); openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh (Cần giải phép tính)" aria-label="Góc phụ huynh">
                <span class="material-symbols-outlined lock-icon">lock</span>
                <span class="lock-label-text">Ba mẹ</span>
            </button>
        </div>
    </header>

    <!-- ==================== LƯỚI TẤT CẢ HOẠT ĐỘNG & 10 NHÓM BÀI HỌC (CHUẨN IPAD) ==================== -->
    <div class="ipad-hub-main">
        <div class="ipad-hub-headline-row">
            <div class="headline-mascot-chip" onclick="playAudioChime('celebrate')" title="Sóc Nâu đồng hành">
                <img src="~/images/mascot-squirrel-3d.png" alt="Sóc Nâu" class="chip-squirrel-img" />
                <span class="chip-bubble-text">Bé chọn bài học để khám phá nhé! 🌰</span>
            </div>
            <div class="headline-counter-chip">
                <span>Tổng cộng: @activityCards.Count mục học tập</span>
            </div>
        </div>

        <div class="ipad-unified-cards-grid">
            @foreach (var card in activityCards)
            {
                <a class="ipad-card-tile clay-card @card.Theme" href="@card.Url" onclick="playAudioChime('tap')" title="@card.Title • @card.Badge">
                    <div class="tile-top-bar">
                        <span class="tile-emoji-art">@card.Emoji</span>
                        <span class="tile-badge-pill">@card.Badge</span>
                    </div>
                    <div class="tile-content-box">
                        <h3 class="tile-title-text">@card.Title</h3>
                        <p class="tile-desc-text">@card.Desc</p>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            let audioCtx = null;

            window.playAudioChime = function (type) {
                try {
                    if (!audioCtx) {
                        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    }
                    if (audioCtx.state === 'suspended') {
                        audioCtx.resume();
                    }

                    const now = audioCtx.currentTime;
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);

                    if (type === 'celebrate') {
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(523.25, now);
                        osc.frequency.exponentialRampToValueAtTime(1046.50, now + 0.25);
                        gain.gain.setValueAtTime(0.2, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                        osc.start(now);
                        osc.stop(now + 0.35);
                    } else {
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(587.33, now);
                        osc.frequency.exponentialRampToValueAtTime(880.00, now + 0.12);
                        gain.gain.setValueAtTime(0.18, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
                        osc.start(now);
                        osc.stop(now + 0.18);
                    }
                } catch (e) {
                    // Ignore audio error
                }
            };
        })();
    </script>
}
