@model KidsHomeViewModel
@{
    ViewData["Title"] = "Khu học của bé";

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }
}

<section class="kid-screen kid-home-screen">
    <!-- Topbar Hồ Sơ Bé Tinh Gọn -->
    <div class="kid-topbar home-topbar clay-card">
        <div class="kid-header-profile">
            <div class="squirrel-avatar-wrap">
                <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Ảnh bé" class="squirrel-avatar" />
            </div>
            <div>
                <p class="eyebrow">Sóc Nâu Đồng Hành</p>
                <h1>Chào @((Model.ChildProfile?.Nickname) ?? "bạn nhỏ")! 👋</h1>
            </div>
        </div>
        <div class="kid-topbar-actions">
            <a class="star-pill clay-button" asp-controller="Profiles" asp-action="Index" title="Đổi hồ sơ bé">
                <span class="material-symbols-outlined">face</span>
                <span>Đổi bé</span>
            </a>
        </div>
    </div>

    <!-- Lời Chào Sóc Nâu Tự Động Thu Gọn Sau Vài Giây -->
    <div class="mascot-greeting-toast clay-card" id="mascotGreetingToast">
        <img src="~/images/mascot-squirrel-3d.png" alt="Sóc Nâu 3D" class="toast-mascot-img" />
        <div class="toast-speech-col">
            <div class="toast-speech-header">
                <strong>Hôm nay mình học một chút thôi nhé! 🌟</strong>
                <button class="sound-button clay-button" type="button" aria-label="Nghe lời chào" onclick="window.speechSynthesis && window.speechSynthesis.speak(new SpeechSynthesisUtterance('Chào bạn nhỏ! Hôm nay mình học một chút thôi nhé. Bắt đầu bằng nét chữ, rồi chơi với số và hình.'))">
                    <span class="material-symbols-outlined">volume_up</span>
                </button>
            </div>
            <p>Bắt đầu bằng nét chữ, rồi cùng chơi với những con số và thế giới xung quanh.</p>
        </div>
        <button type="button" class="toast-close-btn" onclick="dismissGreetingToast()" aria-label="Đóng lời chào">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>

    <!-- Nút Bắt Đầu Bài Học Hôm Nay 3D -->
    <a class="hero-mission-card clay-button" asp-controller="Kids" asp-action="Today">
        <div class="hero-mission-icon-wrap">
            <span class="material-symbols-outlined hero-play-icon">play_circle</span>
        </div>
        <div class="hero-mission-content">
            <span class="hero-mission-badge">Mục tiêu hôm nay ✨</span>
            <strong>Bắt đầu bài học ngay</strong>
            <small>Chỉ 10 - 15 phút mỗi ngày cùng Sóc Nâu</small>
        </div>
        <span class="hero-mission-arrow material-symbols-outlined">arrow_forward</span>
    </a>

    <!-- Lưới Khám Phá Các Nhóm Kỹ Năng Đa Dạng Sắc Màu -->
    <div class="skill-section-header">
        <h2 class="section-title">
            <span class="material-symbols-outlined title-icon">category</span>
            Khám phá các nhóm kỹ năng
        </h2>
        <span class="section-sub">Chọn một chủ đề bé yêu thích để bắt đầu hành trình</span>
    </div>

    <div class="skill-grid">
        @foreach (var group in Model.SkillGroups)
        {
            var (badgeText, icon3d, themeClass) = group.Code switch
            {
                "chu-cai" => ("29 Chữ Cái & Nét", "menu_book", "theme-coral"),
                "chu-so" => ("Chữ Số 0 - 9", "pin", "theme-amber"),
                "so-luong-toan" => ("Đếm & So Sánh", "calculate", "theme-mint"),
                "tu-duy-logic" => ("Ghép Bóng & Logic", "extension", "theme-cyan"),
                "ky-nang-song" => ("Kỹ Năng & Cảm Xúc", "volunteer_activism", "theme-purple"),
                "ngon-ngu" => ("Vốn Từ & Âm Vần", "record_voice_over", "theme-pink"),
                "hinh-dang-khong-gian" => ("Hình Khối & Không Gian", "category", "theme-teal"),
                _ => ("Khám Phá Mới", group.IconKey, "theme-coral")
            };

            <a class="skill-tile clay-card @themeClass" asp-controller="Kids" asp-action="Skill" asp-route-id="@group.Id">
                <div class="skill-tile-icon-wrap">
                    <span class="material-symbols-outlined skill-tile-icon">@icon3d</span>
                </div>
                <div class="skill-tile-body">
                    <div class="skill-tag-pill">@badgeText</div>
                    <strong>@group.Name</strong>
                    <small>@group.Description</small>
                </div>
                <div class="skill-tile-arrow-wrap">
                    <span class="material-symbols-outlined">arrow_forward</span>
                </div>
            </a>
        }
    </div>
</section>

<!-- Bottom Navigation for Kids -->
<nav class="kid-bottom-nav">
    <a class="active" asp-controller="Kids" asp-action="Home">
        <span class="material-symbols-outlined">home</span>
        <span>Trang chủ</span>
    </a>
    <a asp-controller="Kids" asp-action="Today">
        <span class="material-symbols-outlined">edit_square</span>
        <span>Bài tập</span>
    </a>
    <a asp-controller="Kids" asp-action="Rewards">
        <span class="material-symbols-outlined">emoji_events</span>
        <span>Quà tặng</span>
    </a>
    <a asp-controller="Parent" asp-action="Dashboard">
        <span class="material-symbols-outlined">family_restroom</span>
        <span>Phụ huynh</span>
    </a>
</nav>

@section Scripts {
    <script>
        function dismissGreetingToast() {
            const toast = document.getElementById("mascotGreetingToast");
            if (toast) {
                toast.classList.add("toast-dismissed");
                setTimeout(() => {
                    toast.style.display = "none";
                }, 400);
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            // Tự động thu gọn lời chào nhanh sau 2 giây
            setTimeout(() => {
                dismissGreetingToast();
            }, 2000);
        });
    </script>
}
