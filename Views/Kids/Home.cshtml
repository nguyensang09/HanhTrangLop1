@model KidsHomeViewModel
@{
    ViewData["Title"] = "Góc của bé - Hành Trang Lớp 1";

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    // Xây dựng danh mục các thẻ hoạt động cho bé
    var allCards = new List<(string Title, string Icon, string ColorTheme, string Badge, string Url)>();

    // 1. Bài học hôm nay
    allCards.Add(("Bài Học Hôm Nay", "play_circle", "card-theme-amber", "Mục tiêu ✨", Url.Action("Today", "Kids")!));
    // 2. Bé tập tô
    allCards.Add(("Góc Bé Tập Tô", "draw", "card-theme-coral", "Vẽ tự do 🎨", Url.Action("Tracing", "Kids")!));
    // 3. Nghe song ngữ
    allCards.Add(("Nghe Song Ngữ", "record_voice_over", "card-theme-sky", "ABC & Số 0-20 🎧", Url.Action("BilingualListen", "Kids")!));
    // 4. Kho quà & huy hiệu
    allCards.Add(("Kho Quà Tặng", "emoji_events", "card-theme-gold", "Huy hiệu 🏆", Url.Action("Rewards", "Kids")!));

    // Thêm các nhóm kỹ năng cốt lõi
    foreach (var g in Model.SkillGroups)
    {
        var (icon, theme, badge) = g.Code switch
        {
            "chu-cai" => ("menu_book", "card-theme-coral", "29 Chữ Cái & Nét"),
            "chu-so" => ("pin", "card-theme-mint", "Chữ Số 0 - 9"),
            "so-luong-toan" => ("calculate", "card-theme-amber", "Đếm & So Sánh"),
            "tu-duy-logic" => ("extension", "card-theme-cyan", "Ghép Bóng & Logic"),
            "ky-nang-song" => ("volunteer_activism", "card-theme-purple", "Kỹ Năng Sống"),
            "ngon-ngu" => ("record_voice_over", "card-theme-pink", "Vốn Từ & Âm"),
            "hinh-dang-khong-gian" => ("category", "card-theme-teal", "Hình Khối"),
            _ => (g.IconKey ?? "school", "card-theme-coral", g.Name)
        };
        allCards.Add((g.Name, icon, theme, badge, Url.Action("Skill", "Kids", new { id = g.Id })!));
    }

    // Phân trang 8 thẻ / trang (cố định 2 hàng x 4 cột)
    const int PageSize = 8;
    var totalCards = allCards.Count;
    var totalPages = (int)Math.Ceiling(totalCards / (double)PageSize);
}

<div class="child-zone-shell">
    <!-- ==================== HEADER GÓC CỦA BÉ ==================== -->
    <header class="child-zone-header">
        <!-- Góc trái: Avatar bé bo tròn lớn (đường kính 80px trên Tablet/PC, 48px trên Mobile) -->
        <div class="child-header-left">
            <a class="child-avatar-touch" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bạn nhỏ khác">
                <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Avatar bé" class="child-avatar-img" />
                <span class="child-avatar-switch-badge" title="Đổi bé">
                    <span class="material-symbols-outlined">sync_alt</span>
                </span>
            </a>
            <div class="child-header-greeting">
                <span class="child-hi-eyebrow">Chào bạn nhỏ</span>
                <strong class="child-name-display">@((Model.ChildProfile?.Nickname) ?? "Bé yêu") 👋</strong>
            </div>
        </div>

        <!-- Ở giữa: Huy hiệu/ngôi sao điểm thưởng dạng icon 3D nổi bật, số font đậm 32px -->
        <div class="child-header-center">
            <div class="child-star-badge-3d" title="Số sao thưởng bé tích lũy được">
                <span class="star-3d-icon">⭐</span>
                <span class="star-number-display">@Model.Stars</span>
                <span class="star-label-text">sao</span>
            </div>
        </div>

        <!-- Góc phải: Nút "Chuyển góc phụ huynh" (icon ổ khóa bo tròn, kích thước 72x72px trên Tablet, min 48x48px trên Mobile) -->
        <div class="child-header-right">
            <button type="button" class="child-lock-gate-btn" onclick="openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh (Cần giải phép tính)" aria-label="Góc phụ huynh">
                <span class="material-symbols-outlined lock-icon">lock</span>
                <span class="lock-label-text">Ba mẹ</span>
            </button>
        </div>
    </header>

    <!-- ==================== LƯỚI BÀI HỌC (2 HÀNG x 4 CỘT = 8 THẺ/TRANG) ==================== -->
    <main class="child-zone-main">
        <div class="child-pages-slider" id="childPagesSlider">
            @for (int pageIndex = 0; pageIndex < totalPages; pageIndex++)
            {
                var pageCards = allCards.Skip(pageIndex * PageSize).Take(PageSize).ToList();
                <div class="child-grid-page @(pageIndex == 0 ? "is-active" : "")" data-page-index="@pageIndex">
                    <div class="child-cards-grid">
                        @foreach (var card in pageCards)
                        {
                            <a class="child-card-tile @card.ColorTheme" href="@card.Url" onclick="playChildCardClick(event, this)">
                                <div class="card-badge-pill">@card.Badge</div>
                                <div class="card-illustration-box">
                                    <span class="material-symbols-outlined card-main-icon">@card.Icon</span>
                                </div>
                                <div class="card-title-box">
                                    <h3 class="card-title-text">@card.Title</h3>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- ==================== ĐIỀU HƯỚNG CHÂN TRANG (2 NÚT 88x88px Ở HAI GÓC DƯỚI) ==================== -->
        <div class="child-zone-footer-nav">
            <!-- Nút "Trước" (88x88px cố định góc dưới bên trái) -->
            <button type="button" class="child-corner-nav-btn btn-prev" id="childBtnPrev" onclick="navigateChildPage(-1)" aria-label="Trang trước" title="Xem trang trước" disabled>
                <span class="material-symbols-outlined nav-arrow-icon">arrow_back</span>
                <span class="nav-text-small">Trước</span>
            </button>

            <!-- Chỉ số trang giữa 2 nút -->
            <div class="child-pagination-dots" id="childPageDots">
                @for (int i = 0; i < totalPages; i++)
                {
                    <span class="page-dot @(i == 0 ? "is-active" : "")" onclick="goToChildPage(@i)" title="Trang @(i + 1)"></span>
                }
            </div>

            <!-- Nút "Sau" (88x88px cố định góc dưới bên phải) -->
            <button type="button" class="child-corner-nav-btn btn-next" id="childBtnNext" onclick="navigateChildPage(1)" aria-label="Trang tiếp theo" title="Xem trang tiếp">
                <span class="material-symbols-outlined nav-arrow-icon">arrow_forward</span>
                <span class="nav-text-small">Sau</span>
            </button>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        (function () {
            let currentPage = 0;
            const totalPages = @totalPages;
            let audioContext = null;

            // Âm thanh phản hồi khi chạm vào thẻ bài học (Web Audio API)
            window.playChildCardClick = function (e, element) {
                try {
                    if (!audioContext) {
                        audioContext = new (window.AudioContext || window.webkitAudioContext)();
                    }
                    if (audioContext.state === 'suspended') {
                        audioContext.resume();
                    }
                    const osc = audioContext.createOscillator();
                    const gain = audioContext.createGain();
                    osc.connect(gain);
                    gain.connect(audioContext.destination);

                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(587.33, audioContext.currentTime); // D5
                    osc.frequency.exponentialRampToValueAtTime(880, audioContext.currentTime + 0.12); // A5
                    gain.gain.setValueAtTime(0.2, audioContext.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.22);

                    osc.start();
                    osc.stop(audioContext.currentTime + 0.22);
                } catch (err) {
                    // Ignore audio error
                }
            };

            window.goToChildPage = function (index) {
                if (index < 0 || index >= totalPages) return;
                currentPage = index;
                updateChildPages();
            };

            window.navigateChildPage = function (delta) {
                const next = currentPage + delta;
                if (next >= 0 && next < totalPages) {
                    currentPage = next;
                    updateChildPages();
                }
            };

            function updateChildPages() {
                const pages = document.querySelectorAll(".child-grid-page");
                pages.forEach((p, idx) => {
                    if (idx === currentPage) {
                        p.classList.add("is-active");
                    } else {
                        p.classList.remove("is-active");
                    }
                });

                const dots = document.querySelectorAll(".child-pagination-dots .page-dot");
                dots.forEach((d, idx) => {
                    if (idx === currentPage) {
                        d.classList.add("is-active");
                    } else {
                        d.classList.remove("is-active");
                    }
                });

                const btnPrev = document.getElementById("childBtnPrev");
                const btnNext = document.getElementById("childBtnNext");
                if (btnPrev) btnPrev.disabled = (currentPage === 0);
                if (btnNext) btnNext.disabled = (currentPage >= totalPages - 1);
            }

            // Hỗ trợ cử chỉ vuốt lướt màn hình trên cảm ứng
            let touchStartX = 0;
            const slider = document.getElementById("childPagesSlider");
            if (slider) {
                slider.addEventListener("touchstart", function (e) {
                    touchStartX = e.changedTouches[0].screenX;
                }, { passive: true });

                slider.addEventListener("touchend", function (e) {
                    const touchEndX = e.changedTouches[0].screenX;
                    const diff = touchStartX - touchEndX;
                    if (Math.abs(diff) > 50) {
                        if (diff > 0) {
                            navigateChildPage(1);
                        } else {
                            navigateChildPage(-1);
                        }
                    }
                }, { passive: true });
            }
        })();
    </script>
}
