@model LearnViewModel
@{
    ViewData["Title"] = Model.Item.Title;
    ViewData["FocusMode"] = true;
    var customInteractionTypes = new[]
    {
        InteractionTypes.SingleChoice,
        InteractionTypes.ListenAndChoose,
        InteractionTypes.MultiSelect,
        InteractionTypes.DragDrop,
        InteractionTypes.Matching,
        InteractionTypes.Ordering,
        InteractionTypes.Counting,
        InteractionTypes.QuantityBuilder,
        InteractionTypes.Comparison,
        InteractionTypes.Classification,
        InteractionTypes.StoryChoice
    };

    var topicCode = Model.Item.Topic?.Code?.ToLowerInvariant() ?? string.Empty;
    var titleLower = Model.Item.Title.ToLowerInvariant();
    var symbolLower = (Model.TracingSymbol ?? string.Empty).ToLowerInvariant();
    var itemCodeLower = (Model.Item.Code ?? string.Empty).ToLowerInvariant();
    var isPictureTracing = topicCode.Contains("tao-hinh") || topicCode.Contains("tranh") ||
        topicCode == "art" || titleLower.Contains("tranh") || titleLower.Contains("tạo hình") ||
        symbolLower.Contains("phong-canh") || symbolLower.Contains("do-dung") ||
        symbolLower.Contains("meo-con") || symbolLower.Contains("ca-heo") ||
        symbolLower.Contains("o-che-mua") || symbolLower.Contains("hinh-hoc") ||
        symbolLower.Contains("trai-tao") || symbolLower.Contains("tau-hoa") ||
        symbolLower.Contains("chu-tho") || symbolLower.Contains("ong-vang") ||
        symbolLower.Contains("may-bay") || symbolLower.Contains("thuyen") ||
        symbolLower.Contains("cau-vong") || symbolLower.Contains("chu-buom") ||
        symbolLower.Contains("khung-long") || symbolLower.Contains("ten-lua") ||
        itemCodeLower.Contains("picture");

    var successDestination = string.Empty;
    var successActionText = "Sang bài tiếp theo";
    if (Model.IsCorrect == true)
    {
        if (Model.NextItemId.HasValue)
        {
            successDestination = Model.FromTracing
                ? Url.Action("Learn", "Kids", new { id = Model.NextItemId.Value, fromTracing = true }) ?? string.Empty
                : Url.Action("Learn", "Kids", new { id = Model.NextItemId.Value, skillGroupId = Model.ReturnSkillGroupId }) ?? string.Empty;
        }
        else if (Model.FromTracing)
        {
            successDestination = Url.Action("Tracing", "Kids") ?? string.Empty;
            successActionText = "Về danh sách tập tô";
        }
        else if (Model.ReturnSkillGroupId.HasValue)
        {
            successDestination = Url.Action("Skill", "Kids", new { id = Model.ReturnSkillGroupId.Value }) ?? string.Empty;
            successActionText = "Về bản đồ bài học";
        }
        else
        {
            successDestination = Url.Action("Today", "Kids") ?? string.Empty;
            successActionText = "Về bản đồ bài học";
        }
    }
}

<section class="learn-screen learning-focus-shell"
         data-learning-voice
         data-activity-type="@Model.Item.InteractionType"
         data-sound-enabled="@(Model.ChildProfile?.SoundEnabled != false ? "true" : "false")"
         data-english-voice="@(Model.EnglishVoiceEnabled ? "true" : "false")"
         data-title-text="@Model.Item.Title"
         data-title-audio-url="@Model.TitleAudioUrl"
         data-title-audio-url-en="@Model.TitleAudioUrlEn"
         data-instruction-text="@Model.Item.InstructionText"
         data-question-text="@Model.CurrentQuestion?.PromptText"
         data-question-audio-url="@Model.QuestionAudioUrl"
         data-question-audio-url-en="@Model.QuestionAudioUrlEn"
         data-instruction-audio-url="@Model.InstructionAudioUrl"
         data-instruction-audio-url-en="@Model.InstructionAudioUrlEn"
         data-correct-audio-url="@Model.CorrectFeedbackAudioUrl"
         data-correct-audio-url-en="@Model.CorrectFeedbackAudioUrlEn"
         data-retry-audio-url="@Model.RetryFeedbackAudioUrl"
         data-retry-audio-url-en="@Model.RetryFeedbackAudioUrlEn"
         data-tracing-audio-url="@Model.TracingAudioUrl"
         data-tracing-audio-url-en="@Model.TracingAudioUrlEn"
         data-feedback-text="@Model.FeedbackMessage"
         data-result="@(Model.IsCorrect == true ? "correct" : Model.IsCorrect == false ? "retry" : string.Empty)">
    
    <textarea class="activity-payload" data-activity-payload hidden>@(Model.CurrentQuestion?.PayloadJson ?? "{}")</textarea>

    <!-- Topbar Focus Mode (1 Tiêu đề chính + Nút nghe / Nút xem mẫu góc phải) -->
    <header class="learning-common-zone">
        <div class="learning-focus-topbar">
            @if (Model.FromTracing)
            {
                <a class="icon-link learning-back-btn clay-button" asp-controller="Kids" asp-action="Tracing" title="Quay lại Góc Tập Tô"><span class="material-symbols-outlined">arrow_back</span></a>
            }
            else if (Model.ReturnSkillGroupId.HasValue)
            {
                <a class="icon-link learning-back-btn clay-button" asp-controller="Kids" asp-action="Skill" asp-route-id="@Model.ReturnSkillGroupId" title="Quay lại"><span class="material-symbols-outlined">arrow_back</span></a>
            }
            else
            {
                <a class="icon-link learning-back-btn clay-button" asp-controller="Kids" asp-action="Today" title="Quay lại"><span class="material-symbols-outlined">arrow_back</span></a>
            }
            <h1>@(Model.CurrentQuestion?.PromptText ?? Model.Item.Title)</h1>
            <div class="learning-topbar-actions">
                @if (Model.Item.InteractionType == InteractionTypes.Tracing && !isPictureTracing)
                {
                    <button class="tracing-demo clay-button" type="button" title="Xem mẫu tô nét">
                        <span class="material-symbols-outlined">auto_draw_solid</span>
                    </button>
                }
                <button class="learning-voice-button clay-button" type="button" title="Nghe câu hỏi" data-learning-replay="question">
                    <span class="material-symbols-outlined">volume_up</span>
                </button>
            </div>
        </div>
    </header>

    @if (Model.IsCorrect == true)
    {
        <div class="learning-success-overlay" data-learning-success-popup data-destination="@successDestination" role="dialog" aria-modal="true" aria-labelledby="learning-success-title">
            <div class="learning-success-popup" role="document">
                <button class="learning-success-close clay-button" type="button" data-success-close aria-label="Đóng và chuyển bài">
                    <span class="material-symbols-outlined">close</span>
                </button>
                <div class="learning-success-decorations" aria-hidden="true">
                    @for (var index = 0; index < 8; index++)
                    {
                        <span data-success-decoration></span>
                    }
                </div>
                <div class="learning-success-mascot-wrap">
                    <img src="~/images/avatars/avatar-squirrel.png" alt="Nhân vật chúc mừng" class="learning-success-mascot" data-success-mascot />
                    <span class="learning-success-badge material-symbols-outlined" aria-hidden="true">stars</span>
                </div>
                <h2 id="learning-success-title">Xuất sắc quá! 🎉</h2>
                <p>@(string.IsNullOrWhiteSpace(Model.FeedbackMessage) ? "Giỏi lắm, con làm đúng rồi!" : Model.FeedbackMessage)</p>
                <a class="app-btn clay-button learning-success-continue" href="@successDestination" data-success-continue>
                    <span>@successActionText</span>
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
                <div class="learning-success-timer" aria-hidden="true"><span></span></div>
                @* <small>Tự động chuyển sau 3 giây</small> *@
            </div>
        </div>
    }


    @if (Model.Item.InteractionType == InteractionTypes.Tracing)
    {
        <div class="choice-board tracing-lesson-layout interaction-tracing">
            <div class="lesson-answer-zone tracing-answer-zone">
                <div class="tracing-board tracing-canvas-host clay-card"
                     data-tracing-min-points="@Model.TracingMinPoints"
                     data-tracing-expected-strokes="@Model.TracingExpectedStrokeCount"
                     data-tracing-audio-url="@Model.TracingAudioUrl"
                     data-tracing-symbol="@Model.TracingSymbol"
                     data-is-picture="@(isPictureTracing ? "true" : "false")">
                    <div class="tracing-guide-overlay" aria-hidden="true"></div>
                    <canvas class="tracing-canvas" width="920" height="1200" aria-label="Bảng tô nét"></canvas>
                </div>
                <form class="tracing-submit-form" asp-controller="Kids" asp-action="CompleteTracing" asp-route-id="@Model.Item.Id" asp-route-skillGroupId="@Model.ReturnSkillGroupId" asp-route-fromTracing="@Model.FromTracing" method="post">
                    <input class="tracing-strokes-input" type="hidden" name="StrokeDataJson" value="[]" />
                    <input class="tracing-metrics-input" type="hidden" name="MetricsJson" value="{}" />
                    <div class="tracing-bottom-bar">
                        <div class="board-actions tracing-controls-bar">
                            @if (!string.IsNullOrWhiteSpace(Model.TracingAudioUrl))
                            {
                                <button class="tracing-audio clay-button" type="button" title="Nghe hướng dẫn"><span class="material-symbols-outlined">volume_up</span></button>
                            }
                            <button class="tracing-undo clay-button" type="button" title="Hoàn tác nét vẽ"><span class="material-symbols-outlined">undo</span></button>
                            <button class="tracing-clear clay-button" type="button" title="Xóa toàn bộ để vẽ lại"><span class="material-symbols-outlined">delete</span></button>
                        </div>
                        <button class="app-btn tracing-submit-button clay-button" type="submit" disabled>
                            <span class="material-symbols-outlined">check_circle</span>
                            <span>Hoàn thành bài tô</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (Model.CurrentQuestion is not null)
    {
        <form class="choice-board interaction-@Model.Item.InteractionType" asp-controller="Kids" asp-action="Answer" asp-route-id="@Model.Item.Id" asp-route-skillGroupId="@Model.ReturnSkillGroupId" method="post">
            <input type="hidden" name="QuestionId" value="@Model.CurrentQuestion.Id" />
            @if (!string.IsNullOrWhiteSpace(Model.QuestionImageUrl))
            {
                <div class="lesson-content-zone">
                    <img class="story-image lesson-support-image" src="@Model.QuestionImageUrl" alt="@Model.QuestionImageAltText" />
                </div>
            }
            @if (customInteractionTypes.Contains(Model.Item.InteractionType))
            {
                <input type="hidden" name="AnswerValue" data-activity-answer />
                <textarea class="activity-payload" data-activity-payload hidden>@Model.CurrentQuestion.PayloadJson</textarea>
                <div class="lesson-answer-zone">
                    <div class="lesson-answer-content">
                        <div class="activity-runtime" data-activity-runtime data-activity-type="@Model.Item.InteractionType"></div>
                    </div>
                    <button class="app-btn app-btn-wide activity-check-button clay-button" type="submit" disabled data-activity-submit>
                        <span class="material-symbols-outlined">check_circle</span>
                        <span>Kiểm tra đáp án</span>
                    </button>
                </div>
            }
            else
            {
                <div class="lesson-answer-zone">
                    <div class="lesson-answer-content">
                        <div class="choice-grid activity-option-grid">
                            @foreach (var choice in Model.Choices)
                            {
                                <button name="AnswerValue" value="@choice.Value" type="submit" class="activity-option clay-button" data-speak-option="@choice.Text">
                                    <span class="answer-label">@choice.Text</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </form>
    }
</section>

@section Scripts {
    <script src="~/js/learning-voice.js" asp-append-version="true"></script>
    <script src="~/js/tracing-guides.js" asp-append-version="true"></script>
    <script src="~/js/tracing-canvas.js" asp-append-version="true"></script>
    <script src="~/js/learning-activities.js" asp-append-version="true"></script>
    <script src="~/js/learning-success.js" asp-append-version="true"></script>
}
