@model LearnViewModel
@{
    ViewData["Title"] = Model.Item.Title;
    ViewData["FocusMode"] = true;
    var customInteractionTypes = new[]
    {
        InteractionTypes.SingleChoice,
        InteractionTypes.ListenAndChoose,
        InteractionTypes.MultiSelect,
        InteractionTypes.DragDrop,
        InteractionTypes.Matching,
        InteractionTypes.Ordering,
        InteractionTypes.Counting,
        InteractionTypes.QuantityBuilder,
        InteractionTypes.Comparison,
        InteractionTypes.Classification,
        InteractionTypes.StoryChoice
    };
}

<section class="learn-screen learning-focus-shell"
         data-learning-voice
         data-sound-enabled="@(Model.ChildProfile?.SoundEnabled != false ? "true" : "false")"
         data-title-text="@Model.Item.Title"
         data-title-audio-url="@Model.TitleAudioUrl"
         data-instruction-text="@Model.Item.InstructionText"
         data-question-text="@Model.CurrentQuestion?.PromptText"
         data-question-audio-url="@Model.QuestionAudioUrl"
         data-instruction-audio-url="@Model.InstructionAudioUrl"
         data-correct-audio-url="@Model.CorrectFeedbackAudioUrl"
         data-retry-audio-url="@Model.RetryFeedbackAudioUrl"
         data-feedback-text="@Model.FeedbackMessage"
         data-result="@(Model.IsCorrect == true ? "correct" : Model.IsCorrect == false ? "retry" : string.Empty)">
    
    <!-- Topbar Focus Mode (1 Tiêu đề chính + 1 Nút nghe) -->
    <header class="learning-common-zone">
        <div class="learning-focus-topbar">
            @if (Model.ReturnSkillGroupId.HasValue)
            {
                <a class="icon-link learning-back-btn clay-button" asp-controller="Kids" asp-action="Skill" asp-route-id="@Model.ReturnSkillGroupId" title="Quay lại"><span class="material-symbols-outlined">arrow_back</span></a>
            }
            else
            {
                <a class="icon-link learning-back-btn clay-button" asp-controller="Kids" asp-action="Today" title="Quay lại"><span class="material-symbols-outlined">arrow_back</span></a>
            }
            <h1>@(Model.CurrentQuestion?.PromptText ?? Model.Item.Title)</h1>
            <button class="learning-voice-button clay-button" type="button" title="Nghe câu hỏi" data-learning-replay="question">
                <span class="material-symbols-outlined">volume_up</span>
            </button>
        </div>
    </header>

    @if (Model.IsCorrect == true)
    {
        <!-- Màn Hình Chúc Mừng Bé Trả Lời Đúng - RỰC RỠ & SINH ĐỘNG -->
        <div class="answer-celebration-card clay-card" role="status">
            @if (Model.ReturnSkillGroupId.HasValue)
            {
                <!-- Nút Bản Đồ Bài Học Tách Biệt Ở Góc Phải -->
                <a class="celebration-map-corner-btn clay-button" asp-controller="Kids" asp-action="Skill" asp-route-id="@Model.ReturnSkillGroupId" title="Về bản đồ bài học">
                    <span class="material-symbols-outlined">grid_view</span>
                    <span>Bản đồ</span>
                </a>
            }

            <div class="celebration-confetti-wrap">
                <span class="confetti-dot dot-1"></span>
                <span class="confetti-dot dot-2"></span>
                <span class="confetti-dot dot-3"></span>
                <span class="confetti-dot dot-4"></span>
                <span class="confetti-dot dot-5"></span>
            </div>

            <div class="celebration-mascot-wrap">
                <img src="~/images/soc-nau-mascot.png" alt="Sóc Nâu Chúc Mừng" class="celebration-mascot-img pulse-animation" />
                <div class="celebration-star-badge">
                    <span class="material-symbols-outlined">star</span>
                </div>
            </div>

            <h2 class="celebration-title">Xuất Sắc Quá! 🎉</h2>
            <p class="celebration-message">@(string.IsNullOrWhiteSpace(Model.FeedbackMessage) ? "Bé đã trả lời rất chính xác, tiếp tục phát huy nhé!" : Model.FeedbackMessage)</p>

            <div class="celebration-reward-pill">
                <span class="material-symbols-outlined star-icon">stars</span>
                <span>Thưởng <strong>+1 Ngôi Sao Vàng</strong> vào túi quà</span>
            </div>

            <div class="celebration-actions">
                @if (Model.NextItemId.HasValue)
                {
                    <a class="app-btn clay-button celebration-btn-primary" asp-controller="Kids" asp-action="Learn" asp-route-id="@Model.NextItemId" asp-route-skillGroupId="@Model.ReturnSkillGroupId">
                        <span>Sang bài tiếp theo</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </a>
                }
                else if (Model.ReturnSkillGroupId.HasValue)
                {
                    <a class="app-btn clay-button celebration-btn-primary" asp-controller="Kids" asp-action="Skill" asp-route-id="@Model.ReturnSkillGroupId">
                        <span class="material-symbols-outlined">map</span>
                        <span>Về bản đồ hành trình</span>
                    </a>
                }
                else
                {
                    <a class="app-btn clay-button celebration-btn-primary" asp-controller="Kids" asp-action="Summary">
                        <span class="material-symbols-outlined">emoji_events</span>
                        <span>Xem tổng kết quà tặng</span>
                    </a>
                }
            </div>
        </div>
    }

    @if (Model.IsCorrect == false)
    {
        <!-- Banner Động Viên Thân Thiện Khi Làm Chưa Đúng -->
        <div class="answer-retry-toast clay-card" role="alert">
            <img src="~/images/mascot-squirrel-3d.png" alt="Sóc Nâu" class="retry-mascot-img" />
            <div class="retry-text-col">
                <strong>Chưa chính xác rồi, bé đừng lo nhé! 🌱</strong>
                <p>@(string.IsNullOrWhiteSpace(Model.FeedbackMessage) ? "Bé hãy quan sát thật kỹ câu hỏi rồi thử chọn lại nha." : Model.FeedbackMessage)</p>
            </div>
            <button class="sound-button clay-button" type="button" aria-label="Nghe lại hướng dẫn" data-learning-replay="retry">
                <span class="material-symbols-outlined">volume_up</span>
            </button>
        </div>
    }

    @if (Model.IsCorrect != true && Model.Item.InteractionType == InteractionTypes.Tracing)
    {
        <div class="choice-board tracing-lesson-layout interaction-tracing">
            <div class="lesson-answer-zone tracing-answer-zone">
                <div class="tracing-board tracing-canvas-host clay-card"
                     data-tracing-min-points="@Model.TracingMinPoints"
                     data-tracing-expected-strokes="@Model.TracingExpectedStrokeCount"
                     data-tracing-audio-url="@Model.TracingAudioUrl"
                     data-tracing-symbol="@Model.TracingSymbol">
                    @if (!string.IsNullOrWhiteSpace(Model.QuestionImageUrl))
                    {
                        <div class="tracing-corner-flashcard" title="Thẻ mẫu: @Model.QuestionImageAltText">
                            <img class="tracing-corner-image" src="@Model.QuestionImageUrl" alt="@Model.QuestionImageAltText" />
                        </div>
                    }
                    <div class="tracing-guide-overlay" aria-hidden="true"></div>
                    <canvas class="tracing-canvas" width="720" height="720" aria-label="Bảng tô nét"></canvas>
                    <div class="board-actions">
                        @if (!string.IsNullOrWhiteSpace(Model.TracingAudioUrl))
                        {
                            <button class="tracing-audio clay-button" type="button" title="Nghe hướng dẫn"><span class="material-symbols-outlined">volume_up</span></button>
                        }
                        <button class="tracing-undo clay-button" type="button" title="Hoàn tác nét vẽ"><span class="material-symbols-outlined">undo</span></button>
                        <button class="tracing-clear clay-button" type="button" title="Xóa toàn bộ để vẽ lại"><span class="material-symbols-outlined">delete</span></button>
                    </div>
                </div>
                <form class="tracing-submit-form" asp-controller="Kids" asp-action="CompleteTracing" asp-route-id="@Model.Item.Id" asp-route-skillGroupId="@Model.ReturnSkillGroupId" method="post">
                    <input class="tracing-strokes-input" type="hidden" name="StrokeDataJson" value="[]" />
                    <input class="tracing-metrics-input" type="hidden" name="MetricsJson" value="{}" />
                    <p class="tracing-status" aria-live="polite">Bé tô theo nét hướng dẫn ở trên nhé.</p>
                    <button class="app-btn app-btn-wide tracing-submit-button clay-button" type="submit" disabled>
                        <span class="material-symbols-outlined">check_circle</span>
                        <span>Hoàn thành bài tô</span>
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Model.IsCorrect != true && Model.CurrentQuestion is not null)
    {
        <form class="choice-board interaction-@Model.Item.InteractionType" asp-controller="Kids" asp-action="Answer" asp-route-id="@Model.Item.Id" asp-route-skillGroupId="@Model.ReturnSkillGroupId" method="post">
            <input type="hidden" name="QuestionId" value="@Model.CurrentQuestion.Id" />
            @if (!string.IsNullOrWhiteSpace(Model.QuestionImageUrl))
            {
                <div class="lesson-content-zone">
                    <img class="story-image lesson-support-image" src="@Model.QuestionImageUrl" alt="@Model.QuestionImageAltText" />
                </div>
            }
            @if (customInteractionTypes.Contains(Model.Item.InteractionType))
            {
                <input type="hidden" name="AnswerValue" data-activity-answer />
                <textarea class="activity-payload" data-activity-payload hidden>@Model.CurrentQuestion.PayloadJson</textarea>
                <div class="lesson-answer-zone">
                    <div class="lesson-answer-content">
                        <div class="activity-runtime" data-activity-runtime data-activity-type="@Model.Item.InteractionType"></div>
                    </div>
                    <button class="app-btn app-btn-wide activity-check-button clay-button" type="submit" disabled data-activity-submit>
                        <span class="material-symbols-outlined">check_circle</span>
                        <span>Kiểm tra đáp án</span>
                    </button>
                </div>
            }
            else
            {
                <div class="lesson-answer-zone">
                    <div class="lesson-answer-content">
                        <div class="choice-grid activity-option-grid">
                            @foreach (var choice in Model.Choices)
                            {
                                <button name="AnswerValue" value="@choice.Value" type="submit" class="activity-option clay-button" data-speak-option="@choice.Text">
                                    <span class="answer-label">@choice.Text</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </form>
    }
</section>

@section Scripts {
    <script src="~/js/learning-voice.js" asp-append-version="true"></script>
    <script src="~/js/tracing-canvas.js" asp-append-version="true"></script>
    <script src="~/js/learning-activities.js" asp-append-version="true"></script>
}
