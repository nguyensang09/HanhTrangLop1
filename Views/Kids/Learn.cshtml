@model LearnViewModel
@{
    ViewData["Title"] = Model.Item.Title;
    var customInteractionTypes = new[]
    {
        InteractionTypes.ListenAndChoose,
        InteractionTypes.MultiSelect,
        InteractionTypes.DragDrop,
        InteractionTypes.Matching,
        InteractionTypes.Ordering,
        InteractionTypes.Counting,
        InteractionTypes.QuantityBuilder,
        InteractionTypes.Comparison,
        InteractionTypes.Classification,
        InteractionTypes.StoryChoice
    };
}

<section class="learn-screen">
    <div class="kid-topbar">
        @if (Model.ReturnSkillGroupId.HasValue)
        {
            <a class="icon-link" asp-controller="Kids" asp-action="Skill" asp-route-id="@Model.ReturnSkillGroupId"><span class="material-symbols-outlined">arrow_back</span></a>
        }
        else
        {
            <a class="icon-link" asp-controller="Kids" asp-action="Today"><span class="material-symbols-outlined">arrow_back</span></a>
        }
        <h1>@Model.Item.Title</h1>
        <div class="star-pill"><span class="material-symbols-outlined">star</span>125</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
    {
        <div class="feedback-band @(Model.IsCorrect == true ? "success" : "retry")">
            <span class="material-symbols-outlined">@(Model.IsCorrect == true ? "celebration" : "tips_and_updates")</span>
            <strong>@Model.FeedbackMessage</strong>
        </div>
    }

    <div class="instruction-band">
        <span class="material-symbols-outlined">volume_up</span>
        <strong>@Model.Item.InstructionText</strong>
    </div>

    @if (Model.Item.InteractionType == InteractionTypes.Tracing)
    {
        <div class="tracing-board tracing-canvas-host"
             data-tracing-min-points="@Model.TracingMinPoints"
             data-tracing-expected-strokes="@Model.TracingExpectedStrokeCount"
             data-tracing-audio-url="@Model.TracingAudioUrl"
             data-tracing-symbol="@Model.TracingSymbol">
            @if (Model.TracingGuideMode == "outline")
            {
                <div class="trace-letter outline-guide">@Model.TracingSymbol</div>
            }
            @if (Model.TracingShowStartPoint)
            {
                <div class="trace-start"></div>
            }
            <canvas class="tracing-canvas" width="720" height="720" aria-label="Bảng tô nét"></canvas>
            <div class="board-actions">
                @if (!string.IsNullOrWhiteSpace(Model.TracingAudioUrl))
                {
                    <button class="tracing-audio" type="button" title="Nghe hướng dẫn"><span class="material-symbols-outlined">volume_up</span></button>
                }
                <button class="tracing-undo" type="button" title="Hoàn tác"><span class="material-symbols-outlined">undo</span></button>
                <button class="tracing-clear" type="button" title="Xóa nét"><span class="material-symbols-outlined">delete</span></button>
            </div>
        </div>
        <form class="tracing-submit-form" asp-controller="Kids" asp-action="CompleteTracing" asp-route-id="@Model.Item.Id" asp-route-skillGroupId="@Model.ReturnSkillGroupId" method="post">
            <input class="tracing-strokes-input" type="hidden" name="StrokeDataJson" value="[]" />
            <input class="tracing-metrics-input" type="hidden" name="MetricsJson" value="{}" />
            <p class="tracing-status">Con tô theo nét gợi ý nhé.</p>
            <button class="app-btn app-btn-wide tracing-submit-button" type="submit" disabled>Con đã tô xong</button>
        </form>
    }
    else if (Model.CurrentQuestion is not null)
    {
        <form class="choice-board interaction-@Model.Item.InteractionType" asp-controller="Kids" asp-action="Answer" asp-route-id="@Model.Item.Id" asp-route-skillGroupId="@Model.ReturnSkillGroupId" method="post">
            <input type="hidden" name="QuestionId" value="@Model.CurrentQuestion.Id" />
            <div class="interaction-badge">
                <span class="material-symbols-outlined">
                    @(Model.Item.InteractionType == InteractionTypes.ListenAndChoose ? "hearing" :
                        Model.Item.InteractionType == InteractionTypes.MultiSelect ? "checklist" :
                        Model.Item.InteractionType == InteractionTypes.DragDrop ? "drag_indicator" :
                        Model.Item.InteractionType == InteractionTypes.Matching ? "conversion_path" :
                        Model.Item.InteractionType == InteractionTypes.Ordering ? "sort" :
                        Model.Item.InteractionType == InteractionTypes.Counting ? "counter_1" :
                        Model.Item.InteractionType == InteractionTypes.QuantityBuilder ? "shopping_basket" :
                        Model.Item.InteractionType == InteractionTypes.Comparison ? "compare_arrows" :
                        Model.Item.InteractionType == InteractionTypes.Classification ? "category" :
                        Model.Item.InteractionType == InteractionTypes.StoryChoice ? "auto_stories" : "touch_app")
                </span>
                <strong>
                    @(Model.Item.InteractionType == InteractionTypes.ListenAndChoose ? "Nghe - chọn" :
                        Model.Item.InteractionType == InteractionTypes.MultiSelect ? "Chọn nhiều" :
                        Model.Item.InteractionType == InteractionTypes.DragDrop ? "Kéo - thả" :
                        Model.Item.InteractionType == InteractionTypes.Matching ? "Nối cặp" :
                        Model.Item.InteractionType == InteractionTypes.Ordering ? "Sắp xếp" :
                        Model.Item.InteractionType == InteractionTypes.Counting ? "Đếm đồ vật" :
                        Model.Item.InteractionType == InteractionTypes.QuantityBuilder ? "Tạo số lượng" :
                        Model.Item.InteractionType == InteractionTypes.Comparison ? "So sánh" :
                        Model.Item.InteractionType == InteractionTypes.Classification ? "Phân loại" :
                        Model.Item.InteractionType == InteractionTypes.StoryChoice ? "Nghe truyện" : "Chọn đáp án")
                </strong>
            </div>
            <h2>@Model.CurrentQuestion.PromptText</h2>
            @if (!string.IsNullOrWhiteSpace(Model.QuestionImageUrl))
            {
                <img class="story-image" src="@Model.QuestionImageUrl" alt="Hình minh họa bài học" />
            }
            @if (customInteractionTypes.Contains(Model.Item.InteractionType))
            {
                <input type="hidden" name="AnswerValue" data-activity-answer />
                <textarea class="activity-payload" data-activity-payload hidden>@Model.CurrentQuestion.PayloadJson</textarea>
                <div class="activity-runtime" data-activity-runtime data-activity-type="@Model.Item.InteractionType"></div>
                <button class="app-btn app-btn-wide activity-check-button" type="submit" disabled data-activity-submit>Kiểm tra</button>
            }
            else
            {
                <div class="choice-grid">
                    @foreach (var choice in Model.Choices)
                    {
                        <button name="AnswerValue" value="@choice.Value" type="submit">@choice.Text</button>
                    }
                </div>
            }
        </form>
    }

    @if (Model.IsCorrect == true && Model.NextItemId.HasValue)
    {
        <a class="app-btn app-btn-wide" asp-controller="Kids" asp-action="Learn" asp-route-id="@Model.NextItemId" asp-route-skillGroupId="@Model.ReturnSkillGroupId">Tiếp tục</a>
    }
    else if (Model.IsCorrect == true && Model.ReturnSkillGroupId.HasValue)
    {
        <a class="app-btn app-btn-wide" asp-controller="Kids" asp-action="Skill" asp-route-id="@Model.ReturnSkillGroupId">Về danh sách bài</a>
    }
    else if (Model.IsCorrect == true)
    {
        <a class="app-btn app-btn-wide" asp-controller="Kids" asp-action="Summary">Xem tổng kết</a>
    }
    else
    {
        <button class="app-btn app-btn-wide disabled-button" disabled>Tiếp tục</button>
    }
</section>

@section Scripts {
    @if (Model.Item.InteractionType == InteractionTypes.Tracing)
    {
        <script src="~/js/tracing-canvas.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/learning-activities.js" asp-append-version="true"></script>
    }
}
