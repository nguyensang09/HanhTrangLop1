@model KidsRewardsViewModel
@{
    ViewData["Title"] = "Kho Quà & Thành Tích Của Bé";
    var earnedCount = Model.Badges.Count(x => x.IsEarned);
    var totalCount = Model.Badges.Count;
    var inventoryCount = Model.Badges.Count(x => x.IsEarned && x.Definition.RewardType == "item");
    var gardenItems = Model.Badges.Where(x => x.Definition.RewardType == "item").ToList();
    var totalGardenItems = gardenItems.Count;
    var badgesOnlyCount = Model.Badges.Count(x => x.Definition.RewardType == "badge");

    // Level calculation from TotalStars
    var (levelName, levelBadge, levelIcon) = Model.TotalStars switch
    {
        >= 150 => ("Phù Thủy Tí Hon Đại Tài", "Hạng Kim Cương", "💎"),
        >= 80  => ("Hiệp Sĩ Tri Thức", "Hạng Vàng", "🥇"),
        >= 30  => ("Nhà Thám Hiểm Nhí", "Hạng Bạc", "🥈"),
        _      => ("Bé Tập Sự Thông Thái", "Hạng Đồng", "🥉")
    };

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" or "meo-con" => "/images/avatars/avatar-cat.png",
            "avatar-dog" or "cun-con" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    string ResolveRewardIcon(string? iconKey)
    {
        if (string.IsNullOrWhiteSpace(iconKey)) return "military_tech";
        return iconKey.Trim().ToLowerInvariant() switch
        {
            "royalty" => "crown",
            "trophy" => "emoji_events",
            "nature" => "park",
            _ => iconKey
        };
    }
}

@{
    var childName = string.IsNullOrWhiteSpace(Model.ChildProfile?.Nickname) ? "Bé" : Model.ChildProfile!.Nickname.Trim();
    var hasChests = Model.ClaimableGrants.Count > 0;
    var guideText = hasChests
        ? $"{childName} ơi, có {Model.ClaimableGrants.Count} rương báu đang chờ con mở đó! Chạm vào nút “Mở ngay” nhé! 🎁"
        : $"Chào {childName}! Cứ học xong 10 bài trong một nhóm là một rương báu thần kỳ sẽ xuất hiện ở đây! ✨";
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/kid-hub.css" asp-append-version="true" />

<div class="kh kh-rewards kh--with-dock">
    <div class="kh-sky" aria-hidden="true">
        <span class="kh-cloud kh-cloud--1"></span>
        <span class="kh-cloud kh-cloud--2"></span>
        <span class="kh-cloud kh-cloud--3"></span>
        <span class="kh-float kh-float--1">🎁</span>
        <span class="kh-float kh-float--2">🏅</span>
        <span class="kh-float kh-float--3">🌻</span>
        <span class="kh-float kh-float--4">✨</span>
    </div>

    @if (TempData["RewardMessage"] is string rewardMessage)
    {
        <div class="kh-notice" id="rewardNotice" role="status">
            <span class="material-symbols-outlined" aria-hidden="true">celebration</span>
            <strong>@rewardMessage</strong>
        </div>
    }

    <header class="kh-topbar">
        <a class="kh-pill" asp-controller="Kids" asp-action="Home" title="Về trang chủ bé học" aria-label="Trang chủ" onclick="playAudioChime('click')">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span><span class="kh-hide-sm">Trang chủ</span>
        </a>
        <a class="kh-avatar" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bé khác" aria-label="Đổi bé khác">
            <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Avatar bé" />
            <span class="kh-avatar-badge material-symbols-outlined" aria-hidden="true">sync_alt</span>
        </a>
        <div class="kh-brand">
            <span class="kh-brand-mark" aria-hidden="true">🏆</span>
            <span class="kh-brand-text">
                <small>Kho Quà Vinh Dự</small>
                <strong>Bộ Sưu Tập Của Bé</strong>
            </span>
        </div>
        <div class="kh-pill kh-pill--stars" title="Số danh hiệu đã mở khóa">
            <span aria-hidden="true">🎖️</span><strong>@earnedCount/@totalCount</strong>
        </div>
        <button type="button" class="kh-pill kh-pill--lock" onclick="openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh (Cần giải phép tính)" aria-label="Góc phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span><span class="kh-hide-sm">Ba mẹ</span>
        </button>
    </header>

    <!-- Sóc Nâu + hạng của bé + 3 con số nổi bật -->
    <section class="kh-hero">
        <div class="kh-guide">
            <img class="kh-guide-img" src="~/images/soc-nau-mascot.png" onerror="this.src='/images/mascot-squirrel-3d.png'" alt="Sóc Nâu" />
            <div class="kh-guide-copy">
                <span class="kh-level-pill"><span aria-hidden="true">@levelIcon</span><span>@levelBadge • @levelName</span></span>
                <p class="kh-bubble">@guideText</p>
            </div>
        </div>
        <div class="kh-hero-card">
            <div class="kh-stats">
                <div class="kh-stat">
                    <span class="kh-stat-icon" aria-hidden="true">⭐</span>
                    <strong>@Model.TotalStars</strong>
                    <span>Tổng sao</span>
                </div>
                <div class="kh-stat kh-stat--violet">
                    <span class="kh-stat-icon" aria-hidden="true">🎖️</span>
                    <strong>@earnedCount/@totalCount</strong>
                    <span>Huy hiệu</span>
                </div>
                <div class="kh-stat kh-stat--good">
                    <span class="kh-stat-icon" aria-hidden="true">🌻</span>
                    <strong>@inventoryCount/@totalGardenItems</strong>
                    <span>Kỳ quan</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Rương báu đang chờ mở -->
    <section class="kh-panel kh-panel--chests @(hasChests ? "has-chests" : "")">
        <div class="kh-panel-head">
            <span class="kh-panel-emoji" aria-hidden="true">🎁</span>
            <div class="kh-panel-title">
                <h2>@(hasChests ? "Rương Báu Đang Chờ Bé Mở!" : "Hộp Quà Thần Bí Đang Chờ Đón")</h2>
                <p>@(hasChests ? "Bé đã xuất sắc đạt mốc học tập. Chạm vào rương để mở quà nhé!" : "Cứ hoàn thành 10 bài trong mỗi nhóm môn, bé sẽ nhận được một chiếc rương báu!")</p>
            </div>
            @if (hasChests)
            {
                <span class="kh-chip kh-chip--gold">✨ Có @Model.ClaimableGrants.Count rương sẵn sàng</span>
            }
        </div>

        @if (hasChests)
        {
            <div class="kh-chests">
                @foreach (var item in Model.ClaimableGrants)
                {
                    <article class="kh-chest">
                        <div class="kh-chest-art" aria-hidden="true">
                            🎁
                            <span class="material-symbols-outlined">@ResolveRewardIcon(item.Reward.IconKey)</span>
                        </div>
                        <div class="kh-chest-info">
                            <strong>@item.Reward.Name</strong>
                            <small>@item.SkillName • Mốc @item.Grant.MilestoneValue bài</small>
                        </div>
                        <form asp-action="ClaimReward" asp-route-grantId="@item.Grant.Id" method="post" class="kh-chest-form" onsubmit="onClaimChest(event, this)">
                            <button type="submit" class="kh-big-btn kh-big-btn--gold">
                                <span>Mở ngay</span>
                                <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                            </button>
                        </form>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="kh-empty">
                <span class="kh-empty-icon" aria-hidden="true">🧰</span>
                <div>
                    <strong>Chưa có rương báu nào đang chờ mở lúc này</strong>
                    <p>Bé hãy tiếp tục học thêm các bài mới ở phần Bài Học nhé. Mỗi nhóm môn cứ đủ 10 bài là rương vàng sẽ tự động xuất hiện tại đây!</p>
                </div>
            </div>
        }
    </section>

    <!-- Khu vườn của bé -->
    <section class="kh-panel">
        <div class="kh-panel-head">
            <span class="kh-panel-emoji" aria-hidden="true">🌻</span>
            <div class="kh-panel-title">
                <h2>Khu Vườn Của Bé</h2>
                <p>Mỗi vật phẩm kỳ diệu được ươm mầm khi bé đạt các mốc 10 bài học</p>
            </div>
            <span class="kh-chip kh-chip--good">🌸 Đã nở hoa @inventoryCount/@totalGardenItems</span>
        </div>

        <div class="kh-garden">
            @foreach (var badge in gardenItems)
            {
                var icon = ResolveRewardIcon(badge.Definition.IconKey);
                <div class="kh-prize kh-prize--garden @(badge.IsEarned ? "is-unlocked" : "is-locked")"
                     role="button"
                     data-badge-name="@badge.Definition.Name"
                     data-badge-category="Vật phẩm khu vườn"
                     data-badge-icon="@icon"
                     data-badge-rule="@badge.Definition.RuleJson"
                     data-is-earned="@(badge.IsEarned ? "true" : "false")"
                     data-earned-at="@(badge.EarnedAt.HasValue ? badge.EarnedAt.Value.ToString("dd/MM/yyyy") : "")"
                     onclick="openBadgeModal(this)"
                     title="Bấm để xem chi tiết @badge.Definition.Name">
                    <div class="kh-prize-medal">
                        <span class="material-symbols-outlined" aria-hidden="true">@icon</span>
                        @if (badge.IsEarned)
                        {
                            <span class="kh-prize-tag" aria-hidden="true">✨</span>
                        }
                        else
                        {
                            <span class="kh-prize-tag material-symbols-outlined" aria-hidden="true">lock</span>
                        }
                    </div>
                    <strong class="kh-prize-name">@badge.Definition.Name</strong>
                    <span class="kh-prize-state">@(badge.IsEarned ? "🌸 Đã nở hoa" : "🌱 Chưa ươm mầm")</span>
                </div>
            }
        </div>
    </section>

    <!-- Hành trình mở rương theo nhóm môn -->
    <section class="kh-panel">
        <div class="kh-panel-head">
            <span class="kh-panel-emoji" aria-hidden="true">🗺️</span>
            <div class="kh-panel-title">
                <h2>Hành Trình Mở Rương Theo Nhóm</h2>
                <p>Theo dõi tiến độ hoàn thành bài học để chạm tới rương quà tiếp theo</p>
            </div>
        </div>

        <div class="kh-journey">
            @foreach (var skill in Model.SkillProgress)
            {
                var target = Math.Min(skill.NextMilestone, Math.Max(skill.TotalLessons, 10));
                var remaining = Math.Max(0, target - skill.UniqueCompleted);
                var segmentPercent = skill.TotalLessons < 10
                    ? (skill.TotalLessons == 0 ? 0 : (int)Math.Round(skill.UniqueCompleted * 100d / skill.TotalLessons))
                    : skill.CurrentSegmentProgress * 10;

                <a class="kh-journey-card" asp-controller="Kids" asp-action="Skill" asp-route-id="@skill.SkillGroupId" style="--skill-color:@skill.Color" onclick="playAudioChime('tap')">
                    <span class="kh-journey-icon" aria-hidden="true">
                        <span class="material-symbols-outlined">@skill.IconKey</span>
                    </span>
                    <span class="kh-journey-copy">
                        <strong>@skill.SkillName</strong>
                        <span>Đã làm: @skill.UniqueCompleted/@skill.TotalLessons bài</span>
                        <span class="kh-journey-track"><span style="width:@Math.Clamp(segmentPercent, 0, 100)%"></span></span>
                        <small>@(skill.TotalLessons < 10 ? "Hoàn thành nhóm để nhận huy hiệu" : remaining == 0 ? "🎉 Rương đã sẵn sàng!" : $"Còn {remaining} bài nữa để mở rương mốc {target}")</small>
                    </span>
                    <span class="kh-journey-go material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
            }
        </div>
    </section>

    <!-- Rương vừa mở gần đây -->
    @if (Model.RecentClaimedGrants.Count > 0)
    {
        <section class="kh-panel">
            <div class="kh-panel-head">
                <span class="kh-panel-emoji" aria-hidden="true">🕰️</span>
                <div class="kh-panel-title">
                    <h2>Rương Vừa Mở Gần Đây</h2>
                    <p>Những dấu mốc chiến tích đáng tự hào của bé</p>
                </div>
            </div>
            <div class="kh-history">
                @foreach (var item in Model.RecentClaimedGrants)
                {
                    <div class="kh-history-item">
                        <span class="material-symbols-outlined" aria-hidden="true">@ResolveRewardIcon(item.Reward.IconKey)</span>
                        <div>
                            <strong>@item.Reward.Name</strong>
                            <small>@item.SkillName • Mốc @item.Grant.MilestoneValue bài</small>
                        </div>
                        <time datetime="@item.Grant.ClaimedAt?.ToString("O")">@item.Grant.ClaimedAt?.ToString("dd/MM")</time>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Bộ sưu tập huy hiệu & vật phẩm -->
    <section class="kh-panel">
        <div class="kh-panel-head">
            <span class="kh-panel-emoji" aria-hidden="true">🏅</span>
            <div class="kh-panel-title">
                <h2>Tủ Huy Hiệu Của Bé</h2>
                <p>Chạm vào từng huy hiệu để xem cách mở khóa nhé!</p>
            </div>
        </div>

        <div class="kh-tabs" role="tablist" aria-label="Lọc bộ sưu tập">
            <button type="button" class="kh-tab active" onclick="filterRewards('all', this)">
                <span class="material-symbols-outlined" aria-hidden="true">stars</span>
                <span>Tất cả (@totalCount)</span>
            </button>
            <button type="button" class="kh-tab" onclick="filterRewards('badge', this)">
                <span class="material-symbols-outlined" aria-hidden="true">military_tech</span>
                <span>Huy hiệu học tập (@badgesOnlyCount)</span>
            </button>
            <button type="button" class="kh-tab" onclick="filterRewards('item', this)">
                <span class="material-symbols-outlined" aria-hidden="true">park</span>
                <span>Vật phẩm khu vườn (@totalGardenItems)</span>
            </button>
            <button type="button" class="kh-tab" onclick="filterRewards('earned', this)">
                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                <span>Đã đạt (@earnedCount)</span>
            </button>
            <button type="button" class="kh-tab" onclick="filterRewards('locked', this)">
                <span class="material-symbols-outlined" aria-hidden="true">lock</span>
                <span>Chưa mở (@(totalCount - earnedCount))</span>
            </button>
        </div>

        <div class="kh-collection" id="rewardsCollectionGrid">
            @foreach (var badge in Model.Badges)
            {
                var isItem = badge.Definition.RewardType == "item";
                var categoryLabel = isItem ? "Vật phẩm khu vườn" : "Huy hiệu vinh dự";
                var icon = ResolveRewardIcon(badge.Definition.IconKey);

                <div class="kh-prize @(isItem ? "kh-prize--garden" : "") @(badge.IsEarned ? "is-unlocked" : "is-locked")"
                     role="button"
                     data-reward-type="@badge.Definition.RewardType"
                     data-is-earned="@(badge.IsEarned ? "true" : "false")"
                     data-badge-name="@badge.Definition.Name"
                     data-badge-category="@categoryLabel"
                     data-badge-icon="@icon"
                     data-badge-rule="@badge.Definition.RuleJson"
                     data-earned-at="@(badge.EarnedAt.HasValue ? badge.EarnedAt.Value.ToString("dd/MM/yyyy") : "")"
                     onclick="openBadgeModal(this)">
                    <div class="kh-prize-medal">
                        <span class="material-symbols-outlined" aria-hidden="true">@icon</span>
                        @if (badge.IsEarned)
                        {
                            <span class="kh-prize-tag" aria-hidden="true">✨</span>
                        }
                        else
                        {
                            <span class="kh-prize-tag material-symbols-outlined" aria-hidden="true">lock</span>
                        }
                    </div>
                    <strong class="kh-prize-name">@badge.Definition.Name</strong>
                    <span class="kh-prize-cat">@categoryLabel</span>
                    <p class="kh-prize-rule">@badge.Definition.RuleJson</p>
                    @if (badge.IsEarned)
                    {
                        <span class="kh-prize-state">
                            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                            <span>Đã đạt @(badge.EarnedAt.HasValue ? $"• {badge.EarnedAt.Value:dd/MM}" : "")</span>
                        </span>
                    }
                    else
                    {
                        <span class="kh-prize-state">
                            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
                            <span>Chưa mở</span>
                        </span>
                    }
                </div>
            }
        </div>
    </section>

    <!-- Hộp chi tiết huy hiệu (site.css .badge-modal-overlay lo ẩn/hiện qua lớp is-active) -->
    <div class="badge-modal-overlay" id="badgeDetailModal" onclick="onModalOverlayClick(event)">
        <div class="kh-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
            <button type="button" class="kh-modal-close" onclick="closeBadgeModal()" aria-label="Đóng chi tiết">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>

            <div class="kh-modal-halo" id="modalHalo">
                <span class="material-symbols-outlined" id="modalIcon">military_tech</span>
            </div>

            <h3 id="modalTitle">Tên huy hiệu</h3>
            <span class="kh-modal-cat" id="modalCategory">Huy hiệu vinh dự</span>

            <div class="kh-modal-rule">
                <div class="kh-modal-rule-label">
                    <span class="material-symbols-outlined" aria-hidden="true">target</span>
                    <span>Điều kiện đạt được</span>
                </div>
                <p id="modalRule">Quy tắc mở khóa...</p>
            </div>

            <div class="kh-modal-speech">
                <img src="~/images/soc-nau-mascot.png" onerror="this.src='/images/mascot-squirrel-3d.png'" alt="Sóc Nâu" />
                <p id="modalSpeech">"Bé hãy cố gắng nhé! Sóc Nâu luôn đồng hành cùng bé trên từng bài học!"</p>
            </div>

            <button type="button" class="kh-big-btn kh-big-btn--violet" onclick="closeBadgeModal()">
                Đã hiểu rồi, cảm ơn Sóc Nâu! ✨
            </button>
        </div>
    </div>

    <!-- Canvas cho hiệu ứng pháo hoa Confetti -->
    <canvas id="confettiCanvas"></canvas>

    <!-- Thanh điều hướng dưới của khu bé -->
    <nav class="kid-bottom-nav kh-dock" aria-label="Điều hướng">
        <a asp-controller="Kids" asp-action="Home" onclick="playAudioChime('tap')">
            <span class="material-symbols-outlined" aria-hidden="true">home</span>
            <span>Trang chủ</span>
        </a>
        <a asp-controller="Kids" asp-action="Today" onclick="playAudioChime('tap')">
            <span class="material-symbols-outlined" aria-hidden="true">map</span>
            <span>Bài tập</span>
        </a>
        <a class="active" asp-controller="Kids" asp-action="Rewards" aria-current="page">
            <span class="material-symbols-outlined" aria-hidden="true">emoji_events</span>
            <span>Quà tặng</span>
        </a>
        <a href="#" onclick="openParentGate('/parent/dashboard'); return false;" title="Cổng mở khóa cho phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <span>Phụ huynh</span>
        </a>
    </nav>
</div>

@section Scripts {
    <script>
        (function () {
            // Web Audio API Synthesizer
            let audioCtx = null;
            function getAudioContext() {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (AudioContextClass) audioCtx = new AudioContextClass();
                }
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                return audioCtx;
            }

            window.playAudioChime = function (type) {
                try {
                    const ctx = getAudioContext();
                    if (!ctx) return;
                    const now = ctx.currentTime;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    if (type === 'tap') {
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(523.25, now);
                        osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.08);
                        gain.gain.setValueAtTime(0.15, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
                        osc.start(now);
                        osc.stop(now + 0.1);
                    } else if (type === 'click') {
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(440, now);
                        gain.gain.setValueAtTime(0.1, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
                        osc.start(now);
                        osc.stop(now + 0.06);
                    } else if (type === 'start') {
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(440, now);
                        osc.frequency.exponentialRampToValueAtTime(880, now + 0.18);
                        gain.gain.setValueAtTime(0.18, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
                        osc.start(now);
                        osc.stop(now + 0.22);
                    } else if (type === 'celebrate') {
                        const notes = [523.25, 659.25, 783.99, 1046.50, 1318.51];
                        notes.forEach((freq, idx) => {
                            const o = ctx.createOscillator();
                            const g = ctx.createGain();
                            o.type = 'triangle';
                            o.frequency.setValueAtTime(freq, now + idx * 0.07);
                            g.gain.setValueAtTime(0.18, now + idx * 0.07);
                            g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.07 + 0.18);
                            o.connect(g);
                            g.connect(ctx.destination);
                            o.start(now + idx * 0.07);
                            o.stop(now + idx * 0.07 + 0.18);
                        });
                    }
                } catch (e) {
                    console.warn("Audio chime error:", e);
                }
            };

            // Confetti Particle System
            window.launchConfetti = function () {
                const canvas = document.getElementById('confettiCanvas');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;

                const colors = ['#f59e0b', '#10b981', '#3b82f6', '#ec4899', '#8b5cf6', '#ef4444', '#facc15'];
                const particles = [];
                for (let i = 0; i < 90; i++) {
                    particles.push({
                        x: canvas.width / 2 + (Math.random() - 0.5) * 200,
                        y: canvas.height / 2 - 100,
                        vx: (Math.random() - 0.5) * 16,
                        vy: (Math.random() - 1) * 14 - 3,
                        color: colors[Math.floor(Math.random() * colors.length)],
                        size: Math.random() * 8 + 6,
                        tilt: Math.random() * 10,
                        tiltAngle: Math.random() * Math.PI,
                        tiltAngleInc: Math.random() * 0.08 + 0.04,
                        opacity: 1
                    });
                }

                let animationFrameId;
                const startTime = Date.now();

                function render() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    let alive = false;

                    particles.forEach(p => {
                        p.x += p.vx;
                        p.y += p.vy;
                        p.vy += 0.35; // gravity
                        p.tiltAngle += p.tiltAngleInc;
                        p.tilt = Math.sin(p.tiltAngle) * 12;

                        if (p.y < canvas.height && p.opacity > 0) {
                            alive = true;
                            ctx.fillStyle = p.color;
                            ctx.beginPath();
                            ctx.ellipse(p.x, p.y, p.size, p.size / 2, p.tiltAngle, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    });

                    if (alive && Date.now() - startTime < 3500) {
                        animationFrameId = requestAnimationFrame(render);
                    } else {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                    }
                }

                cancelAnimationFrame(animationFrameId);
                render();
            };

            // Filter Tabs
            window.filterRewards = function (filter, btn) {
                playAudioChime('click');
                document.querySelectorAll(".kh-tab").forEach(el => el.classList.remove("active"));
                if (btn) btn.classList.add("active");

                const cards = document.querySelectorAll("#rewardsCollectionGrid .kh-prize");
                cards.forEach(card => {
                    const type = card.getAttribute("data-reward-type");
                    const isEarned = card.getAttribute("data-is-earned") === "true";

                    if (filter === "all") {
                        card.style.display = "flex";
                    } else if (filter === "badge" && type === "badge") {
                        card.style.display = "flex";
                    } else if (filter === "item" && type === "item") {
                        card.style.display = "flex";
                    } else if (filter === "earned" && isEarned) {
                        card.style.display = "flex";
                    } else if (filter === "locked" && !isEarned) {
                        card.style.display = "flex";
                    } else {
                        card.style.display = "none";
                    }
                });
            };

            // Modal Popup Handling
            window.openBadgeModal = function (card) {
                if (!card) return;
                playAudioChime('tap');
                const name = card.getAttribute("data-badge-name") || "Huy hiệu";
                const category = card.getAttribute("data-badge-category") || "Huy hiệu vinh dự";
                const icon = card.getAttribute("data-badge-icon") || "military_tech";
                const rule = card.getAttribute("data-badge-rule") || "";
                const isEarned = card.getAttribute("data-is-earned") === "true";
                const earnedAt = card.getAttribute("data-earned-at") || "";

                openBadgeModalFromData(name, category, icon, rule, isEarned, earnedAt);
            };

            window.openBadgeModalFromData = function (name, category, icon, rule, isEarned, earnedAt) {
                playAudioChime('tap');
                const modal = document.getElementById("badgeDetailModal");
                if (!modal) return;

                document.getElementById("modalTitle").textContent = name;
                document.getElementById("modalCategory").textContent = category;
                document.getElementById("modalIcon").textContent = icon;
                document.getElementById("modalRule").textContent = rule || "Chăm chỉ học tập các bài học tương ứng để mở khóa!";

                const halo = document.getElementById("modalHalo");
                const speech = document.getElementById("modalSpeech");

                if (isEarned) {
                    halo.classList.remove("is-locked");
                    const dateMsg = earnedAt ? ` vào ngày ${earnedAt}` : "";
                    speech.textContent = `Tuyệt vời lắm bé yêu! Bé đã xuất sắc mở khóa danh hiệu này${dateMsg}. Hãy tự hào về nỗ lực của mình nhé!`;
                } else {
                    halo.classList.add("is-locked");
                    speech.textContent = `Bé ơi, danh hiệu này đang chờ bé rinh về đó! Hãy hoàn thành các bài học tương ứng để mở khóa nhé!`;
                }

                modal.classList.add("is-active");
            };

            window.closeBadgeModal = function () {
                playAudioChime('click');
                const modal = document.getElementById("badgeDetailModal");
                if (modal) modal.classList.remove("is-active");
            };

            window.onModalOverlayClick = function (e) {
                if (e.target.id === 'badgeDetailModal') {
                    closeBadgeModal();
                }
            };

            // Chest Claim Action
            window.onClaimChest = function (e, form) {
                playAudioChime('celebrate');
                launchConfetti();
            };

            // Trigger celebration on load if there's a success notice
            document.addEventListener('DOMContentLoaded', () => {
                const notice = document.getElementById('rewardNotice');
                if (notice) {
                    playAudioChime('celebrate');
                    launchConfetti();
                }
            });
        })();
    </script>
}
