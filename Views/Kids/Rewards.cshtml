@model KidsRewardsViewModel
@{
    ViewData["Title"] = "Quà tặng & Huy hiệu của bé";
    var earnedCount = Model.Badges.Count(x => x.IsEarned);
    var totalCount = Model.Badges.Count;
    var inventoryCount = Model.Badges.Count(x => x.IsEarned && x.Definition.RewardType == "item");

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" or "meo-con" => "/images/avatars/avatar-cat.png",
            "avatar-dog" or "cun-con" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }
}

<section class="kid-screen kid-rewards-screen">
    @if (TempData["RewardMessage"] is string rewardMessage)
    {
        <div class="reward-success-notice clay-card" role="status">
            <span class="material-symbols-outlined">celebration</span>
            <strong>@rewardMessage</strong>
        </div>
    }
    <!-- Topbar chuẩn không gian bé -->
    <header class="child-zone-header clay-card">
        <div class="child-header-left">
            <a class="child-back-home-btn" asp-controller="Kids" asp-action="Home" title="Về trang chủ bé học" aria-label="Trang chủ">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <a class="child-avatar-touch" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bé khác">
                <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Avatar bé" class="child-avatar-img" />
                <span class="child-avatar-switch-badge" title="Đổi bé">
                    <span class="material-symbols-outlined">sync_alt</span>
                </span>
            </a>
            <div class="child-header-greeting">
                <span class="child-hi-eyebrow">Bộ sưu tập thành tích</span>
                <strong class="child-name-display">Kho Quà Của Bé 🏆</strong>
            </div>
        </div>
        <div class="child-header-center">
            <div class="child-star-badge-3d" title="Số danh hiệu đã mở khóa">
                <span class="star-3d-icon">⭐</span>
                <span class="star-number-display">@earnedCount/@totalCount</span>
                <span class="star-label-text">đã mở khóa</span>
            </div>
        </div>
        <div class="child-header-right">
            <button type="button" class="child-lock-gate-btn" onclick="openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh (Cần giải phép tính)" aria-label="Góc phụ huynh">
                <span class="material-symbols-outlined lock-icon">lock</span>
                <span class="lock-label-text">Ba mẹ</span>
            </button>
        </div>
    </header>

    <!-- Garden Welcome Banner -->
    <div class="summary-hero-card clay-card">
        <div class="summary-mascot-wrap">
            <img src="~/images/soc-nau-mascot.png" alt="Sóc Nâu" class="summary-mascot-img pulse-animation" />
        </div>
        <div class="summary-hero-copy">
            <h2>Khu Vườn Danh Dự Của Bé! ✨</h2>
            <p>Bé đã có <strong>@Model.TotalStars sao thành tích</strong>, mở khóa <strong>@earnedCount/@totalCount phần thưởng</strong> và sưu tập <strong>@inventoryCount vật phẩm</strong>. Cứ 10 bài khác nhau trong mỗi nhóm, một rương mới sẽ chờ bé!</p>
        </div>
    </div>

    @if (Model.ClaimableGrants.Count > 0)
    {
        <section class="reward-awaiting-section clay-card">
            <div class="reward-section-heading">
                <span class="material-symbols-outlined">redeem</span>
                <div><h2>Quà đang chờ bé</h2><p>Bé đã đủ mốc. Hãy mở rương nhé!</p></div>
            </div>
            <div class="reward-awaiting-grid">
                @foreach (var item in Model.ClaimableGrants)
                {
                    <article class="reward-awaiting-card">
                        <span class="material-symbols-outlined reward-awaiting-icon">@item.Reward.IconKey</span>
                        <div><strong>@item.Reward.Name</strong><small>@item.SkillName • Mốc @item.Grant.MilestoneValue bài</small></div>
                        <form asp-action="ClaimReward" asp-route-grantId="@item.Grant.Id" method="post">
                            <button type="submit" class="app-btn clay-button reward-claim-btn">Mở quà</button>
                        </form>
                    </article>
                }
            </div>
        </section>
    }
    else
    {
        <section class="reward-empty-state clay-card" aria-label="Không có quà đang chờ">
            <span class="material-symbols-outlined">inventory_2</span>
            <div><strong>Chưa có rương đang chờ</strong><p>Tiếp tục hành trình, cứ 10 bài khác nhau trong một nhóm bé sẽ mở khóa một rương.</p></div>
        </section>
    }

    <section class="reward-skill-journey">
        <div class="reward-section-heading">
            <span class="material-symbols-outlined">map</span>
            <div><h2>Hành trình các nhóm</h2><p>Mỗi nhóm có tiến độ rương riêng.</p></div>
        </div>
        <div class="reward-skill-progress-grid">
            @foreach (var skill in Model.SkillProgress)
            {
                var target = Math.Min(skill.NextMilestone, Math.Max(skill.TotalLessons, 10));
                var remaining = Math.Max(0, target - skill.UniqueCompleted);
                var segmentPercent = skill.TotalLessons < 10
                    ? (skill.TotalLessons == 0 ? 0 : (int)Math.Round(skill.UniqueCompleted * 100d / skill.TotalLessons))
                    : skill.CurrentSegmentProgress * 10;
                <a class="reward-skill-progress-card clay-card" asp-controller="Kids" asp-action="Skill" asp-route-id="@skill.SkillGroupId" style="--skill-color:@skill.Color">
                    <span class="material-symbols-outlined reward-skill-icon">@skill.IconKey</span>
                    <div class="reward-skill-copy">
                        <strong>@skill.SkillName</strong>
                        <span>@skill.UniqueCompleted/@skill.TotalLessons bài đã hoàn thành</span>
                        <div class="reward-progress-track"><span style="width:@Math.Clamp(segmentPercent, 0, 100)%"></span></div>
                        <small>@(skill.TotalLessons < 10 ? "Hoàn thành nhóm để nhận huy hiệu" : remaining == 0 ? "Rương đã sẵn sàng" : $"Còn {remaining} bài đến rương mốc {target}")</small>
                    </div>
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
            }
        </div>
    </section>

    @if (Model.RecentClaimedGrants.Count > 0)
    {
        <section class="reward-history-section clay-card">
            <div class="reward-section-heading">
                <span class="material-symbols-outlined">history</span>
                <div><h2>Rương vừa mở</h2><p>Những dấu mốc gần nhất của bé.</p></div>
            </div>
            <div class="reward-history-list">
                @foreach (var item in Model.RecentClaimedGrants)
                {
                    <div class="reward-history-item">
                        <span class="material-symbols-outlined">@item.Reward.IconKey</span>
                        <div><strong>@item.Reward.Name</strong><small>@item.SkillName • Mốc @item.Grant.MilestoneValue bài</small></div>
                        <time datetime="@item.Grant.ClaimedAt?.ToString("O")">@item.Grant.ClaimedAt?.ToString("dd/MM/yyyy")</time>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Filter Category Tabs -->
    <div class="reward-filter-tabs">
        <button type="button" class="reward-tab-btn active clay-button" onclick="filterRewards('all', this)">
            <span class="material-symbols-outlined">stars</span>
            <span>Tất cả (@totalCount)</span>
        </button>
        <button type="button" class="reward-tab-btn clay-button" onclick="filterRewards('badge', this)">
            <span class="material-symbols-outlined">military_tech</span>
            <span>Huy hiệu (@Model.Badges.Count(x => x.Definition.RewardType == "badge"))</span>
        </button>
        <button type="button" class="reward-tab-btn clay-button" onclick="filterRewards('item', this)">
            <span class="material-symbols-outlined">park</span>
            <span>Vật phẩm (@Model.Badges.Count(x => x.Definition.RewardType == "item"))</span>
        </button>
        <button type="button" class="reward-tab-btn clay-button" onclick="filterRewards('earned', this)">
            <span class="material-symbols-outlined">check_circle</span>
            <span>Đã đạt (@earnedCount)</span>
        </button>
    </div>

    <!-- Rewards & Badges Grid -->
    <div class="rewards-collection-grid" id="rewardsCollectionGrid">
        @foreach (var badge in Model.Badges)
        {
            <div class="reward-badge-card clay-card @(badge.IsEarned ? "is-unlocked" : "is-locked")"
                 data-reward-type="@badge.Definition.RewardType"
                 data-is-earned="@(badge.IsEarned ? "true" : "false")">
                <div class="badge-medal-wrap">
                    <span class="material-symbols-outlined badge-icon">@badge.Definition.IconKey</span>
                    @if (badge.IsEarned)
                    {
                        <span class="badge-status-sparkle">✨</span>
                    }
                    else
                    {
                        <span class="badge-lock-tag material-symbols-outlined">lock</span>
                    }
                </div>
                <strong class="badge-name">@badge.Definition.Name</strong>
                <p class="badge-rule">@badge.Definition.RuleJson</p>
                @if (badge.IsEarned)
                {
                    <span class="badge-earned-pill">
                        <span class="material-symbols-outlined mini-star">check_circle</span>
                        <span>Đã đạt @(badge.EarnedAt.HasValue ? $"• {badge.EarnedAt.Value:dd/MM}" : "")</span>
                    </span>
                }
                else
                {
                    <span class="badge-locked-pill">
                        <span class="material-symbols-outlined mini-star">lock</span>
                        <span>Chưa mở</span>
                    </span>
                }
            </div>
        }
    </div>
</section>

<!-- Bottom Navigation for Kids -->
<nav class="kid-bottom-nav">
    <a asp-controller="Kids" asp-action="Home">
        <span class="material-symbols-outlined">home</span>
        <span>Trang chủ</span>
    </a>
    <a asp-controller="Kids" asp-action="Today">
        <span class="material-symbols-outlined">edit_square</span>
        <span>Bài tập</span>
    </a>
    <a class="active" asp-controller="Kids" asp-action="Rewards">
        <span class="material-symbols-outlined">emoji_events</span>
        <span>Quà tặng</span>
    </a>
    <a href="#" onclick="openParentGate('/parent/dashboard'); return false;" title="Cổng mở khóa cho phụ huynh">
        <span class="material-symbols-outlined">lock</span>
        <span>Phụ huynh</span>
    </a>
</nav>

@section Scripts {
    <script>
        function filterRewards(filter, btn) {
            document.querySelectorAll(".reward-tab-btn").forEach(el => el.classList.remove("active"));
            if (btn) btn.classList.add("active");

            const cards = document.querySelectorAll(".reward-badge-card");
            cards.forEach(card => {
                const type = card.getAttribute("data-reward-type");
                const isEarned = card.getAttribute("data-is-earned") === "true";

                if (filter === "all") {
                    card.style.display = "flex";
                } else if (filter === "badge" && type === "badge") {
                    card.style.display = "flex";
                } else if (filter === "item" && type === "item") {
                    card.style.display = "flex";
                } else if (filter === "earned" && isEarned) {
                    card.style.display = "flex";
                } else {
                    card.style.display = "none";
                }
            });
        }
    </script>
}
