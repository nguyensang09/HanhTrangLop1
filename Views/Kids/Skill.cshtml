@model SkillLearningListViewModel
@{
    ViewData["Title"] = Model.SkillGroup.Name;
    var progressPercent = Model.Items.Count == 0 ? 0 : Model.CompletedCount * 100 / Model.Items.Count;

    static string GetInteractionName(string interactionType) => interactionType switch
    {
        InteractionTypes.Tracing => "Tô nét vẽ",
        InteractionTypes.MultiSelect => "Chọn nhiều",
        InteractionTypes.ListenAndChoose => "Nghe & chọn",
        InteractionTypes.DragDrop => "Kéo thả",
        InteractionTypes.Matching => "Nối cặp",
        InteractionTypes.Ordering => "Sắp xếp",
        InteractionTypes.Counting => "Đếm đồ vật",
        InteractionTypes.QuantityBuilder => "Tạo số lượng",
        InteractionTypes.Comparison => "So sánh",
        InteractionTypes.Classification => "Phân loại",
        InteractionTypes.StoryChoice => "Nghe kể chuyện",
        _ => "Chọn đáp án"
    };

    static string GetInteractionIcon(string interactionType) => interactionType switch
    {
        InteractionTypes.Tracing => "draw",
        InteractionTypes.MultiSelect => "checklist",
        InteractionTypes.ListenAndChoose => "hearing",
        InteractionTypes.DragDrop => "pan_tool",
        InteractionTypes.Matching => "conversion_path",
        InteractionTypes.Ordering => "sort",
        InteractionTypes.Counting => "counter_1",
        InteractionTypes.QuantityBuilder => "shopping_basket",
        InteractionTypes.Comparison => "compare_arrows",
        InteractionTypes.Classification => "category",
        InteractionTypes.StoryChoice => "auto_stories",
        _ => "touch_app"
    };
}

<section class="kid-screen skill-library-page">
    <div class="kid-topbar skill-library-header">
        <a class="icon-link clay-button" asp-controller="Kids" asp-action="Home" aria-label="Quay lại trang chủ">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div class="skill-library-heading">
            <span class="skill-library-icon material-symbols-outlined" style="--skill-color:@Model.SkillGroup.Color">@Model.SkillGroup.IconKey</span>
            <div>
                <p class="eyebrow">Nhóm kỹ năng</p>
                <h1>@Model.SkillGroup.Name</h1>
            </div>
        </div>
        <div class="star-pill clay-button">
            <span class="material-symbols-outlined star-icon">star</span>
            <span>@Model.CompletedCount/@Model.Items.Count</span>
        </div>
    </div>

    <div class="skill-banner-card clay-card" style="--skill-color:@Model.SkillGroup.Color">
        <p class="skill-library-description">@Model.SkillGroup.Description</p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="soft-card clay-card empty-state mt-4">
            <span class="material-symbols-outlined empty-icon">menu_book</span>
            <h2>Nhóm này đang chuẩn bị bài mới</h2>
            <p>Con quay lại sau nhé.</p>
        </div>
    }
    else
    {
        <div class="learning-library-list">
            @foreach (var row in Model.Items)
            {
                <article class="soft-card clay-card learning-library-item">
                    <div class="learning-item-symbol" style="--skill-color:@Model.SkillGroup.Color">
                        <span class="material-symbols-outlined">
                            @GetInteractionIcon(row.Item.InteractionType)
                        </span>
                    </div>
                    <div class="learning-item-copy">
                        <div class="learning-item-meta">
                            <span class="meta-tag type-tag">@GetInteractionName(row.Item.InteractionType)</span>
                            <span class="meta-tag level-tag">Mức @row.Item.Level</span>
                            <span class="meta-tag time-tag">⏱ @row.Item.EstimatedMinutes phút</span>
                        </div>
                        <h2>@row.Item.Title</h2>
                        <p>@row.Item.InstructionText</p>
                        @if (row.LatestStatus == "completed")
                        {
                            <small class="learning-item-status completed"><span class="material-symbols-outlined">check_circle</span> Đã hoàn thành (+@row.StarsEarned sao)</small>
                        }
                        else if (row.LatestStatus == "needs_practice")
                        {
                            <small class="learning-item-status practice"><span class="material-symbols-outlined">refresh</span> Cùng luyện lại nhé</small>
                        }
                    </div>
                    <a class="app-btn app-btn-small clay-button library-action-btn" asp-controller="Kids" asp-action="Learn" asp-route-id="@row.Item.Id" asp-route-skillGroupId="@Model.SkillGroup.Id">
                        <span class="material-symbols-outlined">@(row.LatestStatus == "completed" ? "replay" : "play_arrow")</span>
                        <span>@(row.LatestStatus is null ? "Vào bài" : "Học lại")</span>
                    </a>
                </article>
            }
        </div>
    }
</section>

<nav class="kid-bottom-nav">
    <a class="active" asp-controller="Kids" asp-action="Home"><span class="material-symbols-outlined">home</span><span>Trang chủ</span></a>
    <a asp-controller="Kids" asp-action="Today"><span class="material-symbols-outlined">edit_square</span><span>Bài tập</span></a>
    <a asp-controller="Kids" asp-action="Rewards"><span class="material-symbols-outlined">emoji_events</span><span>Quà tặng</span></a>
    <a asp-controller="Parent" asp-action="Dashboard"><span class="material-symbols-outlined">family_restroom</span><span>Phụ huynh</span></a>
</nav>
