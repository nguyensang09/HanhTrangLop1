@model SkillLearningListViewModel
@{
    ViewData["Title"] = Model.SkillGroup.Name;
    var totalItems = Model.Items.Count;
    var completedCount = Model.CompletedCount;
    var progressPercent = totalItems > 0 ? (int)Math.Round((double)completedCount / totalItems * 100) : 0;

    // Trạm hiện tại luôn là bài đầu tiên chưa từng hoàn thành.
    var currentItemIndex = Model.CurrentItemId.HasValue
        ? Model.Items.ToList().FindIndex(x => x.Item.Id == Model.CurrentItemId.Value)
        : -1;

    static string GetStageSymbol(LearningItem item, int index)
    {
        var title = item.Title.Trim();
        var match = System.Text.RegularExpressions.Regex.Match(title, @"(?:chữ cái|chữ|nét|số|chữ số)\s+([A-ZÀ-Ỹ0-9a-zĂÂĐÊÔƠƯăâđêôơư]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (match.Success)
        {
            return match.Groups[1].Value.ToUpperInvariant();
        }
        return (index + 1).ToString();
    }

    static (string Label, string Icon) GetInteractionMeta(string? type)
    {
        return (type ?? string.Empty).ToLowerInvariant() switch
        {
            "tracing" => ("Tập tô nét & vẽ hình", "draw"),
            "single_choice" or "singlechoice" => ("Trắc nghiệm chọn đáp án", "touch_app"),
            "listen_and_choose" or "listentochoose" or "listenthoose" => ("Luyện nghe & chọn đúng", "volume_up"),
            "counting" => ("Đếm số lượng đồ vật", "pin"),
            "matching" => ("Nối cặp hình tương ứng", "join"),
            "classification" => ("Phân loại theo nhóm", "category"),
            "comparison" => ("So sánh lớn - nhỏ - bằng", "balance"),
            "drag_drop" or "dragdrop" => ("Kéo thả vào vị trí đúng", "drag_indicator"),
            "story_choice" or "storychoice" => ("Đọc truyện tương tác", "auto_stories"),
            "quantity_builder" or "quantitybuilder" => ("Xếp số lượng tương ứng", "grid_view"),
            _ => ("Bài tập tương tác chuẩn", "school")
        };
    }

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" or "meo-con" => "/images/avatars/avatar-cat.png",
            "avatar-dog" or "cun-con" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    // 6 Theme màu sắc rực rỡ luân phiên để mỗi trạm bắt mắt khác biệt
    var stationThemes = new[] { "theme-amber", "theme-emerald", "theme-sky", "theme-purple", "theme-pink", "theme-teal" };

    // Dải ziczac 12 điểm lượn sóng rộng trải đều hai bên map
    var zigPositions = new[] {
        "pos-center",
        "pos-semi-right",
        "pos-mid-right",
        "pos-far-right",
        "pos-mid-right",
        "pos-semi-right",
        "pos-center",
        "pos-semi-left",
        "pos-mid-left",
        "pos-far-left",
        "pos-mid-left",
        "pos-semi-left"
    };

    // Danh mục các nhân vật & tiểu cảnh phong phú phân bổ theo 4 Tầng Địa Hình (Biomes)
    var meadowLandmarks = new (string Avatar, string Icon, string Title, string Subtitle, string AccentClass, string Bubble)[]
    {
        ("/images/avatars/avatar-bunny.png", "favorite", "Thỏ Trắng", "Nhảy múa rộn ràng 🥕", "deco-bunny", "Bé học siêu quá! 🥕"),
        ("/images/avatars/avatar-dog.png", "pets", "Cún Con", "Tiến bước rộn ràng 🐾", "deco-dog", "Gâu gâu, cố lên! 🐾"),
        ("", "spa", "Thung Lũng Nấm", "Nấm đốm xinh xắn 🍄", "deco-mushroom", "Vườn nấm rực rỡ 🍄"),
        ("", "forest", "Vườn Táo Ngọt", "Trái chín trĩu cành 🍎", "deco-nature", "Hái táo cùng bé 🍎"),
        ("/images/avatars/avatar-bear.png", "star", "Gấu Vàng", "Bé học chăm ngoan 🍯", "deco-bear", "Học vui mỗi ngày! 🍯")
    };

    var forestLandmarks = new (string Avatar, string Icon, string Title, string Subtitle, string AccentClass, string Bubble)[]
    {
        ("/images/decorations/dinosaur.svg", "pets", "Khủng Long Xanh", "Cố lên bạn nhỏ! 🦕", "deco-dino", "Bé dũng cảm quá! 🦕"),
        ("/images/decorations/cute-car.svg", "directions_car", "Xe Đua Vượt Núi", "Vút bay về đích! 🚗", "deco-car", "Bé chạy thật nhanh! 🏁"),
        ("", "campground", "Trạm Cắm Trại", "Nghỉ chân bên suối ⛺", "deco-camp", "Trạm tiếp năng lượng ⛺"),
        ("/images/avatars/avatar-cat.png", "auto_stories", "Mèo Con", "Cùng nhau đọc sách 📖", "deco-cat", "Meo meo, thật giỏi! 📖")
    };

    var skyLandmarks = new (string Avatar, string Icon, string Title, string Subtitle, string AccentClass, string Bubble)[]
    {
        ("/images/decorations/robot.svg", "smart_toy", "Robot Tí Hon", "Nạp năng lượng trí tuệ 🤖", "deco-robot", "Chào bạn nhỏ! ⚡"),
        ("/images/decorations/cute-plane.svg", "flight", "Máy Bay Nhỏ", "Lướt trên mây trắng ✈️", "deco-plane", "Khám phá bầu trời! ☁️"),
        ("", "cloud", "Xứ Sở Mây Bông", "Bồng bềnh diệu kỳ ⛅", "deco-nature", "Mây trắng mỉm cười ⛅"),
        ("", "visibility", "Đài Thiên Văn", "Ngắm ngàn vì sao 🔭", "deco-robot", "Khám phá vũ trụ! 🔭")
    };

    var cosmicLandmarks = new (string Avatar, string Icon, string Title, string Subtitle, string AccentClass, string Bubble)[]
    {
        ("/images/decorations/rocket.svg", "rocket_launch", "Tên Lửa Vũ Trụ", "Vươn tới các vì sao 🚀", "deco-rocket", "Bay cao ước mơ! 🌟"),
        ("/images/avatars/avatar-cat.png", "pets", "Mèo Phi Hành Gia", "Khám phá ngân hà 🌌", "deco-cat", "Tới đích rồi bé ơi! 🌠"),
        ("", "emoji_events", "Cột Mốc Vàng", "Sắp đến đích rồi 🏆", "deco-trophy", "Chiến thắng vinh quang 🏆"),
        ("", "military_tech", "Vương Miện Tri Thức", "Đỉnh cao lâu đài 👑", "deco-trophy", "Bé là nhà vô địch! 👑")
    };

    // Danh mục tiểu cảnh thiên nhiên lấp đầy bên sườn đối diện
    var natureClusters = new (string Art, string Tag, string Cheer)[]
    {
        ("🌻 🌸", "Hoa Hướng Dương", "Hoa nở chào đón bé! 🌸"),
        ("🍄 ✨", "Nấm Đốm Đỏ", "Bụi nấm cổ tích phát sáng! 🍄"),
        ("🌾 🏡", "Cối Xay Gió", "Gió mát thổi bay khó khăn! 🌾"),
        ("🦋 🌼", "Cánh Bướm Bay", "Bướm lượn bên trang sách! 🦋"),
        ("⛺ 🔥", "Lửa Trại Nhỏ", "Ấm áp tình bạn nhỏ! ⛺"),
        ("🌲 🌰", "Cây Thông Xanh", "Vươn cao đón ánh nắng! 🌲"),
        ("🌈 ☁️", "Cầu Vồng Mây", "Lung linh bảy sắc thần tiên! 🌈"),
        ("🎈 ✨", "Khinh Khí Cầu", "Bay cao tới ước mơ! 🎈"),
        ("🕊️ ⛅", "Chim Bồ Câu", "Hót vang khúc ca vui! 🕊️"),
        ("✨ 🌠", "Mưa Sao Băng", "Một điều ước cho bé giỏi! 🌠"),
        ("👑 🌟", "Cúp Vinh Quang", "Bé chinh phục bài học! 🏆"),
        ("💎 🔮", "Pha Lê Tri Thức", "Trí tuệ bé tỏa sáng! 💎")
    };

    var sprinkles = new string[] { "🦋", "🌸", "🍄", "✨", "🍀", "🌼", "🐞", "⭐", "🌿", "🌈" };

    var defaultSelectedItem = currentItemIndex >= 0 ? Model.Items[currentItemIndex] : Model.Items.LastOrDefault();
    var (defaultMetaLabel, defaultMetaIcon) = GetInteractionMeta(defaultSelectedItem?.Item.InteractionType);
}

<section class="kid-screen skill-adventure-page ipad-adventure-layout">
    <!-- ==================== TOPBAR HỢP NHẤT TIẾN ĐỘ & ĐIỀU HƯỚNG BÉ ==================== -->
    <header class="child-zone-header clay-card skill-unified-header">
        <div class="child-header-left">
            <a class="child-back-home-btn" asp-controller="Kids" asp-action="Home" title="Về trang chủ bé học" aria-label="Trang chủ" onclick="playAudioChime('tap')">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <a class="child-avatar-touch" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bé khác" onclick="playAudioChime('tap')">
                <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Avatar bé" class="child-avatar-img" />
                <span class="child-avatar-switch-badge" title="Đổi bé">
                    <span class="material-symbols-outlined">sync_alt</span>
                </span>
            </a>
            <div class="child-header-greeting">
                <span class="child-hi-eyebrow">Hành trình khám phá</span>
                <strong class="child-name-display">@Model.SkillGroup.Name</strong>
            </div>
        </div>

        <div class="child-header-center">
            <div class="header-merged-progress-chip" title="Tiến độ bài học: @completedCount/@totalItems bài (@progressPercent%)">
                <div class="progress-chip-header">
                    <span class="chip-flag-icon">🚩</span>
                    <strong class="chip-count-text">Trạm @completedCount/@totalItems</strong>
                    <span class="chip-percent-text">(@progressPercent%)</span>
                </div>
                <div class="chip-progress-track">
                    <div class="chip-progress-fill" style="width: @progressPercent%;"></div>
                </div>
            </div>
        </div>

        <div class="child-header-right">
            <button type="button" class="child-header-action-btn btn-jump-active" onclick="scrollToActiveStation()" title="Nhảy đến trạm bài đang học dở">
                <span class="material-symbols-outlined">my_location</span>
                <span class="btn-label-text">Bài đang học</span>
            </button>
            <button type="button" class="child-header-action-btn" id="headerToggleViewBtn" onclick="toggleSkillView(this)" data-current-view="map" title="Chuyển đổi Bản đồ / Danh sách">
                <span class="material-symbols-outlined" id="headerToggleViewIcon">format_list_bulleted</span>
                <span class="btn-label-text" id="headerToggleViewText">Danh sách</span>
            </button>
            <button type="button" class="child-lock-gate-btn" onclick="openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh" aria-label="Góc phụ huynh">
                <span class="material-symbols-outlined lock-icon">lock</span>
                <span class="lock-label-text">Ba mẹ</span>
            </button>
        </div>
    </header>

    @if (totalItems == 0)
    {
        <div class="soft-card clay-card empty-state mt-4">
            <span class="material-symbols-outlined empty-icon">menu_book</span>
            <h2>Nhóm này đang chuẩn bị bài mới</h2>
            <p>Bé quay lại sau nhé.</p>
        </div>
    }
    else
    {
        <!-- ==================== BẢN ĐỒ PHIÊU LƯU TRẢI RỘNG CÂN ĐỐI (1 CỘT RỘNG RÃI) ==================== -->
        <div class="skill-map-workspace" id="skillAdventureMapView">
            <div class="skill-map-trail-col clay-card" id="mapTrailScrollContainer">
                <!-- Nền thiên nhiên sinh động và mây trời nhẹ nhàng -->
                <div class="adventure-scenic-overlay" aria-hidden="true">
                    <div class="ambient-pastel-rainbow"></div>
                    <div class="ambient-hot-air-balloon">
                        <span class="balloon-emoji">🎈</span>
                        <span class="balloon-label">Bay cao tri thức</span>
                    </div>
                    <div class="ambient-rocket-float">
                        <img src="~/images/decorations/rocket.svg" alt="" class="ambient-rocket-img" />
                    </div>
                    <div class="ambient-plane-float">
                        <img src="~/images/decorations/cute-plane.svg" alt="" class="ambient-plane-img" />
                    </div>
                    <div class="ambient-butterfly bfly-1">🦋</div>
                    <div class="ambient-butterfly bfly-2">🦋</div>
                    <div class="ambient-cloud cloud-1"></div>
                    <div class="ambient-cloud cloud-2"></div>
                    <div class="ambient-cloud cloud-3"></div>
                    <div class="ambient-cloud cloud-4"></div>
                    <div class="ambient-cloud cloud-5"></div>
                </div>

                <!-- SVG Đường mòn kết nối mềm mại nối từ dưới lên -->
                <svg class="adventure-svg-road" id="adventure-svg-road" aria-hidden="true">
                    <path class="road-bg-path" d="" fill="none" />
                    <path class="road-done-path" d="" fill="none" />
                    <path class="road-dash-path" d="" fill="none" />
                </svg>

                <div class="adventure-trail-vertical" id="adventure-trail">
                    <!-- 1. ĐỈNH BẢN ĐỒ (TOP): LÂU ĐÀI BÍ MẬT / VỀ ĐÍCH -->
                    <div class="map-summit-node">
                        <div class="castle-summit-card clay-card" onclick="playAudioChime('celebrate')" title="Lâu Đài Bí Mật">
                            <span class="castle-icon">🏰</span>
                            <span class="castle-sub-tag">🔒 Đích đến</span>
                            <strong class="castle-title">Trạm @(totalItems + 1): Lâu Đài Bí Mật</strong>
                        </div>
                    </div>

                    <!-- 2. CÁC TRẠM HỌC TỪ TRÊN XUỐNG DƯỚI (VẼ TỪ BÀI CUỐI ĐẾN BÀI 1 ĐỂ BÀI 1 NẰM Ở ĐÁY) -->
                    @for (var i = totalItems - 1; i >= 0; i--)
                    {
                        var row = Model.Items[i];
                        var stepNumber = i + 1;
                        var isCurrent = Model.CurrentItemId == row.Item.Id;
                        var isCompleted = row.EverCompleted;
                        var isLocked = !isCompleted && !isCurrent;
                        var posClass = zigPositions[i % zigPositions.Length];
                        var themeClass = stationThemes[i % stationThemes.Length];
                        var symbol = GetStageSymbol(row.Item, i);
                        var (metaLabel, metaIcon) = GetInteractionMeta(row.Item.InteractionType);
                        var learnUrl = Url.Action("Learn", "Kids", new { id = row.Item.Id, skillGroupId = Model.SkillGroup.Id });

                        // Phân chia theo 4 tầng Biome
                        var ratio = (double)stepNumber / totalItems;
                        var isBiomeMeadow = ratio <= 0.28;
                        var isBiomeForest = ratio > 0.28 && ratio <= 0.55;
                        var isBiomeSky = ratio > 0.55 && ratio <= 0.80;
                        var isBiomeCosmic = ratio > 0.80;

                        var charItem = isBiomeMeadow ? meadowLandmarks[i % meadowLandmarks.Length] :
                                       isBiomeForest ? forestLandmarks[i % forestLandmarks.Length] :
                                       isBiomeSky    ? skyLandmarks[i % skyLandmarks.Length] :
                                                       cosmicLandmarks[i % cosmicLandmarks.Length];

                        var natureItem = natureClusters[i % natureClusters.Length];

                        var milestone = stepNumber % 10 == 0
                            ? Model.Milestones.FirstOrDefault(x => x.MilestoneValue == stepNumber)
                            : null;

                        // Randomization & Organic Placement:
                        // Tính toán vị trí ngẫu nhiên giả lập (deterministic seed) theo stepNumber
                        var seed = (stepNumber * 47 + 23) % 100;
                        var isNodeRight = posClass.Contains("right");
                        var isNodeLeft = posClass.Contains("left");

                        // Luôn đặt trang trí ở phía đối diện của trạm học để đảm bảo TUYỆT ĐỐI không đè vào vùng click trạm
                        var decoSide = isNodeRight ? "left" : isNodeLeft ? "right" : ((seed % 2 == 0) ? "left" : "right");
                        var sideClass = decoSide == "left" ? "side-left" : "side-right";

                        // Dao động ngẫu nhiên: lề ngang 4% - 20%, độ lệch dọc -16px đến +16px, góc nghiêng -6deg đến +6deg
                        var hOffset = 4 + (seed % 16);
                        var vJitter = ((seed % 9) - 4) * 4;
                        var tiltDeg = ((seed % 7) - 3) * 2;

                        // Nhịp điệu xuất hiện tự nhiên (Rhythm):
                        // Cứ mỗi 3 bước: 1 bước Nhân vật, 1 bước Cụm tiểu cảnh, 1 bước Hạt mầm thiên nhiên/khoảng thở thoáng đãng
                        var rowPattern = stepNumber % 3;

                        // Cổng mốc phân tầng chuyển cảnh (Biome Gateway)
                        var gateThreshold = (int)Math.Round(totalItems * 0.75);
                        var gateThresholdMid = (int)Math.Round(totalItems * 0.50);
                        var gateThresholdLow = (int)Math.Round(totalItems * 0.25);

                        @if (milestone is not null)
                        {
                            <div class="adventure-step-row reward-milestone-row">
                                <div class="adventure-station-node pos-center reward-milestone-node">
                                    @if (milestone.State == RewardGrantStates.Claimable && milestone.GrantId.HasValue)
                                    {
                                        <form asp-action="ClaimReward" asp-route-grantId="@milestone.GrantId" method="post" class="chest-node-badge is-claimable">
                                            <button type="submit" class="chest-circle-icon" title="Mở rương thưởng mốc @stepNumber bài">
                                                <span class="chest-emoji-art">🎁</span>
                                            </button>
                                            <span class="station-label-pill chest-pill">Mở quà mốc @stepNumber</span>
                                        </form>
                                    }
                                    else if (milestone.State == RewardGrantStates.Claimed)
                                    {
                                        <div class="chest-node-badge is-claimed" title="@milestone.RewardName">
                                            <div class="chest-circle-icon"><span class="material-symbols-outlined">@milestone.RewardIconKey</span></div>
                                            <div class="station-label-pill completed-pill">Đã nhận • Mốc @stepNumber</div>
                                        </div>
                                    }
                                    else
                                    {
                                        var completedTowardMilestone = Math.Clamp(completedCount - (stepNumber - 10), 0, 10);
                                        <div class="chest-node-badge is-locked" onclick="handleLockedStation(this, @stepNumber)" title="Rương mốc @stepNumber">
                                            <div class="chest-circle-icon">
                                                <span class="material-symbols-outlined lock-tag">lock</span>
                                                <span class="chest-emoji-art">🎁</span>
                                            </div>
                                            <div class="station-label-pill chest-pill">@completedTowardMilestone/10 • Rương mốc @stepNumber</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else if (stepNumber == gateThreshold)
                        {
                            <div class="biome-checkpoint-row">
                                <div class="biome-gate-banner gate-cosmic" onclick="interactFlankDeco(this, 'Bé vừa tiến vào Xứ Sở Ánh Sao! 🌌')">
                                    <span>🚀</span>
                                    <span>Cổng 3: Xứ Sở Ánh Sao & Lâu Đài</span>
                                    <span>⭐</span>
                                </div>
                            </div>
                        }
                        else if (stepNumber == gateThresholdMid)
                        {
                            <div class="biome-checkpoint-row">
                                <div class="biome-gate-banner gate-sky" onclick="interactFlankDeco(this, 'Chào mừng bé đến Vương Quốc Mây Trời! ☁️')">
                                    <span>☁️</span>
                                    <span>Cổng 2: Vương Quốc Bầu Trời & Mây Trắng</span>
                                    <span>🎈</span>
                                </div>
                            </div>
                        }
                        else if (stepNumber == gateThresholdLow)
                        {
                            <div class="biome-checkpoint-row">
                                <div class="biome-gate-banner gate-forest" onclick="interactFlankDeco(this, 'Bé tiến vào Rừng Rậm & Đồi Khủng Long! 🦕')">
                                    <span>🦕</span>
                                    <span>Cổng 1: Rừng Rậm & Đồi Khủng Long</span>
                                    <span>🌲</span>
                                </div>
                            </div>
                        }

                        <div class="adventure-step-row">
                            <!-- 1. CÁC PHẦN TRANG TRÍ XUẤT HIỆN RANDOM TỰ NHIÊN, KHÔNG ĐÈ LÊN VÙNG BÀI HỌC -->
                            @if (rowPattern == 0)
                            {
                                <!-- A. NHÂN VẬT HOẠT HÌNH CÓ BÓNG THOẠI & ÂM THANH VUI NHỘN -->
                                <div class="flank-landmark-deco @sideClass @charItem.AccentClass"
                                     style="@(decoSide): @(hOffset)%; top: calc(50% + @(vJitter)px); transform: translateY(-50%) rotate(@(tiltDeg)deg);"
                                     onclick="interactFlankDeco(this, '@charItem.Bubble')"
                                     title="Bấm vào để chơi cùng @charItem.Title!">
                                    <div class="flank-vignette-scenery">
                                        <div class="flank-avatar-wrap">
                                            @if (!string.IsNullOrEmpty(charItem.Avatar))
                                            {
                                                <img src="@charItem.Avatar" alt="" class="flank-avatar-img" />
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined flank-icon">@charItem.Icon</span>
                                            }
                                        </div>
                                        <div class="flank-speech-cloud">
                                            <span class="flank-bubble-text">@charItem.Bubble</span>
                                        </div>
                                    </div>
                                    <div class="flank-info-chip">
                                        <span class="flank-title">@charItem.Title</span>
                                        <span class="flank-sub">@charItem.Subtitle</span>
                                    </div>
                                    <div class="flank-ground-patch">
                                        <span class="patch-grass">🌱</span>
                                        <span class="patch-flower">🌸</span>
                                    </div>
                                </div>
                            }
                            else if (rowPattern == 1)
                            {
                                <!-- B. TIỂU CẢNH THIÊN NHIÊN (HOA, CỐI XAY GIÓ, KHINH KHÍ CẦU, NẤM THẦN) -->
                                <div class="flank-scenery-cluster @sideClass"
                                     style="@(decoSide): @(hOffset)%; top: calc(50% + @(vJitter)px); transform: translateY(-50%) rotate(@(tiltDeg)deg);"
                                     onclick="interactFlankDeco(this, '@natureItem.Cheer')"
                                     title="@natureItem.Tag • Bấm vào xem phép thuật!">
                                    <span class="scenery-emoji-art">@natureItem.Art</span>
                                    <span class="scenery-tag-pill">@natureItem.Tag</span>
                                </div>
                            }
                            else
                            {
                                <!-- C. HẠT THIÊN NHIÊN VI MÔ (BƯỚM LƯỢN / HOA CỎ / SAO NHỎ) TẠO KHOẢNG THỞ SINH ĐỘNG -->
                                var sprinkleEmoji = sprinkles[seed % sprinkles.Length];
                                var sprinkleOffset = 5 + ((seed * 3) % 15);
                                <div class="micro-nature-sprinkle"
                                     style="@(decoSide): @(sprinkleOffset)%; top: calc(50% + @(vJitter)px);"
                                     title="Thiên nhiên tươi đẹp">
                                    <span>@sprinkleEmoji</span>
                                </div>
                            }

                            <!-- 3. TRẠM BÀI HỌC Ở GIỮA / ZICZAC -->
                            <div class="adventure-station-node @posClass @(isCurrent ? "node-active-station" : "")"
                                 id="@(isCurrent ? "active-learning-station" : $"station-node-{stepNumber}")"
                                 data-step-num="@stepNumber"
                                 data-title="@row.Item.Title">

                                @if (isCurrent)
                                {
                                    <!-- Mascot Sóc Nâu đứng bên cạnh trạm đang học dở vẫy tay mời bé vào học -->
                                    <a href="@learnUrl" class="squirrel-chat-guide" title="Bé bấm để vào học ngay cùng Sóc Nâu!" onclick="playAudioChime('start')">
                                        <div class="squirrel-speech-pill pulse-bounce">
                                            <span>Vào học ngay bé ơi! ▶</span>
                                        </div>
                                        <div class="squirrel-avatar-bubble pulse-animation">
                                            <img src="~/images/mascot-squirrel-3d.png" alt="Sóc Nâu" class="squirrel-bubble-img" />
                                        </div>
                                    </a>

                                    <!-- Trạm Đang Học (Nổi Bật Nhất, Bấm Là Vào Học Luôn) -->
                                    <a href="@learnUrl"
                                       class="station-circle-btn station-current clay-station"
                                       title="Trạm @stepNumber: @row.Item.Title • Bấm vào học ngay! ▶"
                                       onclick="playAudioChime('tap')">
                                        <div class="station-core">
                                            <span class="station-symbol-hero">@symbol</span>
                                            <span class="station-pulse-ring"></span>
                                            <span class="station-mini-tag material-symbols-outlined">@metaIcon</span>
                                        </div>
                                    </a>
                                    <div class="station-label-pill current-pill">
                                        <span>▶ Trạm @stepNumber: @row.Item.Title</span>
                                    </div>
                                }
                                else if (isCompleted)
                                {
                                    <!-- Trạm Đã Hoàn Thành (Theme màu sắc, 3 Sao Vàng) -->
                                    <a href="@learnUrl"
                                       class="station-circle-btn station-completed @themeClass clay-station"
                                       title="Trạm @stepNumber: @row.Item.Title • Bấm để luyện tập lại"
                                       onclick="playAudioChime('tap')">
                                        <div class="station-core">
                                            <div class="station-stars-crown">⭐⭐⭐</div>
                                            <span class="station-symbol-char">@symbol</span>
                                            <span class="station-check-badge material-symbols-outlined">check_circle</span>
                                        </div>
                                    </a>
                                    <div class="station-label-pill completed-pill">
                                        <span class="check-prefix">✔</span>
                                        <span>Trạm @stepNumber: @row.Item.Title</span>
                                    </div>
                                }
                                else
                                {
                                    <!-- Trạm Khóa -->
                                    <div class="station-circle-btn station-locked clay-station"
                                         onclick="handleLockedStation(this, @stepNumber)"
                                         title="Trạm @stepNumber: @row.Item.Title (Chưa mở khóa)">
                                        <div class="station-core">
                                            <span class="material-symbols-outlined lock-icon">lock</span>
                                            <span class="station-locked-symbol">@symbol</span>
                                        </div>
                                    </div>
                                    <div class="station-label-pill locked-pill">
                                        <span>Trạm @stepNumber: @row.Item.Title</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- 3. ĐÁY BẢN ĐỒ (BOTTOM): CỔNG KHỞI HÀNH -->
                    <div class="map-start-node">
                        <div class="start-gate-card clay-card" onclick="playAudioChime('celebrate')">
                            <span class="material-symbols-outlined flag-icon">flag</span>
                            <span>Khởi đầu cuộc phiêu lưu từ Trạm 1</span>
                            <span class="start-gate-decor">🌱</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== 2. CHẾ ĐỘ DANH SÁCH LƯỚI BÀI HỌC (GRID VIEW) ==================== -->
        <div id="skillCompactGridView" class="skill-view-container" style="display: none;">
            <div class="skill-grid-wrap">
                <div class="skill-grid-group">
                    <div class="skill-group-heading">
                        <span class="group-tag-pill">Tất cả bài học</span>
                        <h3 class="group-title">@Model.SkillGroup.Name</h3>
                        <span class="group-stats">@completedCount/@totalItems bài hoàn thành</span>
                    </div>
                    <div class="skill-items-cards-grid">
                        @for (var idx = 0; idx < Model.Items.Count; idx++)
                        {
                            var itemRow = Model.Items[idx];
                            var isCurrent = Model.CurrentItemId == itemRow.Item.Id;
                            var isCompleted = itemRow.EverCompleted;
                            var isLocked = !isCompleted && !isCurrent;
                            var symbol = GetStageSymbol(itemRow.Item, idx);

                            <a class="skill-grid-card clay-card @(isCompleted ? "is-completed" : isCurrent ? "is-current" : "is-locked")"
                               href="@(!isLocked ? Url.Action("Learn", "Kids", new { id = itemRow.Item.Id, skillGroupId = Model.SkillGroup.Id }) : "javascript:void(0)")"
                               onclick="playAudioChime('tap')"
                               title="@itemRow.Item.Title">
                                <div class="grid-card-top">
                                    <span class="grid-card-num">Bài @(idx + 1)</span>
                                    @if (isCompleted)
                                    {
                                        <span class="grid-card-badge is-done">
                                            <span class="material-symbols-outlined">check_circle</span>
                                            <span>Đạt</span>
                                        </span>
                                    }
                                    else if (isCurrent)
                                    {
                                        <span class="grid-card-badge is-learning">
                                            <span class="material-symbols-outlined">play_arrow</span>
                                            <span>Đang học</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="grid-card-badge is-lock">
                                            <span class="material-symbols-outlined">lock</span>
                                        </span>
                                    }
                                </div>
                                <div class="grid-card-body">
                                    <div class="grid-symbol-avatar">@symbol</div>
                                    <strong class="grid-item-title">@itemRow.Item.Title</strong>
                                </div>
                                <div class="grid-card-footer">
                                    @if (isCompleted)
                                    {
                                        <span class="grid-stars-earned">⭐ +@(itemRow.StarsEarned > 0 ? itemRow.StarsEarned : 3) sao</span>
                                    }
                                    else if (isCurrent)
                                    {
                                        <span class="grid-action-prompt">Vào học ngay ▶</span>
                                    }
                                    else
                                    {
                                        <span class="grid-locked-text">Chưa mở khóa</span>
                                    }
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ==================== FLOATING NAVIGATION DOCK TIỆN ÍCH CHO MAP ==================== -->
    <nav class="kid-bottom-nav skill-floating-dock" aria-label="Thanh điều hướng học tập">
        <a asp-controller="Kids" asp-action="Home" title="Về trang chủ bé học" onclick="playAudioChime('tap')">
            <span class="material-symbols-outlined">home</span>
            <span>Trang chủ</span>
        </a>
        <a href="javascript:void(0)" class="active" id="dockBtnMap" onclick="toggleSkillView('map')" title="Bản đồ phiêu lưu">
            <span class="material-symbols-outlined">explore</span>
            <span>Bản đồ</span>
        </a>
        <a href="javascript:void(0)" id="dockBtnGrid" onclick="toggleSkillView('grid')" title="Danh sách bài học">
            <span class="material-symbols-outlined">format_list_bulleted</span>
            <span>Danh sách</span>
        </a>
        <a href="javascript:void(0)" onclick="scrollToActiveStation()" title="Đến trạm bài đang học" class="dock-btn-target">
            <span class="material-symbols-outlined">my_location</span>
            <span>Đang học</span>
        </a>
        <a asp-controller="Kids" asp-action="Rewards" title="Kho quà tặng & thành tích" onclick="playAudioChime('celebrate')">
            <span class="material-symbols-outlined">emoji_events</span>
            <span>Quà tặng</span>
        </a>
    </nav>
</section>

@section Scripts {
    <script>
        let audioCtx = null;

        // Bộ âm thanh Web Audio API sinh động cho trẻ em
        window.playAudioChime = function (type) {
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }

                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'start') {
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    notes.forEach((freq, idx) => {
                        const o = audioCtx.createOscillator();
                        const g = audioCtx.createGain();
                        o.connect(g);
                        g.connect(audioCtx.destination);
                        o.type = 'triangle';
                        o.frequency.setValueAtTime(freq, now + idx * 0.08);
                        g.gain.setValueAtTime(0.15, now + idx * 0.08);
                        g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.22);
                        o.start(now + idx * 0.08);
                        o.stop(now + idx * 0.08 + 0.22);
                    });
                    return;
                }

                if (type === 'celebrate') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.exponentialRampToValueAtTime(1046.50, now + 0.25);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                } else {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, now);
                    osc.frequency.exponentialRampToValueAtTime(880.00, now + 0.1);
                    gain.gain.setValueAtTime(0.18, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
                    osc.start(now);
                    osc.stop(now + 0.18);
                }
            } catch (e) {
                // Audio context error ignore
            }
        };

        // Tương tác khi chạm vào nhân vật hoặc tiểu cảnh thiên nhiên trên map
        window.interactFlankDeco = function (elem, cheerMsg) {
            playAudioChime('celebrate');
            elem.classList.remove("deco-clicked-bounce");
            void elem.offsetWidth; // Trigger reflow
            elem.classList.add("deco-clicked-bounce");

            let toast = document.getElementById("flankDecoToast");
            if (!toast) {
                toast = document.createElement("div");
                toast.id = "flankDecoToast";
                toast.className = "locked-station-toast clay-card";
                document.body.appendChild(toast);
            }
            toast.innerHTML = `<span class="material-symbols-outlined">sentiment_satisfied</span><span>${cheerMsg || "Bé giỏi quá! ✨"}</span>`;
            toast.classList.add("show");
            clearTimeout(window._decoToastTimeout);
            window._decoToastTimeout = setTimeout(() => toast.classList.remove("show"), 2200);
        };

        // Vẽ đường nối cong SVG mềm mại chạy từ trạm dưới lên trạm trên
        function drawAdventureRoad() {
            const svg = document.getElementById("adventure-svg-road");
            const container = document.getElementById("adventure-trail");
            if (!svg || !container) return;

            const nodes = container.querySelectorAll(".adventure-station-node .station-circle-btn, .adventure-station-node .chest-circle-icon");
            if (nodes.length < 2) return;

            const containerRect = container.getBoundingClientRect();
            svg.setAttribute("width", containerRect.width);
            svg.setAttribute("height", containerRect.height);

            // Thu thập tọa độ tâm các trạm theo thứ tự từ dưới lên trên
            const points = [];
            for (let i = nodes.length - 1; i >= 0; i--) {
                const node = nodes[i];
                const rect = node.getBoundingClientRect();
                const x = rect.left + rect.width / 2 - containerRect.left;
                const y = rect.top + rect.height / 2 - containerRect.top;
                points.push({ x, y });
            }

            if (points.length < 2) return;

            let d = `M ${points[0].x} ${points[0].y}`;
            for (let i = 0; i < points.length - 1; i++) {
                const p0 = points[i];
                const p1 = points[i + 1];
                const cx1 = p0.x;
                const cy1 = (p0.y + p1.y) / 2;
                const cx2 = p1.x;
                const cy2 = (p0.y + p1.y) / 2;
                d += ` C ${cx1} ${cy1}, ${cx2} ${cy2}, ${p1.x} ${p1.y}`;
            }

            const pathBg = svg.querySelector(".road-bg-path");
            const pathDash = svg.querySelector(".road-dash-path");
            if (pathBg) pathBg.setAttribute("d", d);
            if (pathDash) pathDash.setAttribute("d", d);
        }

        // Xử lý khi bé bấm vào trạm chưa mở khóa (Khóa 🔒)
        function handleLockedStation(btn, stepNum) {
            playAudioChime('tap');
            btn.classList.add("station-shake-anim");
            setTimeout(() => btn.classList.remove("station-shake-anim"), 600);

            let toast = document.getElementById("lockedStationToast");
            if (!toast) {
                toast = document.createElement("div");
                toast.id = "lockedStationToast";
                toast.className = "locked-station-toast clay-card";
                document.body.appendChild(toast);
            }
            toast.innerHTML = `<span class="material-symbols-outlined">lock</span><span>Bé hãy hoàn thành các trạm trước để mở khóa Trạm ${stepNum} nhé! 💛</span>`;
            toast.classList.add("show");
            clearTimeout(window._toastTimeout);
            window._toastTimeout = setTimeout(() => toast.classList.remove("show"), 2600);
        }

        // Chuyển đổi giữa Bản đồ và Danh sách bài
        function toggleSkillView(modeOrCaller) {
            const mapView = document.getElementById("skillAdventureMapView");
            const gridView = document.getElementById("skillCompactGridView");
            const headerIcon = document.getElementById("headerToggleViewIcon");
            const headerText = document.getElementById("headerToggleViewText");
            const dockMap = document.getElementById("dockBtnMap");
            const dockGrid = document.getElementById("dockBtnGrid");

            let targetMode = modeOrCaller;
            if (typeof modeOrCaller !== 'string') {
                const isCurrentlyMap = mapView && mapView.style.display !== 'none';
                targetMode = isCurrentlyMap ? 'grid' : 'map';
            }

            if (targetMode === 'grid') {
                if (mapView) mapView.style.display = 'none';
                if (gridView) gridView.style.display = 'block';
                if (headerIcon) headerIcon.textContent = 'explore';
                if (headerText) headerText.textContent = 'Bản đồ';
                if (dockMap) dockMap.classList.remove('active');
                if (dockGrid) dockGrid.classList.add('active');
            } else {
                if (gridView) gridView.style.display = 'none';
                if (mapView) mapView.style.display = 'block';
                if (headerIcon) headerIcon.textContent = 'format_list_bulleted';
                if (headerText) headerText.textContent = 'Danh sách';
                if (dockGrid) dockGrid.classList.remove('active');
                if (dockMap) dockMap.classList.add('active');
                setTimeout(() => {
                    drawAdventureRoad();
                    scrollToActiveStation(false);
                }, 60);
            }
        }

        // Cuộn mượt đến trạm đang học dở bên trong container bản đồ
        function scrollToActiveStation(smooth = true) {
            const mapView = document.getElementById("skillAdventureMapView");
            if (mapView && mapView.style.display === 'none') {
                toggleSkillView('map');
            }
            setTimeout(() => {
                const activeStation = document.getElementById("active-learning-station");
                const scrollContainer = document.getElementById("mapTrailScrollContainer");
                if (activeStation && scrollContainer) {
                    const containerRect = scrollContainer.getBoundingClientRect();
                    const stationRect = activeStation.getBoundingClientRect();
                    const targetScrollTop = scrollContainer.scrollTop + (stationRect.top - containerRect.top) - (containerRect.height / 2) + (stationRect.height / 2);

                    scrollContainer.scrollTo({
                        top: Math.max(0, targetScrollTop),
                        behavior: smooth ? "smooth" : "auto"
                    });

                    activeStation.classList.add("highlight-station-pulse");
                    setTimeout(() => activeStation.classList.remove("highlight-station-pulse"), 2800);
                }
            }, 80);
        }

        document.addEventListener("DOMContentLoaded", () => {
            drawAdventureRoad();
            setTimeout(drawAdventureRoad, 100);
            setTimeout(drawAdventureRoad, 300);

            // Tự động nhảy ngay đến trạm đang học dở dang khi vào trang
            setTimeout(() => {
                scrollToActiveStation(true);
            }, 250);
        });

        window.addEventListener("resize", drawAdventureRoad, { passive: true });
    </script>
}
