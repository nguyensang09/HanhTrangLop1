@model SkillLearningListViewModel
@{
    ViewData["Title"] = Model.SkillGroup.Name;

    // Mỗi nhóm kỹ năng có một "thế giới" riêng: bố cục, màu, nhân vật dẫn đường và lời cô dặn khác nhau.
    var world = ResolveWorld(Model.SkillGroup.Code);
    var items = Model.Items;
    var totalItems = items.Count;
    // Tiến độ theo lộ trình hiện tại (học lại một bài cũ thì các bài phía sau không còn tính); rương quà tính theo
    // số bài từng hoàn thành nên không bị mất khi bé học lại.
    var completedCount = Model.CompletedCount;
    var chestCount = Model.EverCompletedCount;
    var progressPercent = totalItems > 0 ? (int)Math.Round(completedCount * 100.0 / totalItems) : 0;
    var childName = string.IsNullOrWhiteSpace(Model.ChildProfile?.Nickname) ? "Con" : Model.ChildProfile!.Nickname.Trim();
    var perMilestone = HanhTrangLop1.Application.Learning.RewardProgressionService.LessonsPerMilestone;

    // Thông tin hiển thị của từng bài (tính một lần, dùng lại ở bản đồ và ở nút "Học tiếp").
    var icons = new string[totalItems];
    var hasMapIcon = new bool[totalItems];
    var stageNames = new string?[totalItems];
    var styleLabels = new string[totalItems];
    var stars = new int[totalItems];
    var currentIndex = -1;
    var totalStars = 0;
    for (var i = 0; i < totalItems; i++)
    {
        var row = items[i];
        var play = PlayStyle(row.Item.InteractionType);
        var (mapIcon, stageName) = ReadMapMeta(row.Item.ContentJson);
        hasMapIcon[i] = mapIcon is not null;
        // Tên chặng: ưu tiên "stage" trong ContentJson, sau đó tới tên Chủ đề.
        stageNames[i] = stageName
            ?? (string.IsNullOrWhiteSpace(row.Item.Topic?.Name) ? null : row.Item.Topic!.Name.Trim());
        icons[i] = mapIcon ?? play.Emoji;
        styleLabels[i] = play.Label;
        // Giữ quy ước cũ: bài đã hoàn thành nhưng chưa ghi nhận sao thì hiển thị đủ 3 sao.
        stars[i] = row.IsPathCompleted ? (row.StarsEarned > 0 ? Math.Min(row.StarsEarned, 3) : 3) : 0;
        totalStars += stars[i];
        if (Model.CurrentItemId.HasValue && row.Item.Id == Model.CurrentItemId.Value)
        {
            currentIndex = i;
        }
    }

    // Chia chặng: các bài liền nhau cùng "stage" (ContentJson) hoặc cùng Chủ đề gộp thành một chặng;
    // bài không có thông tin chặng thì cứ 10 bài một chặng.
    var stages = new List<SwStage>();
    for (var i = 0; i < totalItems; i++)
    {
        var key = stageNames[i];
        var startNew = stages.Count == 0
            || !string.Equals(stages[^1].Key, key, StringComparison.Ordinal)
            || (key is null && stages[^1].Indexes.Count >= perMilestone);
        if (startNew)
        {
            stages.Add(new SwStage
            {
                Number = stages.Count + 1,
                Key = key,
                Title = key ?? string.Empty
            });
        }
        stages[^1].Indexes.Add(i);
    }
    foreach (var stage in stages)
    {
        var first = stage.Indexes[0];
        var last = stage.Indexes[^1];
        if (string.IsNullOrEmpty(stage.Title))
        {
            stage.Title = first == last ? $"Bài {first + 1}" : $"Bài {first + 1} – {last + 1}";
        }
        stage.Emoji = hasMapIcon[first] ? icons[first] : world.StageEmojis[(stage.Number - 1) % world.StageEmojis.Length];
        stage.Done = stage.Indexes.Count(ix => items[ix].IsPathCompleted);
        stage.Stars = stage.Indexes.Sum(ix => stars[ix]);
        stage.HasCurrent = currentIndex >= 0 && stage.Indexes.Contains(currentIndex);
        stage.State = stage.Done == stage.Indexes.Count ? "is-done"
            : stage.HasCurrent ? "is-current"
            : stage.Done > 0 ? "is-partial"
            : "is-upcoming";
        stage.Open = totalItems <= 12 || stage.HasCurrent || (currentIndex < 0 && ReferenceEquals(stage, stages[^1]));
    }

    var milestoneByValue = Model.Milestones
        .GroupBy(m => m.MilestoneValue)
        .ToDictionary(g => g.Key, g => g.First());
    var claimableCount = Model.Milestones.Count(m => m.State == RewardGrantStates.Claimable && m.GrantId.HasValue);
    var nextChest = Model.Milestones
        .OrderBy(m => m.MilestoneValue)
        .FirstOrDefault(m => m.State != RewardGrantStates.Claimable && m.State != RewardGrantStates.Claimed);
    var lessonsToChest = nextChest is null ? 0 : Math.Max(0, nextChest.MilestoneValue - chestCount);

    var bubble = totalItems == 0
        ? "{name} ơi, cô đang chuẩn bị bài mới cho con. Con quay lại sau nhé!"
        : completedCount == 0 ? world.Intro
        : currentIndex < 0 ? world.Done
        : world.Middle;
    bubble = bubble.Replace("{name}", childName);

    var currentUrl = currentIndex >= 0
        ? Url.Action("Learn", "Kids", new { id = items[currentIndex].Item.Id, skillGroupId = Model.SkillGroup.Id })
        : null;
    var reviewIndex = Model.LastPracticedItemId.HasValue
        ? items.ToList().FindIndex(x => x.Item.Id == Model.LastPracticedItemId.Value)
        : -1;

    int[] wave = { 0, 1, 2, 1, 0, -1, -2, -1 };
    const int snakeCols = 3;
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/skill-worlds.css" asp-append-version="true" />

<div class="sw sw--@world.Key" id="skillWorld" data-flash="@(TempData["SkillMessage"] as string)">
    <div class="sw-scene" aria-hidden="true">
        <span class="sw-cloud sw-cloud--1"></span>
        <span class="sw-cloud sw-cloud--2"></span>
        <span class="sw-cloud sw-cloud--3"></span>
        @for (var s = 0; s < world.Scene.Length; s++)
        {
            <span class="sw-float sw-float--@(s + 1)">@(world.Scene[s])</span>
        }
        @if (!string.IsNullOrEmpty(world.DecoImage))
        {
            <img class="sw-deco-img" src="@world.DecoImage" alt="" />
        }
    </div>

    <header class="sw-topbar">
        <a class="sw-pill sw-pill--back" asp-controller="Kids" asp-action="Home" aria-label="Về trang chủ" data-sfx="tap">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span><span class="sw-hide-sm">Trang chủ</span>
        </a>
        <a class="sw-avatar" asp-controller="Profiles" asp-action="Index" aria-label="Đổi bé khác" title="Bấm để đổi bé khác" data-sfx="tap">
            <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="" />
            <span class="sw-avatar-badge material-symbols-outlined" aria-hidden="true">sync_alt</span>
        </a>
        <div class="sw-brand">
            <span class="sw-brand-mark" aria-hidden="true">@world.Emoji</span>
            <span class="sw-brand-text">
                <small>@world.Title</small>
                <strong>@Model.SkillGroup.Name</strong>
            </span>
        </div>
        <a class="sw-pill sw-pill--stars" asp-controller="Kids" asp-action="Rewards" title="Sao con đã nhận ở nhóm này · Bấm để xem kho quà" data-sfx="tap">
            <span aria-hidden="true">⭐</span><strong>@totalStars</strong>
        </a>
        <button type="button" class="sw-pill sw-pill--lock" onclick="openParentGate('/parent/dashboard')" aria-label="Góc phụ huynh" title="Góc phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span><span class="sw-hide-sm">Ba mẹ</span>
        </button>
    </header>

    <section class="sw-hero">
        <div class="sw-guide">
            <div class="sw-guide-figure">
                <img class="sw-guide-img" src="@world.Guide" alt="@world.GuideName" />
                <span class="sw-guide-name">@world.GuideName</span>
            </div>
            <p class="sw-bubble">@bubble</p>
        </div>

        <div class="sw-hero-card">
            @if (totalItems > 0)
            {
                <div class="sw-meter" role="progressbar" aria-valuemin="0" aria-valuemax="@totalItems" aria-valuenow="@completedCount" aria-label="Tiến độ của con">
                    <div class="sw-meter-label">
                        <span>Hành trình của con</span>
                        <strong>@(completedCount) / @(totalItems) bài · @(progressPercent)%</strong>
                    </div>
                    <div class="sw-meter-track"><span style="width:@(progressPercent)%"></span></div>
                </div>

                @if (currentIndex >= 0)
                {
                    <a class="sw-continue" href="@currentUrl" data-sfx="start">
                        <span class="sw-continue-orb @(GlyphClass(icons[currentIndex]))" aria-hidden="true">@(icons[currentIndex])</span>
                        <span class="sw-continue-text">
                            <small>@(completedCount == 0 ? "Bắt đầu nào" : "Con học tiếp bài này nhé") · Bài @(currentIndex + 1)</small>
                            <strong>@(items[currentIndex].Item.Title)</strong>
                        </span>
                        <span class="sw-continue-play material-symbols-outlined" aria-hidden="true">play_arrow</span>
                    </a>
                }
                else
                {
                    <p class="sw-hero-done">🏆 Con đã học xong tất cả các bài! Con chạm vào bài bất kỳ để luyện thêm nhé.</p>
                    @if (reviewIndex >= 0)
                    {
                        <a class="sw-continue sw-continue--review" href="@Url.Action("Learn", "Kids", new { id = items[reviewIndex].Item.Id, skillGroupId = Model.SkillGroup.Id })" data-sfx="start"
                           data-sw-replay="@Url.Action("Replay", "Kids", new { id = Model.SkillGroup.Id, itemId = items[reviewIndex].Item.Id })"
                           data-replay-title="Bài @(reviewIndex + 1): @(items[reviewIndex].Item.Title)"
                           data-replay-locks="@(totalItems - reviewIndex - 1)">
                            <span class="sw-continue-orb @(GlyphClass(icons[reviewIndex]))" aria-hidden="true">@(icons[reviewIndex])</span>
                            <span class="sw-continue-text">
                                <small>Ôn lại bài con vừa học</small>
                                <strong>@(items[reviewIndex].Item.Title)</strong>
                            </span>
                            <span class="sw-continue-play material-symbols-outlined" aria-hidden="true">replay</span>
                        </a>
                    }
                }

                @if (claimableCount > 0)
                {
                    <button type="button" class="sw-chest-call" data-sw-goto-chest>
                        <span aria-hidden="true">🎁</span>
                        <span>Con có @claimableCount rương quà đang chờ mở! Chạm để tới rương nhé.</span>
                    </button>
                }
                else if (nextChest is not null && lessonsToChest > 0)
                {
                    <p class="sw-chest-hint"><span aria-hidden="true">🎁</span> Con học thêm <strong>@lessonsToChest bài</strong> nữa là mở được rương quà!</p>
                }
            }
            else
            {
                <div class="sw-empty">
                    <span class="sw-empty-icon" aria-hidden="true">📦</span>
                    <strong>Nhóm này đang chuẩn bị bài mới</strong>
                    <span>Con quay lại sau nhé, cô sẽ thêm bài thật vui!</span>
                    <a class="sw-continue" asp-controller="Kids" asp-action="Home" data-sfx="tap">
                        <span class="sw-continue-orb" aria-hidden="true">🏠</span>
                        <span class="sw-continue-text"><small>Quay về</small><strong>Trang chủ của con</strong></span>
                        <span class="sw-continue-play material-symbols-outlined" aria-hidden="true">home</span>
                    </a>
                </div>
            }
        </div>
    </section>

    @if (totalItems > 0)
    {
        <p class="sw-world-hint"><span aria-hidden="true">💡</span> @world.Hint</p>

        <div class="sw-map">
            @foreach (var stage in stages)
            {
                var stageCount = stage.Indexes.Count;
                <details class="sw-stage @stage.State" id="sw-stage-@stage.Number" open="@stage.Open">
                    <summary class="sw-stage-head">
                        <span class="sw-stage-emoji @(GlyphClass(stage.Emoji))" aria-hidden="true">@stage.Emoji</span>
                        <span class="sw-stage-text">
                            <small>@world.StageWord @stage.Number</small>
                            <strong>@stage.Title</strong>
                        </span>
                        <span class="sw-stage-meta">
                            @if (stage.State == "is-done")
                            {
                                <span class="sw-stage-chip sw-stage-chip--done">🏆 Xong · ⭐ @stage.Stars</span>
                            }
                            else if (stage.State == "is-upcoming")
                            {
                                <span class="sw-stage-chip sw-stage-chip--soon">🔒 @(stageCount) bài</span>
                            }
                            else
                            {
                                <span class="sw-stage-chip">@(stage.Done)/@(stageCount) bài · ⭐ @stage.Stars</span>
                            }
                        </span>
                        <span class="sw-stage-chev material-symbols-outlined" aria-hidden="true">expand_more</span>
                    </summary>

                    @{
                        // Danh sách ô trên bản đồ của chặng: bài học, và rương quà ngay sau mỗi bài thứ 10.
                        var slots = new List<(int Index, SkillMilestoneViewModel? Chest)>();
                        foreach (var ix in stage.Indexes)
                        {
                            slots.Add((ix, null));
                            if ((ix + 1) % perMilestone == 0 && milestoneByValue.TryGetValue(ix + 1, out var ms))
                            {
                                slots.Add((ix, ms));
                            }
                        }
                    }

                    <ol class="sw-track">
                        @for (var k = 0; k < slots.Count; k++)
                        {
                            var slot = slots[k];
                            var slotStyle = $"--k:{k};--w:{wave[k % wave.Length]}";
                            string? link = null;
                            if (world.Key == "kham-pha")
                            {
                                var rowNo = k / snakeCols;
                                var colInRow = k % snakeCols;
                                var col = rowNo % 2 == 0 ? colInRow : snakeCols - 1 - colInRow;
                                slotStyle += $";--r:{rowNo + 1};--c:{col + 1}";
                                link = k == slots.Count - 1 ? null
                                    : colInRow < snakeCols - 1 ? (rowNo % 2 == 0 ? "r" : "l")
                                    : "d";
                            }

                            if (slot.Chest is { } chest)
                            {
                                var value = chest.MilestoneValue;
                                var isClaimable = chest.State == RewardGrantStates.Claimable && chest.GrantId.HasValue;
                                var isClaimed = chest.State == RewardGrantStates.Claimed;
                                <li class="sw-slot sw-slot--chest @(isClaimable ? "is-claimable" : isClaimed ? "is-claimed" : "is-locked")" style="@slotStyle" data-link="@link">
                                    @if (isClaimable)
                                    {
                                        <form asp-controller="Kids" asp-action="ClaimReward" asp-route-grantId="@chest.GrantId" method="post" class="sw-chest-form">
                                            <button type="submit" class="sw-chest" data-sfx="celebrate" aria-label="Mở rương quà mốc @value bài">
                                                <span class="sw-chest-icon" aria-hidden="true">🎁</span>
                                                <span class="sw-chest-label">Mở quà nào!</span>
                                                <span class="sw-chest-sub">Mốc @value bài</span>
                                            </button>
                                        </form>
                                    }
                                    else if (isClaimed)
                                    {
                                        <div class="sw-chest" title="@chest.RewardName">
                                            <span class="sw-chest-icon sw-chest-icon--claimed material-symbols-outlined" aria-hidden="true">@chest.RewardIconKey</span>
                                            <span class="sw-chest-label">Con đã nhận quà</span>
                                            <span class="sw-chest-sub">@(string.IsNullOrWhiteSpace(chest.RewardName) ? $"Mốc {value} bài" : chest.RewardName)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        var toward = Math.Clamp(chestCount - (value - perMilestone), 0, perMilestone);
                                        var remain = value - chestCount;
                                        var chestMsg = remain > 0
                                            ? $"Con học thêm {remain} bài nữa để mở rương quà này nhé! 🎁"
                                            : "Rương quà sắp mở rồi, con học tiếp nhé! 🎁";
                                        <button type="button" class="sw-chest" data-sw-locked data-msg="@chestMsg" aria-label="Rương quà mốc @value bài, chưa mở">
                                            <span class="sw-chest-icon" aria-hidden="true">🎁<i class="sw-chest-lock">🔒</i></span>
                                            <span class="sw-chest-label">@(toward)/@(perMilestone) bài</span>
                                            <span class="sw-chest-sub">Rương mốc @value</span>
                                        </button>
                                    }
                                </li>
                            }
                            else
                            {
                                var ix = slot.Index;
                                var row = items[ix];
                                var isCurrent = ix == currentIndex;
                                // Mọi bài sau bài đang học đều khóa, kể cả bài từng hoàn thành trước khi bé chọn học lại.
                                var isLocked = !isCurrent && (!row.IsPathCompleted || (currentIndex >= 0 && ix > currentIndex));
                                var isDone = row.IsPathCompleted && !isLocked;
                                var state = isCurrent ? "is-current" : isDone ? "is-done" : "is-locked";
                                var href = isLocked ? null : Url.Action("Learn", "Kids", new { id = row.Item.Id, skillGroupId = Model.SkillGroup.Id });
                                // Học lại bài đã xong = đưa lộ trình về bài này (POST); số bài đang mở phía sau sẽ bị khóa lại.
                                var replayUrl = isDone ? Url.Action("Replay", "Kids", new { id = Model.SkillGroup.Id, itemId = row.Item.Id }) : null;
                                var relockCount = isDone ? (currentIndex < 0 ? totalItems : currentIndex + 1) - (ix + 1) : 0;
                                var label = isLocked
                                    ? $"Bài {ix + 1}: {row.Item.Title}. Chưa mở"
                                    : isDone ? $"Bài {ix + 1}: {row.Item.Title}. {stars[ix]} trên 3 sao. Chạm để học lại"
                                    : $"Bài {ix + 1}: {row.Item.Title}. Bài con đang học";
                                var sideEmoji = world.Side.Length > 0 && k % 2 == 0 ? world.Side[(k / 2) % world.Side.Length] : null;
                                <li class="sw-slot sw-slot--lesson @state" style="@slotStyle" data-link="@link">
                                    <a class="sw-node"
                                       href="@href"
                                       id="@(isCurrent ? "sw-current" : null)"
                                       role="@(isLocked ? "button" : null)"
                                       tabindex="@(isLocked ? "0" : null)"
                                       aria-disabled="@(isLocked ? "true" : null)"
                                       aria-label="@label"
                                       data-sw-locked="@(isLocked ? "true" : null)"
                                       data-msg="@(isLocked ? "Con học xong các bài trước để mở bài này nhé! 💛" : null)"
                                       data-sw-replay="@replayUrl"
                                       data-replay-title="@(isDone ? $"Bài {ix + 1}: {row.Item.Title}" : null)"
                                       data-replay-locks="@(isDone ? relockCount.ToString() : null)"
                                       data-sfx="@(isLocked ? null : isCurrent ? "start" : "tap")">
                                        @if (isCurrent)
                                        {
                                            <span class="sw-flag" aria-hidden="true">Con học bài này nhé!</span>
                                        }
                                        <span class="sw-deco" aria-hidden="true"></span>
                                        <span class="sw-orb" aria-hidden="true">
                                            <span class="sw-orb-icon @(GlyphClass(icons[ix]))">@(icons[ix])</span>
                                            @if (isLocked)
                                            {
                                                <i class="sw-lock">🔒</i>
                                            }
                                            else if (isDone)
                                            {
                                                <i class="sw-check">✔</i>
                                            }
                                        </span>
                                        <span class="sw-info" aria-hidden="true">
                                            <span class="sw-num">@(ix + 1)</span>
                                            <span class="sw-title">@row.Item.Title</span>
                                            <span class="sw-style">@(styleLabels[ix])</span>
                                            @if (isDone)
                                            {
                                                <span class="sw-stars">@StarText(stars[ix])</span>
                                            }
                                        </span>
                                    </a>
                                    @if (sideEmoji is not null)
                                    {
                                        <span class="sw-side @(wave[k % wave.Length] > 0 ? "sw-side--l" : "sw-side--r")" aria-hidden="true">@sideEmoji</span>
                                    }
                                </li>
                            }
                        }
                    </ol>
                </details>
            }

            <div class="sw-finish">
                <span class="sw-finish-icon" aria-hidden="true">🏆</span>
                <span>@(currentIndex < 0 ? "Con đã về đích rồi! Cô thưởng con một tràng pháo tay 👏" : "Cô chờ con ở đích nhé! Mỗi bài con học là một bước tới gần hơn.")</span>
            </div>
        </div>

        @if (currentIndex >= 0)
        {
            <button type="button" class="sw-fab" data-sw-goto-current aria-label="Tới bài con đang học">
                <span class="material-symbols-outlined" aria-hidden="true">my_location</span>
                <span class="sw-fab-text">Bài đang học</span>
            </button>
        }
    }

    @* Học lại bài cũ: hỏi lại một lần vì các bài phía sau sẽ khóa lại; bé xác nhận thì gửi POST đưa lộ trình về bài đó. *@
    <form id="swReplayForm" method="post" hidden>@Html.AntiForgeryToken()</form>
    <div class="sw-sheet" id="swReplaySheet" hidden role="dialog" aria-modal="true" aria-labelledby="swReplayTitle">
        <div class="sw-sheet-card">
            <span class="sw-sheet-icon" aria-hidden="true">🔁</span>
            <h2 class="sw-sheet-title" id="swReplayTitle">Con học lại bài này nhé?</h2>
            <p class="sw-sheet-lesson" data-replay-name></p>
            <p class="sw-sheet-note" data-replay-note></p>
            <div class="sw-sheet-actions">
                <button type="button" class="sw-sheet-btn sw-sheet-btn--go" data-replay-confirm>
                    <span class="material-symbols-outlined" aria-hidden="true">replay</span><span>Học lại bài này</span>
                </button>
                <button type="button" class="sw-sheet-btn" data-replay-cancel>Để sau</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var root = document.getElementById('skillWorld');
            if (!root) return;
            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // Âm thanh nhỏ khi chạm (Web Audio, không cần tệp âm thanh).
            var audioCtx = null;
            function chime(type) {
                try {
                    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    if (audioCtx.state === 'suspended') audioCtx.resume();
                    var now = audioCtx.currentTime;
                    var notes = type === 'start' ? [523.25, 659.25, 783.99, 1046.5]
                        : type === 'celebrate' ? [659.25, 783.99, 1046.5, 1318.5]
                        : type === 'locked' ? [392, 330]
                        : [587.33, 880];
                    notes.forEach(function (freq, idx) {
                        var o = audioCtx.createOscillator();
                        var g = audioCtx.createGain();
                        o.connect(g); g.connect(audioCtx.destination);
                        o.type = type === 'locked' ? 'sine' : 'triangle';
                        var t = now + idx * 0.07;
                        o.frequency.setValueAtTime(freq, t);
                        g.gain.setValueAtTime(0.14, t);
                        g.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
                        o.start(t); o.stop(t + 0.22);
                    });
                } catch (e) { /* bỏ qua lỗi âm thanh */ }
            }

            var toast = null, toastTimer = 0;
            function showToast(msg) {
                if (!toast) {
                    toast = document.createElement('div');
                    toast.className = 'sw-toast';
                    toast.setAttribute('role', 'status');
                    root.appendChild(toast);
                }
                toast.textContent = msg;
                toast.classList.remove('is-show');
                void toast.offsetWidth;
                toast.classList.add('is-show');
                clearTimeout(toastTimer);
                toastTimer = setTimeout(function () { toast.classList.remove('is-show'); }, 2600);
            }

            function shake(el) {
                el.classList.remove('is-shake');
                void el.offsetWidth;
                el.classList.add('is-shake');
                setTimeout(function () { el.classList.remove('is-shake'); }, 600);
            }

            // Đưa một ô vào giữa tầm nhìn: cuộn ngang trong đoàn tàu (nếu có) rồi cuộn trang khi cần.
            function bringIntoView(el, smooth, force) {
                var stage = el.closest('details');
                if (stage && !stage.open) stage.open = true;
                var track = el.closest('.sw-track');
                if (track && track.scrollWidth > track.clientWidth + 4) {
                    var slot = el.closest('.sw-slot') || el;
                    var left = slot.offsetLeft - (track.clientWidth - slot.offsetWidth) / 2;
                    track.scrollTo({ left: Math.max(0, left), behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
                }
                var rect = el.getBoundingClientRect();
                var vh = window.innerHeight || document.documentElement.clientHeight;
                if (force || rect.top < 70 || rect.bottom > vh - 20) {
                    el.scrollIntoView({ block: 'center', inline: 'nearest', behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
                }
            }

            function spotlight(el) {
                el.classList.remove('is-spot');
                void el.offsetWidth;
                el.classList.add('is-spot');
                setTimeout(function () { el.classList.remove('is-spot'); }, 2600);
            }

            // Học lại bài đã xong: bài đó thành bài đang học, các bài đang mở phía sau khóa lại.
            var replaySheet = document.getElementById('swReplaySheet');
            var replayForm = document.getElementById('swReplayForm');
            var pendingReplay = null;
            function submitReplay(url) {
                if (!replayForm || !url) return;
                replayForm.action = url;
                replayForm.submit();
            }
            function openReplay(node) {
                var url = node.getAttribute('data-sw-replay');
                var locks = parseInt(node.getAttribute('data-replay-locks') || '0', 10);
                if (!replaySheet || !(locks > 0)) { submitReplay(url); return; }
                pendingReplay = url;
                replaySheet.querySelector('[data-replay-name]').textContent = node.getAttribute('data-replay-title') || '';
                replaySheet.querySelector('[data-replay-note]').textContent =
                    'Con sẽ học lại từ bài này. ' + locks + ' bài phía sau sẽ khóa lại, con học lần lượt để mở lại nhé!';
                replaySheet.hidden = false;
                requestAnimationFrame(function () { replaySheet.classList.add('is-open'); });
                var go = replaySheet.querySelector('[data-replay-confirm]');
                if (go) go.focus();
            }
            function closeReplay() {
                if (!replaySheet) return;
                pendingReplay = null;
                replaySheet.classList.remove('is-open');
                replaySheet.hidden = true;
            }
            if (replaySheet) {
                replaySheet.addEventListener('click', function (ev) {
                    if (ev.target.closest('[data-replay-confirm]')) { chime('start'); submitReplay(pendingReplay); return; }
                    if (ev.target.closest('[data-replay-cancel]') || ev.target === replaySheet) { chime('tap'); closeReplay(); }
                });
                document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape' && !replaySheet.hidden) closeReplay(); });
            }

            root.addEventListener('click', function (ev) {
                if (replaySheet && replaySheet.contains(ev.target)) return;
                var replay = ev.target.closest('[data-sw-replay]');
                if (replay && root.contains(replay)) {
                    ev.preventDefault();
                    chime('tap');
                    openReplay(replay);
                    return;
                }
                var locked = ev.target.closest('[data-sw-locked]');
                if (locked && root.contains(locked)) {
                    ev.preventDefault();
                    chime('locked');
                    shake(locked);
                    showToast(locked.getAttribute('data-msg') || 'Con học xong các bài trước nhé! 💛');
                    return;
                }
                if (ev.target.closest('[data-sw-goto-current]')) {
                    var cur = document.getElementById('sw-current');
                    if (cur) { chime('tap'); bringIntoView(cur, true, true); spotlight(cur); }
                    return;
                }
                if (ev.target.closest('[data-sw-goto-chest]')) {
                    var chest = root.querySelector('.sw-slot--chest.is-claimable .sw-chest');
                    if (chest) { chime('celebrate'); bringIntoView(chest, true, true); spotlight(chest); }
                    return;
                }
                var sfx = ev.target.closest('[data-sfx]');
                if (sfx) chime(sfx.getAttribute('data-sfx'));
            });

            // Bàn phím: trạm đang khóa có role="button" nên Enter/Space cũng báo nhắc nhở.
            root.addEventListener('keydown', function (ev) {
                if (ev.key !== 'Enter' && ev.key !== ' ') return;
                var locked = ev.target.closest && ev.target.closest('a[data-sw-locked]');
                if (locked) { ev.preventDefault(); locked.click(); }
            });

            root.querySelectorAll('details.sw-stage').forEach(function (d) {
                d.addEventListener('toggle', function () { if (d.open) chime('tap'); });
            });

            // Lời nhắc từ máy chủ (ví dụ bé mở một bài đang khóa bằng đường dẫn cũ).
            var flash = root.getAttribute('data-flash');
            if (flash) setTimeout(function () { showToast(flash); }, 400);

            function jumpToCurrent() {
                var cur = document.getElementById('sw-current');
                if (!cur) return;
                bringIntoView(cur, true, false);
                spotlight(cur);
            }
            if (document.readyState === 'complete') setTimeout(jumpToCurrent, 300);
            else window.addEventListener('load', function () { setTimeout(jumpToCurrent, 300); });
        })();
    </script>
}

