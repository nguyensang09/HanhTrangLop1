    };

    // Đọc ContentJson một lần cho mỗi bài: "mapIcon" (emoji hoặc một chữ/số) và "stage" (tên chặng).
    private static (string? MapIcon, string? Stage) ReadMapMeta(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)
            || (!json.Contains("mapIcon", StringComparison.Ordinal) && !json.Contains("\"stage\"", StringComparison.Ordinal)))
        {
            return (null, null);
        }
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
            {
                return (null, null);
            }
            string? icon = null, stage = null;
            if (doc.RootElement.TryGetProperty("mapIcon", out var iconEl) && iconEl.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var value = iconEl.GetString()?.Trim();
                icon = string.IsNullOrEmpty(value) || value.Length > 16 ? null : value;
            }
            if (doc.RootElement.TryGetProperty("stage", out var stageEl) && stageEl.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var value = stageEl.GetString()?.Trim();
                stage = string.IsNullOrEmpty(value) ? null : value;
            }
            return (icon, stage);
        }
        catch (System.Text.Json.JsonException)
        {
            return (null, null);
        }
    }

    // mapIcon là chữ cái/chữ số (ví dụ "B", "7") thì hiển thị bằng phông chữ tròn đậm thay cho emoji.
    private static bool IsGlyph(string icon) => icon.Length <= 3 && icon.All(char.IsLetterOrDigit);

    private static string GlyphClass(string icon) => IsGlyph(icon) ? "is-glyph" : "is-emoji";

    private static string StarText(int n)
    {
        var filled = Math.Clamp(n, 0, 3);
        return new string('★', filled) + new string('☆', 3 - filled);
    }

    private static string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return Squirrel;
        if (key.StartsWith('/')) return key;
        return key switch
        {
            "avatar-cat" or "meo-con" => Cat,
            "avatar-dog" or "cun-con" => Dog,
            "avatar-bunny" or "tho-trang" => Bunny,
            "avatar-bear" or "gau-vang" => Bear,
            "avatar-squirrel" or "soc-nau" => Squirrel,
            _ => Squirrel
        };
    }
}
