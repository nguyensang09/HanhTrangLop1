@model SessionSummaryViewModel
@{
    ViewData["Title"] = "Tổng kết buổi học";
    var childName = (Model.ChildProfile?.Nickname) ?? "bạn nhỏ";
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/kid-hub.css" asp-append-version="true" />

<div class="kh kh-summary">
    <div class="kh-sky" aria-hidden="true">
        <span class="kh-cloud kh-cloud--1"></span>
        <span class="kh-cloud kh-cloud--2"></span>
        <span class="kh-cloud kh-cloud--3"></span>
        <span class="kh-float kh-float--1">🎉</span>
        <span class="kh-float kh-float--2">🎈</span>
        <span class="kh-float kh-float--3">⭐</span>
        <span class="kh-float kh-float--4">🎊</span>
    </div>

    <header class="kh-topbar">
        <a class="kh-pill" asp-controller="Kids" asp-action="Home" title="Về trang chủ" aria-label="Về trang chủ">
            <span class="material-symbols-outlined" aria-hidden="true">home</span><span class="kh-hide-sm">Trang chủ</span>
        </a>
        <div class="kh-brand">
            <span class="kh-brand-mark" aria-hidden="true">🏅</span>
            <span class="kh-brand-text">
                <small>Hoàn thành bài học</small>
                <strong>Tổng Kết Buổi Học</strong>
            </span>
        </div>
        <div class="kh-pill kh-pill--stars" title="Số sao nhận được trong buổi học">
            <span aria-hidden="true">⭐</span><strong>+@Model.StarsEarned</strong><small class="kh-hide-sm">sao</small>
        </div>
    </header>

    <!-- Màn chúc mừng -->
    <section class="kh-celebrate">
        <div class="kh-celebrate-burst" aria-hidden="true"><span>✨</span><span>🌟</span><span>🎉</span><span>⭐</span></div>
        <img class="kh-celebrate-mascot" src="~/images/soc-nau-mascot.png" onerror="this.src='/images/mascot-squirrel-3d.png'" alt="Sóc Nâu" />
        <h1>Giỏi lắm, @childName! 🎉</h1>
        <span class="kh-star-burst"><span aria-hidden="true">⭐</span> +@Model.StarsEarned sao</span>
        <p>Bé hoàn thành <strong>@Model.CompletedItems</strong> bài học và nhận được <strong>@Model.StarsEarned</strong> ngôi sao lấp lánh!</p>
    </section>

    <!-- Huy hiệu mới được mở khóa (nếu có) -->
    @if (Model.NewlyUnlockedRewards.Count > 0)
    {
        <section class="kh-panel kh-panel--chests has-chests">
            <div class="kh-panel-head">
                <span class="kh-panel-emoji" aria-hidden="true">🏅</span>
                <div class="kh-panel-title">
                    <h2>Huy hiệu mới mở khóa! ✨</h2>
                    <p>Bé vừa nhận thêm phần thưởng mới đó!</p>
                </div>
            </div>
            <div class="kh-newbadges">
                @foreach (var badge in Model.NewlyUnlockedRewards)
                {
                    <div class="kh-newbadge">
                        <div class="kh-prize-medal">
                            <span class="material-symbols-outlined" aria-hidden="true">@badge.IconKey</span>
                        </div>
                        <strong>@badge.Name</strong>
                        <small>@badge.RuleJson</small>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Ba con số nổi bật -->
    <div class="kh-stats">
        <div class="kh-stat kh-stat--good">
            <span class="kh-stat-icon" aria-hidden="true">✅</span>
            <strong>@Model.CompletedItems</strong>
            <span>Bài hoàn thành</span>
        </div>
        <div class="kh-stat kh-stat--warm">
            <span class="kh-stat-icon" aria-hidden="true">💪</span>
            <strong>@Model.NeedsPracticeItems</strong>
            <span>Cần luyện thêm</span>
        </div>
        <div class="kh-stat kh-stat--pink">
            <span class="kh-stat-icon" aria-hidden="true">🎖️</span>
            <strong>@Model.TotalEarnedBadgesCount</strong>
            <span>Huy hiệu đạt được</span>
        </div>
    </div>

    <!-- Hai nút hành động to -->
    <div class="kh-actions">
        <a class="kh-big-btn kh-big-btn--gold" asp-controller="Kids" asp-action="Rewards">
            <span class="material-symbols-outlined" aria-hidden="true">emoji_events</span>
            <span>Xem kho quà tặng & huy hiệu</span>
        </a>
        <a class="kh-big-btn kh-big-btn--white" asp-controller="Kids" asp-action="Home">
            <span class="material-symbols-outlined" aria-hidden="true">home</span>
            <span>Về trang chủ</span>
        </a>
    </div>

    <!-- Danh sách hoạt động vừa hoàn thành -->
    @if (Model.Attempts.Count > 0)
    {
        <section class="kh-panel">
            <div class="kh-panel-head">
                <span class="kh-panel-emoji" aria-hidden="true">📋</span>
                <div class="kh-panel-title">
                    <h2>Các hoạt động vừa hoàn thành (@Model.Attempts.Count)</h2>
                </div>
            </div>
            <div class="kh-attempts">
                @foreach (var attempt in Model.Attempts)
                {
                    var isDone = attempt.Status == "completed";
                    <div class="kh-attempt @(isDone ? "completed" : "practice")">
                        <span class="kh-attempt-icon" aria-hidden="true">@(isDone ? "✓" : "↻")</span>
                        <div class="kh-attempt-body">
                            <strong>@(attempt.LearningItem?.Title ?? "Bài học tương tác")</strong>
                            <small>@(isDone ? "✨ Đạt chuẩn" : "🔄 Cùng luyện lại") — +@attempt.StarsEarned sao</small>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>
