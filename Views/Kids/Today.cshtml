@model TodayLessonViewModel
@using HanhTrangLop1.Application.Learning
@inject KidsModuleService Modules
@{
    ViewData["Title"] = $"Bài Học Hôm Nay - Ngày {Model.SelectedDayNumber}";
    var progressPercent = Model.TotalCount == 0 ? 0 : (Model.CompletedCount * 100 / Model.TotalCount);
    var isAllDone = Model.TotalCount > 0 && Model.CompletedCount == Model.TotalCount;
    var totalStarsToday = Model.Steps.Sum(x => x.StarsEarned);
    var activeStep = Model.Steps.FirstOrDefault(x => x.Status == TodayLessonStepStatus.Active)
                     ?? Model.Steps.FirstOrDefault(x => x.Status == TodayLessonStepStatus.NeedsPractice)
                     ?? Model.Steps.FirstOrDefault();
    var activeStepIndex = activeStep != null ? Model.Steps.ToList().IndexOf(activeStep) + 1 : 1;

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" or "meo-con" => "/images/avatars/avatar-cat.png",
            "avatar-dog" or "cun-con" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    (string Tag, string Icon, string ThemeClass) ResolveSubject(LearningItem item)
    {
        var skillCode = item.SkillGroup?.Code?.ToLowerInvariant() ?? "";
        var interaction = item.InteractionType?.ToLowerInvariant() ?? "";

        if (interaction == InteractionTypes.Tracing)
        {
            return ("Bé tập tô", "draw", "quest-theme-coral");
        }

        return skillCode switch
        {
            "chu-cai" => ("Chữ cái & Nét", "menu_book", "quest-theme-amber"),
            "chu-so" => ("Số và Đếm", "calculate", "quest-theme-mint"),
            "tu-duy-logic" or "hinh-dang-khong-gian" => ("Tư duy & Logic", "psychology", "quest-theme-cyan"),
            "ky-nang-song" => ("Kỹ năng sống", "volunteer_activism", "quest-theme-purple"),
            "ngon-ngu" => ("Vần từ & Âm", "record_voice_over", "quest-theme-pink"),
            _ => (item.SkillGroup?.Name ?? "Bài học", "school", "quest-theme-amber")
        };
    }

    // Chia 12 bài thành 3 hàng (3 chặng học tập)
    var stage1 = Model.Steps.Take(4).ToList();
    var stage2 = Model.Steps.Skip(4).Take(4).ToList();
    var stage3 = Model.Steps.Skip(8).Take(4).ToList();

    var stages = new[]
    {
        (StageIndex: 1, Name: "Chặng 1: Khởi Động", Sub: "Làm quen chữ cái & Nét cơ bản", Icon: "rocket_launch", ThemeClass: "stage-launch", Steps: stage1, StartIndex: 1),
        (StageIndex: 2, Name: "Chặng 2: Khám Phá", Sub: "Chữ số, Toán học & Tư duy logic", Icon: "explore", ThemeClass: "stage-explore", Steps: stage2, StartIndex: 5),
        (StageIndex: 3, Name: "Chặng 3: Về Đích", Sub: "Luyện nét, Kỹ năng & Thử thách", Icon: "emoji_events", ThemeClass: "stage-finish", Steps: stage3, StartIndex: 9)
    };
}

@{
    var childName = string.IsNullOrWhiteSpace(Model.ChildProfile?.Nickname) ? "Con" : Model.ChildProfile!.Nickname.Trim();

    // Hình minh họa to, dễ nhận ra cho bé 5 tuổi (thay cho biểu tượng nét mảnh).
    string StepEmoji(LearningItem item)
    {
        var interaction = item.InteractionType?.ToLowerInvariant() ?? "";
        if (interaction == InteractionTypes.Tracing) return "✏️";
        if (interaction == InteractionTypes.Counting) return "🔢";
        if (interaction == InteractionTypes.Matching) return "🧩";
        return (item.SkillGroup?.Code?.ToLowerInvariant() ?? "") switch
        {
            "chu-cai" => "🔤",
            "chu-so" => "🔢",
            "tu-duy-logic" => "💡",
            "hinh-dang-khong-gian" => "🔺",
            "ky-nang-song" => "💖",
            "ngon-ngu" => "📚",
            "ghi-nho-tap-trung" => "🧠",
            _ => "⭐"
        };
    }

    // Bài đã xong nhưng chưa ghi nhận sao thì vẫn hiển thị đủ 3 sao (giống bản đồ kỹ năng).
    int ShownStars(TodayLessonStepViewModel s) => s.StarsEarned > 0 ? Math.Min(s.StarsEarned, 3) : 3;

    var remainingCount = Model.TotalCount - Model.CompletedCount;
    var guideText = isAllDone
        ? $"Giỏi quá {childName} ơi! Con đã học xong cả {Model.TotalCount} bài hôm nay. Mình đi nhận quà nhé! 🎁"
        : Model.CompletedCount == 0
            ? $"Chào {childName}! Hôm nay mình cùng học chủ đề “{Model.DayThemeTitle}” nhé! 🌟"
            : $"{childName} giỏi lắm, xong {Model.CompletedCount} bài rồi! Còn {remainingCount} bài nữa thôi, cố lên nào! 💪";
    var stageEmojis = new[] { "🚀", "🧭", "🏆" };
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/kid-hub.css" asp-append-version="true" />

<div class="kh kh-today kh--with-dock">
    <div class="kh-sky" aria-hidden="true">
        <span class="kh-cloud kh-cloud--1"></span>
        <span class="kh-cloud kh-cloud--2"></span>
        <span class="kh-cloud kh-cloud--3"></span>
        <span class="kh-float kh-float--1">🗺️</span>
        <span class="kh-float kh-float--2">⭐</span>
        <span class="kh-float kh-float--3">🚩</span>
        <span class="kh-float kh-float--4">🎈</span>
    </div>

    <header class="kh-topbar">
        <a class="kh-pill" asp-controller="Kids" asp-action="Home" title="Về trang chủ bé học" aria-label="Trang chủ" onclick="playAudioChime('tap')">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span><span class="kh-hide-sm">Trang chủ</span>
        </a>
        <a class="kh-avatar" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bé khác" aria-label="Đổi bé khác" onclick="playAudioChime('tap')">
            <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Avatar bé" />
            <span class="kh-avatar-badge material-symbols-outlined" aria-hidden="true">sync_alt</span>
        </a>
        <div class="kh-brand">
            <span class="kh-brand-mark" aria-hidden="true">🗺️</span>
            <span class="kh-brand-text">
                <small>Ngày @Model.SelectedDayNumber</small>
                <strong>Hành Trình Học Tập</strong>
            </span>
        </div>
        <div class="kh-pill kh-pill--stars" title="Số bài hoàn thành trong ngày">
            <span aria-hidden="true">⭐</span><strong>@Model.CompletedCount/@Model.TotalCount</strong><small class="kh-hide-sm">bài</small>
        </div>
        <button type="button" class="kh-pill kh-pill--lock" onclick="playAudioChime('tap'); openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh (Cần giải phép tính)" aria-label="Góc phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span><span class="kh-hide-sm">Ba mẹ</span>
        </button>
    </header>

    <!-- Dải chọn ngày học: mỗi ngày là một "hòn đá" trên đường đi -->
    <nav class="kh-days" aria-label="Chọn ngày học">
        <button type="button" class="kh-days-arrow" onclick="scrollRoadmap(-1)" aria-label="Ngày trước" title="Lùi lại">
            <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
        </button>
        <div class="kh-days-track" id="roadmapStripTrack">
            @foreach (var day in Model.RoadmapDays)
            {
                if (day.IsLocked)
                {
                    <div class="kh-day is-locked" title="Ngày @day.DayNumber (Chưa mở khóa)" aria-disabled="true">
                        <small>Ngày</small>
                        <strong>@day.DayNumber</strong>
                        <span class="kh-day-mark material-symbols-outlined" aria-hidden="true">lock</span>
                    </div>
                }
                else
                {
                    var isSelected = day.DayNumber == Model.SelectedDayNumber;
                    <a class="kh-day @(isSelected ? "is-selected" : "") @(day.IsCompleted ? "is-completed" : day.IsCurrent ? "is-current" : "")"
                       asp-controller="Kids"
                       asp-action="Today"
                       asp-route-day="@day.DayNumber"
                       onclick="playAudioChime('click')"
                       aria-current="@(isSelected ? "page" : null)"
                       title="@day.Title">
                        <small>Ngày</small>
                        <strong>@day.DayNumber</strong>
                        @if (day.IsCompleted)
                        {
                            <span class="kh-day-mark" aria-hidden="true">✓</span>
                        }
                        else if (day.IsCurrent)
                        {
                            <span class="kh-day-mark" aria-hidden="true">★</span>
                        }
                    </a>
                }
            }
        </div>
        <button type="button" class="kh-days-arrow" onclick="scrollRoadmap(1)" aria-label="Ngày sau" title="Xem tiếp">
            <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </button>
    </nav>

    <!-- Sóc Nâu dẫn đường + tiến độ ngày + nút học tiếp -->
    <section class="kh-hero">
        <div class="kh-guide">
            <img class="kh-guide-img" src="~/images/mascot-squirrel-3d.png" alt="Sóc Nâu" />
            <p class="kh-bubble">@guideText</p>
        </div>
        <div class="kh-hero-card">
            <div class="kh-meter" role="progressbar" aria-valuemin="0" aria-valuemax="@Model.TotalCount" aria-valuenow="@Model.CompletedCount" aria-label="Tiến độ hôm nay">
                <div class="kh-meter-label">
                    <span>Ngày @Model.SelectedDayNumber · @Model.DayThemeTitle</span>
                    <strong>@Model.CompletedCount / @Model.TotalCount bài · @progressPercent%</strong>
                </div>
                <div class="kh-meter-track"><span style="width:@progressPercent%"></span></div>
            </div>
            @if (isAllDone)
            {
                <a class="kh-continue kh-continue--gold" asp-controller="Kids" asp-action="Summary" onclick="playAudioChime('celebrate')">
                    <span class="kh-continue-orb" aria-hidden="true">🏆</span>
                    <span class="kh-continue-text">
                        <small>Con đã học xong cả ngày!</small>
                        <strong>Tổng kết & Nhận quà</strong>
                    </span>
                    <span class="kh-continue-play material-symbols-outlined" aria-hidden="true">play_arrow</span>
                </a>
            }
            else if (activeStep != null)
            {
                var activeIsPractice = activeStep.Status == TodayLessonStepStatus.NeedsPractice;
                <a class="kh-continue @(activeIsPractice ? "kh-continue--practice" : "")" asp-controller="Kids" asp-action="Learn" asp-route-id="@activeStep.Item.Id" onclick="playAudioChime('start')">
                    <span class="kh-continue-orb" aria-hidden="true">@StepEmoji(activeStep.Item)</span>
                    <span class="kh-continue-text">
                        <small>@(activeIsPractice ? "Con luyện lại" : Model.CompletedCount == 0 ? "Bắt đầu nào" : "Học tiếp") · Bài @activeStepIndex</small>
                        <strong>@activeStep.Item.Title</strong>
                    </span>
                    <span class="kh-continue-play material-symbols-outlined" aria-hidden="true">play_arrow</span>
                </a>
            }
            else
            {
                <div class="kh-empty">
                    <span class="kh-empty-icon" aria-hidden="true">📦</span>
                    <div><strong>Cô đang chuẩn bị bài mới cho con. Con quay lại sau nhé!</strong></div>
                </div>
            }
        </div>
    </section>

    <!-- Các chặng học: mỗi chặng 4 bài -->
    <div class="kh-stages">
        @foreach (var st in stages)
        {
            if (st.Steps.Count == 0)
            {
                continue;
            }
            var stageDone = st.Steps.Count(x => x.Status == TodayLessonStepStatus.Completed);
            var isStageComplete = stageDone == st.Steps.Count && st.Steps.Count > 0;

            <section class="kh-stage kh-stage--@st.StageIndex @(isStageComplete ? "is-done" : "")" aria-label="@st.Name">
                <div class="kh-stage-head">
                    <span class="kh-stage-emoji" aria-hidden="true">@(stageEmojis[st.StageIndex - 1])</span>
                    <span class="kh-stage-text">
                        <small>Chặng @st.StageIndex</small>
                        <strong>@(st.Name.Replace($"Chặng {st.StageIndex}: ", ""))</strong>
                        <span>@st.Sub</span>
                    </span>
                    @if (isStageComplete)
                    {
                        <span class="kh-chip kh-chip--good">🏆 Xong rồi!</span>
                    }
                    else
                    {
                        <span class="kh-chip">@stageDone/@st.Steps.Count bài</span>
                    }
                </div>

                <div class="kh-steps">
                    @for (var j = 0; j < st.Steps.Count; j++)
                    {
                        var step = st.Steps[j];
                        var stepNum = st.StartIndex + j;
                        var (subjectTag, _, _) = ResolveSubject(step.Item);
                        var statusClass = step.Status.ToString().ToLowerInvariant();
                        var isLocked = step.Status == TodayLessonStepStatus.Locked;
                        var isCompleted = step.Status == TodayLessonStepStatus.Completed;
                        var isActive = step.Status == TodayLessonStepStatus.Active;
                        var isNeedsPractice = step.Status == TodayLessonStepStatus.NeedsPractice;
                        var isCurrent = !isAllDone && ReferenceEquals(step, activeStep) && (isActive || isNeedsPractice);
                        var learnUrl = Url.Action("Learn", "Kids", new { id = step.Item.Id });
                        var stateText = isCompleted ? "đã xong" : isActive ? "đang mở" : isNeedsPractice ? "cần luyện thêm" : "chưa mở";

                        <article class="kh-step kh-step--@statusClass @(isCurrent ? "is-current" : "") @(!isLocked ? "is-clickable" : "")"
                                 data-step-index="@stepNum"
                                 role="@(isLocked ? null : "button")"
                                 aria-disabled="@(isLocked ? "true" : null)"
                                 aria-label="Bài @stepNum: @step.Item.Title (@stateText)"
                                 onclick="@(!isLocked ? $"onQuestCardClick('{learnUrl}')" : null)">
                            @if (isCurrent)
                            {
                                <span class="kh-step-flag">@(isNeedsPractice ? "Con luyện lại bài này nhé!" : "Con học bài này nhé!")</span>
                            }
                            <span class="kh-step-num">@stepNum</span>
                            <span class="kh-step-orb" aria-hidden="true">
                                <span class="kh-step-icon">@StepEmoji(step.Item)</span>
                                @if (isCompleted)
                                {
                                    <span class="kh-step-badge">✓</span>
                                }
                                else if (isNeedsPractice)
                                {
                                    <span class="kh-step-badge material-symbols-outlined">replay</span>
                                }
                                else if (isLocked)
                                {
                                    <span class="kh-step-badge material-symbols-outlined">lock</span>
                                }
                            </span>
                            <span class="kh-step-subject">@subjectTag</span>
                            <h4 class="kh-step-title" title="@step.Item.Title">@step.Item.Title</h4>
                            @if (isCompleted)
                            {
                                var shown = ShownStars(step);
                                <span class="kh-step-stars" aria-label="@shown sao">@(new string('★', shown))<span class="is-empty">@(new string('★', 3 - shown))</span></span>
                                <span class="kh-step-cta">
                                    <span class="material-symbols-outlined" aria-hidden="true">replay</span>
                                    <span>Học lại</span>
                                </span>
                            }
                            else if (isActive)
                            {
                                <span class="kh-step-cta">
                                    <span>Vào học</span>
                                    <span class="material-symbols-outlined" aria-hidden="true">play_arrow</span>
                                </span>
                            }
                            else if (isNeedsPractice)
                            {
                                <span class="kh-step-cta">
                                    <span>Luyện lại</span>
                                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                                </span>
                            }
                            else
                            {
                                <span class="kh-step-cta">
                                    <span class="material-symbols-outlined" aria-hidden="true">lock</span>
                                    <span>Chưa mở</span>
                                </span>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    <!-- Rương quà cuối ngày -->
    <div class="kh-finale">
        <span class="kh-finale-chest" aria-hidden="true">🎁</span>
        <div class="kh-finale-text">
            <h3>Rương quà cuối ngày</h3>
            <p>Học xong các bài hôm nay để nhận thật nhiều sao vàng và mở khóa huy hiệu nhé!</p>
        </div>
        <a class="kh-continue kh-continue--gold" asp-controller="Kids" asp-action="Summary" onclick="playAudioChime('celebrate')">
            <span class="kh-continue-orb" aria-hidden="true">🏅</span>
            <span class="kh-continue-text">
                <small>Xem kết quả</small>
                <strong>Tổng kết & Nhận quà</strong>
            </span>
        </a>
    </div>

    <!-- Thanh điều hướng dưới của khu bé -->
    <nav class="kid-bottom-nav kh-dock" aria-label="Điều hướng">
        <a asp-controller="Kids" asp-action="Home" onclick="playAudioChime('tap')">
            <span class="material-symbols-outlined" aria-hidden="true">home</span>
            <span>Trang chủ</span>
        </a>
        @if (await Modules.IsVisibleAsync(KidsModuleKeys.Today))
        {
            <a class="active" asp-controller="Kids" asp-action="Today" onclick="playAudioChime('tap')" aria-current="page">
                <span class="material-symbols-outlined" aria-hidden="true">map</span>
                <span>Bài tập</span>
            </a>
        }
        @if (await Modules.IsVisibleAsync(KidsModuleKeys.Rewards))
        {
            <a asp-controller="Kids" asp-action="Rewards" onclick="playAudioChime('tap')">
                <span class="material-symbols-outlined" aria-hidden="true">emoji_events</span>
                <span>Quà tặng</span>
            </a>
        }
        <a href="#" onclick="playAudioChime('tap'); openParentGate('/parent/dashboard'); return false;" title="Cổng mở khóa cho phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <span>Phụ huynh</span>
        </a>
    </nav>
</div>

@section Scripts {
    <script>
        (function () {
            let audioCtx = null;
            function getAudioContext() {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (AudioContextClass) audioCtx = new AudioContextClass();
                }
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                return audioCtx;
            }

            window.playAudioChime = function (type) {
                try {
                    const ctx = getAudioContext();
                    if (!ctx) return;

                    const now = ctx.currentTime;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    if (type === 'tap') {
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(523.25, now);
                        osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.08);
                        gain.gain.setValueAtTime(0.15, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
                        osc.start(now);
                        osc.stop(now + 0.1);
                    } else if (type === 'click') {
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(440, now);
                        gain.gain.setValueAtTime(0.1, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
                        osc.start(now);
                        osc.stop(now + 0.06);
                    } else if (type === 'start') {
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(440, now);
                        osc.frequency.exponentialRampToValueAtTime(880, now + 0.18);
                        gain.gain.setValueAtTime(0.18, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
                        osc.start(now);
                        osc.stop(now + 0.22);
                    } else if (type === 'celebrate') {
                        const notes = [523.25, 659.25, 783.99, 1046.50];
                        notes.forEach((freq, idx) => {
                            const o = ctx.createOscillator();
                            const g = ctx.createGain();
                            o.type = 'triangle';
                            o.frequency.setValueAtTime(freq, now + idx * 0.07);
                            g.gain.setValueAtTime(0.15, now + idx * 0.07);
                            g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.07 + 0.15);
                            o.connect(g);
                            g.connect(ctx.destination);
                            o.start(now + idx * 0.07);
                            o.stop(now + idx * 0.07 + 0.15);
                        });
                    }
                } catch (e) {
                    console.warn("Audio chime error:", e);
                }
            };

            window.scrollRoadmap = function (direction) {
                const track = document.getElementById('roadmapStripTrack');
                if (!track) return;
                const scrollAmount = direction * 280;
                track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                playAudioChime('click');
            };

            window.onQuestCardClick = function (url) {
                if (!url) return;
                playAudioChime('start');
                setTimeout(() => {
                    window.location.href = url;
                }, 120);
            };

            document.addEventListener('DOMContentLoaded', () => {
                const track = document.getElementById('roadmapStripTrack');
                const selectedPill = track?.querySelector('.kh-day.is-selected');
                if (track && selectedPill) {
                    const pillLeft = selectedPill.offsetLeft;
                    const trackWidth = track.clientWidth;
                    const pillWidth = selectedPill.clientWidth;
                    track.scrollTo({
                        left: pillLeft - (trackWidth / 2) + (pillWidth / 2),
                        behavior: 'smooth'
                    });
                }
            });
        })();
    </script>
}
