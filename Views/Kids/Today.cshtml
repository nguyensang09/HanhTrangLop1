@model TodayLessonViewModel
@{
    ViewData["Title"] = $"Bài Học Hôm Nay - Ngày {Model.SelectedDayNumber}";
    var progressPercent = Model.TotalCount == 0 ? 0 : (Model.CompletedCount * 100 / Model.TotalCount);
    var isAllDone = Model.TotalCount > 0 && Model.CompletedCount == Model.TotalCount;
    var totalStarsToday = Model.Steps.Sum(x => x.StarsEarned);
    var activeStep = Model.Steps.FirstOrDefault(x => x.Status == TodayLessonStepStatus.Active)
                     ?? Model.Steps.FirstOrDefault(x => x.Status == TodayLessonStepStatus.NeedsPractice)
                     ?? Model.Steps.FirstOrDefault();
    var activeStepIndex = activeStep != null ? Model.Steps.ToList().IndexOf(activeStep) + 1 : 1;

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" or "meo-con" => "/images/avatars/avatar-cat.png",
            "avatar-dog" or "cun-con" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    (string Tag, string Icon, string ThemeClass) ResolveSubject(LearningItem item)
    {
        var skillCode = item.SkillGroup?.Code?.ToLowerInvariant() ?? "";
        var interaction = item.InteractionType?.ToLowerInvariant() ?? "";

        if (interaction == InteractionTypes.Tracing)
        {
            return ("Bé tập tô", "draw", "quest-theme-coral");
        }

        return skillCode switch
        {
            "chu-cai" => ("Chữ cái & Nét", "menu_book", "quest-theme-amber"),
            "chu-so" or "so-luong-toan" => ("Toán & Chữ số", "calculate", "quest-theme-mint"),
            "tu-duy-logic" or "hinh-dang-khong-gian" => ("Tư duy & Logic", "psychology", "quest-theme-cyan"),
            "ky-nang-song" => ("Kỹ năng sống", "volunteer_activism", "quest-theme-purple"),
            "ngon-ngu" => ("Vần từ & Âm", "record_voice_over", "quest-theme-pink"),
            _ => (item.SkillGroup?.Name ?? "Bài học", "school", "quest-theme-amber")
        };
    }

    // Chia 12 bài thành 3 hàng (3 chặng học tập)
    var stage1 = Model.Steps.Take(4).ToList();
    var stage2 = Model.Steps.Skip(4).Take(4).ToList();
    var stage3 = Model.Steps.Skip(8).Take(4).ToList();

    var stages = new[]
    {
        (StageIndex: 1, Name: "Chặng 1: Khởi Động", Sub: "Làm quen chữ cái & Nét cơ bản", Icon: "rocket_launch", ThemeClass: "stage-launch", Steps: stage1, StartIndex: 1),
        (StageIndex: 2, Name: "Chặng 2: Khám Phá", Sub: "Chữ số, Toán học & Tư duy logic", Icon: "explore", ThemeClass: "stage-explore", Steps: stage2, StartIndex: 5),
        (StageIndex: 3, Name: "Chặng 3: Về Đích", Sub: "Luyện nét, Kỹ năng & Thử thách", Icon: "emoji_events", ThemeClass: "stage-finish", Steps: stage3, StartIndex: 9)
    };
}

<section class="kid-screen kid-today-screen">
    <!-- Topbar chuẩn không gian bé (Đồng bộ với Góc Bé Tập Tô & toàn bộ Kids Zone) -->
    <header class="child-zone-header clay-card">
        <div class="child-header-left">
            <a class="child-back-home-btn" asp-controller="Kids" asp-action="Home" title="Về trang chủ bé học" aria-label="Trang chủ" onclick="playAudioChime('tap')">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <a class="child-avatar-touch" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bé khác" onclick="playAudioChime('tap')">
                <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Avatar bé" class="child-avatar-img" />
                <span class="child-avatar-switch-badge" title="Đổi bé">
                    <span class="material-symbols-outlined">sync_alt</span>
                </span>
            </a>
            <div class="child-header-greeting">
                <span class="child-hi-eyebrow">Hành Trang Lớp 1</span>
                <strong class="child-name-display">Bài Học Hôm Nay 🌟</strong>
            </div>
        </div>

        <div class="child-header-center">
            <div class="child-star-badge-3d" title="Số bài hoàn thành trong ngày">
                <span class="star-3d-icon">⭐</span>
                <span class="star-number-display">@Model.CompletedCount/@Model.TotalCount</span>
                <span class="star-label-text">bài hoàn thành</span>
            </div>
        </div>

        <div class="child-header-right">
            <button type="button" class="child-lock-gate-btn" onclick="playAudioChime('tap'); openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh (Cần giải phép tính)" aria-label="Góc phụ huynh">
                <span class="material-symbols-outlined lock-icon">lock</span>
                <span class="lock-label-text">Ba mẹ</span>
            </button>
        </div>
    </header>

    <div class="today-content-wrap">
        <!-- Dải chọn 20 ngày học đồng bộ khung rộng -->
        <div class="today-compact-strip-bar">
            <button type="button" class="strip-arrow-btn" onclick="scrollRoadmap(-1)" aria-label="Ngày trước" title="Lùi lại">
                <span class="material-symbols-outlined">chevron_left</span>
            </button>
            <div class="compact-days-track" id="roadmapStripTrack">
                @foreach (var day in Model.RoadmapDays)
                {
                    if (day.IsLocked)
                    {
                        <div class="day-pill-item is-locked" title="Ngày @day.DayNumber (Chưa mở khóa)">
                            <span class="pill-day-label">Ngày @day.DayNumber</span>
                            <span class="material-symbols-outlined pill-lock-icon">lock</span>
                        </div>
                    }
                    else
                    {
                        var isSelected = day.DayNumber == Model.SelectedDayNumber;
                        <a class="day-pill-item @(isSelected ? "is-selected" : "") @(day.IsCompleted ? "is-completed" : day.IsCurrent ? "is-current" : "")"
                           asp-controller="Kids"
                           asp-action="Today"
                           asp-route-day="@day.DayNumber"
                           onclick="playAudioChime('click')"
                           title="@day.Title">
                            <span class="pill-day-label">Ngày @day.DayNumber</span>
                            @if (day.IsCompleted)
                            {
                                <span class="material-symbols-outlined pill-check-icon">check_circle</span>
                            }
                            else if (day.IsCurrent)
                            {
                                <span class="pill-current-dot"></span>
                            }
                        </a>
                    }
                }
            </div>
            <button type="button" class="strip-arrow-btn" onclick="scrollRoadmap(1)" aria-label="Ngày sau" title="Xem tiếp">
                <span class="material-symbols-outlined">chevron_right</span>
            </button>
        </div>

        <!-- Banner chủ đề ngày & Nút tiếp tục bài học -->
        <div class="today-day-hero-card">
            <div class="hero-theme-info">
                <div class="hero-day-badge">Ngày @Model.SelectedDayNumber</div>
                <div class="hero-theme-details">
                    <h2 class="hero-theme-title">@Model.DayThemeTitle</h2>
                    <div class="hero-progress-inline">
                        <div class="hero-progress-track">
                            <div class="hero-progress-fill" style="width: @progressPercent%"></div>
                        </div>
                        <span class="hero-progress-text">@Model.CompletedCount/@Model.TotalCount bài hoàn thành (@progressPercent%)</span>
                    </div>
                </div>
            </div>
            <div class="hero-action-slot">
                @if (isAllDone)
                {
                    <a class="hero-cta-btn is-all-done" asp-controller="Kids" asp-action="Summary" onclick="playAudioChime('celebrate')">
                        <span class="material-symbols-outlined">military_tech</span>
                        <span>Tổng kết & Nhận quà</span>
                    </a>
                }
                else if (activeStep != null)
                {
                    <a class="hero-cta-btn is-active-step pulse-button" asp-controller="Kids" asp-action="Learn" asp-route-id="@activeStep.Item.Id" onclick="playAudioChime('start')">
                        <span class="material-symbols-outlined">play_circle</span>
                        <span>Học tiếp Bài @activeStepIndex</span>
                        <span class="material-symbols-outlined arrow-icon">arrow_forward</span>
                    </a>
                }
            </div>
        </div>

        <!-- 12 BÀI HỌC CHIA LÀM 3 HÀNG (MỖI HÀNG 4 BÀI TRÊN KHUNG RỘNG) -->
        <div class="today-stages-wrap">
            @foreach (var st in stages)
            {
                var stageDone = st.Steps.Count(x => x.Status == TodayLessonStepStatus.Completed);
                var isStageComplete = stageDone == st.Steps.Count && st.Steps.Count > 0;

                <section class="today-stage-row @st.ThemeClass">
                    <div class="stage-row-header">
                        <div class="stage-header-title-col">
                            <span class="material-symbols-outlined stage-icon">@st.Icon</span>
                            <div class="stage-text-meta">
                                <h3 class="stage-title">@st.Name</h3>
                                <span class="stage-subtitle">@st.Sub</span>
                            </div>
                        </div>
                        <div class="stage-header-stat">
                            <span class="stage-stat-badge @(isStageComplete ? "is-all-done" : "")">
                                @(isStageComplete ? "✓ Hoàn thành" : $"{stageDone}/{st.Steps.Count} bài")
                            </span>
                        </div>
                    </div>

                    <div class="today-stage-grid">
                        @for (var j = 0; j < st.Steps.Count; j++)
                        {
                            var step = st.Steps[j];
                            var stepNum = st.StartIndex + j;
                            var (subjectTag, subjectIcon, themeClass) = ResolveSubject(step.Item);
                            var statusClass = step.Status.ToString().ToLowerInvariant();
                            var isLocked = step.Status == TodayLessonStepStatus.Locked;
                            var isCompleted = step.Status == TodayLessonStepStatus.Completed;
                            var isActive = step.Status == TodayLessonStepStatus.Active;
                            var isNeedsPractice = step.Status == TodayLessonStepStatus.NeedsPractice;

                            var mainIcon = step.Item.InteractionType == InteractionTypes.Tracing ? "draw" :
                                           step.Item.InteractionType == InteractionTypes.Counting ? "pin" :
                                           step.Item.InteractionType == InteractionTypes.Matching ? "join" :
                                           subjectIcon;

                            <article class="today-quest-card @themeClass @statusClass @(!isLocked ? "is-clickable" : "")"
                                     data-step-index="@stepNum"
                                     onclick="@(!isLocked ? $"onQuestCardClick('{Url.Action("Learn", "Kids", new { id = step.Item.Id })}')" : "")">
                                <!-- Card Top: Số bài + Môn học + Sao -->
                                <div class="quest-card-top">
                                    <div class="quest-left-tags">
                                        <span class="quest-num-pill">Bài @stepNum</span>
                                        <span class="quest-subject-tag">
                                            <span class="material-symbols-outlined sub-mini-ico">@subjectIcon</span>
                                            <span>@subjectTag</span>
                                        </span>
                                    </div>
                                    <span class="quest-star-val @(isCompleted ? "is-earned" : "")">
                                        ⭐ @(isCompleted ? $"+{step.StarsEarned}" : "3")
                                    </span>
                                </div>

                                <!-- Card Body: Icon minh họa + Tên bài học rõ ràng trên khung rộng -->
                                <div class="quest-card-body">
                                    <div class="quest-icon-bubble">
                                        <span class="material-symbols-outlined">@mainIcon</span>
                                        @if (isCompleted)
                                        {
                                            <span class="quest-bubble-badge check material-symbols-outlined">check_circle</span>
                                        }
                                        else if (isLocked)
                                        {
                                            <span class="quest-bubble-badge lock material-symbols-outlined">lock</span>
                                        }
                                    </div>
                                    <div class="quest-text-meta">
                                        <h4 class="quest-card-title" title="@step.Item.Title">@step.Item.Title</h4>
                                    </div>
                                </div>

                                <!-- Card Footer: Trạng thái & Nút hành động -->
                                <div class="quest-card-footer">
                                    @if (isCompleted)
                                    {
                                        <span class="quest-done-pill">
                                            <span class="material-symbols-outlined">check_circle</span>
                                            <span>Đã xong</span>
                                        </span>
                                        <span class="quest-replay-btn" title="Học lại bài này">
                                            <span class="material-symbols-outlined">replay</span>
                                            <span>Học lại</span>
                                        </span>
                                    }
                                    else if (isActive)
                                    {
                                        <span class="quest-btn-cta active-btn">
                                            <span>Vào học</span>
                                            <span class="material-symbols-outlined">play_arrow</span>
                                        </span>
                                    }
                                    else if (isNeedsPractice)
                                    {
                                        <span class="quest-btn-cta practice-btn">
                                            <span>Luyện lại</span>
                                            <span class="material-symbols-outlined">restart_alt</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="quest-locked-pill">
                                            <span class="material-symbols-outlined">lock</span>
                                            <span>Chưa mở</span>
                                        </span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        <!-- Tổng kết & Quà tặng cuối trang -->
        <div class="today-summary-banner">
            <div class="summary-banner-content">
                <div class="summary-chest-illustration">
                    <span class="chest-emoji">🎁</span>
                    <span class="sparkle-emoji">✨</span>
                </div>
                <div class="summary-banner-text">
                    <h3>Tổng kết kết quả & Mở khóa quà tặng</h3>
                    <p>Hoàn thành 12 bài học mỗi ngày giúp bé tích lũy nhiều sao vàng để mở khóa 18 huy hiệu vinh danh độc đáo!</p>
                </div>
            </div>
            <a class="summary-banner-btn" asp-controller="Kids" asp-action="Summary" onclick="playAudioChime('celebrate')">
                <span class="material-symbols-outlined">military_tech</span>
                <span>Xem Tổng Kết & Nhận Quà</span>
                <span class="material-symbols-outlined">arrow_forward</span>
            </a>
        </div>
    </div>
</section>

<!-- Bottom Navigation Bar chuẩn Kids Zone -->
<nav class="kid-bottom-nav">
    <a asp-controller="Kids" asp-action="Home" onclick="playAudioChime('tap')">
        <span class="material-symbols-outlined">home</span>
        <span>Trang chủ</span>
    </a>
    <a class="active" asp-controller="Kids" asp-action="Today" onclick="playAudioChime('tap')">
        <span class="material-symbols-outlined">edit_square</span>
        <span>Bài tập</span>
    </a>
    <a asp-controller="Kids" asp-action="Rewards" onclick="playAudioChime('tap')">
        <span class="material-symbols-outlined">emoji_events</span>
        <span>Quà tặng</span>
    </a>
    <a href="#" onclick="playAudioChime('tap'); openParentGate('/parent/dashboard'); return false;" title="Cổng mở khóa cho phụ huynh">
        <span class="material-symbols-outlined">lock</span>
        <span>Phụ huynh</span>
    </a>
</nav>

@section Scripts {
    <script>
        (function () {
            let audioCtx = null;
            function getAudioContext() {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (AudioContextClass) audioCtx = new AudioContextClass();
                }
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                return audioCtx;
            }

            window.playAudioChime = function (type) {
                try {
                    const ctx = getAudioContext();
                    if (!ctx) return;

                    const now = ctx.currentTime;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    if (type === 'tap') {
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(523.25, now);
                        osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.08);
                        gain.gain.setValueAtTime(0.15, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
                        osc.start(now);
                        osc.stop(now + 0.1);
                    } else if (type === 'click') {
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(440, now);
                        gain.gain.setValueAtTime(0.1, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
                        osc.start(now);
                        osc.stop(now + 0.06);
                    } else if (type === 'start') {
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(440, now);
                        osc.frequency.exponentialRampToValueAtTime(880, now + 0.18);
                        gain.gain.setValueAtTime(0.18, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
                        osc.start(now);
                        osc.stop(now + 0.22);
                    } else if (type === 'celebrate') {
                        const notes = [523.25, 659.25, 783.99, 1046.50];
                        notes.forEach((freq, idx) => {
                            const o = ctx.createOscillator();
                            const g = ctx.createGain();
                            o.type = 'triangle';
                            o.frequency.setValueAtTime(freq, now + idx * 0.07);
                            g.gain.setValueAtTime(0.15, now + idx * 0.07);
                            g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.07 + 0.15);
                            o.connect(g);
                            g.connect(ctx.destination);
                            o.start(now + idx * 0.07);
                            o.stop(now + idx * 0.07 + 0.15);
                        });
                    }
                } catch (e) {
                    console.warn("Audio chime error:", e);
                }
            };

            window.scrollRoadmap = function (direction) {
                const track = document.getElementById('roadmapStripTrack');
                if (!track) return;
                const scrollAmount = direction * 280;
                track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                playAudioChime('click');
            };

            window.onQuestCardClick = function (url) {
                if (!url) return;
                playAudioChime('start');
                setTimeout(() => {
                    window.location.href = url;
                }, 120);
            };

            document.addEventListener('DOMContentLoaded', () => {
                const track = document.getElementById('roadmapStripTrack');
                const selectedPill = track?.querySelector('.day-pill-item.is-selected');
                if (track && selectedPill) {
                    const pillLeft = selectedPill.offsetLeft;
                    const trackWidth = track.clientWidth;
                    const pillWidth = selectedPill.clientWidth;
                    track.scrollTo({
                        left: pillLeft - (trackWidth / 2) + (pillWidth / 2),
                        behavior: 'smooth'
                    });
                }
            });
        })();
    </script>
}
