@model KidsTracingHubViewModel
@{
    ViewData["Title"] = "Góc Bé Tập Tô & Luyện Nét";
    var percent = Model.TotalCount == 0 ? 0 : (Model.CompletedCount * 100 / Model.TotalCount);
    var childName = string.IsNullOrWhiteSpace(Model.ChildProfile?.Nickname) ? "Con" : Model.ChildProfile!.Nickname.Trim();

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    string PictureEmoji(string? symbol) => symbol switch
    {
        "phong-canh" => "🏞️",
        "do-dung" => "🎒",
        "hinh-hoc" => "⭐",
        "meo-con" => "🐱",
        "ca-heo" => "🐬",
        "o-che-mua" => "☂️",
        "trai-tao" => "🍎",
        "tau-hoa" => "🚂",
        "chu-tho" => "🐰",
        "ong-vang" => "🐝",
        "may-bay" => "✈️",
        "thuyen" => "⛵",
        "cau-vong" => "🌈",
        "chu-buom" => "🦋",
        "khung-long" => "🦕",
        "ten-lua" => "🚀",
        _ => "🎨"
    };

    // Hình hiển thị to trên thẻ và tên gọi ngắn gọn cho bé
    string CardSymbol(KidsTracingItemViewModel x, string kind) => kind switch
    {
        "basic" => string.IsNullOrWhiteSpace(x.DisplaySymbol) ? "〰" : x.DisplaySymbol,
        "picture" => PictureEmoji(x.Symbol),
        _ => x.Symbol
    };
    string CardLabel(KidsTracingItemViewModel x, string kind) => kind switch
    {
        "upper" or "lower" => $"Chữ {x.Symbol}",
        "number" => $"Số {x.Symbol}",
        _ => x.Title
    };

    var validTabs = new[] { "all", "basic", "picture", "upper", "lower", "number" };
    var activeTab = validTabs.Contains(Model.ActiveTab) ? Model.ActiveTab : "all";

    var sections = new[]
    {
        (Key: "basic", Title: "Nét cơ bản", Sub: "13 nét nền tảng: thẳng, xiên, móc, cong, khuyết và thắt", Emoji: "✏️", Tone: "kh-tone-amber", Unit: "bài", Compact: false, Items: Model.BasicStrokes),
        (Key: "picture", Title: "Tô tranh tạo hình", Sub: "Con vật, đồ vật, phong cảnh và hình học", Emoji: "🎨", Tone: "kh-tone-rose", Unit: "tranh", Compact: false, Items: Model.PictureTraces),
        (Key: "upper", Title: "Chữ in hoa", Sub: "33 chữ cái Việt – Anh viết hoa", Emoji: "🔠", Tone: "kh-tone-sky", Unit: "chữ", Compact: true, Items: Model.UppercaseLetters),
        (Key: "lower", Title: "Chữ in thường", Sub: "33 chữ cái Việt – Anh viết thường", Emoji: "🔡", Tone: "kh-tone-emerald", Unit: "chữ", Compact: true, Items: Model.LowercaseLetters),
        (Key: "number", Title: "Chữ số 0 – 20", Sub: "Tập viết các chữ số đầu tiên", Emoji: "🔢", Tone: "kh-tone-purple", Unit: "số", Compact: true, Items: Model.Numbers)
    };

    // Bài gợi ý tô tiếp: bài đầu tiên chưa tô theo thứ tự nét → chữ hoa → chữ thường → số → tranh
    var suggestion = new[] { "basic", "upper", "lower", "number", "picture" }
        .SelectMany(k => sections.First(s => s.Key == k).Items.Select(x => (Kind: k, Entry: x)))
        .FirstOrDefault(x => !x.Entry.IsCompleted);
    var nextEntry = suggestion.Entry;
    var nextKind = suggestion.Kind ?? "";
    var isAllDone = Model.TotalCount > 0 && Model.CompletedCount == Model.TotalCount;

    var guideText = isAllDone
        ? $"Giỏi quá {childName} ơi! Con đã tô xong tất cả các bài rồi! 🏆"
        : Model.CompletedCount == 0
            ? $"Chào {childName}! Con chọn một nét hoặc một chữ để tập tô nhé! ✏️"
            : $"{childName} đã tô xong {Model.CompletedCount} bài rồi! Mình tô tiếp nhé! 💪";

    int ShownStars(KidsTracingItemViewModel x) => Math.Clamp(x.StarsEarned <= 0 ? 3 : x.StarsEarned, 1, 3);
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/kid-hub.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/kid-extras.css" asp-append-version="true" />

<div class="kh kx-tracing kh--with-dock">
    @* Giữ lớp tracing-hub-screen để site.js + site.css mở cuộn tự do cho trang này. *@
    <span class="kh-scroll-marker tracing-hub-screen" aria-hidden="true"></span>

    <div class="kh-sky" aria-hidden="true">
        <span class="kh-cloud kh-cloud--1"></span>
        <span class="kh-cloud kh-cloud--2"></span>
        <span class="kh-cloud kh-cloud--3"></span>
        <span class="kh-float kh-float--1">✏️</span>
        <span class="kh-float kh-float--2">🖍️</span>
        <span class="kh-float kh-float--3">⭐</span>
        <span class="kh-float kh-float--4">🎨</span>
    </div>

    <header class="kh-topbar">
        <a class="kh-pill" asp-controller="Kids" asp-action="Home" title="Về trang chủ bé học" aria-label="Trang chủ">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span><span class="kh-hide-sm">Trang chủ</span>
        </a>
        <a class="kh-avatar" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi bé khác" aria-label="Đổi bé khác">
            <img src="@ResolveAvatar(Model.ChildProfile?.AvatarKey)" alt="Avatar bé" />
            <span class="kh-avatar-badge material-symbols-outlined" aria-hidden="true">sync_alt</span>
        </a>
        <div class="kh-brand">
            <span class="kh-brand-mark" aria-hidden="true">✏️</span>
            <span class="kh-brand-text">
                <small>Vở luyện nét & chữ</small>
                <strong>Góc Bé Tập Tô</strong>
            </span>
        </div>
        <div class="kh-pill kh-pill--stars" title="Số bài đã tô xong">
            <span aria-hidden="true">⭐</span><strong>@Model.CompletedCount/@Model.TotalCount</strong><small class="kh-hide-sm">đã tô</small>
        </div>
        <button type="button" class="kh-pill kh-pill--lock" onclick="openParentGate('/parent/dashboard')" title="Chuyển sang Góc Phụ Huynh (Cần giải phép tính)" aria-label="Góc phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span><span class="kh-hide-sm">Ba mẹ</span>
        </button>
    </header>

    <!-- Sóc Nâu dẫn đường + tiến độ + nút tô tiếp -->
    <section class="kh-hero">
        <div class="kh-guide">
            <img class="kh-guide-img" src="~/images/mascot-squirrel-3d.png" alt="Sóc Nâu" />
            <p class="kh-bubble">@guideText</p>
        </div>
        <div class="kh-hero-card">
            <div class="kh-meter" role="progressbar" aria-valuemin="0" aria-valuemax="@Model.TotalCount" aria-valuenow="@Model.CompletedCount" aria-label="Tiến độ tập tô">
                <div class="kh-meter-label">
                    <span>Con đã tô</span>
                    <strong>@Model.CompletedCount / @Model.TotalCount bài · @percent%</strong>
                </div>
                <div class="kh-meter-track"><span style="width:@percent%"></span></div>
            </div>
            @if (nextEntry != null)
            {
                <a class="kh-continue" asp-controller="Kids" asp-action="Learn" asp-route-id="@nextEntry.Item.Id" asp-route-fromTracing="true">
                    <span class="kh-continue-orb kx-continue-symbol" aria-hidden="true">@CardSymbol(nextEntry, nextKind)</span>
                    <span class="kh-continue-text">
                        <small>@(Model.CompletedCount == 0 ? "Bắt đầu tô nào" : "Tô tiếp nhé")</small>
                        <strong>@CardLabel(nextEntry, nextKind)</strong>
                    </span>
                    <span class="kh-continue-play material-symbols-outlined" aria-hidden="true">play_arrow</span>
                </a>
            }
            else if (isAllDone)
            {
                <a class="kh-continue kh-continue--gold" asp-controller="Kids" asp-action="Rewards">
                    <span class="kh-continue-orb" aria-hidden="true">🏆</span>
                    <span class="kh-continue-text">
                        <small>Con đã tô xong hết rồi!</small>
                        <strong>Đi xem quà nào</strong>
                    </span>
                    <span class="kh-continue-play material-symbols-outlined" aria-hidden="true">play_arrow</span>
                </a>
            }
            else
            {
                <div class="kh-empty">
                    <span class="kh-empty-icon" aria-hidden="true">📦</span>
                    <div><strong>Cô đang chuẩn bị bài tô mới. Con quay lại sau nhé!</strong></div>
                </div>
            }
        </div>
    </section>

    <!-- Thẻ chọn nhóm bài (giữ lớp tracing-tab-btn + data-tab cho script) -->
    <nav class="kh-tabs kx-tabs" aria-label="Chọn nhóm bài tô">
        <button type="button" class="kh-tab kx-tab tracing-tab-btn @(activeTab == "all" ? "active" : "")" data-tab="all" aria-pressed="@(activeTab == "all" ? "true" : "false")">
            <span class="kx-tab-emoji" aria-hidden="true">🌟</span>
            <span>Tất cả</span>
            <span class="kx-tab-count">@Model.TotalCount</span>
        </button>
        @foreach (var s in sections)
        {
            <button type="button" class="kh-tab kx-tab tracing-tab-btn @(activeTab == s.Key ? "active" : "")" data-tab="@s.Key" aria-pressed="@(activeTab == s.Key ? "true" : "false")">
                <span class="kx-tab-emoji" aria-hidden="true">@s.Emoji</span>
                <span>@s.Title</span>
                <span class="kx-tab-count">@s.Items.Count</span>
            </button>
        }
    </nav>

    @foreach (var s in sections)
    {
        var doneCount = s.Items.Count(x => x.IsCompleted);
        var isVisible = activeTab == "all" || activeTab == s.Key;
        <section class="kh-panel kx-trace-section @s.Tone" data-section="@s.Key" aria-label="@s.Title" hidden="@(isVisible ? null : "hidden")">
            <div class="kh-panel-head">
                <span class="kh-panel-emoji kx-panel-emoji" aria-hidden="true">@s.Emoji</span>
                <div class="kh-panel-title">
                    <h2>@s.Title</h2>
                    <p>@s.Sub</p>
                </div>
                @if (s.Items.Count > 0 && doneCount == s.Items.Count)
                {
                    <span class="kh-chip kh-chip--good">🏆 Xong hết rồi!</span>
                }
                else
                {
                    <span class="kh-chip">@doneCount/@s.Items.Count @s.Unit</span>
                }
            </div>

            @if (s.Items.Count == 0)
            {
                <div class="kh-empty">
                    <span class="kh-empty-icon" aria-hidden="true">📦</span>
                    <div><strong>Cô đang chuẩn bị bài mới cho con nhé!</strong></div>
                </div>
            }
            else
            {
                <div class="kx-trace-grid @(s.Compact ? "kx-trace-grid--compact" : "")">
                    @foreach (var entry in s.Items)
                    {
                        var label = CardLabel(entry, s.Key);
                        var isNext = nextEntry != null && entry.Item.Id == nextEntry.Item.Id;
                        var shown = ShownStars(entry);
                        <a class="kx-trace-card kx-trace-card--@s.Key @(entry.IsCompleted ? "is-done" : "") @(isNext ? "is-next" : "")"
                           asp-controller="Kids"
                           asp-action="Learn"
                           asp-route-id="@entry.Item.Id"
                           asp-route-fromTracing="true"
                           title="@entry.Title"
                           aria-label="@label – @(entry.IsCompleted ? $"đã tô xong, {shown} sao" : "chưa tô")">
                            @if (isNext)
                            {
                                <span class="kx-trace-flag" aria-hidden="true">Tô tiếp nhé!</span>
                            }
                            @if (entry.IsCompleted)
                            {
                                <span class="kx-trace-check" aria-hidden="true">✓</span>
                            }
                            <span class="kx-trace-symbol @(s.Key == "picture" ? "kx-trace-symbol--emoji" : s.Key == "basic" ? "kx-trace-symbol--stroke" : "")" aria-hidden="true">@CardSymbol(entry, s.Key)</span>
                            <span class="kx-trace-name">@label</span>
                            @if (entry.IsCompleted)
                            {
                                <span class="kx-stars" aria-hidden="true">@(new string('★', shown))<span class="is-empty">@(new string('★', 3 - shown))</span></span>
                                <span class="kx-trace-cta kx-trace-cta--done" aria-hidden="true">
                                    <span class="material-symbols-outlined">replay</span><span>Tô lại</span>
                                </span>
                            }
                            else
                            {
                                <span class="kx-trace-cta" aria-hidden="true">
                                    <span class="material-symbols-outlined">edit</span><span>Tô nào</span>
                                </span>
                            }
                        </a>
                    }
                </div>
            }
        </section>
    }

    <!-- Thanh điều hướng dưới của khu bé -->
    <nav class="kid-bottom-nav kh-dock" aria-label="Điều hướng">
        <a asp-controller="Kids" asp-action="Home">
            <span class="material-symbols-outlined" aria-hidden="true">home</span>
            <span>Trang chủ</span>
        </a>
        <a asp-controller="Kids" asp-action="Today">
            <span class="material-symbols-outlined" aria-hidden="true">map</span>
            <span>Bài tập</span>
        </a>
        <a asp-controller="Kids" asp-action="Rewards">
            <span class="material-symbols-outlined" aria-hidden="true">emoji_events</span>
            <span>Quà tặng</span>
        </a>
        <a href="#" onclick="openParentGate('/parent/dashboard'); return false;" title="Cổng mở khóa cho phụ huynh">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <span>Phụ huynh</span>
        </a>
    </nav>
</div>

@section Scripts {
<script>
(function () {
    var tabButtons = Array.prototype.slice.call(document.querySelectorAll(".tracing-tab-btn"));
    var sections = Array.prototype.slice.call(document.querySelectorAll(".kx-trace-section[data-section]"));
    if (!tabButtons.length) return;

    function applyTab(selectedTab) {
        tabButtons.forEach(function (btn) {
            var on = btn.getAttribute("data-tab") === selectedTab;
            btn.classList.toggle("active", on);
            btn.setAttribute("aria-pressed", on ? "true" : "false");
        });
        sections.forEach(function (sec) {
            sec.hidden = !(selectedTab === "all" || sec.getAttribute("data-section") === selectedTab);
        });
        // Ghi nhớ nhóm đang chọn vào ?tab= để khi bé quay lại vẫn đúng nhóm
        try {
            var url = new URL(window.location.href);
            if (selectedTab === "all") {
                url.searchParams.delete("tab");
            } else {
                url.searchParams.set("tab", selectedTab);
            }
            window.history.replaceState(window.history.state, "", url.toString());
        } catch (e) { }
    }

    tabButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
            applyTab(btn.getAttribute("data-tab") || "all");
        });
    });
})();
</script>
}
