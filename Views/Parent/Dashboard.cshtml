@model ParentDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Góc phụ huynh - Báo cáo & Đồng hành cùng bé";
    var isAdmin = User.IsInRole("Admin") || string.Equals(User.Identity?.Name, "admin", StringComparison.OrdinalIgnoreCase);

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    // Luôn xuất số theo dấu chấm thập phân để CSS (width/height) không bị hỏng khi máy chủ dùng văn hóa vi-VN.
    string Css(decimal value) => Math.Round(Math.Min(100m, Math.Max(0m, value)), 1).ToString(CultureInfo.InvariantCulture);
    string Pct(decimal value) => Math.Round(Math.Min(100m, Math.Max(0m, value))).ToString("0", CultureInfo.InvariantCulture);

    string WeekDay(DateTime date) => date.DayOfWeek switch
    {
        DayOfWeek.Monday => "T2",
        DayOfWeek.Tuesday => "T3",
        DayOfWeek.Wednesday => "T4",
        DayOfWeek.Thursday => "T5",
        DayOfWeek.Friday => "T6",
        DayOfWeek.Saturday => "T7",
        _ => "CN"
    };

    (string Cls, string Icon, string Text, string Chip) AttemptState(string? status) => status switch
    {
        "completed" => ("is-good", "check_circle", "Hoàn thành tốt", "pa-chip--good"),
        "needs_practice" => ("is-warn", "replay", "Cần luyện thêm", "pa-chip--warn"),
        _ => ("", "pending", "Chưa làm xong", "")
    };

    var childNames = Model.Children.ToDictionary(x => x.Id, x => x.Nickname);
    var childAvatars = Model.Children.ToDictionary(x => x.Id, x => x.AvatarKey);
    var progressByChild = Model.ProgressItems
        .GroupBy(x => x.ChildProfileId)
        .OrderBy(g => Model.Children.ToList().FindIndex(c => c.Id == g.Key))
        .ToList();
    var showChildNames = progressByChild.Count > 1;

    var needsAttention = Model.ChildSummaries
        .Where(x => x.NeedsPracticeItems > 0)
        .OrderByDescending(x => x.NeedsPracticeItems)
        .ToList();

    var weekCompleted = Model.DailyActivities.Sum(x => x.CompletedItems);
    var weekPractice = Model.DailyActivities.Sum(x => x.NeedsPracticeItems);
    var weekMinutes = Model.DailyActivities.Sum(x => x.LearningMinutes);
    var activeDays = Model.DailyActivities.Count(x => x.CompletedItems + x.NeedsPracticeItems > 0 || x.LearningMinutes > 0);
    var maxDayTotal = Math.Max(1, Model.DailyActivities.Select(x => x.CompletedItems + x.NeedsPracticeItems).DefaultIfEmpty(0).Max());
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/parent.css" asp-append-version="true" />

<section class="pa pa-dashboard">
    <div class="pa-wrap">
        <header class="pa-hero">
            <div class="pa-hero-main">
                <div class="pa-hero-text">
                    <span class="pa-eyebrow">
                        <span class="material-symbols-outlined" aria-hidden="true">family_restroom</span>
                        Góc phụ huynh
                    </span>
                    <h1 class="pa-title">Kết quả học tập của bé</h1>
                    <p class="pa-lead">Theo dõi thời gian học, bài đã làm tốt và những phần bé cần luyện thêm để cùng bé vững vàng vào lớp 1.</p>
                </div>
            </div>
            <div class="pa-hero-actions">
                <a class="pa-btn pa-btn--ghost" asp-action="Profiles">
                    <span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span>
                    <span>Hồ sơ các bé</span>
                </a>
            </div>
        </header>

        <!-- Thành tích tích lũy -->
        <div class="pa-group-head">
            <h2 class="pa-group-title">Thành tích tích lũy</h2>
            <p class="pa-group-hint">Tính trên toàn bộ lịch sử học của các bé. Khi bé học lại bài cũ, các kết quả đã đạt vẫn được giữ nguyên.</p>
        </div>
        <div class="pa-stats">
            <div class="pa-stat pa-stat--sky">
                <span class="pa-stat-icon"><span class="material-symbols-outlined" aria-hidden="true">schedule</span></span>
                <div class="pa-stat-value">@Model.TotalLearningMinutes<span class="pa-stat-unit">phút</span></div>
                <div class="pa-stat-label">Tổng thời gian học</div>
                <div class="pa-stat-hint">Tuần này: @weekMinutes phút</div>
            </div>
            <div class="pa-stat pa-stat--good">
                <span class="pa-stat-icon"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span></span>
                <div class="pa-stat-value">@Model.TotalCompletedItems<span class="pa-stat-unit">lượt</span></div>
                <div class="pa-stat-label">Bài làm tốt</div>
                <div class="pa-stat-hint">Đạt chuẩn ngay trong lượt làm</div>
            </div>
            <div class="pa-stat pa-stat--warn">
                <span class="pa-stat-icon"><span class="material-symbols-outlined" aria-hidden="true">replay</span></span>
                <div class="pa-stat-value">@Model.TotalNeedsPracticeItems<span class="pa-stat-unit">lượt</span></div>
                <div class="pa-stat-label">Cần luyện thêm</div>
                <div class="pa-stat-hint">Bé cần thêm lời động viên</div>
            </div>
            <div class="pa-stat pa-stat--sun">
                <span class="pa-stat-icon"><span class="material-symbols-outlined" aria-hidden="true">emoji_events</span></span>
                <div class="pa-stat-value">@Model.TotalRewards</div>
                <div class="pa-stat-label">Huy hiệu & phần thưởng</div>
                <div class="pa-stat-hint">Bé đã nhận được</div>
            </div>
        </div>

        <div class="pa-layout">
            <!-- ===== Cột chính ===== -->
            <div class="pa-col">
                <!-- Hoạt động 7 ngày -->
                <section class="pa-card" aria-labelledby="pa-week-title">
                    <div class="pa-card-head">
                        <h2 class="pa-card-title" id="pa-week-title">
                            <span class="material-symbols-outlined" aria-hidden="true">insights</span>
                            7 ngày gần đây
                        </h2>
                    </div>
                    <div class="pa-chart-summary">
                        <span class="pa-chip pa-chip--violet"><span class="material-symbols-outlined" aria-hidden="true">event_available</span>@activeDays/@Model.DailyActivities.Count ngày có học</span>
                        <span class="pa-chip pa-chip--good">@weekCompleted lượt làm tốt</span>
                        <span class="pa-chip pa-chip--warn">@weekPractice lượt cần luyện</span>
                    </div>

                    <div class="pa-chart-scroll">
                        <ol class="pa-chart">
                            @foreach (var day in Model.DailyActivities)
                            {
                                var total = day.CompletedItems + day.NeedsPracticeItems;
                                var isToday = day.Date.Date == DateTime.Today;
                                var stackHeight = total == 0 ? 0m : (decimal)total / maxDayTotal * 100m;
                                var goodShare = total == 0 ? 0m : (decimal)day.CompletedItems / total * 100m;
                                var warnShare = total == 0 ? 0m : (decimal)day.NeedsPracticeItems / total * 100m;

                                <li class="pa-bar @(isToday ? "is-today" : "")"
                                    aria-label="@(isToday ? "Hôm nay, " : "")@day.DateLabel: @day.CompletedItems lượt làm tốt, @day.NeedsPracticeItems lượt cần luyện, @day.LearningMinutes phút">
                                    <span class="pa-bar-total @(total == 0 ? "is-zero" : "")" aria-hidden="true">@total</span>
                                    <span class="pa-bar-track" aria-hidden="true">
                                        <span class="pa-bar-stack" style="height:@Css(stackHeight)%">
                                            @if (day.CompletedItems > 0)
                                            {
                                                <span class="pa-bar-seg pa-bar-seg--good" style="height:@Css(goodShare)%"></span>
                                            }
                                            @if (day.NeedsPracticeItems > 0)
                                            {
                                                <span class="pa-bar-seg pa-bar-seg--warn" style="height:@Css(warnShare)%"></span>
                                            }
                                        </span>
                                    </span>
                                    <span class="pa-bar-day" aria-hidden="true">
                                        <b>@(isToday ? "Nay" : WeekDay(day.Date))</b>
                                        <small>@day.DateLabel</small>
                                    </span>
                                    <span class="pa-bar-min" aria-hidden="true">@day.LearningMinutes′</span>
                                </li>
                            }
                        </ol>
                    </div>

                    <div class="pa-legend">
                        <span><i class="is-good"></i>Làm tốt</span>
                        <span><i class="is-warn"></i>Cần luyện thêm</span>
                        <span><i class="is-min"></i>Số phút học (′)</span>
                    </div>
                </section>

                <!-- Mức nắm vững theo nhóm kỹ năng -->
                <section class="pa-card" aria-labelledby="pa-skill-title">
                    <div class="pa-card-head">
                        <h2 class="pa-card-title" id="pa-skill-title">
                            <span class="material-symbols-outlined" aria-hidden="true">military_tech</span>
                            Mức nắm vững theo nhóm kỹ năng
                        </h2>
                    </div>
                    <p class="pa-card-sub">Phần trăm càng cao, bé càng thành thạo nhóm kỹ năng đó.</p>

                    @if (!Model.ProgressItems.Any())
                    {
                        <div class="pa-empty">
                            <span class="material-symbols-outlined" aria-hidden="true">school</span>
                            <p>Chưa có dữ liệu. Khi bé hoàn thành bài học đầu tiên, tiến độ từng nhóm kỹ năng sẽ hiện ở đây.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var group in progressByChild)
                        {
                            <div class="pa-skill-group">
                                @if (showChildNames)
                                {
                                    <div class="pa-skill-group-name">
                                        <img src="@ResolveAvatar(childAvatars.GetValueOrDefault(group.Key))" alt="" />
                                        <span>@(childNames.GetValueOrDefault(group.Key) ?? "Bé")</span>
                                    </div>
                                }
                                <ul class="pa-skill-list">
                                    @foreach (var progress in group.OrderBy(x => x.SkillGroup?.SortOrder).ThenBy(x => x.SkillGroup?.Name))
                                    {
                                        var color = string.IsNullOrWhiteSpace(progress.SkillGroup?.Color) ? "#7c5cff" : progress.SkillGroup!.Color;
                                        var icon = string.IsNullOrWhiteSpace(progress.SkillGroup?.IconKey) ? "school" : progress.SkillGroup!.IconKey;
                                        <li class="pa-skill" style="--skill:@color">
                                            <div class="pa-skill-top">
                                                <span class="pa-skill-name">
                                                    <span class="material-symbols-outlined pa-skill-icon" aria-hidden="true">@icon</span>
                                                    <span>@(progress.SkillGroup?.Name ?? "Kỹ năng học tập")</span>
                                                </span>
                                                <span class="pa-skill-pct">@Pct(progress.MasteryLevel)%</span>
                                            </div>
                                            <div class="pa-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Pct(progress.MasteryLevel)" aria-label="@(progress.SkillGroup?.Name ?? "Kỹ năng"): nắm vững @Pct(progress.MasteryLevel)%">
                                                <span style="width:@Css(progress.MasteryLevel)%"></span>
                                            </div>
                                            <div class="pa-skill-meta">
                                                <span><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>@progress.CompletedItems bài làm tốt</span>
                                                @if (progress.NeedsPracticeItems > 0)
                                                {
                                                    <span class="pa-chip pa-chip--warn">@progress.NeedsPracticeItems bài cần luyện</span>
                                                }
                                                @if (progress.LastPracticedAt.HasValue)
                                                {
                                                    <span><span class="material-symbols-outlined" aria-hidden="true">history</span>Gần nhất @progress.LastPracticedAt.Value.LocalDateTime.ToString("dd/MM")</span>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                </section>

                <!-- Nhật ký gần đây -->
                <section class="pa-card" aria-labelledby="pa-recent-title">
                    <div class="pa-card-head">
                        <h2 class="pa-card-title" id="pa-recent-title">
                            <span class="material-symbols-outlined" aria-hidden="true">history</span>
                            Hoạt động gần đây
                        </h2>
                    </div>

                    @if (!Model.RecentAttempts.Any())
                    {
                        <div class="pa-empty">
                            <span class="material-symbols-outlined" aria-hidden="true">hourglass_empty</span>
                            <p>Chưa có lượt học nào gần đây.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="pa-activity">
                            @foreach (var attempt in Model.RecentAttempts)
                            {
                                var state = AttemptState(attempt.Status);
                                <li class="pa-activity-item @state.Cls">
                                    <span class="pa-activity-icon"><span class="material-symbols-outlined" aria-hidden="true">@state.Icon</span></span>
                                    <div class="pa-activity-body">
                                        <div class="pa-activity-top">
                                            <span class="pa-activity-title">@(attempt.LearningItem?.Title ?? "Bài học")</span>
                                            <span class="pa-chip @state.Chip">@state.Text</span>
                                        </div>
                                        <div class="pa-activity-meta">
                                            <span><span class="material-symbols-outlined" aria-hidden="true">face</span>@(attempt.ChildProfile?.Nickname ?? "Bé")</span>
                                            <span><span class="material-symbols-outlined" aria-hidden="true">schedule</span>@attempt.StartedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                                            @if (attempt.StarsEarned > 0)
                                            {
                                                <span class="is-stars"><span class="material-symbols-outlined" aria-hidden="true">star</span>+@attempt.StarsEarned sao</span>
                                            }
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <!-- ===== Cột phụ ===== -->
            <aside class="pa-col">
                @if (isAdmin)
                {
                    <div class="pa-card pa-admin d-lg-none">
                        <span class="pa-stat-icon"><span class="material-symbols-outlined" aria-hidden="true">shield_person</span></span>
                        <div class="pa-admin-body">
                            <h3>Tài khoản quản trị viên</h3>
                            <p>Quản lý kho bài học, âm thanh, hình ảnh và dữ liệu hệ thống.</p>
                            <a class="pa-btn pa-btn--primary" asp-controller="Admin" asp-action="Index">
                                <span class="material-symbols-outlined" aria-hidden="true">admin_panel_settings</span>
                                <span>Vào trang quản trị</span>
                            </a>
                        </div>
                    </div>
                }

                <!-- Các bé -->
                <section class="pa-card" aria-labelledby="pa-children-title">
                    <div class="pa-card-head">
                        <h2 class="pa-card-title" id="pa-children-title">
                            <span class="material-symbols-outlined" aria-hidden="true">face</span>
                            Các bé
                        </h2>
                        <a class="pa-link" asp-action="Profiles">
                            <span class="material-symbols-outlined" aria-hidden="true">settings</span>
                            Quản lý
                        </a>
                    </div>

                    @if (!Model.ChildSummaries.Any())
                    {
                        <div class="pa-empty">
                            <img src="~/images/mascot-squirrel-3d.png" alt="Sóc Nâu" />
                            <p class="pa-empty-title">Chưa có hồ sơ bé nào</p>
                            <p>Ba mẹ hãy tạo hồ sơ để bắt đầu đồng hành cùng bé.</p>
                            <a class="pa-btn pa-btn--primary" asp-action="Profiles">
                                <span class="material-symbols-outlined" aria-hidden="true">add_circle</span>
                                <span>Tạo hồ sơ cho bé</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="pa-children">
                            @foreach (var summary in Model.ChildSummaries)
                            {
                                <article class="pa-child">
                                    <div class="pa-child-top">
                                        <img src="@ResolveAvatar(summary.Child.AvatarKey)" alt="" class="pa-avatar" />
                                        <div>
                                            <h3 class="pa-child-name">@summary.Child.Nickname</h3>
                                            <div class="pa-child-sub">
                                                <span><span class="material-symbols-outlined" aria-hidden="true">alarm</span>Mục tiêu @summary.Child.DailyLearningMinutes phút/ngày</span>
                                                <span>
                                                    <span class="material-symbols-outlined" aria-hidden="true">history</span>
                                                    @(summary.LastLearnedAt.HasValue
                                                        ? $"Học gần nhất {summary.LastLearnedAt.Value.LocalDateTime:dd/MM HH:mm}"
                                                        : "Chưa có buổi học nào")
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="pa-mini-stats">
                                        <div class="pa-mini is-good"><b>@summary.CompletedItems</b><small>làm tốt</small></div>
                                        <div class="pa-mini is-warn"><b>@summary.NeedsPracticeItems</b><small>cần luyện</small></div>
                                        <div class="pa-mini is-sun"><b>@summary.StarsEarned</b><small>sao</small></div>
                                        <div class="pa-mini is-sky"><b>@summary.LearningMinutes</b><small>phút</small></div>
                                    </div>

                                    <div>
                                        <div class="pa-meter-label">
                                            <span>Mức nắm vững trung bình</span>
                                            <strong>@Pct(summary.AverageMastery)%</strong>
                                        </div>
                                        <div class="pa-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Pct(summary.AverageMastery)" aria-label="Mức nắm vững trung bình của @summary.Child.Nickname">
                                            <span style="width:@Css(summary.AverageMastery)%"></span>
                                        </div>
                                    </div>

                                    <div class="pa-actions-2">
                                        <a class="pa-btn pa-btn--primary" asp-controller="Kids" asp-action="Home" asp-route-childProfileId="@summary.Child.Id">
                                            <span class="material-symbols-outlined" aria-hidden="true">play_circle</span>
                                            <span>Vào học</span>
                                        </a>
                                        <a class="pa-btn pa-btn--ghost" asp-action="Report" asp-route-childId="@summary.Child.Id">
                                            <span class="material-symbols-outlined" aria-hidden="true">bar_chart</span>
                                            <span>Báo cáo</span>
                                        </a>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>

                <!-- Bé cần luyện thêm -->
                @if (Model.ChildSummaries.Any())
                {
                    <section class="pa-card" aria-labelledby="pa-attn-title">
                        <div class="pa-card-head">
                            <h2 class="pa-card-title" id="pa-attn-title">
                                <span class="material-symbols-outlined" aria-hidden="true">tips_and_updates</span>
                                Cần ba mẹ đồng hành
                            </h2>
                        </div>
                        @if (!needsAttention.Any())
                        {
                            <div class="pa-attn-ok">
                                <span class="material-symbols-outlined" aria-hidden="true">sentiment_satisfied</span>
                                <span>Chưa có bài nào cần luyện thêm. Các bé đang làm rất tốt!</span>
                            </div>
                        }
                        else
                        {
                            <ul class="pa-attn">
                                @foreach (var summary in needsAttention)
                                {
                                    var weakest = Model.ProgressItems
                                        .Where(x => x.ChildProfileId == summary.Child.Id && x.NeedsPracticeItems > 0)
                                        .OrderByDescending(x => x.NeedsPracticeItems)
                                        .ThenBy(x => x.MasteryLevel)
                                        .FirstOrDefault();
                                    <li>
                                        <a class="pa-attn-item" asp-action="Report" asp-route-childId="@summary.Child.Id">
                                            <img src="@ResolveAvatar(summary.Child.AvatarKey)" alt="" class="pa-avatar" />
                                            <span class="pa-attn-text">
                                                <b>@summary.Child.Nickname</b>
                                                <small>@(weakest?.SkillGroup is not null
                                                    ? $"{summary.NeedsPracticeItems} lượt cần luyện · nhiều nhất ở {weakest.SkillGroup.Name}"
                                                    : $"{summary.NeedsPracticeItems} lượt cần luyện")</small>
                                            </span>
                                            <span class="material-symbols-outlined pa-attn-go" aria-hidden="true">chevron_right</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                <div class="pa-note pa-note--sky">
                    <span class="material-symbols-outlined" aria-hidden="true">lightbulb</span>
                    <div>
                        <strong>Lời khuyên đồng hành</strong>
                        <p>Trẻ 5 tuổi học hiệu quả nhất khoảng <b>10–15 phút mỗi ngày</b>. Ba mẹ hãy ngồi cùng, khen ngợi khi bé cố gắng và cho bé nghỉ sau mỗi phiên học nhé!</p>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>
