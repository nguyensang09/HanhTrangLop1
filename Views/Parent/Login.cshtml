@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập phụ huynh";
}

<section class="auth-panel">
    <div class="soft-card form-card">
        <h1>Góc phụ huynh</h1>
        <p class="text-muted" style="font-size:0.95rem; margin-bottom:1.25rem;">
            Đăng nhập để theo dõi và cùng bé học tập mỗi ngày.
        </p>

        <form asp-action="Login" method="post" id="loginForm">
            <input type="hidden" name="deviceType" id="deviceTypeInput" value="pc" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label asp-for="Username">Tên tài khoản</label>
            <input asp-for="Username" class="form-control" placeholder="Nhập tên tài khoản hoặc email..." autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger"></span>

            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>

            <label class="check-row">
                <input asp-for="RememberMe" />
                Ghi nhớ đăng nhập
            </label>

            <button class="app-btn app-btn-wide" type="submit">Đăng nhập</button>
            <div class="mt-3 text-center">
                <span>Chưa có tài khoản? </span>
                <a asp-action="Register" style="font-weight:600;">Tạo tài khoản mới</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            function detectDeviceType() {
                var width = window.innerWidth || screen.width;
                var hasTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
                var ua = (navigator.userAgent || '').toLowerCase();
                var isMobileUA = /mobile|iphone|ipod|android.*mobile/.test(ua);
                var isTabletUA = /ipad|tablet|(android(?!.*mobile))/.test(ua);

                if (isMobileUA || width < 768) {
                    return 'mobile';
                }
                if (isTabletUA || (width >= 768 && width <= 1440) || (hasTouch && width <= 1600)) {
                    return 'tablet';
                }
                return 'pc';
            }
            var el = document.getElementById('deviceTypeInput');
            if (el) {
                el.value = detectDeviceType();
            }
        })();
    </script>
}
