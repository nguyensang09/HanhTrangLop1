@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập phụ huynh";
}

<section class="auth-panel">
    <div class="soft-card form-card">
        <h1>Góc phụ huynh</h1>
        <p>Tài khoản mẫu: <strong>phuhuynh@hanhtranglop1.local</strong> / <strong>Phuhuynh@123456</strong></p>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>

            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>

            <label class="check-row">
                <input asp-for="RememberMe" />
                Ghi nhớ đăng nhập
            </label>

            <button class="app-btn app-btn-wide" type="submit">Đăng nhập</button>
            <a asp-action="Register">Tạo tài khoản mới</a>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
