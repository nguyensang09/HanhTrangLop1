@model ChildProfileFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Sửa hồ sơ bé" : "Thêm hồ sơ bé";
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/parent.css" asp-append-version="true" />

<section class="pa pa-profile-form-page">
    <div class="pa-wrap pa-wrap--narrow">
        <header class="pa-hero">
            <div class="pa-hero-main">
                <div class="pa-hero-text">
                    <span class="pa-eyebrow">
                        <span class="material-symbols-outlined" aria-hidden="true">@(isEdit ? "edit" : "person_add")</span>
                        Hồ sơ của bé
                    </span>
                    <h1 class="pa-title">@ViewData["Title"]</h1>
                    <p class="pa-lead">Thông tin này giúp Sóc Nâu gọi đúng tên bé và gợi ý thời lượng học phù hợp.</p>
                </div>
            </div>
        </header>

        <div class="pa-card">
            <form method="post" enctype="multipart/form-data" class="pa-form">
                <div asp-validation-summary="ModelOnly" class="pa-summary"></div>

                <fieldset class="pa-fieldset">
                    <legend class="pa-legend-title">Thông tin cơ bản</legend>

                    <div class="pa-field">
                        <label asp-for="Nickname" class="pa-label">Tên bé</label>
                        <input asp-for="Nickname" class="pa-input" placeholder="Ví dụ: Bé Bắp, Minh Khang..." autocomplete="off" />
                        <span asp-validation-for="Nickname" class="pa-error"></span>
                    </div>

                    <div class="pa-field">
                        <label asp-for="BirthYear" class="pa-label">Năm sinh</label>
                        <input asp-for="BirthYear" class="pa-input" placeholder="Ví dụ: 2019, 2020..." inputmode="numeric" />
                        <span asp-validation-for="BirthYear" class="pa-error"></span>
                    </div>
                </fieldset>

                <fieldset class="pa-fieldset">
                    <legend class="pa-legend-title">Ảnh đại diện của bé</legend>
                    <p class="pa-help">Chọn một nhân vật hoặc tải ảnh thật của bé.</p>

                    <div class="pa-avatar-grid">
                        <label class="pa-avatar-option">
                            <input type="radio" asp-for="AvatarKey" value="avatar-squirrel" checked="@(Model.AvatarKey == "avatar-squirrel" || Model.AvatarKey == "soc-nau")" />
                            <span class="pa-avatar-card">
                                <img src="~/images/avatars/avatar-squirrel.png" alt="" />
                                <span>Sóc Nâu</span>
                            </span>
                        </label>
                        <label class="pa-avatar-option">
                            <input type="radio" asp-for="AvatarKey" value="avatar-cat" checked="@(Model.AvatarKey == "avatar-cat")" />
                            <span class="pa-avatar-card">
                                <img src="~/images/avatars/avatar-cat.png" alt="" />
                                <span>Mèo Con</span>
                            </span>
                        </label>
                        <label class="pa-avatar-option">
                            <input type="radio" asp-for="AvatarKey" value="avatar-dog" checked="@(Model.AvatarKey == "avatar-dog")" />
                            <span class="pa-avatar-card">
                                <img src="~/images/avatars/avatar-dog.png" alt="" />
                                <span>Cún Con</span>
                            </span>
                        </label>
                        <label class="pa-avatar-option">
                            <input type="radio" asp-for="AvatarKey" value="avatar-bunny" checked="@(Model.AvatarKey == "avatar-bunny" || Model.AvatarKey == "tho-trang")" />
                            <span class="pa-avatar-card">
                                <img src="~/images/avatars/avatar-bunny.png" alt="" />
                                <span>Thỏ Trắng</span>
                            </span>
                        </label>
                        <label class="pa-avatar-option">
                            <input type="radio" asp-for="AvatarKey" value="avatar-bear" checked="@(Model.AvatarKey == "avatar-bear" || Model.AvatarKey == "gau-vang")" />
                            <span class="pa-avatar-card">
                                <img src="~/images/avatars/avatar-bear.png" alt="" />
                                <span>Gấu Con</span>
                            </span>
                        </label>
                    </div>
                    <span asp-validation-for="AvatarKey" class="pa-error"></span>

                    <div class="pa-upload">
                        <input asp-for="AvatarFile" type="file" accept="image/*" class="pa-sr-only" id="avatarFileInput" onchange="previewAvatar(this)" />
                        <label for="avatarFileInput" class="pa-btn pa-btn--ghost pa-upload-btn">
                            <span class="material-symbols-outlined" aria-hidden="true">add_a_photo</span>
                            <span>Hoặc tải ảnh thật của bé</span>
                        </label>
                        <div id="avatarPreviewContainer" class="pa-preview" style="display:none;">
                            <img id="avatarPreviewImg" src="" alt="Ảnh bé vừa chọn" />
                            <small>Đã chọn ảnh của bé</small>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="pa-fieldset">
                    <legend class="pa-legend-title">Cài đặt học tập</legend>

                    <div class="pa-field">
                        <label asp-for="DailyLearningMinutes" class="pa-label">Thời lượng học mỗi ngày</label>
                        <select asp-for="DailyLearningMinutes" class="pa-input">
                            <option value="10">10 phút (Khởi động)</option>
                            <option value="15">15 phút (Đề xuất)</option>
                            <option value="20">20 phút (Chăm chỉ)</option>
                        </select>
                        <span asp-validation-for="DailyLearningMinutes" class="pa-error"></span>
                    </div>

                    <label class="pa-switch">
                        <input asp-for="SoundEnabled" />
                        <span class="pa-switch-text">
                            <b>Bật âm thanh và giọng đọc hướng dẫn</b>
                            <small>Sóc Nâu đọc câu hỏi và hướng dẫn cho bé nghe.</small>
                        </span>
                    </label>

                    <label class="pa-switch">
                        <input asp-for="EnglishVoice" />
                        <span class="pa-switch-text">
                            <b>Giọng đọc tiếng Anh (song ngữ Việt – Anh)</b>
                            <small>Chữ trên màn hình vẫn là tiếng Việt, riêng giọng đọc câu hỏi và hướng dẫn phát bằng tiếng Anh để bé làm quen song ngữ.</small>
                        </span>
                    </label>
                </fieldset>

                <div class="pa-form-actions">
                    <a class="pa-btn pa-btn--ghost pa-btn--lg" asp-action="Profiles">
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                        <span>Quay lại danh sách</span>
                    </a>
                    <button class="pa-btn pa-btn--primary pa-btn--lg" type="submit">
                        <span class="material-symbols-outlined" aria-hidden="true">check</span>
                        <span>Lưu hồ sơ</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewAvatar(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatarPreviewImg').src = e.target.result;
                    document.getElementById('avatarPreviewContainer').style.display = 'flex';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
