@model ChildProfileListViewModel
@{
    ViewData["Title"] = "Quản lý hồ sơ các bé";

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/parent.css" asp-append-version="true" />

<section class="pa pa-profiles-page">
    <div class="pa-wrap">
        <header class="pa-hero">
            <div class="pa-hero-main">
                <div class="pa-hero-text">
                    <span class="pa-eyebrow">
                        <span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span>
                        Góc phụ huynh
                    </span>
                    <h1 class="pa-title">Hồ sơ các bé</h1>
                    <p class="pa-lead">Đặt tên, chọn nhân vật đại diện và thời lượng học mỗi ngày phù hợp cho từng bé.</p>
                </div>
            </div>
            <div class="pa-hero-actions">
                <a class="pa-btn pa-btn--primary" asp-action="CreateProfile">
                    <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
                    <span>Thêm hồ sơ bé</span>
                </a>
                <a class="pa-btn pa-btn--ghost" asp-action="Dashboard">
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                    <span>Tổng quan</span>
                </a>
            </div>
        </header>

        @if (!Model.Children.Any())
        {
            <div class="pa-card pa-empty pa-empty--lg">
                <img src="~/images/soc-nau-mascot.png" alt="Sóc Nâu" />
                <h2 class="pa-empty-title">Chưa có hồ sơ bé nào</h2>
                <p>Ba mẹ hãy tạo hồ sơ cho bé để bắt đầu theo dõi tiến độ và nhận gợi ý bài học.</p>
                <a class="pa-btn pa-btn--primary pa-btn--lg" asp-action="CreateProfile">
                    <span class="material-symbols-outlined" aria-hidden="true">add_circle</span>
                    <span>Tạo hồ sơ cho bé ngay</span>
                </a>
            </div>
        }
        else
        {
            <div class="pa-profiles">
                @foreach (var child in Model.Children)
                {
                    <article class="pa-card pa-profile">
                        <div class="pa-profile-top">
                            <img src="@ResolveAvatar(child.AvatarKey)" alt="" class="pa-avatar" />
                            <div>
                                <h2 class="pa-profile-name">@child.Nickname</h2>
                                @if (child.BirthYear.HasValue)
                                {
                                    <div class="pa-tags">
                                        <span class="pa-chip pa-chip--violet">
                                            <span class="material-symbols-outlined" aria-hidden="true">cake</span>
                                            Sinh năm @child.BirthYear (@(DateTime.Now.Year - child.BirthYear.Value) tuổi)
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>

                        <ul class="pa-profile-settings">
                            <li>
                                <span><span class="material-symbols-outlined" aria-hidden="true">alarm</span>Mục tiêu mỗi ngày</span>
                                <b>@child.DailyLearningMinutes phút</b>
                            </li>
                            <li>
                                <span><span class="material-symbols-outlined" aria-hidden="true">@(child.SoundEnabled ? "volume_up" : "volume_off")</span>Âm thanh</span>
                                <b>@(child.SoundEnabled ? "Bật" : "Tắt")</b>
                            </li>
                            <li>
                                <span><span class="material-symbols-outlined" aria-hidden="true">translate</span>Giọng đọc</span>
                                <b>@(child.EnglishVoice ? "Tiếng Anh" : "Tiếng Việt")</b>
                            </li>
                        </ul>

                        <div class="pa-profile-actions">
                            <a class="pa-btn pa-btn--primary" asp-controller="Kids" asp-action="Home" asp-route-childProfileId="@child.Id" title="Cho bé vào học với hồ sơ này">
                                <span class="material-symbols-outlined" aria-hidden="true">play_circle</span>
                                <span>Bé vào học</span>
                            </a>
                            <a class="pa-btn pa-btn--ghost" asp-action="Report" asp-route-childId="@child.Id" title="Xem báo cáo chi tiết">
                                <span class="material-symbols-outlined" aria-hidden="true">bar_chart</span>
                                <span>Báo cáo</span>
                            </a>
                            <a class="pa-btn pa-btn--ghost" asp-action="EditProfile" asp-route-id="@child.Id" title="Chỉnh sửa thông tin bé">
                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                <span>Sửa</span>
                            </a>
                            <form asp-action="DeleteProfile" asp-route-id="@child.Id" method="post"
                                  data-confirm-delete
                                  data-confirm-message="@($"Bạn có chắc chắn muốn xóa hồ sơ của bé {child.Nickname} không?")">
                                <button class="pa-btn pa-btn--danger" type="submit" title="Xóa hồ sơ bé">
                                    <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                    <span>Xóa</span>
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
