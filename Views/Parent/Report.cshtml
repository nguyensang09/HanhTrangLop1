@model ParentReportViewModel
@using System.Globalization
@{
    ViewData["Title"] = $"Báo cáo chi tiết của {Model.Child.Nickname}";

    string ResolveAvatar(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
        if (key.StartsWith("/")) return key;
        return key switch
        {
            "avatar-cat" => "/images/avatars/avatar-cat.png",
            "avatar-dog" => "/images/avatars/avatar-dog.png",
            "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
            "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
            "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
            _ => "/images/mascot-squirrel-3d.png"
        };
    }

    // Luôn xuất số theo dấu chấm thập phân để CSS (width/height) không bị hỏng khi máy chủ dùng văn hóa vi-VN.
    string Css(decimal value) => Math.Round(Math.Min(100m, Math.Max(0m, value)), 1).ToString(CultureInfo.InvariantCulture);
    string Pct(decimal value) => Math.Round(Math.Min(100m, Math.Max(0m, value))).ToString("0", CultureInfo.InvariantCulture);

    string WeekDay(DateTime date) => date.DayOfWeek switch
    {
        DayOfWeek.Monday => "T2",
        DayOfWeek.Tuesday => "T3",
        DayOfWeek.Wednesday => "T4",
        DayOfWeek.Thursday => "T5",
        DayOfWeek.Friday => "T6",
        DayOfWeek.Saturday => "T7",
        _ => "CN"
    };

    (string Cls, string Icon, string Text, string Chip) AttemptState(string? status) => status switch
    {
        "completed" => ("is-good", "check_circle", "Hoàn thành tốt", "pa-chip--good"),
        "needs_practice" => ("is-warn", "replay", "Cần luyện thêm", "pa-chip--warn"),
        _ => ("", "pending", "Chưa làm xong", "")
    };

    var age = Model.Child.BirthYear.HasValue ? DateTime.Now.Year - Model.Child.BirthYear.Value : (int?)null;
    var practiceSkills = Model.SkillReports.Where(x => x.NeedsPracticeItems > 0).OrderByDescending(x => x.NeedsPracticeItems).ToList();
    var periodMinutes = Model.DailyActivities.Sum(x => x.LearningMinutes);
    var activeDays = Model.DailyActivities.Count(x => x.CompletedItems + x.NeedsPracticeItems > 0 || x.LearningMinutes > 0);
    var goalDays = Model.DailyActivities.Count(x => x.LearningMinutes >= Model.Child.DailyLearningMinutes && Model.Child.DailyLearningMinutes > 0);
    var maxDayTotal = Math.Max(1, Model.DailyActivities.Select(x => x.CompletedItems + x.NeedsPracticeItems).DefaultIfEmpty(0).Max());
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/parent.css" asp-append-version="true" />

<section class="pa pa-report">
    <div class="pa-wrap">
        <header class="pa-hero">
            <div class="pa-hero-main">
                <img src="@ResolveAvatar(Model.Child.AvatarKey)" alt="" class="pa-hero-avatar" />
                <div class="pa-hero-text">
                    <span class="pa-eyebrow">
                        <span class="material-symbols-outlined" aria-hidden="true">analytics</span>
                        Báo cáo học tập
                    </span>
                    <h1 class="pa-title">@Model.Child.Nickname</h1>
                    <div class="pa-tags">
                        @if (age.HasValue)
                        {
                            <span class="pa-chip pa-chip--violet"><span class="material-symbols-outlined" aria-hidden="true">cake</span>@age tuổi</span>
                        }
                        <span class="pa-chip pa-chip--violet"><span class="material-symbols-outlined" aria-hidden="true">alarm</span>Mục tiêu @Model.Child.DailyLearningMinutes phút/ngày</span>
                    </div>
                </div>
            </div>
            <div class="pa-hero-actions">
                <a class="pa-btn pa-btn--primary" asp-controller="Kids" asp-action="Home" asp-route-childProfileId="@Model.Child.Id">
                    <span class="material-symbols-outlined" aria-hidden="true">play_circle</span>
                    <span>Bé vào học</span>
                </a>
                <a class="pa-btn pa-btn--ghost" asp-action="ExportReport" asp-route-childId="@Model.Child.Id" title="Tải báo cáo định dạng CSV">
                    <span class="material-symbols-outlined" aria-hidden="true">download</span>
                    <span>Xuất CSV</span>
                </a>
                <a class="pa-btn pa-btn--ghost" asp-action="Dashboard">
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                    <span>Tổng quan</span>
                </a>
            </div>
        </header>

        <!-- Lời khuyên -->
        <div class="pa-advice">
            <span class="pa-advice-icon"><span class="material-symbols-outlined" aria-hidden="true">psychology</span></span>
            <div>
                <h2>Gợi ý cho ba mẹ</h2>
                <p>@Model.RecommendationText</p>
            </div>
        </div>

        <!-- Thành tích tích lũy -->
        <div class="pa-group-head">
            <h2 class="pa-group-title">Thành tích tích lũy</h2>
            <p class="pa-group-hint">Tổng hợp mọi lượt học của bé từ trước đến nay.</p>
        </div>
        <div class="pa-stats">
            <div class="pa-stat pa-stat--good">
                <span class="pa-stat-icon"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span></span>
                <div class="pa-stat-value">@Model.TotalCompletedItems<span class="pa-stat-unit">lượt</span></div>
                <div class="pa-stat-label">Bài làm tốt</div>
                <div class="pa-stat-hint">Đạt chuẩn ngay trong lượt làm</div>
            </div>
            <div class="pa-stat pa-stat--warn">
                <span class="pa-stat-icon"><span class="material-symbols-outlined" aria-hidden="true">replay</span></span>
                <div class="pa-stat-value">@Model.TotalNeedsPracticeItems<span class="pa-stat-unit">lượt</span></div>
                <div class="pa-stat-label">Cần luyện thêm</div>
                <div class="pa-stat-hint">@(practiceSkills.Any() ? $"Ở {practiceSkills.Count} nhóm kỹ năng" : "Chưa có nhóm nào cần luyện")</div>
            </div>
            <div class="pa-stat pa-stat--sun">
                <span class="pa-stat-icon"><span class="material-symbols-outlined" aria-hidden="true">star</span></span>
                <div class="pa-stat-value">@Model.TotalStars<span class="pa-stat-unit">sao</span></div>
                <div class="pa-stat-label">Sao tích lũy</div>
                <div class="pa-stat-hint">Phần thưởng khen ngợi bé</div>
            </div>
            <div class="pa-stat pa-stat--sky">
                <span class="pa-stat-icon"><span class="material-symbols-outlined" aria-hidden="true">schedule</span></span>
                <div class="pa-stat-value">@Model.TotalLearningMinutes<span class="pa-stat-unit">phút</span></div>
                <div class="pa-stat-label">Tổng thời gian học</div>
                <div class="pa-stat-hint">@Model.DailyActivities.Count ngày qua: @periodMinutes phút</div>
            </div>
        </div>

        <div class="pa-note">
            <span class="material-symbols-outlined" aria-hidden="true">info</span>
            <div>
                <strong>Lộ trình hiện tại và lịch sử học</strong>
                <p>Khi bé chọn học lại một bài cũ, lộ trình của bé sẽ tiếp tục từ bài đó và các bài phía sau tạm khóa lại cho đến khi bé đi tiếp. Lịch sử bên dưới — lần hoàn thành, số sao và các lượt làm — vẫn được giữ đầy đủ.</p>
            </div>
        </div>

        <div class="pa-col">
            <!-- Kỹ năng -->
            <section class="pa-card" aria-labelledby="pa-skill-title">
                <div class="pa-card-head">
                    <h2 class="pa-card-title" id="pa-skill-title">
                        <span class="material-symbols-outlined" aria-hidden="true">military_tech</span>
                        Mức nắm vững từng nhóm kỹ năng
                    </h2>
                </div>
                <p class="pa-card-sub">Phần trăm càng cao, bé càng thành thạo nhóm kỹ năng đó.</p>

                @if (!Model.SkillReports.Any())
                {
                    <div class="pa-empty">
                        <span class="material-symbols-outlined" aria-hidden="true">school</span>
                        <p>Chưa có dữ liệu bài học cho bé này.</p>
                    </div>
                }
                else
                {
                    <ul class="pa-skill-list">
                        @foreach (var skill in Model.SkillReports)
                        {
                            var color = string.IsNullOrWhiteSpace(skill.Color) ? "#7c5cff" : skill.Color;
                            var icon = string.IsNullOrWhiteSpace(skill.IconKey) ? "school" : skill.IconKey;
                            <li class="pa-skill" style="--skill:@color">
                                <div class="pa-skill-top">
                                    <span class="pa-skill-name">
                                        <span class="material-symbols-outlined pa-skill-icon" aria-hidden="true">@icon</span>
                                        <span>@skill.SkillName</span>
                                    </span>
                                    <span class="pa-skill-pct">@Pct(skill.MasteryLevel)%</span>
                                </div>
                                <div class="pa-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Pct(skill.MasteryLevel)" aria-label="@skill.SkillName: nắm vững @Pct(skill.MasteryLevel)%">
                                    <span style="width:@Css(skill.MasteryLevel)%"></span>
                                </div>
                                <div class="pa-skill-meta">
                                    <span><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>@skill.CompletedItems bài làm tốt</span>
                                    @if (skill.NeedsPracticeItems > 0)
                                    {
                                        <span class="pa-chip pa-chip--warn">@skill.NeedsPracticeItems bài cần luyện</span>
                                    }
                                    else if (skill.CompletedItems > 0)
                                    {
                                        <span class="pa-chip pa-chip--good">Đang làm tốt</span>
                                    }
                                    @if (skill.LastPracticedAt.HasValue)
                                    {
                                        <span><span class="material-symbols-outlined" aria-hidden="true">history</span>Gần nhất @skill.LastPracticedAt.Value.LocalDateTime.ToString("dd/MM")</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <!-- Biểu đồ theo ngày -->
            <section class="pa-card" aria-labelledby="pa-days-title">
                <div class="pa-card-head">
                    <h2 class="pa-card-title" id="pa-days-title">
                        <span class="material-symbols-outlined" aria-hidden="true">insights</span>
                        @Model.DailyActivities.Count ngày gần đây
                    </h2>
                </div>
                <div class="pa-chart-summary">
                    <span class="pa-chip pa-chip--violet"><span class="material-symbols-outlined" aria-hidden="true">event_available</span>@activeDays/@Model.DailyActivities.Count ngày có học</span>
                    <span class="pa-chip pa-chip--good"><span class="material-symbols-outlined" aria-hidden="true">flag</span>@goalDays ngày đạt mục tiêu phút học</span>
                </div>

                <div class="pa-chart-scroll" tabindex="0" aria-label="Biểu đồ hoạt động theo ngày, có thể vuốt ngang">
                    <ol class="pa-chart pa-chart--14">
                        @foreach (var day in Model.DailyActivities)
                        {
                            var total = day.CompletedItems + day.NeedsPracticeItems;
                            var isToday = day.Date.Date == DateTime.Today;
                            var stackHeight = total == 0 ? 0m : (decimal)total / maxDayTotal * 100m;
                            var goodShare = total == 0 ? 0m : (decimal)day.CompletedItems / total * 100m;
                            var warnShare = total == 0 ? 0m : (decimal)day.NeedsPracticeItems / total * 100m;

                            <li class="pa-bar @(isToday ? "is-today" : "")"
                                aria-label="@(isToday ? "Hôm nay, " : "")@day.DateLabel: @day.CompletedItems lượt làm tốt, @day.NeedsPracticeItems lượt cần luyện, @day.LearningMinutes phút">
                                <span class="pa-bar-total @(total == 0 ? "is-zero" : "")" aria-hidden="true">@total</span>
                                <span class="pa-bar-track" aria-hidden="true">
                                    <span class="pa-bar-stack" style="height:@Css(stackHeight)%">
                                        @if (day.CompletedItems > 0)
                                        {
                                            <span class="pa-bar-seg pa-bar-seg--good" style="height:@Css(goodShare)%"></span>
                                        }
                                        @if (day.NeedsPracticeItems > 0)
                                        {
                                            <span class="pa-bar-seg pa-bar-seg--warn" style="height:@Css(warnShare)%"></span>
                                        }
                                    </span>
                                </span>
                                <span class="pa-bar-day" aria-hidden="true">
                                    <b>@(isToday ? "Nay" : WeekDay(day.Date))</b>
                                    <small>@day.DateLabel</small>
                                </span>
                                <span class="pa-bar-min" aria-hidden="true">@day.LearningMinutes′</span>
                            </li>
                        }
                    </ol>
                </div>

                <div class="pa-legend">
                    <span><i class="is-good"></i>Làm tốt</span>
                    <span><i class="is-warn"></i>Cần luyện thêm</span>
                    <span><i class="is-min"></i>Số phút học (′)</span>
                </div>
            </section>
        </div>

        <!-- Lịch sử -->
        <section class="pa-card" aria-labelledby="pa-history-title">
            <div class="pa-card-head">
                <h2 class="pa-card-title" id="pa-history-title">
                    <span class="material-symbols-outlined" aria-hidden="true">history</span>
                    Lịch sử các lượt học gần đây
                </h2>
            </div>

            @if (!Model.RecentAttempts.Any())
            {
                <div class="pa-empty">
                    <span class="material-symbols-outlined" aria-hidden="true">hourglass_empty</span>
                    <p>Chưa có hoạt động nào được ghi nhận cho bé này.</p>
                </div>
            }
            else
            {
                <ul class="pa-activity">
                    @foreach (var attempt in Model.RecentAttempts)
                    {
                        var state = AttemptState(attempt.Status);
                        <li class="pa-activity-item @state.Cls">
                            <span class="pa-activity-icon"><span class="material-symbols-outlined" aria-hidden="true">@state.Icon</span></span>
                            <div class="pa-activity-body">
                                <div class="pa-activity-top">
                                    <span class="pa-activity-title">@(attempt.LearningItem?.Title ?? "Bài học")</span>
                                    <span class="pa-chip @state.Chip">@state.Text</span>
                                </div>
                                <div class="pa-activity-meta">
                                    <span><span class="material-symbols-outlined" aria-hidden="true">schedule</span>@attempt.StartedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                                    @if (attempt.StarsEarned > 0)
                                    {
                                        <span class="is-stars"><span class="material-symbols-outlined" aria-hidden="true">star</span>+@attempt.StarsEarned sao</span>
                                    }
                                    @if (attempt.HintsUsed > 0)
                                    {
                                        <span><span class="material-symbols-outlined" aria-hidden="true">lightbulb</span>@attempt.HintsUsed gợi ý</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</section>
