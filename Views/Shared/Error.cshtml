@model ErrorViewModel
@{
    ViewData["Title"] = "Ôi, có chút trục trặc";
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/kid-hub.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/kid-extras.css" asp-append-version="true" />

<div class="kh kx-error-page">
    <div class="kh-sky" aria-hidden="true">
        <span class="kh-cloud kh-cloud--1"></span>
        <span class="kh-cloud kh-cloud--2"></span>
        <span class="kh-cloud kh-cloud--3"></span>
    </div>

    <section class="kx-error-card" aria-labelledby="kxErrorTitle">
        <div class="kx-error-art" aria-hidden="true">
            <img class="kx-error-mascot" src="~/images/mascot-squirrel-3d.png" alt="" />
            <span class="kx-error-bubble">🌰❓</span>
        </div>
        <h1 id="kxErrorTitle">Ôi, có chút trục trặc rồi!</h1>
        <p class="kx-error-text">Sóc Nâu chưa mở được trang này. Con thử lại sau một chút, hoặc quay về Góc của bé nhé!</p>

        <div class="kx-error-actions">
            <a class="kh-big-btn kh-big-btn--violet" asp-controller="Kids" asp-action="Home">
                <span class="material-symbols-outlined" aria-hidden="true">school</span>
                <span>Về Góc của bé</span>
            </a>
            <a class="kh-big-btn kh-big-btn--white" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined" aria-hidden="true">home</span>
                <span>Về trang chủ</span>
            </a>
        </div>

        @if (Model?.ShowRequestId == true)
        {
            <details class="kx-error-details">
                <summary>Dành cho ba mẹ / quản trị</summary>
                <p>Mã yêu cầu (gửi cho quản trị khi cần hỗ trợ): <code>@Model.RequestId</code></p>
            </details>
        }
    </section>
</div>
