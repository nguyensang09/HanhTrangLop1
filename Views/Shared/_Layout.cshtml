<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hành Trang Lớp 1</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HanhTrangLop1.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
    @{
        var focusMode = ViewData["FocusMode"] as bool? == true;
    }
    @if (!focusMode)
    {
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">Sóc Nâu Đồng Hành</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Mở điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-controller="Kids" asp-action="Home">Khu học của bé</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Parent" asp-action="Dashboard">Phụ huynh</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>
                        <li class="nav-item"><a class="btn app-btn app-btn-small" asp-controller="Parent" asp-action="Login">Đăng nhập</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    }

    <div class="app-page">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @if (!focusMode)
    {
    <footer class="app-footer">
        <div class="container">
            <span>Hành Trang Lớp 1 - học vui 10 đến 15 phút mỗi ngày.</span>
            <a class="app-footer-credit" href="https://openmoji.org/" target="_blank" rel="noopener">Pictogram OpenMoji, CC BY-SA 4.0</a>
            <a class="app-footer-credit" href="https://commons.wikimedia.org/" target="_blank" rel="noopener">Ảnh chụp từ Wikimedia Commons</a>
        </div>
    </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/tracing-guides.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
