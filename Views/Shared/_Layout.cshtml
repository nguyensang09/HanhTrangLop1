@using HanhTrangLop1.Infrastructure
@using HanhTrangLop1.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Hành Trang Lớp 1 | Sóc Nâu Đồng Hành</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HanhTrangLop1.styles.css" asp-append-version="true" />
</head>
<body class="app-shell @(ViewData["FocusMode"] as bool? == true ? "focus-mode-active" : "")">
    @{
        var focusMode = ViewData["FocusMode"] as bool? == true;
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

        // Lấy thông tin bé đang chọn
        HanhTrangLop1.Models.ChildProfile? activeChild = null;
        var selectedRaw = Context.Session.GetString(SessionKeys.SelectedChildProfileId);
        if (Guid.TryParse(selectedRaw, out var childId))
        {
            activeChild = await Db.ChildProfiles.AsNoTracking().FirstOrDefaultAsync(x => x.Id == childId);
        }
        if (activeChild is null)
        {
            if (User.Identity?.IsAuthenticated == true)
            {
                var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (!string.IsNullOrEmpty(userId))
                {
                    activeChild = await Db.ChildProfiles.AsNoTracking().Where(x => x.ParentUserId == userId).OrderBy(x => x.CreatedAt).FirstOrDefaultAsync();
                }
            }
            else
            {
                activeChild = await Db.ChildProfiles.AsNoTracking().Where(x => x.ParentUserId == null).OrderBy(x => x.CreatedAt).FirstOrDefaultAsync();
            }
        }

        string ResolveAvatar(string? key)
        {
            if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
            if (key.StartsWith("/")) return key;
            return key switch
            {
                "avatar-cat" => "/images/avatars/avatar-cat.png",
                "avatar-dog" => "/images/avatars/avatar-dog.png",
                "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
                "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
                "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
                _ => "/images/mascot-squirrel-3d.png"
            };
        }
    }

    @if (!focusMode)
    {
    <header class="app-site-header">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/soc-nau-mascot.png" alt="Sóc Nâu" class="brand-avatar" />
                    <div class="brand-text-col">
                        <span class="brand-title">Sóc Nâu Đồng Hành</span>
                        <span class="brand-subtitle">Hành Trang Lớp 1</span>
                    </div>
                </a>

                <!-- Mobile Hamburger Button -->
                <button class="navbar-toggler border-0 shadow-none p-2" type="button" data-bs-toggle="collapse" data-bs-target="#appMainNavbar" aria-controls="appMainNavbar"
                        aria-expanded="false" aria-label="Mở bảng điều hướng">
                    <span class="material-symbols-outlined fs-2 text-dark">menu</span>
                </button>

                <!-- Navigation Links & User Controls -->
                <div class="navbar-collapse collapse justify-content-end" id="appMainNavbar">
                    <ul class="navbar-nav align-items-lg-center gap-lg-2 my-2 my-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Kids" ? "active" : "")" asp-controller="Kids" asp-action="Home">
                                <span class="material-symbols-outlined nav-icon">school</span>
                                <span>Góc học của bé</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Parent" ? "active" : "")" asp-controller="Parent" asp-action="Dashboard">
                                <span class="material-symbols-outlined nav-icon">family_restroom</span>
                                <span>Góc phụ huynh</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                                    <span class="material-symbols-outlined nav-icon">admin_panel_settings</span>
                                    <span>Quản trị</span>
                                </a>
                            </li>
                        }

                        <!-- Chip thông tin bé đang chọn -->
                        <li class="nav-item ms-lg-2 py-1 py-lg-0">
                            <a class="active-child-chip" asp-controller="Profiles" asp-action="Index" title="Bấm để đổi hồ sơ bé khác">
                                <img src="@ResolveAvatar(activeChild?.AvatarKey)" alt="Bé" class="active-child-avatar" />
                                <span class="active-child-name">@(activeChild?.Nickname ?? "Bạn nhỏ")</span>
                                <span class="material-symbols-outlined ms-1" style="font-size:1.1rem; color:#f97316;">sync_alt</span>
                            </a>
                        </li>

                        <!-- Auth section -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item py-1 py-lg-0">
                                <div class="user-profile-badge" title="Tài khoản đang đăng nhập">
                                    <span class="user-avatar-icon material-symbols-outlined">person</span>
                                    <span>@(User.Identity.Name)</span>
                                </div>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Parent" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn app-btn app-btn-small app-btn-muted" title="Đăng xuất khỏi hệ thống">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-1"><a class="btn app-btn app-btn-small" asp-controller="Parent" asp-action="Login">Đăng nhập</a></li>
                            <li class="nav-item"><a class="btn app-btn app-btn-small app-btn-muted" asp-controller="Parent" asp-action="Register">Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    }

    <div class="app-page">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @if (!focusMode)
    {
    <footer class="app-footer">
        <div class="container footer-content">
            <div class="footer-brand">
                <img src="~/images/soc-nau-mascot.png" alt="Sóc Nâu" class="footer-avatar" />
                <span>Hành Trang Lớp 1 - Học vui 10-15 phút mỗi ngày cùng Sóc Nâu</span>
            </div>
            <div class="footer-links">
                <a class="app-footer-credit" href="https://openmoji.org/" target="_blank" rel="noopener">Pictogram OpenMoji (CC BY-SA 4.0)</a>
                <a class="app-footer-credit" href="https://commons.wikimedia.org/" target="_blank" rel="noopener">Wikimedia Commons</a>
            </div>
        </div>
    </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/tracing-guides.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
