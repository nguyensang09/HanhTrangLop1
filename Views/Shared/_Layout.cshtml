@using HanhTrangLop1.Infrastructure
@using HanhTrangLop1.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@{
    // Tính toán sớm để dùng trong attribute của <body>
    var _ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var _isKidsZone = string.Equals(_ctrl, "Kids", StringComparison.OrdinalIgnoreCase) ||
                      string.Equals(_ctrl, "KidsMath", StringComparison.OrdinalIgnoreCase) ||
                      string.Equals(_ctrl, "Games", StringComparison.OrdinalIgnoreCase);
    var _isFocusMode = ViewData["FocusMode"] as bool? == true;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>@ViewData["Title"] - Hành Trang Lớp 1 | Sóc Nâu Đồng Hành</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HanhTrangLop1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/entry.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kid-font.css" asp-append-version="true" />
    @if (_isKidsZone || _isFocusMode)
    {
        <link rel="preload" href="~/fonts/andika/andika-700-latin.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="~/fonts/andika/andika-700-vietnamese.woff2" as="font" type="font/woff2" crossorigin />
    }
    <script>
        (function() {
            var ua = navigator.userAgent || '';
            var isTouch = /iPad|iPhone|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1) || /Android|webOS|BlackBerry|IEMobile|Opera Mini/i.test(ua);
            document.documentElement.classList.add(isTouch ? 'is-touch-device' : 'is-pc-device');
        })();
    </script>
</head>
<body class="app-shell @(_isFocusMode ? "focus-mode-active" : "") @(_isKidsZone ? "kids-zone-active" : "")">
    <script>
        if (document.documentElement.classList.contains('is-pc-device')) {
            document.body.classList.add('is-pc-device');
        } else if (document.documentElement.classList.contains('is-touch-device')) {
            document.body.classList.add('is-touch-device');
        }
    </script>
    @{
        var focusMode = _isFocusMode;
        var currentController = _ctrl;
        var isKidsZone = _isKidsZone;
        var isAdminZone = string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase);

        // Thanh điều hướng chung (nơi duy nhất dùng tới thông tin bé đang chọn) chỉ hiện
        // ngoài khu bé học, khu quản trị và chế độ tập trung. Trước đây truy vấn hồ sơ bé
        // chạy ở MỌI request, kể cả các trang không hề hiển thị chip thông tin bé, nên mỗi
        // lần mở trang bài học hay trang quản trị đều có 1-2 truy vấn hoàn toàn bỏ đi.
        var showSiteNavigation = !focusMode && !isKidsZone && !isAdminZone;

        HanhTrangLop1.Models.ChildProfile? activeChild = null;
        if (showSiteNavigation)
        {
            var selectedRaw = Context.Session.GetString(SessionKeys.SelectedChildProfileId);
            if (Guid.TryParse(selectedRaw, out var childId))
            {
                activeChild = await Db.ChildProfiles.AsNoTracking().FirstOrDefaultAsync(x => x.Id == childId);
            }
            if (activeChild is null)
            {
                if (User.Identity?.IsAuthenticated == true)
                {
                    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    if (!string.IsNullOrEmpty(userId))
                    {
                        activeChild = await Db.ChildProfiles.AsNoTracking().Where(x => x.ParentUserId == userId).OrderBy(x => x.CreatedAt).FirstOrDefaultAsync();
                    }
                }
                else
                {
                    activeChild = await Db.ChildProfiles.AsNoTracking().Where(x => x.ParentUserId == null).OrderBy(x => x.CreatedAt).FirstOrDefaultAsync();
                }
            }
        }

        string ResolveAvatar(string? key)
        {
            if (string.IsNullOrWhiteSpace(key)) return "/images/mascot-squirrel-3d.png";
            if (key.StartsWith("/")) return key;
            return key switch
            {
                "avatar-cat" => "/images/avatars/avatar-cat.png",
                "avatar-dog" => "/images/avatars/avatar-dog.png",
                "avatar-bunny" or "tho-trang" => "/images/avatars/avatar-bunny.png",
                "avatar-bear" or "gau-vang" => "/images/avatars/avatar-bear.png",
                "avatar-squirrel" or "soc-nau" => "/images/mascot-squirrel-3d.png",
                _ => "/images/mascot-squirrel-3d.png"
            };
        }
    }

    @if (showSiteNavigation)
    {
    <header class="app-site-header en-header">
        <nav class="navbar navbar-expand-xl app-navbar en-nav" aria-label="Điều hướng chính">
            <div class="container en-nav-inner">
                <!-- Logo -->
                <a class="navbar-brand en-brand" asp-area="" asp-controller="Home" asp-action="Index" title="Về trang chủ">
                    <img src="~/images/soc-nau-mascot.png" alt="" class="en-brand-avatar" />
                    <span class="en-brand-text">
                        <span class="en-brand-title">Hành Trang Lớp 1</span>
                        <span class="en-brand-sub">Sóc Nâu Đồng Hành</span>
                    </span>
                </a>

                <!-- Nút mở menu (điện thoại, iPad) -->
                <button class="navbar-toggler en-menu-btn" type="button" data-bs-toggle="collapse" data-bs-target="#appMainNavbar" aria-controls="appMainNavbar"
                        aria-expanded="false" aria-label="Mở bảng điều hướng">
                    <span class="material-symbols-outlined" aria-hidden="true">menu</span>
                    <span>Menu</span>
                </button>

                <!-- Liên kết điều hướng & tài khoản -->
                <div class="navbar-collapse collapse" id="appMainNavbar">
                    <ul class="navbar-nav en-nav-links">
                        <li class="nav-item">
                            <a class="nav-link en-nav-link @(currentController == "Kids" ? "active" : "")" asp-controller="Kids" asp-action="Home" title="Chuyển sang màn hình học cho bé">
                                <span class="material-symbols-outlined en-nav-icon" aria-hidden="true">school</span>
                                <span>Góc của bé</span>
                            </a>
                        </li>
                        @if (currentController != "Parent")
                        {
                            <li class="nav-item">
                                <a class="nav-link en-nav-link" asp-controller="Parent" asp-action="Dashboard">
                                    <span class="material-symbols-outlined en-nav-icon en-nav-icon--violet" aria-hidden="true">family_restroom</span>
                                    <span>Góc phụ huynh</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || string.Equals(User.Identity?.Name, "admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link en-nav-link" asp-controller="Admin" asp-action="Index" title="Vào hệ thống Quản trị CMS">
                                    <span class="material-symbols-outlined en-nav-icon en-nav-icon--ink" aria-hidden="true">admin_panel_settings</span>
                                    <span>Quản trị CMS</span>
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Cụm bé & tài khoản: Đổi bé · Đổi tài khoản · Đăng xuất -->
                    <div class="en-account">
                        <a class="en-chip en-chip--child" asp-controller="Profiles" asp-action="Index" title="Chọn bạn nhỏ khác để học">
                            <img src="@ResolveAvatar(activeChild?.AvatarKey)" alt="" class="en-chip-avatar" />
                            <span class="en-chip-text">
                                <strong>@(activeChild?.Nickname ?? "Bạn nhỏ")</strong>
                                <small><span class="material-symbols-outlined" aria-hidden="true">sync_alt</span>Đổi bé</small>
                            </span>
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="en-chip en-chip--account" asp-controller="Parent" asp-action="Login" title="Đăng nhập bằng tài khoản phụ huynh khác">
                                <span class="material-symbols-outlined en-chip-icon" aria-hidden="true">account_circle</span>
                                <span class="en-chip-text">
                                    <strong>@(User.Identity.Name)</strong>
                                    <small><span class="material-symbols-outlined" aria-hidden="true">switch_account</span>Đổi tài khoản</small>
                                </span>
                            </a>
                            <form asp-controller="Parent" asp-action="Logout" method="post" class="en-logout-form">
                                <button type="submit" class="en-btn en-btn--sm en-btn--logout" title="Đăng xuất khỏi tài khoản phụ huynh">
                                    <span class="material-symbols-outlined" aria-hidden="true">logout</span>
                                    <span>Đăng xuất</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="en-account-auth">
                                <a class="en-btn en-btn--sm en-btn--violet" asp-controller="Parent" asp-action="Login">
                                    <span class="material-symbols-outlined" aria-hidden="true">login</span>
                                    <span>Đăng nhập</span>
                                </a>
                                <a class="en-btn en-btn--sm en-btn--ghost" asp-controller="Parent" asp-action="Register">Đăng ký</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    }

    <div class="app-page">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @if (showSiteNavigation)
    {
    <footer class="app-footer">
        <div class="container footer-content">
            <div class="footer-brand">
                <img src="~/images/soc-nau-mascot.png" alt="Sóc Nâu" class="footer-avatar" />
                <span>Hành Trang Lớp 1 - Học vui 10-15 phút mỗi ngày cùng Sóc Nâu</span>
            </div>
            <div class="footer-links">
                <a class="app-footer-credit" href="https://openmoji.org/" target="_blank" rel="noopener">Pictogram OpenMoji (CC BY-SA 4.0)</a>
                <a class="app-footer-credit" href="https://commons.wikimedia.org/" target="_blank" rel="noopener">Wikimedia Commons</a>
            </div>
        </div>
    </footer>
    }
    <partial name="_ParentGateModal" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* tracing-guides.js (65 KB) chỉ cần cho 3 trang có bảng tô nét, nhưng trước đây được
       nạp ở MỌI trang, và 2 trang quản trị còn nạp thêm lần nữa trong mục Scripts nên tải
       và chạy hai lần. Vẫn phải đặt trước site.js vì trình soạn bài tô nét gọi
       window.tracingGuides ngay lúc site.js khởi tạo. *@
    @if (ViewData["NeedsTracingGuides"] as bool? == true)
    {
        <script src="~/js/tracing-guides.js" asp-append-version="true"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
